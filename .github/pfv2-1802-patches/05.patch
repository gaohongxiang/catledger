+// ResolveStableSourceIdentityKind reports whether source identifiers are strong
+// enough to identify one source-system record independently of file position.
+func ResolveStableSourceIdentityKind(identifiers SourceIdentifiers) (IdentityKind, bool) {
+	kind, _, stable := stableSourceIdentityParts(identifiers)
+	return kind, stable
+}
+
+func stableSourceIdentityParts(identifiers SourceIdentifiers) (IdentityKind, []string, bool) {
+	transactionId := normalizeStableIdentityIdentifier(identifiers.TransactionId)
+	if transactionId != "" {
+		return IDENTITY_KIND_SOURCE_TRANSACTION_ID, []string{transactionId}, true
+	}
+
+	orderId := normalizeStableIdentityIdentifier(identifiers.OrderId)
+	merchantOrderId := normalizeStableIdentityIdentifier(identifiers.MerchantOrderId)
+	if orderId != "" && merchantOrderId != "" {
+		return IDENTITY_KIND_ORDER_COMBINATION, []string{orderId, merchantOrderId}, true
+	}
+
+	return "", nil, false
+}
