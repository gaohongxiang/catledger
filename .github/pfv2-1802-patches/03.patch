+func TestDedupServicePreservesIdenticalPhysicalRowsWithoutStableIdentifiers(t *testing.T) {
+	repository, database := newSQLiteDedupRepository(t, 1)
+	candidate, accountKey := dedupSourceAccountEvidence(t)
+	const uid = int64(4501)
+	const fileId = int64(4502)
+	const sourceAccountId = int64(4503)
+	insertDedupFixtures(t, database, uid, fileId, sourceAccountId, accountKey, nil, "8")
+	service := newDedupTestService(t, repository, 4600)
+	document := dedupEvidenceDocument(candidate, []importing.EvidenceRow{
+		dedupValidRow(1, "", 4350, true),
+		dedupValidRow(2, "", 4350, true),
+		dedupValidRow(3, "", 4350, true),
+		dedupValidRow(4, "", 4350, true),
+	})
+
+	batch, err := service.PersistEvidenceDocument(nil, dedupPersistRequest(uid, fileId, sourceAccountId, "identical_physical_rows", document))
+	if err != nil {
+		t.Fatalf("persist identical physical rows: %v", err)
+	}
+	assertDedupBatchCounts(t, batch, 4, 4, 0, 0, 0, 4)
+	rows := listDedupRows(t, repository, uid, batch.BatchId)
+	assertDedupRowStates(t, rows, []importing.IdentityState{
+		importing.IDENTITY_STATE_NEW,
+		importing.IDENTITY_STATE_NEW,
+		importing.IDENTITY_STATE_NEW,
+		importing.IDENTITY_STATE_NEW,
+	})
+	seen := make(map[string]struct{}, len(rows))
+	for _, row := range rows {
+		if row.IdentityId == nil || row.IdentityKeyVersion != importing.IDENTITY_KEY_VERSION_V2 {
+			t.Fatalf("physical identity metadata mismatch: %+v", row)
+		}
+		if _, exists := seen[row.ObservedSourceIdentityKey]; exists {
+			t.Fatalf("different physical locators shared identity %q", row.ObservedSourceIdentityKey)
+		}
+		seen[row.ObservedSourceIdentityKey] = struct{}{}
+	}
+	if count := countDedupBeans(t, database, uid, new(importing.SourceIdentity)); count != 4 {
+		t.Fatalf("identical physical rows were collapsed into %d identities", count)
+	}
+
+	reparsed, err := service.PersistEvidenceDocument(nil, dedupPersistRequest(uid, fileId, sourceAccountId, "identical_physical_rows_reparse", document))
+	if err != nil {
+		t.Fatalf("reparse identical physical rows: %v", err)
+	}
+	assertDedupBatchCounts(t, reparsed, 4, 4, 0, 4, 0, 4)
+	reparsedRows := listDedupRows(t, repository, uid, reparsed.BatchId)
+	for index := range rows {
+		if reparsedRows[index].IdentityState != importing.IDENTITY_STATE_EXACT_DUPLICATE ||
+			rows[index].IdentityId == nil || reparsedRows[index].IdentityId == nil ||
+			*rows[index].IdentityId != *reparsedRows[index].IdentityId {
+			t.Fatalf("same file locator did not converge on reparse: first=%+v second=%+v", rows[index], reparsedRows[index])
+		}
+	}
+}
