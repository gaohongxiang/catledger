+func isValidIdentityCandidateVersion(candidate *IdentityCandidate) bool {
+	if candidate == nil {
+		return false
+	}
+
+	switch candidate.Kind {
+	case IDENTITY_KIND_SOURCE_TRANSACTION_ID, IDENTITY_KIND_ORDER_COMBINATION:
+		return candidate.IdentityKeyVersion == IDENTITY_KEY_VERSION_V1
+	case IDENTITY_KIND_PHYSICAL_RECORD:
+		return candidate.IdentityKeyVersion == IDENTITY_KEY_VERSION_V2
+	default:
+		return false
+	}
+}
