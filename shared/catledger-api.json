{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catledger-api current development contract",
  "requestEnvelope": {
    "required": ["action"],
    "shape": {
      "action": "one of actions",
      "data": "action-specific object"
    }
  },
  "actions": {
    "catalog.get": {
      "kind": "read",
      "data": [],
      "returns": ["uid", "accounts", "categories"],
      "accounts": ["accountId", "type", "nature", "name", "currency", "version", "archived"],
      "categories": ["id", "kind", "systemKey", "name", "sortOrder", "version"],
      "consistency": "single read-only snapshot; active categories; no balances or initialization writes"
    },
    "bootstrap": {
      "kind": "read-idempotent",
      "data": [],
      "returns": ["initialized", "uid", "isNewUser", "categories"]
    },
    "dashboard.get": {
      "kind": "read",
      "data": ["month"],
      "returns": ["month", "netWorthMinor", "summary", "cashFlowTrend", "accounts", "recentTransactions"]
    },
    "statistics.get": {
      "kind": "read",
      "data": ["month"],
      "returns": ["month", "summary", "daily", "cashFlowTrend", "metrics", "uncategorized", "expenseCategories", "incomeCategories"]
    },
    "accounts.list": {
      "kind": "read",
      "data": [],
      "returns": ["accounts"]
    },
    "accounts.create": {
      "kind": "idempotent-mutation",
      "data": ["requestId", "type", "name", "currency", "openingDisplayBalanceMinor", "occurredLocalAt", "timezoneOffsetMinutes"],
      "returns": "account"
    },
    "accounts.createBatch": {
      "kind": "idempotent-mutation",
      "data": ["requestId", "accounts"],
      "returns": ["accounts"]
    },
    "accounts.update": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "accountId", "version", "name"],
      "returns": "account"
    },
    "accounts.archive": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "accountId", "version"],
      "returns": "account"
    },
    "accounts.correctBalance": {
      "kind": "idempotent-mutation",
      "data": ["requestId", "accountId", "displayBalanceMinor", "occurredLocalAt", "timezoneOffsetMinutes"],
      "returns": "account"
    },
    "categories.list": {
      "kind": "read",
      "data": [],
      "returns": ["categories"]
    },
    "categories.unclassified": {
      "kind": "read",
      "data": ["month"],
      "returns": ["month", "groups", "categories"]
    },
    "categories.assignTransactions": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "categoryId", "items"],
      "returns": ["updatedCount"]
    },
    "categories.create": {
      "kind": "idempotent-mutation",
      "data": ["requestId", "kind", "name"],
      "returns": "category"
    },
    "categories.update": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "categoryId", "version", "name"],
      "returns": "category"
    },
    "categories.archive": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "categoryId", "version"],
      "returns": "category"
    },
    "categories.restore": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "categoryId", "version"],
      "returns": "category"
    },
    "categories.reorder": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "kind", "items"],
      "returns": ["categories"]
    },
    "transactions.list": {
      "kind": "read",
      "data": ["month", "date?", "accountId?", "categoryId?", "uncategorized? (boolean; exclusive with categoryId)", "search?", "pageSize?", "cursor?"],
      "returns": ["month", "date?", "summary", "transactions (origin; importContext?={updateId,eventId})", "nextCursor"]
    },
    "transactions.create": {
      "kind": "idempotent-mutation",
      "data": ["requestId", "type", "sourceAccountId?", "destinationAccountId?", "categoryId?", "originalTransactionId?", "amountMinor", "occurredLocalAt", "timezoneOffsetMinutes", "note?"],
      "returns": "transaction"
    },
    "transactions.update": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "transactionId", "version", "type", "sourceAccountId?", "destinationAccountId?", "categoryId?", "originalTransactionId?", "amountMinor", "occurredLocalAt", "timezoneOffsetMinutes", "note?"],
      "returns": "transaction"
    },
    "transactions.refundable": {
      "kind": "read",
      "data": ["limit?"],
      "returns": ["transactions"]
    },
    "transactions.linkRefund": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "transactionId", "version", "originalTransactionId"],
      "returns": "transaction"
    },
    "transactions.setCategory": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "transactionId", "version", "categoryId (nullable)"],
      "returns": ["transactionId", "version", "categoryId"]
    },
    "transactions.delete": {
      "kind": "idempotent-versioned-mutation",
      "data": ["requestId", "transactionId", "version"],
      "returns": ["transactionId", "deleted", "version"]
    }
  },
  "rules": {
    "identity": "identity is resolved only from trusted WeChat context; identity-shaped client fields are rejected recursively; bootstrap returns the current user uid for display only",
    "uid": "one immutable 10-digit decimal string per user, first digit nonzero; displayed and copied unchanged; existing UUID ownership is migrated by 0011; other entity and request IDs remain UUIDs",
    "money": "minor-unit decimal strings only; JavaScript floating point is forbidden",
    "time": "occurredLocalAt plus JavaScript getTimezoneOffset() minutes; optional date and month filters use local date",
    "mutation": "requestId is UUID; same key and request replays, same key with different request conflicts",
    "deletion": "accounts and categories archive; manual transactions soft-delete; no physical business deletion",
    "refund": "manual refunds must reference one active original expense; imported pending refunds credit one account without affecting income or expense statistics until linked",
    "cashBalance": "a write may not create or deepen a negative cash balance; historical negative cash remains visible and only improving writes or an explicit balance correction are allowed"
  },
  "successEnvelope": {
    "ok": true,
    "data": "action-specific public result; bootstrap includes uid; WeChat OpenID and identity digests are never returned"
  },
  "failureCodes": [
    "ACCOUNT_INACTIVE",
    "AUTH_REQUIRED",
    "CONFLICT",
    "IDEMPOTENCY_CONFLICT",
    "INSUFFICIENT_CASH_BALANCE",
    "INITIALIZATION_REQUIRED",
    "INTERNAL_ERROR",
    "INVALID_REQUEST",
    "NOT_FOUND",
    "REFUND_EXCEEDS_ORIGINAL",
    "REFUNDED_TRANSACTION_LOCKED",
    "SERVICE_NOT_CONFIGURED",
    "SERVICE_TEMPORARY_UNAVAILABLE",
    "UNSUPPORTED_ACTION",
    "UNSUPPORTED_CURRENCY",
    "VALIDATION_ERROR"
  ]
}
