{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catledger-api v1 bootstrap contract",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["action"],
    "properties": {
      "action": {
        "const": "bootstrap"
      }
    }
  },
  "success": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ok", "data"],
    "properties": {
      "ok": {
        "const": true
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "required": ["initialized", "isNewUser", "categories"],
        "properties": {
          "initialized": {
            "const": true
          },
          "isNewUser": {
            "type": "boolean"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "systemKey", "name", "sortOrder"],
              "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["expense", "income"] },
                "systemKey": { "type": "string" },
                "name": { "type": "string" },
                "sortOrder": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "failureCodes": [
    "AUTH_REQUIRED",
    "INTERNAL_ERROR",
    "INVALID_REQUEST",
    "SERVICE_NOT_CONFIGURED",
    "UNSUPPORTED_ACTION"
  ],
  "identityRule": "uid and WeChat OpenID are server-only and must never be accepted from or returned to the client"
}
