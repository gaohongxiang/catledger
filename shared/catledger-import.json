      "kind": "idempotent-file-mutation",
      "data": [
        "requestId",
        "importId",
        "fileID",
        "timezoneOffsetMinutes"
      ],
      "returns": [
        "import",
        "batch?",
        "duplicateImportId?",
        "reusedImportId?",
        "replacedUpdateId?",
        "duplicateDisposition?"
      ],
      "isolation": "a failed file parse changes only that import file and never rolls back or mutates sibling files"
    },
    "imports.getFile": {
      "kind": "read",
      "data": [
        "importId",
        "pageSize?",
        "cursor?",
        "includeOptions?"
      ],
      "returns": [
        "import",
        "batch?",
        "rows",
        "nextCursor"
      ],
      "rowPolicy": "Each source row appears once in cursor order; parsed rows do not create draft events or old per-row decisions."
    },
    "imports.discardFile": {
      "kind": "idempotent-versioned-mutation",
      "data": [
        "requestId",
