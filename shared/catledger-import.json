{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catledger-import current development contract",
  "organizerViewFields": {
    "issues[].subjectEventIds?": "当前 uid/update 下非 candidate 的真实事件成员 ID，去重；只读展示，不能作为写入授权",
    "events[].duplicateEvidenceCount?": "当前 uid/update/event 下 evidenceRole=duplicate 的来源记录数；不包含 supporting/discarded"
  },
  "performanceV2": {
    "protocolVersion": 2,
    "status": "PERF-4 bounded native workbench",
    "budgetsBytes": {
      "request": 65536,
      "receipt": 32768,
      "summary": 65536,
      "page": 262144,
      "legacy": 262144
    },
    "pageSize": {
      "default": 40,
      "max": 100
    },
    "cursorScope": [
      "server subjectHash HMAC-SHA256",
      "uid",
      "updateId",
      "update.version",
      "planVersion",
      "active domain version",
      "normalized filter",
      "order",
      "last key"
    ],
    "receiptPolicy": "所有导入命令固定小回执，首次事实同事务冻结，摘要独立读取；旧请求身份只读核实。",
    "spec": "specs/mini-1906o-consolidated-optimization/PERFORMANCE-V2-CONTRACT.md",
    "clientState": {
      "maxCachedPages": 3,
      "maxCursorHistory": 8,
      "summary": "Server-authoritative counts and posting gates; current page never supplies batch totals.",
      "selection": "Group actions send selection.mode=all with issueVersion, independent of visible members."
    }
  },
  "requestEnvelope": {
    "required": [
      "action"
    ],
    "shape": {
      "action": "one of actions",
      "data": "action-specific object"
    }
  },
  "actions": {
