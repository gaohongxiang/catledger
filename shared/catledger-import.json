    "imports.prepareMany": {
      "kind": "idempotent-mutation",
      "data": [
        "requestId",
        "files[{fileName,size}]"
      ],
      "returns": [
        "files[{importId,cloudPath,fileName,version}]",
        "maxFiles"
      ]
    },
