    "FILE_FORMAT_UNSUPPORTED",
    "FILE_NOT_UPLOADED",
    "FILE_SIZE_INVALID",
    "IDEMPOTENCY_CONFLICT",
    "IDENTITY_CONFLICT",
    "INSUFFICIENT_CASH_BALANCE",
    "INITIALIZATION_REQUIRED",
    "INTERNAL_ERROR",
    "INVALID_REQUEST",
    "NOT_FOUND",
    "SERVICE_NOT_CONFIGURED",
    "SERVICE_TEMPORARY_UNAVAILABLE",
    "UNRESOLVED_IMPORT",
    "UNSUPPORTED_ACTION",
    "VALIDATION_ERROR",
    "OPERATION_UNCONFIRMED",
    "RECEIPT_RECONCILIATION_REQUIRED"
  ]
}
