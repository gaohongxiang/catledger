.record-summary { padding: 12rpx 0 4rpx; color: var(--ui-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; font-weight: 400; line-height: 1.6; }
.summary-counts { display: flex; flex-wrap: wrap; gap: 4rpx 20rpx; }
.summary-toggle { display: flex; min-height: 88rpx; align-items: center; margin: 0; padding: 0; color: var(--ui-muted, var(--theme-text-muted, #726d66)); font: inherit; background: transparent; text-align: left; border: 0; }
.summary-toggle::after { border: 0; }
.summary-toggle:active { opacity: .72; }
.summary-details { padding-bottom: 16rpx; }
