<view wx:if="{{open}}" class="login-backdrop {{themeClass}}" style="{{themeStyle}}" bindtap="close">
  <view class="login-sheet" catchtap="stopBubble">
    <view class="login-accent"></view>

    <text class="login-title">连接你的个人账本</text>
    <text class="login-copy">可以直接登录，也可以更换头像和昵称。</text>
    <view class="login-profile-row">
      <view class="login-avatar-column">
        <image class="login-avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <button class="login-profile-action" size="mini" open-type="chooseAvatar" disabled="{{submitting}}" bindchooseavatar="chooseAvatar">使用微信头像</button>
      </view>
      <view class="login-nickname-column">
        <view class="login-nickname-label-row">
          <text class="login-field-label">昵称</text>
          <button class="login-shuffle" size="mini" disabled="{{submitting}}" bindtap="shuffleNickname">换一个</button>
        </view>
        <view class="login-nickname-field {{nicknameFocused ? 'login-nickname-field-focused' : ''}}" bindtap="focusNickname">
          <input class="login-nickname-input" aria-label="昵称" type="nickname" value="{{nickname}}" maxlength="24" placeholder="输入昵称" confirm-type="done" focus="{{nicknameFocused}}" cursor-spacing="32" disabled="{{submitting}}" bindinput="bindNickname" bindblur="blurNickname" />
        </view>
        <button class="login-profile-action" size="mini" disabled="{{submitting}}" bindtap="focusNickname">使用微信昵称</button>
      </view>
    </view>
    <text wx:if="{{errorMessage}}" class="login-error">{{errorMessage}}</text>
    <button class="login-primary {{submitting ? 'login-primary-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirm">登录</button>
    <text class="login-cancel" bindtap="close">暂不登录，继续看看</text>
  </view>
</view>
