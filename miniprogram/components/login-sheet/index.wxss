.login-startup {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-page, #FAF8F4);
  color: var(--theme-text-muted, #746a60);
  font-family: "PingFang SC", "Source Han Sans SC", sans-serif;
  font-size: var(--font-body, 28rpx);
}

.login-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 31, 26, .36);
}
.login-sheet {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  overflow: auto;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-xl, 32rpx) var(--theme-radius-xl, 32rpx) 0 0;
  box-shadow: var(--theme-shadow-lifted, 0 -14rpx 40rpx rgba(74, 50, 30, .14));
  max-height: 86vh;
  color: var(--theme-ink);
  font-family: "PingFang SC", "Source Han Sans SC", sans-serif;
  font-weight: 400;
}
.login-accent {
  position: absolute;
  top: 0;
  right: 0;
  width: 132rpx;
  height: 8rpx;
  background: var(--theme-accent, #be5b24);
  display: none;
}
.login-kicker,
.login-title,
.login-copy,
.login-field-label,
.login-error,
.login-cancel { display: block; }
.login-cancel {
  min-height: 88rpx;
  line-height: 88rpx;
  padding-top: 12rpx;
  font-size: var(--font-caption, 24rpx);
}
.login-kicker {
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.login-title {
  max-width: 580rpx;
  margin-top: 6rpx;
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.4;
}
.login-copy {
  max-width: 620rpx;
  margin-top: 12rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.55;
}
.login-profile-row { display: flex; align-items: flex-end; gap: 24rpx; margin-top: 24rpx; }
.login-avatar-column { flex: 0 0 184rpx; display: flex; flex-direction: column; align-items: center; }
.login-avatar-image { width: 96rpx; height: 96rpx; border-radius: var(--theme-radius-large, 24rpx); }
.login-nickname-column { flex: 1; min-width: 0; max-width: 380rpx; }
.login-field-label { display: block; margin-bottom: 8rpx; color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); }
.login-nickname-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 64rpx;
  padding: 0 12rpx;
  background: var(--theme-surface, #fffdf9);
  border: 1rpx solid var(--theme-border, #e5dfd7);
  border-radius: var(--theme-radius-small, 12rpx);
}
.login-nickname-field-focused { border-color: var(--theme-accent, #be5b24); }
.login-nickname-input { flex: 1; min-width: 0; box-sizing: border-box; width: 0; height: 46rpx; padding: 0; color: var(--theme-ink, #29231e); font-size: var(--font-body, 28rpx); }
.login-sheet .login-profile-row .login-profile-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-height: 72rpx;
  margin: 8rpx 0 0;
  padding: 8rpx 4rpx;
  color: var(--theme-accent-strong, #a34d20);
  background: transparent;
  border-radius: var(--theme-radius-small, 12rpx);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  line-height: 1.4;
}
.login-profile-action::after { border: 0; }
.login-profile-action:active { opacity: .7; }
.login-error { margin-top: 12rpx; color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); }
.login-primary {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  color: var(--theme-on-accent, #fffaf1);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  background: var(--theme-accent, #be5b24);
  border-radius: var(--theme-radius-medium, 18rpx);
  line-height: 1.5;
  padding: 20rpx 24rpx;
}
.login-primary:active { opacity: .76; }
.login-primary-disabled { opacity: .56; }
.login-cancel {
  min-height: 72rpx;
  padding-top: 18rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 72rpx;
  text-align: center;
}

.login-sheet .login-nickname-field .login-shuffle {
  display: flex; flex: 0 0 auto; align-self: stretch; align-items: center; justify-content: center;
  min-height: 0; min-width: 104rpx; margin: 0; padding: 0 4rpx 0 16rpx;
  color: var(--theme-accent-strong, #a34d20); background: transparent;
  font-size: var(--font-caption, 24rpx); line-height: 1.4; font-weight: 400; border-radius: 0;
}
.login-shuffle::after { border: 0; }
.login-shuffle:active { opacity: .7; }

/* 组件样式隔离，抖动帧需本地一份；reduced-motion 同样本地收敛。 */
@keyframes login-nickname-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(3px); }
}
.login-nickname-shake { animation: login-nickname-shake 360ms ease; }
@media (prefers-reduced-motion: reduce) {
  .login-nickname-shake { animation: none !important; }
}
