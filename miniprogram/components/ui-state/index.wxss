.us {
  display: block;
  box-sizing: border-box;
  padding: 28rpx;
  margin: 20rpx 0;
  color: var(--theme-text-muted, #70685f);
  background: var(--theme-surface, #fffefd);
  border: 1rpx solid var(--theme-line, #eae4dc);
  border-radius: var(--layout-radius-large, 24rpx);
  line-height: 1.6;
  font-size: var(--font-body, 28rpx);
  overflow-wrap: anywhere;
}

.us-centered { text-align: center; }

.us-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--theme-ink, #2c2823);
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
}

.us-desc { display: block; }

.us-error { color: var(--theme-danger, #a95132); }
.us-error .us-title { color: var(--theme-danger, #a95132); }
