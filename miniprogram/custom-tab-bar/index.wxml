<login-sheet id="loginSheet" />

<view wx:if="{{!hidden}}" class="tab-shell {{themeClass}} ui-refined" style="{{themeStyle}}">
  <view class="tab-side tab-side-left">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      wx:if="{{index < 2}}"
      class="tab-item {{selected === index ? 'tab-item-selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon" mode="aspectFit" src="{{themeIconRoot}}/{{selected === index ? item.selectedIconPath : item.iconPath}}" />
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>

  <view class="record-entry" role="button" aria-label="记一笔" bindtap="openEditor">
    <view class="record-fab">
      <image class="record-icon" mode="aspectFit" src="{{themeIconRoot}}/tab-plus.svg" />
    </view>
    <text class="record-label">记账</text>
  </view>

  <view class="tab-side tab-side-right">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      wx:if="{{index >= 2}}"
      class="tab-item {{selected === index ? 'tab-item-selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon" mode="aspectFit" src="{{themeIconRoot}}/{{selected === index ? item.selectedIconPath : item.iconPath}}" />
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
