.tab-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 10rpx 24rpx env(safe-area-inset-bottom);
  background: var(--theme-surface, #fffdf9);
  border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}

.tab-side { display: flex; width: 40%; height: 96rpx; }
.tab-side-right { margin-left: auto; }
.tab-item {
  display: flex;
  width: 50%;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--theme-text-muted, #746a60);
  transition: opacity 120ms ease;
}
.tab-item:active { opacity: .62; }
.tab-icon-wrap {
  display: flex;
  width: 52rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}
.tab-item-selected .tab-icon-wrap { background: var(--theme-accent-soft, #f6e5d8); }
.tab-icon { width: 32rpx; height: 32rpx; }
.tab-label { margin-top: 2rpx; font-size: 21rpx; font-weight: 400; line-height: 1.2; }
.tab-item-selected .tab-label { color: var(--theme-accent, #d97732); }

.record-entry {
  position: absolute;
  top: -22rpx;
  left: 50%;
  display: flex;
  width: 112rpx;
  height: 134rpx;
  align-items: center;
  flex-direction: column;
  transform: translateX(-50%);
}
.record-fab {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--theme-accent, #d97732);
  border: 4rpx solid var(--theme-surface, #fffdf9);
  border-radius: 999rpx;
  box-shadow: var(--theme-shadow-soft, 0 3rpx 14rpx rgba(74, 50, 30, .05));
  transition: opacity 120ms ease;
}
.record-entry:active .record-fab { opacity: .72; }
.record-icon { width: 34rpx; height: 34rpx; }
.record-label { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 21rpx; font-weight: 400; line-height: 1.2; }

.entry-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 31, 26, .34);
}
.entry-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--theme-surface, #fffdf9);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: var(--theme-shadow-lifted, 0 -14rpx 40rpx rgba(74, 50, 30, .14));
}
.entry-heading { padding-bottom: 26rpx; }
.entry-kicker,
.entry-title,
.entry-copy,
.entry-option-title,
.entry-option-note,
.entry-cancel { display: block; }
.entry-kicker { color: var(--theme-secondary, #64705d); font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; }
.entry-title { margin-top: 6rpx; color: var(--theme-ink, #29231e); font-size: 32rpx; font-weight: 600; }
.entry-copy { margin-top: 10rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; line-height: 1.55; }
.entry-option {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  transition: opacity 120ms ease;
}
.entry-option:active { opacity: .76; }
.entry-option-primary { color: var(--theme-on-accent, #fffaf4); background: var(--theme-accent, #d97732); }
.entry-option-secondary { margin-top: 12rpx; color: var(--theme-ink, #29231e); background: var(--theme-accent-soft, #f6e5d8); }
.entry-option-title { font-size: 26rpx; font-weight: 600; }
.entry-option-note { margin-top: 4rpx; font-size: 22rpx; opacity: .72; }
.entry-badge { padding: 6rpx 12rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 20rpx; font-weight: 600; background: var(--theme-surface, #fffdf9); border-radius: 999rpx; }
.entry-arrow { color: var(--theme-accent-strong, #b85f2e); font-size: 34rpx; }
.entry-cancel { min-height: 72rpx; padding-top: 22rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; line-height: 72rpx; text-align: center; }
