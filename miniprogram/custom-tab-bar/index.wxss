.tab-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 10rpx 24rpx env(safe-area-inset-bottom);
  background: var(--theme-surface, #fffdf9);
  border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}

.tab-side { display: flex; width: 40%; height: 96rpx; }
.tab-side-right { margin-left: auto; }
.tab-item {
  display: flex;
  width: 50%;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--theme-text-muted, #746a60);
  transition: opacity 120ms ease;
}
.tab-item:active { opacity: .62; }
.tab-icon-wrap {
  display: flex;
  width: 52rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}
.tab-item-selected .tab-icon-wrap { background: var(--theme-accent-soft, #f6e5d8); }
.tab-icon { width: 32rpx; height: 32rpx; }
.tab-label {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}
.tab-item-selected .tab-label { color: var(--theme-accent, #d97732); }

.record-entry {
  position: absolute;
  top: -22rpx;
  left: 50%;
  display: flex;
  width: 112rpx;
  height: 134rpx;
  align-items: center;
  flex-direction: column;
  transform: translateX(-50%);
}
.record-fab {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--theme-accent, #d97732);
  border: 4rpx solid var(--theme-surface, #fffdf9);
  border-radius: 999rpx;
  box-shadow: var(--theme-shadow-soft, 0 3rpx 14rpx rgba(74, 50, 30, .05));
  transition: opacity 120ms ease;
}
.record-entry:active .record-fab { opacity: .72; }
.record-icon { width: 34rpx; height: 34rpx; }
.record-label {
  margin-top: 4rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

/* 所有一级页面使用同一底栏字感。 */
.tab-shell.ui-refined { border-top-width: 1rpx; font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif; }
.tab-shell.ui-refined.theme-warm-ledger { background: #fffefd; border-top-color: #eae4dc; }
.ui-refined .tab-icon-wrap { background: transparent; }
.ui-refined .tab-label,
.ui-refined .record-label { font-size: 24rpx; font-weight: 400; letter-spacing: 0; }
.ui-refined .tab-item-selected .tab-label { color: var(--theme-accent-strong, #a85b2e); }
.ui-refined .record-fab { box-shadow: 0 4rpx 12rpx rgba(61, 44, 28, .06); }
.ui-refined.theme-warm-ledger .record-fab { border-color: #fffefd; }
