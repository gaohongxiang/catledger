.loan-link-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.ll-note-card { display: block; margin: 24rpx 0; padding: var(--layout-space-5); background: var(--theme-surface-muted); border-radius: var(--layout-radius-medium); }
.ll-note { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.7; }
.ll-note + .ll-note { margin-top: var(--layout-space-1); }
.ll-warning { color: var(--theme-danger); }
.ll-field { display: block; padding: 18rpx 0; }
.ll-field > text { display: block; color: var(--theme-text-muted); margin-bottom: var(--layout-space-2); font-size: var(--font-caption); }
.ll-picker { display: flex; align-items: center; justify-content: space-between; gap: var(--layout-space-4); box-sizing: border-box; min-height: 88rpx; padding: 22rpx 24rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-medium); font-size: var(--font-body); }
.ll-picker-value { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.ll-candidate { display: block; box-sizing: border-box; width: 100%; margin: 0 0 20rpx; padding: 28rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large); text-align: left; font-size: var(--font-body); line-height: 1.7; overflow-wrap: anywhere; transition: transform var(--layout-motion-fast) var(--motion-press-timing), opacity var(--layout-motion-fast) ease; }
.ll-candidate-hover { transform: scale(var(--motion-press-scale, .965)); opacity: .88; }
.ll-candidate .ll-note { margin-top: 6rpx; }
.ll-candidate-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--layout-space-5); }
.ll-candidate-title { flex: 1; min-width: 0; font-weight: 500; overflow-wrap: anywhere; }
.ll-candidate-amount { flex-shrink: 0; text-align: right; font-size: var(--font-section); font-weight: 500; }
.ll-summary { margin-top: var(--layout-space-5); padding: 28rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large); }
.ll-principal { display: block; margin-bottom: var(--layout-space-1); font-size: var(--font-display); font-weight: 500; line-height: 1.2; overflow-wrap: anywhere; }
.ll-section-title { display: block; margin: 32rpx 0 16rpx; font-size: var(--font-section); font-weight: 500; }
.ll-action-text { display: block; margin-top: var(--layout-space-2); color: var(--theme-accent-strong); font-size: var(--font-caption); }
.ll-evidence { margin-top: var(--layout-space-5); padding: 24rpx 28rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large); }
.ll-evidence .ll-section-title { margin-top: 0; }
.ll-row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--layout-space-5); padding: 20rpx 0; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-caption); }
.ll-row text:first-child { color: var(--theme-text-muted); flex-shrink: 0; }
.ll-row text:last-child { text-align: right; overflow-wrap: anywhere; }
.ll-link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 8rpx 0 0; padding: 12rpx 20rpx; background: transparent; color: var(--theme-accent-strong); font-size: var(--font-caption); }
.ll-action { margin-top: var(--layout-space-4); }
.ll-paging { display: flex; align-items: center; justify-content: space-between; gap: var(--layout-space-4); margin-top: var(--layout-space-5); }
.ll-page-button { display: flex; flex: 1; align-items: center; justify-content: center; gap: var(--layout-space-1); min-height: 88rpx; margin: 0; padding: 16rpx 20rpx; background: transparent; color: var(--theme-accent-strong); font-size: var(--font-body); font-weight: 500; }
.ll-page-button[disabled] { background: transparent; color: var(--theme-text-muted); }
