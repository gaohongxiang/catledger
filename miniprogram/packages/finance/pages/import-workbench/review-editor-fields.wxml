<template name="review-editor-fields">
  <view class="detail-nature-first editor-summary-card">
    <view class="issue-summary-main">
      <picker wx:if="{{canEdit && editor.supported && !editor.principal && !editor.repaymentChannel}}" mode="selector" range="{{editor.natureOptions}}" range-key="label" value="{{editor.natureIndex}}" bindchange="changeReviewedNature" disabled="{{disabled}}" aria-label="选择交易性质"><view class="issue-summary-nature"><text>{{editor.natureLabel}}</text><text class="editor-nature-chevron" aria-hidden="true">›</text></view></picker>
      <text wx:else class="issue-summary-nature">{{editor.natureLabel}}</text>
      <view class="editor-amount money-number {{editor.directionClass}}"><text>¥</text><view wx:if="{{canEdit && editor.supported && !editor.repaymentChannel}}" class="editor-amount-input"><text class="editor-amount-measure" aria-hidden="true">{{draft.amountInput || '0.00'}}</text><input type="digit" class="money-number" value="{{draft.amountInput}}" placeholder="0.00" data-field="amountInput" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" aria-label="记账金额（元）" /></view><text wx:else>{{draft.amountInput || '金额待补充'}}</text></view>
    </view>
    <button wx:if="{{canEdit}}" class="issue-summary-meta editor-summary-meta editor-summary-edit" bindtap="toggleEditorDetails" disabled="{{sheet.saving}}" aria-label="{{editor.repaymentChannel ? '修改交易对方与备注' : '修改日期、交易对方与备注'}}" aria-expanded="{{sheet.detailsExpanded}}"><text wx:if="{{editor.summaryParty}}" class="issue-summary-party">{{editor.summaryParty}}</text><text class="issue-summary-time">{{editor.summaryTime || '时间待补充'}}</text></button>
    <view wx:else class="issue-summary-meta editor-summary-meta"><text wx:if="{{editor.summaryParty}}" class="issue-summary-party">{{editor.summaryParty}}</text><text class="issue-summary-time">{{editor.summaryTime || '时间待补充'}}</text></view>
    <text wx:if="{{editor.fieldErrors.amountInput}}" class="editor-field-error">{{editor.fieldErrors.amountInput}}</text>
    <view wx:if="{{editor.showOwnership}}" class="repayment-ownership">
      <button wx:if="{{canEdit && editor.supported && !editor.repaymentChannel}}" class="repayment-mode-row" data-field="owner" data-value="{{draft.owner === 'other' ? 'self' : 'other'}}" bindtap="changeEditorMode" disabled="{{disabled || draft.composition === 'repayment'}}"><text class="repayment-mode-label">还款归属</text><text class="repayment-mode-value">{{draft.owner === 'other' ? '替他人还款' : '为自己还款'}}<text class="repayment-mode-chevron" aria-hidden="true">›</text></text></button>
      <view wx:else class="repayment-mode-row"><text class="repayment-mode-label">还款归属</text><text class="repayment-mode-value">{{draft.owner === 'other' ? '替他人还款' : '为自己还款'}}</text></view>
      <view wx:if="{{editor.other}}" class="ownership-treatment">
        <text class="mapping-label">这笔钱是否需要收回？</text>
        <button class="ownership-option {{draft.otherTreatment === 'expense' ? 'ownership-option-selected' : ''}}" data-field="otherTreatment" data-value="expense" bindtap="changeEditorMode" disabled="{{disabled || !canEdit}}"><view class="ownership-treatment-copy"><text class="ownership-treatment-title">无需收回</text><text class="ownership-treatment-detail">记为支出</text></view><view class="ownership-treatment-check" aria-hidden="true" /></button>
        <button class="ownership-option {{draft.otherTreatment === 'pending' ? 'ownership-option-selected' : ''}}" data-field="otherTreatment" data-value="pending" bindtap="changeEditorMode" disabled="{{disabled || !canEdit}}"><view class="ownership-treatment-copy"><text class="ownership-treatment-title">需要收回或暂不确定</text><text class="ownership-treatment-detail">保留待核对，暂不入账</text></view><view class="ownership-treatment-check" aria-hidden="true" /></button>
      </view>
    </view>
  </view>
  <view wx:if="{{editor.fundsEndpoints.length}}" class="decision-group">
    <text class="decision-group-title">{{editor.routeTitle}}</text>
    <view class="funds-card">
      <block wx:for="{{editor.fundsEndpoints}}" wx:key="key" wx:for-item="endpoint" wx:for-index="endpointIndex">
        <view wx:if="{{endpointIndex}}" class="funds-link" />
        <view class="funds-endpoint">
          <view class="funds-dot {{endpoint.required ? 'is-required' : ''}}" />
          <text class="funds-endpoint-label">{{endpoint.label}}<text wx:if="{{endpoint.required}}" class="funds-endpoint-required"> · 必选</text></text>
          <button wx:if="{{endpoint.open && canEdit}}" class="funds-add" data-endpoint="{{endpoint.key}}" bindtap="addFundsAccount" disabled="{{disabled || !endpoint.addable}}" aria-label="添加{{endpoint.label}}">＋ 添加</button>
        </view>
        <view wx:for="{{endpoint.accounts}}" wx:key="index" wx:for-item="account" wx:for-index="accountIndex" class="funds-account-row {{endpoint.required ? 'is-required' : ''}}">
          <button wx:if="{{canEdit && editor.supported && !account.readonly}}" class="funds-account" data-target="{{account.target}}" bindtap="openDirectory" disabled="{{disabled}}" aria-label="{{(account.accountId ? '修改' : '选择') + endpoint.label}}">
            <text class="funds-account-name {{account.accountId ? '' : 'is-empty'}}">{{account.name || '请选择' + endpoint.label}}</text>
          </button>
          <view wx:else class="funds-account"><text class="funds-account-name">{{account.name || '待补充'}}</text></view>
          <input wx:if="{{endpoint.split && canEdit}}" type="digit" class="funds-account-amount" value="{{account.amountInput}}" data-endpoint="{{endpoint.key}}" data-index="{{account.index}}" bindinput="changeFundsAmount" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" placeholder="0.00" placeholder-class="funds-amount-placeholder" disabled="{{disabled}}" aria-label="本账户金额（元）" />
          <text wx:elif="{{endpoint.split}}" class="funds-account-amount">¥{{account.amountInput || '0.00'}}</text>
          <button wx:if="{{endpoint.split && canEdit}}" class="funds-account-remove" data-endpoint="{{endpoint.key}}" data-index="{{account.index}}" bindtap="removeFundsAccount" disabled="{{disabled}}" aria-label="移除此账户">×</button>
          <text wx:elif="{{!endpoint.split && canEdit && editor.supported && !account.readonly}}" class="funds-account-chevron" aria-hidden="true">›</text>
        </view>
      </block>
      <text wx:if="{{editor.splitRepayment}}" class="sheet-copy funds-note">多个还入账户只用于本人负债；替他人还款请只留一个还入账户。</text>
    </view>
  </view>
  <view wx:if="{{editor.repaymentChannel}}" class="decision-group">
    <text class="decision-group-title">还款金额构成</text>
    <view class="channel-breakdown">
      <view class="channel-breakdown-amounts">
        <view class="channel-breakdown-item"><text class="channel-breakdown-label">还款到账</text><text class="channel-breakdown-value money-number">¥{{editor.repaymentChannel.repaymentText}}</text></view>
        <text class="channel-breakdown-op" aria-hidden="true">＋</text>
        <view class="channel-breakdown-item"><text class="channel-breakdown-label">{{editor.repaymentChannel.confirmed ? '手续费' : '差额 · 待核对'}}</text><text class="channel-breakdown-value money-number {{editor.repaymentChannel.confirmed ? '' : 'channel-breakdown-fee-pending'}}">¥{{editor.repaymentChannel.feeText}}</text></view>
        <text class="channel-breakdown-op" aria-hidden="true">＝</text>
        <view class="channel-breakdown-item"><text class="channel-breakdown-label">合计扣款</text><text class="channel-breakdown-value money-number channel-breakdown-total">¥{{editor.repaymentChannel.totalText}}</text></view>
      </view>
      <text class="channel-breakdown-note">金额与还入账户来自两份原文；修改请先拆开同笔判断</text>
      <text wx:if="{{editor.fieldErrors.repaymentChannel}}" class="editor-field-error">{{editor.fieldErrors.repaymentChannel}}</text>
      <view wx:if="{{!editor.repaymentChannel.confirmed}}" class="ownership-treatment channel-confirm">
        <button wx:if="{{canEdit && editor.supported}}" class="ownership-option {{draft.repaymentChannelConfirmed ? 'ownership-option-selected' : ''}}" data-field="repaymentChannelConfirmed" data-value="{{!draft.repaymentChannelConfirmed}}" bindtap="changeEditorMode" disabled="{{disabled}}" aria-role="checkbox" aria-checked="{{draft.repaymentChannelConfirmed}}"><view class="ownership-treatment-copy"><text class="ownership-treatment-title">{{editor.repaymentChannel.confirmationText}}</text><text class="ownership-treatment-detail">勾选后保存；不确定可先保留待核对</text></view><view class="ownership-treatment-check" aria-hidden="true" /></button>
      </view>
    </view>
  </view>
  <view wx:if="{{canEdit && editor.bankSuggestion}}" class="bank-suggestion">
    <view class="bank-suggestion-summary"><text class="bank-suggestion-copy">未提供尾号，请核对</text><button wx:for="{{editor.bankSuggestion.candidates}}" wx:key="accountId" class="funds-suggestion" data-id="{{item.accountId}}" bindtap="selectEditorSuggestion" disabled="{{disabled}}" aria-label="{{'使用建议账户：' + item.name}}"><text class="funds-suggestion-name">使用：{{item.name}}</text></button></view>
    <text wx:if="{{sheet.suggestionLoading && !editor.bankSuggestion.candidates.length}}" class="sheet-copy">正在读取建议账户…</text>
    <button wx:if="{{sheet.suggestionError}}" class="review-text-action" data-retry="true" bindtap="loadEditorSuggestions" disabled="{{disabled || sheet.suggestionLoading}}">{{sheet.suggestionError}}</button>
    <button wx:if="{{sheet.suggestionMore}}" class="review-text-action" data-target="{{editor.bankSuggestion.target}}" bindtap="openDirectory" disabled="{{disabled}}">查看全部账户<text class="app-chevron">›</text></button>
  </view>
  <text wx:if="{{editor.fieldErrors.funds}}" class="editor-field-error">{{editor.fieldErrors.funds}}</text>
  <text wx:if="{{canEdit && !sheet.detailsExpanded && (editor.fieldErrors.time || editor.fieldErrors.counterparty || editor.fieldErrors.note)}}" class="editor-field-error">{{editor.fieldErrors.time || editor.fieldErrors.counterparty || editor.fieldErrors.note}}</text>
  <view wx:if="{{sheet.detailsExpanded}}" class="mapping-fields editor-details">
    <view class="mapping-field"><text class="mapping-label">日期</text><picker wx:if="{{canEdit && editor.supported && !editor.repaymentChannel}}" mode="date" value="{{draft.date}}" data-field="date" bindchange="changeEditorText" disabled="{{disabled}}"><text class="mapping-value">{{draft.date || '请选择日期'}}<text class="app-chevron">›</text></text></picker><text wx:else>{{draft.date || '待补充'}}</text></view>
    <view class="mapping-field"><text class="mapping-label">时间</text><input wx:if="{{canEdit && editor.supported && !editor.repaymentChannel}}" value="{{draft.time}}" maxlength="8" placeholder="时:分:秒" data-field="time" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" aria-label="交易时间，时分秒" /><text wx:else>{{draft.time || '待补充'}}</text></view>
    <text wx:if="{{editor.fieldErrors.time}}" class="editor-field-error">{{editor.fieldErrors.time}}</text>
    <view class="mapping-field"><text class="mapping-label">交易对方</text><input wx:if="{{canEdit && editor.supported}}" value="{{draft.counterparty}}" maxlength="200" placeholder="选填" data-field="counterparty" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" aria-label="记账交易对方" /><text wx:else class="mapping-value">{{draft.counterparty || '未填写'}}</text></view>
    <text wx:if="{{editor.fieldErrors.counterparty}}" class="editor-field-error">{{editor.fieldErrors.counterparty}}</text>
    <view class="mapping-field"><text class="mapping-label">备注</text><textarea wx:if="{{canEdit && editor.supported}}" auto-height value="{{draft.note}}" maxlength="200" placeholder="选填；不改变原始账单" data-field="note" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" aria-label="记账备注" /><text wx:else class="mapping-value">{{draft.note || '未填写'}}</text></view>
    <text wx:if="{{editor.fieldErrors.note}}" class="editor-field-error">{{editor.fieldErrors.note}}</text>
    <block wx:for="{{editor.fundsEndpoints}}" wx:key="key" wx:for-item="endpoint"><block wx:for="{{endpoint.accounts}}" wx:key="index" wx:for-item="account"><button wx:if="{{canEdit && account.accountId && !account.readonly && !account.removable}}" class="review-text-action" data-field="{{account.target === 'reviewAccount' ? 'ledgerAccountId' : 'counterpartyLedgerAccountId'}}" bindtap="clearEditorChoice" disabled="{{disabled}}">清除{{endpoint.label}}选择</button></block></block>
    <button wx:if="{{canEdit && draft.categoryId}}" class="review-text-action" data-field="categoryId" bindtap="clearEditorChoice" disabled="{{disabled}}">清除分类</button>
  </view>
  <view wx:if="{{!canEdit && draft.note}}" class="mapping-fields">
    <view class="mapping-field"><text class="mapping-label">备注</text><text class="mapping-value">{{draft.note}}</text></view>
  </view>
  <text wx:if="{{editor.fieldErrors.composition}}" class="editor-field-error">{{editor.fieldErrors.composition}}</text>
  <view wx:if="{{editor.needsCompositionNote}}" class="decision-group">
    <text class="decision-group-title">核对说明</text>
    <view class="decision-card"><textarea wx:if="{{canEdit}}" auto-height value="{{draft.evidenceNote}}" maxlength="300" data-field="evidenceNote" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" placeholder="选填。按单笔记录后不再区分各来源分摊" /><text wx:else>{{draft.evidenceNote || '未填写'}}</text></view>
  </view>
  <text wx:if="{{editor.fieldErrors.evidenceNote}}" class="editor-field-error">{{editor.fieldErrors.evidenceNote}}</text>
  <view wx:if="{{editor.categoryKind}}" class="decision-group">
    <text class="decision-group-title">分类</text>
    <view class="decision-card">
      <button wx:if="{{canEdit && editor.supported}}" class="repayment-mode-row" data-target="editorCategory" bindtap="openDirectory" disabled="{{disabled}}"><text class="repayment-mode-label">分类 · 选填</text><text class="repayment-mode-value">{{editor.categoryName || '待分类（可稍后补）'}}<text class="repayment-mode-chevron" aria-hidden="true">›</text></text></button>
      <view wx:else class="repayment-mode-row"><text class="repayment-mode-label">分类</text><text class="repayment-mode-value">{{editor.categoryName || '待分类'}}</text></view>
    </view>
  </view>
  <text wx:if="{{editor.fieldErrors.categoryId}}" class="editor-field-error">{{editor.fieldErrors.categoryId}}</text>
  <view wx:if="{{editor.showLoan}}" class="decision-group">
    <text class="decision-group-title">还款构成</text>
    <view class="decision-card">
      <view wx:if="{{canEdit}}" class="editor-mode-choices" aria-label="还款方式"><button data-field="repaymentMode" data-value="ordinary" bindtap="changeEditorMode" disabled="{{disabled}}" class="{{draft.repaymentMode === 'ordinary' ? 'editor-mode-selected' : ''}}">普通清偿</button><button data-field="repaymentMode" data-value="loan" bindtap="changeEditorMode" disabled="{{disabled}}" class="{{draft.repaymentMode === 'loan' ? 'editor-mode-selected' : ''}}">贷款本息费</button></view>
      <view wx:if="{{draft.repaymentMode === 'loan'}}" class="mapping-fields">
        <text wx:if="{{editor.fieldErrors.repayment}}" class="editor-field-error">{{editor.fieldErrors.repayment}}</text>
        <text class="sheet-copy">信用卡整单还款选普通清偿。贷款本息费没有的填 0，未知的保留待核对。</text>
        <view wx:for="{{editor.loanFields}}" wx:key="key" class="mapping-field"><text>{{item.label}}</text><input wx:if="{{canEdit}}" type="digit" value="{{item.value}}" data-field="{{item.key}}" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" placeholder="待确认；没有填 0" aria-label="{{item.label + '（元）'}}" /><text wx:else>{{item.value === '' ? '待确认' : '¥' + item.value}}</text></view>
        <button class="repayment-mode-row" data-field="interestTreatment" data-value="{{draft.interestTreatment === 'expense' ? 'accrued' : 'expense'}}" bindtap="changeEditorMode" disabled="{{disabled || !canEdit}}"><text>利息处理</text><text>{{draft.interestTreatment === 'expense' ? '补记本次费用' : '清偿已记费用'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
        <button wx:if="{{draft.interestTreatment === 'expense'}}" class="repayment-mode-row" data-target="editorInterest" bindtap="openDirectory" disabled="{{disabled || !canEdit}}"><text>利息分类</text><text>{{editor.interestCategoryName || '无费用可不填'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
        <button class="repayment-mode-row" data-field="feeTreatment" data-value="{{draft.feeTreatment === 'expense' ? 'accrued' : 'expense'}}" bindtap="changeEditorMode" disabled="{{disabled || !canEdit}}"><text>费用处理</text><text>{{draft.feeTreatment === 'expense' ? '补记本次费用' : '清偿已记费用'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
        <button wx:if="{{draft.feeTreatment === 'expense'}}" class="repayment-mode-row" data-target="editorFee" bindtap="openDirectory" disabled="{{disabled || !canEdit}}"><text>费用分类</text><text>{{editor.feeCategoryName || '无费用可不填'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
        <button class="repayment-mode-row" data-field="loanMode" data-value="{{draft.loanMode === 'defer' ? 'associate' : 'defer'}}" bindtap="changeEditorMode" disabled="{{disabled || !canEdit}}"><text>贷款关联</text><text>{{draft.loanMode === 'associate' ? '关联已有贷款' : '入账后补充'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
        <block wx:if="{{draft.loanMode === 'associate'}}">
          <button class="repayment-mode-row" data-target="editorLoan" bindtap="openDirectory" disabled="{{disabled || !canEdit}}"><text>{{sheet.loanName || '选择贷款计划'}}<text wx:if="{{canEdit}}" class="app-chevron">›</text></text></button>
          <text class="sheet-copy">选择本次清偿的已有收费项；已计入负债的费用不会再次计支出。</text>
          <button wx:if="{{canEdit && draft.loanId}}" class="review-text-action" bindtap="loadEditorCharges" disabled="{{disabled || sheet.chargeLoading}}">{{sheet.chargeLoading ? '正在读取收费项…' : '核验可清偿收费项'}}</button>
          <text wx:if="{{sheet.chargeError}}" class="inline-error">{{sheet.chargeError}}</text>
          <button wx:for="{{sheet.chargeChoices}}" wx:key="chargeId" class="relation-row" data-id="{{item.chargeId}}" bindtap="selectEditorCharge" disabled="{{disabled || !canEdit || sheet.chargeLoading}}"><text>{{item.label}} · {{item.treatment}} · ¥{{item.amount}}</text><text>{{item.selected ? '已选择' : '选择'}}</text></button>
          <button wx:if="{{canEdit && sheet.chargeMore}}" class="review-text-action" data-more="true" bindtap="loadEditorCharges" disabled="{{disabled || sheet.chargeLoading}}">下一页收费项</button>
          <view wx:for="{{editor.chargeRows}}" wx:key="chargeId" class="editor-part"><text>{{item.component === 'interest' ? '利息' : '费用'}}清偿 {{index + 1}}</text><input wx:if="{{canEdit}}" type="digit" value="{{item.amountInput}}" data-index="{{index}}" bindinput="changeEditorChargeAmount" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" placeholder="本次清偿金额" /><text wx:else>¥{{item.amountInput}}</text><button wx:if="{{canEdit}}" class="review-text-action" data-index="{{index}}" bindtap="removeEditorCharge" disabled="{{disabled}}">移除</button></view>
        </block>
      </view>
    </view>
  </view>
  <view wx:if="{{editor.refund}}" class="decision-group">
    <text class="decision-group-title">原消费关系</text>
    <view class="decision-card"><text class="sheet-copy">{{draft.refund ? (draft.refund.mode === 'link' ? '已选择原消费，保存时重新核验' : draft.refund.mode === 'pending' ? '暂记待关联' : '待关联') : (sheet.originalRefund.status === 'confirmed' ? '已关联原消费' : sheet.originalRefund.status === 'pending' ? '已暂记待关联' : '待关联原消费')}}</text>
      <text wx:if="{{editor.refundOriginalText}}" class="sheet-copy">{{editor.refundOriginalText}}</text><text class="sheet-copy">分类：{{editor.refundCategory || '关联原消费后确定'}}（随原消费，不单独编辑）</text>
      <block wx:if="{{canEdit && editor.supported}}">
        <view class="editor-mode-choices"><button data-kind="event" bindtap="loadEditorRefunds" disabled="{{disabled || sheet.refundLoading}}">本批原消费</button><button data-kind="transaction" bindtap="loadEditorRefunds" disabled="{{disabled || sheet.refundLoading}}">历史原消费</button></view>
        <text wx:if="{{sheet.refundLoading}}" class="sheet-copy">正在核验候选…</text><text wx:if="{{sheet.refundError}}" class="inline-error">{{sheet.refundError}}</text>
        <button wx:for="{{sheet.refundChoices}}" wx:key="id" class="relation-row" data-id="{{item.id}}" bindtap="selectEditorRefund" disabled="{{disabled || sheet.refundLoading}}"><view><text>{{item.note || '原消费'}}</text><text class="sheet-copy">{{item.localAt}} · 可退 {{item.amountText}}</text></view><text>{{draft.refund.id === item.id ? '已选' : '选择'}}</text></button>
        <button wx:if="{{sheet.refundMore}}" class="review-text-action" data-kind="{{sheet.refundKind}}" data-more="true" bindtap="loadEditorRefunds" disabled="{{disabled || sheet.refundLoading}}">下一页候选</button>
        <text wx:if="{{sheet.refundTotal === 0 && !sheet.refundLoading}}" class="sheet-copy">本范围没有可关联记录；本批和历史都核验后才可暂记。</text>
        <text wx:if="{{sheet.refundHistoryPending}}" class="sheet-copy">当前草稿未覆盖全部历史候选，将在整批入账时复核；暂记待关联不会自动确认账本中没有原消费。</text>
        <button wx:if="{{sheet.refundCanPending}}" class="review-text-action" data-mode="pending" bindtap="selectEditorRefund" disabled="{{disabled}}">暂记待关联退款</button>
        <button class="review-text-action" data-mode="unlinked" bindtap="selectEditorRefund" disabled="{{disabled}}">清除本笔关联，保留待核对</button>
      </block>
    </view>
  </view>
  <view wx:if="{{editor.source}}" class="decision-group">
    <text class="decision-group-title">分期来源资料</text>
    <view class="decision-card">
      <text wx:if="{{editor.fieldErrors.sourceCorrection}}" class="editor-field-error">{{editor.fieldErrors.sourceCorrection}}</text>
      <view class="mapping-field"><text>本期期号</text><input wx:if="{{canEdit && editor.supported}}" type="number" value="{{draft.periodInput}}" data-field="periodInput" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" placeholder="待确认" /><text wx:else>{{draft.periodInput || '待确认'}}</text></view>
      <view class="mapping-field"><text>总期数 · 选填</text><input wx:if="{{canEdit && editor.supported}}" type="number" value="{{draft.totalTermsInput}}" data-field="totalTermsInput" bindinput="changeEditorText" bindfocus="beginInputEditing" bindblur="finishInputEditing" cursor-spacing="100" disabled="{{disabled}}" placeholder="未提供" /><text wx:else>{{draft.totalTermsInput || '未提供'}}</text></view>
      <!-- 本金形态只是入口，只读详情里点不动，直接不显示。 -->
      <view wx:if="{{editor.attribution && (canEdit || editor.attribution.role !== 'principal')}}" class="attribution-block">
        <text class="attribution-hint">{{editor.attribution.periodLabel}} {{editor.attribution.hint}}</text>
        <!-- 本金行是入口：它不选归属，而是把本期次还没指定归属的利息列出来，点一笔把这笔归到本计划。 -->
        <block wx:if="{{editor.attribution.role === 'principal'}}">
          <view wx:for="{{editor.attribution.pending}}" wx:key="eventId" class="attribution-plan"
            data-id="{{item.eventId}}" data-plan="{{editor.attribution.planLabel}}" bindtap="openEditorPendingInterest">
            <view class="attribution-plan-copy"><text class="attribution-plan-name">{{item.title}}</text><text class="attribution-plan-amount money-number">{{item.amountText}}</text></view>
            <text class="attribution-plan-flag">归入本计划</text>
          </view>
        </block>
        <!-- 费用行才是真正要选的一方：本期次有多个计划且账单没写明时，把候选摆出来让用户指定。 -->
        <block wx:else>
          <view wx:for="{{editor.attribution.plans}}" wx:key="planName" class="attribution-plan {{item.selected ? 'is-selected' : ''}}"
            data-plan="{{item.planName}}" bindtap="selectEditorInstallmentPlan">
            <view class="attribution-plan-copy"><text class="attribution-plan-name">{{item.planName}}</text><text class="attribution-plan-amount money-number">{{item.amountText}}</text></view>
            <text class="attribution-plan-flag">{{item.selected ? '已归属' : '选它'}}</text>
          </view>
          <!-- 指定错了能反悔：清除后归属退回待定，整组回到待核对；required=false 即当前已有归属结论。 -->
          <button wx:if="{{canEdit && editor.attribution.required === false}}" class="review-text-action" bindtap="clearEditorInstallmentPlan" disabled="{{disabled}}">取消指定，回到待核对</button>
          <text wx:if="{{editor.attribution.required}}" class="attribution-required">还没指定，指定后才能入账。</text>
        </block>
      </view>
      <text class="sheet-copy">来源在入账后可关联或新建分期计划；已有认领关系须先核验，不能凭期号认定已还。</text>
    </view>
  </view>
  <text wx:if="{{editor.principal}}" class="sheet-copy">本期本金仅登记分期来源，不代表实际还款，无需选择付款账户。</text>
</template>
