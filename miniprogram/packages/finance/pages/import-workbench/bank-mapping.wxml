<view wx:if="{{bankMappingSheet}}" class="sheet-layer" catchtouchmove="preventTouchMove">
  <view class="sheet-scrim" bindtap="closeBankMapping"></view>
  <view class="workflow-sheet bank-mapping-sheet">
    <view class="sheet-handle"></view>
    <view class="account-choice-header">
      <text class="account-choice-title serif-title">确认银行账单</text>
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="bank-mapping-scroll">
      <text class="bank-mapping-name">{{bankMappingSheet.name}}</text>

      <view class="bank-tokens">
        <picker range="{{bankMappingSheet.statementOptions}}" range-key="label" value="{{bankMappingSheet.statementIndex}}" data-key="statementKind" bindchange="changeBankMapping" disabled="{{busy}}">
          <view class="bank-token"><text>{{bankMappingSheet.tokens[0].value}}</text><text class="bank-caret" aria-hidden="true"></text></view>
        </picker>
        <view class="bank-token" bindtap="openBankHeader" aria-role="button"><text>{{bankMappingSheet.tokens[1].value}}</text><text class="bank-caret" aria-hidden="true"></text></view>
        <picker range="{{bankMappingSheet.amountModes}}" range-key="label" value="{{bankMappingSheet.modeIndex}}" data-key="amountMode" bindchange="changeBankMapping" disabled="{{busy}}">
          <view class="bank-token"><text>{{bankMappingSheet.tokens[2].value}}</text><text class="bank-caret" aria-hidden="true"></text></view>
        </picker>
        <picker wx:if="{{bankMappingSheet.draft.amountMode === 'signed'}}" range="{{bankMappingSheet.directionOptions}}" range-key="label" value="{{bankMappingSheet.positiveIndex}}" data-key="positiveDirection" bindchange="changeBankMapping" disabled="{{busy}}">
          <view class="bank-token {{bankMappingSheet.tokens[3].warning ? 'is-warning' : ''}}"><text>{{bankMappingSheet.tokens[3].label}} {{bankMappingSheet.tokens[3].value}}</text><text class="bank-caret" aria-hidden="true"></text></view>
        </picker>
        <picker wx:if="{{bankMappingSheet.draft.amountMode === 'direction'}}" range="{{bankMappingSheet.directionOptions}}" range-key="label" value="{{bankMappingSheet.debitIndex}}" data-key="debitDirection" bindchange="changeBankMapping" disabled="{{busy}}">
          <view class="bank-token {{bankMappingSheet.tokens[3].warning ? 'is-warning' : ''}}"><text>{{bankMappingSheet.tokens[3].value}}</text><text class="bank-caret" aria-hidden="true"></text></view>
        </picker>
      </view>
      <text class="bank-mapping-copy">点一项直接改；金额方向决定收支，务必确认。</text>

      <view class="bank-group-head bank-preview-head">
        <text class="bank-group-title">读取预览</text>
        <text class="bank-group-note">{{bankMappingSheet.previewLoading ? '正在读取…' : bankMappingSheet.previewPending ? '修改后自动识别' : '点表头换列'}}</text>
      </view>
      <view class="bank-preview">
        <view class="bank-preview-row bank-preview-header">
          <picker wx:for="{{bankMappingSheet.previewColumns}}" wx:key="key" wx:for-item="column" class="bank-preview-head-cell {{column.missing ? 'is-missing' : ''}}"
            range="{{bankMappingSheet.columnOptions}}" range-key="name" value="{{column.selected}}" data-key="{{column.key}}" bindchange="changeBankMapping" disabled="{{busy}}">
            <view class="bank-preview-cell"><text>{{column.header}}</text><text class="bank-caret" aria-hidden="true"></text></view>
          </picker>
        </view>
        <view wx:for="{{bankMappingSheet.previewRows}}" wx:key="key" wx:for-item="row" class="bank-preview-row">
          <text wx:for="{{row.cells}}" wx:key="key" wx:for-item="cell" class="bank-preview-cell {{cell.missing ? 'is-missing' : ''}}">{{cell.missing ? '未选列' : cell.value}}</text>
        </view>
        <text wx:if="{{!bankMappingSheet.previewRows.length}}" class="bank-preview-empty">没有读到样例数据，请检查表头行号。</text>
      </view>
      <text class="bank-mapping-copy">表头用的是账单原文列名；{{bankMappingSheet.readyLabel}}。</text>

      <view wx:if="{{bankHeaderEditing}}" class="bank-header-layer" catchtouchmove="preventTouchMove">
        <view class="bank-header-scrim" bindtap="closeBankHeader"></view>
        <view class="bank-header-panel">
          <text class="bank-header-title">表头行号</text>
          <view class="bank-header-controls">
            <button class="bank-header-step" data-delta="-1" bindtap="stepBankHeader" disabled="{{busy}}">-</button>
            <input class="bank-header-input" type="number" value="{{bankMappingSheet.headerRowInput}}" bindinput="inputBankHeader" disabled="{{busy}}" />
            <button class="bank-header-step" data-delta="1" bindtap="stepBankHeader" disabled="{{busy}}">+</button>
          </view>
          <text class="bank-header-copy">可以步进，也可以直接输入；改完自动重读预览。</text>
          <view class="bank-header-actions">
            <button class="secondary-button" bindtap="closeBankHeader" disabled="{{busy}}">取消</button>
            <button class="primary-button" bindtap="confirmBankHeader" disabled="{{busy}}">确定</button>
          </view>
        </view>
      </view>
    </scroll-view>
    <text wx:if="{{bankMappingSheet.error}}" class="inline-error">{{bankMappingSheet.error}}</text>
    <view class="bank-mapping-actions">
      <button class="secondary-button" bindtap="closeBankMapping" disabled="{{busy}}">稍后</button>
      <button class="primary-button" bindtap="confirmBankMapping" disabled="{{busy || !bankMappingSheet.ready}}" loading="{{busy}}">{{busy ? '正在读取' : bankMappingSheet.ready ? '确认并解析' : '补全必填列'}}</button>
    </view>
  </view>
</view>
