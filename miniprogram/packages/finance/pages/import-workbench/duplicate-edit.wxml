<view wx:if="{{duplicateEditSheet}}" class="sheet-layer" catchtouchmove="preventTouchMove">
  <view class="sheet-scrim" bindtap="closeDuplicateEdit"></view>
  <view class="workflow-sheet editor-sheet duplicate-edit-sheet">
    <view class="sheet-handle"></view>
    <view class="review-sheet-heading"><text class="sheet-title serif-title">修改同笔判断</text><button class="review-sheet-close" bindtap="closeDuplicateEdit" disabled="{{duplicateEditSheet.saving}}" aria-label="关闭修改判断"><image class="review-sheet-close-icon" src="/assets/icons/close.svg" mode="aspectFit" /></button></view>
    <text class="sheet-copy">{{duplicateEditSheet.kind === 'distinct' ? '当前是多笔独立交易，可把下面两条改为同一笔。' : duplicateEditSheet.kind === 'historical' ? '当前关联了已有账目，可以撤回后重新核对。' : '当前合并为一笔，可改为多笔分别核对。'}}</text>
    <scroll-view scroll-y class="pairing-scroll">
      <skeleton-rows wx:if="{{duplicateEditSheet.loading}}" rows="{{2}}" />
      <view wx:if="{{duplicateEditSheet.repayment}}" class="mapping-fields">
        <text class="sheet-copy">先判断是否同一笔，保存后再核对还入账户及差额。</text>
        <view class="mapping-field"><text>还入信用卡</text><text>{{duplicateEditSheet.repayment.targetAccountName}}{{duplicateEditSheet.repayment.targetConfirmed ? '' : ' · 待确认'}}</text></view>
        <view class="mapping-field"><text>还款到账</text><text>{{duplicateEditSheet.repayment.repaymentText}}</text></view>
        <view class="mapping-field"><text>平台扣款</text><text>{{duplicateEditSheet.repayment.totalText}}</text></view>
        <view class="mapping-field"><text>待核对差额</text><text>{{duplicateEditSheet.repayment.feeText}}</text></view>
      </view>
      <view wx:for="{{duplicateEditSheet.records}}" wx:key="index" class="pairing-card">
        <view class="event-record-primary"><text>{{item.sourceLabel}}</text><text class="money-number">¥{{item.amountText}}</text></view>
        <text class="event-title">{{item.title}}</text><text class="event-meta">{{item.localAt}} · {{item.evidenceCount}} 条来源</text>
      </view>
      <view wx:if="{{duplicateEditSheet.kind === 'distinct' && duplicateEditSheet.count > 1}}" class="list-pagination"><button class="stage-previous" data-direction="-1" bindtap="changeDuplicatePair" disabled="{{duplicateEditSheet.saving || duplicateEditSheet.pending || duplicateEditSheet.pairIndex === 0}}">上一对</button><text>{{duplicateEditSheet.pairIndex + 1}} / {{duplicateEditSheet.count}}</text><button class="stage-previous" data-direction="1" bindtap="changeDuplicatePair" disabled="{{duplicateEditSheet.saving || duplicateEditSheet.pending || duplicateEditSheet.pairIndex + 1 >= duplicateEditSheet.count}}">下一对</button></view>
      <text wx:if="{{duplicateEditSheet.reason}}" class="sheet-copy">{{duplicateEditSheet.reason}}</text>
      <view wx:if="{{duplicateEditSheet.error}}" class="relation-empty"><text>{{duplicateEditSheet.error}}</text><button wx:if="{{!duplicateEditSheet.pending}}" class="review-text-action" bindtap="refreshDuplicateEdit" disabled="{{duplicateEditSheet.saving}}">{{duplicateEditSheet.saved ? '刷新列表' : '重新读取'}}</button></view>
    </scroll-view>
    <view class="pairing-footer">
      <button wx:if="{{duplicateEditSheet.pending}}" class="sheet-confirm sheet-confirm-wide" bindtap="saveDuplicateEdit" loading="{{duplicateEditSheet.saving}}" disabled="{{duplicateEditSheet.saving}}">确认上次修改结果</button>
      <view wx:elif="{{!duplicateEditSheet.saved && !duplicateEditSheet.loading && duplicateEditSheet.canSave}}" class="pairing-direct-actions">
        <block wx:if="{{duplicateEditSheet.kind === 'distinct'}}"><button class="sheet-secondary" bindtap="closeDuplicateEdit" disabled="{{duplicateEditSheet.saving}}">仍是多笔</button><button class="sheet-confirm" bindtap="saveDuplicateEdit" loading="{{duplicateEditSheet.saving}}" disabled="{{duplicateEditSheet.saving || duplicateEditSheet.stale}}">{{duplicateEditSheet.repayment ? '改为同次还款' : '改为同一笔'}}</button></block>
        <block wx:else><button class="sheet-secondary" bindtap="saveDuplicateEdit" loading="{{duplicateEditSheet.saving}}" disabled="{{duplicateEditSheet.saving || duplicateEditSheet.stale}}">{{duplicateEditSheet.kind === 'historical' ? '重新核对' : '不是同一笔'}}</button><button class="sheet-confirm" bindtap="closeDuplicateEdit" disabled="{{duplicateEditSheet.saving}}">保持原判断</button></block>
      </view>
      <button wx:elif="{{duplicateEditSheet.saved}}" class="sheet-confirm sheet-confirm-wide" bindtap="refreshDuplicateEdit" disabled="{{duplicateEditSheet.saving}}">刷新列表</button>
    </view>
  </view>
</view>
