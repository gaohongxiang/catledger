/* 待核对与只读详情共用字段、纵向资金区域和安全区。 */
.workflow-sheet.unified-editor-sheet {
  display: flex;
  flex-direction: column;
  height: 86vh;
  max-height: 86vh;
  overflow: hidden;
}
.unified-editor-sheet.review-editor-sheet .review-editor-body {
  flex: 1;
  height: 0;
  min-height: 0;
  max-height: none;
  padding-bottom: var(--layout-space-2);
}
.unified-editor-sheet .evidence-drilldown { display: flex; flex: 1; min-height: 0; flex-direction: column; }
.unified-editor-sheet .evidence-scroll { flex: 1; height: 0; min-height: 0; }
.unified-editor-sheet .sheet-actions,
.unified-editor-sheet .pairing-footer { flex-shrink: 0; }
.unified-editor-sheet .editor-summary-card { margin-bottom: var(--layout-space-5); padding: 28rpx 28rpx 20rpx; border: 1rpx solid var(--ui-line); border-radius: var(--theme-radius-medium, 18rpx); }
.unified-editor-sheet .issue-summary-nature { display: inline-flex; align-items: center; gap: var(--layout-space-1); padding: 6rpx 16rpx; border-radius: var(--theme-radius-small, 12rpx); }
.unified-editor-sheet .editor-nature-chevron { font-size: 26rpx; font-weight: 400; line-height: 1; }
.unified-editor-sheet .editor-amount { display: flex; align-items: baseline; justify-content: flex-end; min-width: 0; max-width: 75%; margin-left: auto; color: var(--ui-ink); font-size: var(--font-title, 40rpx); font-weight: 500; line-height: 1.4; }
.unified-editor-sheet .editor-amount-input { position: relative; min-width: 0; }
.unified-editor-sheet .editor-amount-measure { visibility: hidden; display: block; min-width: 100rpx; white-space: nowrap; }
.unified-editor-sheet .editor-amount input { position: absolute; top: 0; left: 0; width: 100%; height: 100%; min-width: 0; text-align: right; font-size: inherit; font-weight: inherit; line-height: inherit; }
.unified-editor-sheet .editor-summary-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6rpx 18rpx; margin-top: var(--layout-space-2); overflow-wrap: anywhere; }
.unified-editor-sheet .editor-summary-edit { width: 100%; min-height: 0; margin-right: 0; margin-left: 0; padding: 0; border: 0; border-radius: 0; background: transparent; text-align: left; line-height: inherit; }
.unified-editor-sheet .repayment-ownership { margin: 12rpx 0 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
.unified-editor-sheet .bank-suggestion { margin: 24rpx 0; }
.unified-editor-sheet .bank-suggestion-summary { flex-wrap: nowrap; gap: var(--layout-space-1); }
.unified-editor-sheet .bank-suggestion-copy { color: var(--theme-warning, #a76416); font-size: 22rpx; }
.unified-editor-sheet.review-editor-sheet .funds-suggestion { min-width: 0; padding: 4rpx 18rpx; font-size: 22rpx; }
.unified-editor-sheet .mapping-field input,
.unified-editor-sheet .mapping-field textarea {
  box-sizing: border-box;
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 72rpx;
  padding: 14rpx 0;
  font-size: var(--font-body, 28rpx);
  line-height: 1.5;
  color: var(--ui-ink);
}
.unified-editor-sheet .mapping-field textarea { max-height: 240rpx; }
.unified-editor-sheet .mapping-value { min-width: 0; overflow-wrap: anywhere; }
.unified-editor-sheet .editor-details .review-text-action { text-align: left; }
.unified-editor-sheet .editor-cancel { min-height: 64rpx; margin-top: 4rpx; padding: 12rpx 0; background: transparent; line-height: 1.5; }
.unified-editor-sheet .editor-actions-row { display: flex; align-items: stretch; gap: var(--layout-space-3); }
.unified-editor-sheet .editor-actions-row .sheet-confirm { flex: 1; min-width: 0; margin: 0; }
/* 详情与待核对共用底栏：主次操作同一行、同高，返回列表在下方作为次要动作，
   不再是一列全宽大按钮。 */
.unified-editor-sheet .detail-actions { display: flex; flex-direction: column; gap: var(--layout-space-2); }
.unified-editor-sheet .detail-actions .editor-actions-row { width: 100%; }
.unified-editor-sheet .detail-actions .editor-judgment-btn,
.unified-editor-sheet .detail-actions .sheet-confirm { min-height: 88rpx; margin: 0; line-height: 1.5; }
.unified-editor-sheet .detail-actions .sheet-confirm-wide { margin: 0; }
.unified-editor-sheet .detail-actions .editor-cancel { margin-top: 0; }
.unified-editor-sheet .editor-judgment-btn {
  flex: 0 0 auto;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 28rpx;
  border: 0;
  border-radius: var(--theme-radius-medium, 18rpx);
  background: var(--ui-accent-soft);
  color: var(--ui-accent-strong);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.5;
}
.unified-editor-sheet .channel-breakdown {
  margin: 4rpx 0 20rpx;
  padding: 20rpx 24rpx 16rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: var(--theme-radius-medium, 18rpx);
  background: var(--ui-surface);
}
.unified-editor-sheet .channel-breakdown-amounts { display: flex; align-items: flex-end; }
.unified-editor-sheet .channel-breakdown-item { flex: 1; min-width: 0; }
.unified-editor-sheet .channel-breakdown-label { display: block; color: var(--ui-muted); font-size: 22rpx; line-height: 1.4; white-space: nowrap; }
.unified-editor-sheet .channel-breakdown-value { display: block; margin-top: 4rpx; overflow-wrap: anywhere; color: var(--ui-ink); font-size: 26rpx; font-weight: 500; line-height: 1.3; }
.unified-editor-sheet .channel-breakdown-total { color: var(--ui-accent-strong); }
/* 差额待核对只用警示色区分，不加底色：金额格保持三列对齐，卡片骨架不动。 */
.unified-editor-sheet .channel-breakdown-fee-pending { color: var(--theme-warning, #a76416); }
.unified-editor-sheet .channel-breakdown-op { flex: 0 0 auto; padding: 0 6rpx; color: var(--ui-subtle); font-size: 22rpx; line-height: 1.3; }
/* 待确认只强调下面那张勾选卡：外层卡片不做换色，勾选卡描边、放大勾选点和动作行。 */
.unified-editor-sheet .channel-confirm-caption { display: block; padding-top: 14rpx; color: var(--theme-warning, #a76416); font-size: 22rpx; font-weight: 500; line-height: 1.5; }
.unified-editor-sheet .channel-confirm .ownership-option { border-color: var(--theme-warning, #a76416); border-width: 2rpx; background: var(--theme-warning-soft, #fdf6e6); }
.unified-editor-sheet .channel-confirm .ownership-option-selected { border-color: var(--ui-accent); background: var(--ui-accent-soft); }
.unified-editor-sheet .channel-confirm .ownership-treatment-check { width: 36rpx; height: 36rpx; border-color: var(--theme-warning, #a76416); background: var(--ui-surface, #fff); }
.unified-editor-sheet .channel-confirm .ownership-option-selected .ownership-treatment-check { border-color: var(--ui-accent); background: var(--ui-accent); }
.unified-editor-sheet .channel-confirm .ownership-option-selected .ownership-treatment-check::after { left: 10rpx; top: 5rpx; }
.unified-editor-sheet .channel-confirm-action { color: var(--theme-warning, #a76416); }
.unified-editor-sheet .channel-breakdown-note { display: block; margin-top: 14rpx; padding-top: var(--layout-space-2); border-top: 1rpx solid var(--ui-line); color: var(--ui-muted); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .channel-confirm { margin-top: 14rpx; padding-bottom: 0; border-top: 1rpx solid var(--ui-line); }
.unified-editor-sheet .channel-confirm .ownership-option { margin-top: 0; }
.editor-mode-choices { display: flex; flex-wrap: wrap; gap: var(--layout-space-2); margin: 20rpx 0; }

/* 退款原消费候选：商家→商品→时间渠道→原消费/已退/可退→匹配依据，
   每行只说一件事，用户不必再翻原文判断这是哪一次消费。 */
.unified-editor-sheet .refund-candidates { margin-top: var(--layout-space-2); }
.unified-editor-sheet .refund-candidates-title { display: block; margin-bottom: var(--layout-space-1); color: var(--ui-muted); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .refund-candidate {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  margin: 0 0 var(--layout-space-2);
  padding: 18rpx 84rpx 18rpx 20rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: var(--theme-radius-medium, 18rpx);
  background: var(--ui-surface);
  color: var(--ui-ink);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.5;
  text-align: left;
  white-space: normal;
}
.unified-editor-sheet .refund-candidate.is-selected { border-color: var(--ui-accent); background: var(--ui-accent-soft); }
.unified-editor-sheet .refund-candidate-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--layout-space-2); }
.unified-editor-sheet .refund-candidate-title { flex: 1; min-width: 0; overflow: hidden; color: var(--ui-ink); font-size: var(--font-body, 28rpx); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.unified-editor-sheet .refund-candidate-amount { flex: 0 0 auto; color: var(--sem-expense, #b54738); font-size: var(--font-body, 28rpx); font-weight: 500; }
.unified-editor-sheet .refund-candidate-item { display: block; margin-top: 2rpx; overflow: hidden; color: var(--ui-muted); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.unified-editor-sheet .refund-candidate-meta { display: block; margin-top: 4rpx; color: var(--ui-muted); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .refund-candidate-match { display: block; margin-top: 6rpx; color: var(--ui-accent-strong); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .refund-candidate-radio { position: absolute; top: 22rpx; right: 22rpx; width: 32rpx; height: 32rpx; border: 2rpx solid var(--ui-border); border-radius: 50%; background: var(--ui-surface); }
.unified-editor-sheet .refund-candidate.is-selected .refund-candidate-radio { border-color: var(--ui-accent); background: var(--ui-accent); }
.unified-editor-sheet .refund-candidate.is-selected .refund-candidate-radio::after { content: ''; position: absolute; left: 9rpx; top: 4rpx; width: 8rpx; height: 14rpx; border: solid var(--ui-on-accent); border-width: 0 3rpx 3rpx 0; transform: rotate(45deg); }

/* 已关联（含自动确认）的原消费：先说清“现在是哪一笔、当初凭什么”，
   再给更换入口；不因为自动确认就把这块留白。 */
.unified-editor-sheet .refund-linked {
  display: block;
  margin-top: var(--layout-space-2);
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--ui-line);
  border-left: 6rpx solid var(--ui-accent);
  border-radius: var(--theme-radius-medium, 18rpx);
  background: var(--ui-surface-muted);
}
.unified-editor-sheet .refund-linked-head { display: block; color: var(--ui-accent-strong); font-size: 22rpx; font-weight: 500; line-height: 1.5; }
.unified-editor-sheet .refund-linked-title { display: block; margin-top: 4rpx; color: var(--ui-ink); font-size: var(--font-body, 28rpx); font-weight: 500; line-height: 1.5; }
.unified-editor-sheet .refund-linked-meta { display: block; margin-top: 2rpx; color: var(--ui-muted); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .refund-linked-match { display: block; margin-top: 4rpx; color: var(--ui-accent-strong); font-size: 22rpx; line-height: 1.5; }
.unified-editor-sheet .refund-linked-hint { display: block; margin-top: 8rpx; color: var(--ui-muted); font-size: 22rpx; line-height: 1.5; }
.editor-mode-choices button {
  flex: 1 1 180rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  margin: 0;
  padding: 18rpx 12rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: var(--theme-radius-small, 12rpx);
  background: var(--ui-surface);
  color: var(--ui-muted);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.5;
}
.editor-mode-choices button.editor-mode-selected { background: var(--ui-accent-soft); border-color: var(--ui-accent); color: var(--ui-accent-strong); }
.editor-part { display: flex; flex-wrap: wrap; align-items: center; gap: var(--layout-space-2); padding: 16rpx 0; border-bottom: 1rpx solid var(--ui-line); }
.editor-part > button:first-child { flex: 1 1 200rpx; margin: 0; padding: 16rpx 20rpx; border: 1rpx solid var(--ui-line); border-radius: var(--theme-radius-small, 12rpx); background: transparent; color: var(--ui-ink); font-size: var(--font-body, 28rpx); line-height: 1.5; white-space: normal; text-align: left; }
.editor-part > input { box-sizing: border-box; flex: 0 1 180rpx; width: 180rpx; min-height: 80rpx; padding: var(--layout-space-2); border-bottom: 1rpx solid var(--ui-border); font-size: var(--font-body, 28rpx); }
.unified-editor-sheet .editor-part .review-text-action { width: auto; padding: var(--layout-space-2); }
.unified-editor-sheet .sheet-save-hint { white-space: normal; overflow-wrap: anywhere; }

.unified-editor-sheet .editor-field-error { display: block; margin: 8rpx 0 16rpx; color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); line-height: 1.6; white-space: normal; }

/* 决策分组：所有交易性质共用一套容器语言。
   --sem-income/--sem-expense 是固定财务语义色（app.wxss），不随主题变化。 */
.unified-editor-sheet .decision-group { margin-bottom: var(--layout-space-4); }
.unified-editor-sheet .decision-group:last-child { margin-bottom: 0; }
.unified-editor-sheet .decision-group-title { display: block; margin-bottom: var(--layout-space-2); color: var(--ui-muted); font-size: var(--font-caption, 24rpx); font-weight: 500; line-height: 1.5; }
.unified-editor-sheet .decision-card { box-sizing: border-box; padding: 20rpx 24rpx; border: 1rpx solid var(--ui-line); border-radius: var(--theme-radius-medium, 18rpx); background: var(--ui-surface); }
.unified-editor-sheet .decision-card .repayment-mode-row { min-height: 80rpx; padding: 12rpx 0; border-top: 0; }
.unified-editor-sheet .decision-card .repayment-mode-row + .repayment-mode-row { border-top: 1rpx solid var(--ui-line); }
.unified-editor-sheet .decision-card .review-text-action { margin-top: var(--layout-space-2); }
/* 模式切换放在卡片顶部充当分组头，下方账户行用分隔线接续。 */
.unified-editor-sheet .decision-card .editor-mode-choices { margin: 0 0 var(--layout-space-1); }
.unified-editor-sheet .decision-card .editor-mode-choices + .repayment-mode-row { border-top: 1rpx solid var(--ui-line); }
.unified-editor-sheet .decision-group > .editor-mode-choices { margin-top: 0; margin-bottom: var(--layout-space-2); }

/* 值与箭头之间的间距挂在箭头自身的 margin-left 上，不依赖父容器的 gap：
   这些容器都是被压缩的 flex item，gap 在窄屏上会被内容挤到肉眼分辨不出。
   箭头 flex: 0 0 auto，长账户名换行也不会把箭头压扁或贴住。 */
.unified-editor-sheet .repayment-mode-value,
.unified-editor-sheet .editor-summary-card .issue-summary-nature { gap: 0; }
.unified-editor-sheet .repayment-mode-value { min-width: 0; }
.unified-editor-sheet .repayment-mode-value > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.unified-editor-sheet .repayment-mode-chevron,
.unified-editor-sheet .editor-nature-chevron { flex: 0 0 auto; margin-left: var(--layout-space-4); }
/* 文案内联箭头（非 flex 容器）统一走同一间距，避免各处空格宽度不一。 */
.unified-editor-sheet .app-chevron { flex: 0 0 auto; margin-left: var(--layout-space-4); font-weight: 400; }

/* 紧凑化：各决策分组共用同一套行高与内边距。 */
.unified-editor-sheet .decision-group { margin-bottom: var(--layout-space-3); }
.unified-editor-sheet .decision-group-title { margin-bottom: var(--layout-space-1); }
.unified-editor-sheet .decision-card { padding: 16rpx 20rpx; }
.unified-editor-sheet .decision-card .repayment-mode-row { min-height: 72rpx; padding: 10rpx 0; }
.unified-editor-sheet .editor-mode-choices button { min-height: 68rpx; padding: 12rpx 8rpx; }
.unified-editor-sheet .decision-card .editor-part { padding: 8rpx 0; }
.unified-editor-sheet .decision-card .editor-part > button:first-child { min-height: 68rpx; padding: 10rpx 16rpx; }
.unified-editor-sheet .decision-card .editor-part > input { min-height: 68rpx; }
.unified-editor-sheet .decision-group .channel-breakdown { margin-bottom: 0; }
.unified-editor-sheet .editor-amount.row-expense,
.unified-editor-sheet .editor-amount.row-expense .money-number,
.unified-editor-sheet .editor-amount.row-expense input { color: var(--sem-expense, #b54738); }
.unified-editor-sheet .editor-amount.row-income,
.unified-editor-sheet .editor-amount.row-income .money-number,
.unified-editor-sheet .editor-amount.row-income input { color: var(--sem-income, #477153); }

/* 分期费用归属：同一期次有多个计划时，用户在这里指定这笔费用属于哪一个。 */
.unified-editor-sheet .attribution-block { margin-top: var(--layout-space-3); }
.unified-editor-sheet .attribution-hint { display: block; font-size: 24rpx; line-height: 1.5; color: var(--ui-muted); }
.unified-editor-sheet .attribution-plan { display: flex; align-items: center; justify-content: space-between;
  margin-top: var(--layout-space-2); padding: var(--layout-space-2) var(--layout-space-3);
  border: 2rpx solid var(--ui-border); border-radius: var(--theme-radius-small); background: var(--ui-surface); }
.unified-editor-sheet .attribution-plan.is-selected { border-color: var(--ui-accent); background: var(--ui-accent-soft); }
.unified-editor-sheet .attribution-plan-copy { display: flex; flex-direction: column; min-width: 0; }
.unified-editor-sheet .attribution-plan-name { font-size: 28rpx; color: var(--ui-ink); }
.unified-editor-sheet .attribution-plan-amount { margin-top: 4rpx; font-size: 24rpx; color: var(--ui-muted); }
.unified-editor-sheet .attribution-plan-flag { flex-shrink: 0; margin-left: var(--layout-space-3); font-size: 24rpx; color: var(--ui-accent-strong); }
.unified-editor-sheet .attribution-required { display: block; margin-top: var(--layout-space-2); font-size: 24rpx; color: var(--sem-expense, #b54738); }

/* 资金路径：端点组 + 账户清单。
   圆点只标记“这一端是钱的起点或终点”，组内账户是缩进清单行——账户不各自带点，
   层级靠缩进、字号和颜色区分；加账户只增加清单行，端点与卡片骨架不动。 */
.unified-editor-sheet .funds-card {
  padding: 4rpx 20rpx 8rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: var(--theme-radius-medium, 18rpx);
  background: var(--ui-surface);
}
/* 标题行与账户行共用同一条右基准线：右侧留 8rpx，符号不会压到行的底色边缘。 */
.unified-editor-sheet .funds-endpoint { display: flex; align-items: center; gap: var(--layout-space-2); min-height: 72rpx; padding-right: 8rpx; }
/* 多账户的补充说明贴在卡片尾部，只在多账户时出现。放在卡片外会让资金卡片整体上下移动。 */
.unified-editor-sheet .funds-note { margin: 0 0 4rpx 34rpx; }
.unified-editor-sheet .funds-dot { flex: 0 0 auto; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--ui-border); }
.unified-editor-sheet .funds-dot.is-required { background: var(--ui-accent-strong); }
.unified-editor-sheet .funds-endpoint-label { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ui-muted); font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.unified-editor-sheet .funds-endpoint-required { color: var(--ui-accent-strong); }
.unified-editor-sheet .funds-add {
  flex: 0 0 auto; width: 132rpx; min-height: 0; margin: 0 0 0 auto; padding: 12rpx 0;
  border: 0; border-radius: 0; background: transparent;
  color: var(--ui-accent-strong); font-size: 22rpx; line-height: 1.5; text-align: right;
}
.unified-editor-sheet .funds-add::after { border: 0; }
.unified-editor-sheet .funds-add[disabled] { background: transparent; color: var(--ui-subtle); opacity: .55; }
/* 两个端点之间的短连线：只连接端点，不穿过组内的账户行。 */
.unified-editor-sheet .funds-link { height: 16rpx; margin-left: 6rpx; border-left: 1rpx solid var(--ui-line); }
.unified-editor-sheet .funds-account-row { display: flex; align-items: center; gap: var(--layout-space-2); box-sizing: border-box; min-height: 76rpx; padding: 0 8rpx 0 34rpx; border-radius: var(--theme-radius-small, 12rpx); }
/* 未选账户的强调只换底色、不加边框：边框会改变行高，选中瞬间整块会跳。 */
.unified-editor-sheet .funds-account-row.is-required { background: var(--ui-accent-soft); }
.unified-editor-sheet .funds-account {
  display: flex; flex: 1; align-items: center; gap: 0;
  box-sizing: border-box; min-width: 0; min-height: 0; margin: 0; padding: 10rpx 0;
  border: 0; border-radius: 0; background: transparent; text-align: left; line-height: 1.4;
}
.unified-editor-sheet .funds-account::after { border: 0; }
.unified-editor-sheet .funds-account-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ui-ink); font-size: var(--font-body, 28rpx); font-weight: 500; }
.unified-editor-sheet .funds-account-name.is-empty { color: var(--ui-accent-strong); font-weight: 400; }
/* 行尾固定一列：多账户是删除，单账户是箭头。两态占同一格，横向位置不因状态变化。
   符号右对齐，与标题行「＋ 添加」共用同一条右基准线；格子本身仍留 44rpx 作触摸区。 */
.unified-editor-sheet .funds-account-chevron { flex: 0 0 auto; width: 44rpx; color: var(--ui-subtle); font-size: 30rpx; font-weight: 400; line-height: 1; text-align: right; }
/* 金额列：和核对说明同一套描边输入框，不用短横线。 */
.unified-editor-sheet .funds-account-amount {
  box-sizing: border-box; flex: 0 0 auto; width: 144rpx; height: 56rpx; padding: 0 12rpx;
  border: 1rpx solid var(--ui-line); border-radius: 10rpx; background: var(--ui-surface);
  color: var(--ui-ink); font-size: var(--font-caption, 24rpx); line-height: 54rpx; text-align: right;
}
.unified-editor-sheet .funds-amount-placeholder { color: var(--ui-subtle); text-align: right; }
.unified-editor-sheet .funds-account-remove {
  flex: 0 0 auto; width: 44rpx; min-height: 0; margin: 0; padding: 0;
  border: 0; border-radius: 0; background: transparent; color: var(--ui-subtle);
  font-size: 30rpx; line-height: 1.5; text-align: right;
}
.unified-editor-sheet .funds-account-remove::after { border: 0; }
