.bank-mapping-sheet { overflow: hidden; }
.bank-mapping-scroll { max-height: 62vh; margin-bottom: var(--layout-space-5); }
.bank-mapping-name { display: block; margin: 4rpx 0 8rpx; color: var(--ui-muted); font-size: 24rpx; word-break: break-all; }
.bank-mapping-copy { display: block; color: var(--ui-muted); font-size: 24rpx; line-height: 1.6; margin: 12rpx 0 18rpx; }
.bank-mapping-row { display: flex; align-items: center; justify-content: space-between; gap: var(--layout-space-3); min-height: 80rpx; color: var(--ui-ink); font-size: 26rpx; }
.bank-mapping-row > text:first-child { flex-shrink: 0; }
.bank-mapping-row > text:last-child { flex: 1; min-width: 0; max-width: 62%; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.bank-mapping-scroll picker > .bank-mapping-row { border-bottom: 1rpx solid var(--ui-line); }
.bank-mapping-field { border-bottom: 1rpx solid var(--ui-line); padding-bottom: 10rpx; }
.bank-mapping-example { display: block; font-size: 23rpx; line-height: 1.5; color: var(--ui-muted); word-break: break-all; }
.bank-mapping-header-row { border-bottom: 1rpx solid var(--ui-line); }
.bank-header-value { display: flex; align-items: center; gap: var(--layout-space-2); }
.bank-header-value input { width: 88rpx; padding: 10rpx; text-align: center; border: 1rpx solid var(--ui-line); border-radius: 10rpx; color: var(--ui-ink); font-size: inherit; }
.bank-header-status { display: block; margin: 8rpx 0; color: var(--ui-muted); font-size: 22rpx; text-align: right; }
.bank-mapping-sheet .bank-columns-toggle { display: flex; align-items: center; justify-content: center; width: 100%; max-width: none; min-height: 80rpx; height: auto; padding: 12rpx 0; line-height: 1.5; white-space: nowrap; }
.bank-mapping-actions { display: flex; gap: var(--layout-space-4); }
.bank-mapping-actions button { flex: 1; width: 0; min-width: 0; max-width: none; margin: 0; padding: 0 20rpx; border-radius: 999rpx; white-space: nowrap; }
.bank-mapping-actions .primary-button { flex: 2; }

/* 分组：把“文件识别 / 表格结构 / 必填列 / 更多列”分开，避免一排排长得一样的行。 */
.bank-group { margin-top: var(--layout-space-4); }
.bank-group:first-of-type { margin-top: 0; }
.bank-group-title { display: block; color: var(--ui-muted); font-size: var(--font-caption, 24rpx); letter-spacing: 1rpx; }
.bank-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--layout-space-3); }
.bank-group-note { color: var(--ui-muted); font-size: 22rpx; }
.bank-group-note.is-warning { color: var(--theme-warning, #a76416); }
.bank-group-hint { display: block; margin-top: 8rpx; color: var(--theme-warning, #a76416); font-size: 22rpx; line-height: 1.6; }

/* 必填行：左侧强调条 + 状态标签，未选时整行描边。 */
.bank-field-required { position: relative; padding-left: 18rpx; }
.bank-field-required::before { content: ''; position: absolute; left: 0; top: 18rpx; bottom: 18rpx; width: 4rpx; border-radius: 2rpx; background: var(--ui-accent); opacity: 0.35; }
.bank-field-required.is-missing::before { background: var(--theme-warning, #a76416); opacity: 1; }
.bank-field-label { display: flex; align-items: center; gap: 8rpx; color: var(--ui-ink); font-size: 26rpx; }
.bank-required-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--ui-accent); }
.bank-field-value { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; flex: 1; min-width: 0; }
.bank-status { flex: 0 0 auto; padding: 2rpx 10rpx; border-radius: 999rpx; font-size: 20rpx; line-height: 1.6; }
.bank-status-auto { background: var(--ui-surface-muted); color: var(--ui-muted); }
.bank-status-manual { background: var(--ui-accent-soft); color: var(--ui-accent-strong); }
.bank-status-missing { background: var(--theme-warning-soft, #fbf3e4); color: var(--theme-warning, #a76416); }
.bank-field-required.is-missing { border-radius: var(--theme-radius-small, 12rpx); outline: 1rpx solid var(--theme-warning, #a76416); outline-offset: -1rpx; }

/* 摘要条：一句话回答“识别成什么”。 */
.bank-summary { display: flex; align-items: center; gap: 10rpx; margin-top: var(--layout-space-3); padding: 16rpx 20rpx; border-radius: var(--theme-radius-large, 999rpx); background: var(--ui-accent-soft); }
.bank-summary.is-warning { background: var(--theme-warning-soft, #fbf3e4); }
.bank-summary-dot { flex: 0 0 auto; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--ui-accent); }
.bank-summary.is-warning .bank-summary-dot { background: var(--theme-warning, #a76416); }
.bank-summary-text { flex: 1; min-width: 0; color: var(--ui-accent-strong); font-size: 24rpx; line-height: 1.5; }
.bank-summary.is-warning .bank-summary-text { color: var(--theme-warning, #a76416); }
.bank-summary-tag { flex: 0 0 auto; color: var(--ui-accent-strong); font-size: 22rpx; opacity: 0.8; }

/* 预览表：读出来的东西直接摆出来，比列号更好判断。 */
.bank-preview-head { margin-top: var(--layout-space-4); }
.bank-preview { margin-top: 12rpx; overflow: hidden; border: 1rpx solid var(--ui-line); border-radius: var(--theme-radius-small, 12rpx); }
.bank-preview-row { display: flex; gap: 12rpx; padding: 14rpx 16rpx; border-top: 1rpx solid var(--ui-line); }
.bank-preview-row:first-child { border-top: 0; }
.bank-preview-header { background: var(--ui-surface-muted); }
.bank-preview-header .bank-preview-cell { color: var(--ui-muted); font-size: 22rpx; }
.bank-preview-cell { flex: 1 1 0; min-width: 0; overflow: hidden; color: var(--ui-ink); font-size: 24rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.bank-preview-cell:first-child { flex: 1.4 1 0; }
.bank-preview-cell.is-missing { color: var(--theme-warning, #a76416); }
.bank-preview-empty { display: block; padding: 18rpx 16rpx; color: var(--theme-warning, #a76416); font-size: 22rpx; }

/* 列对应：一行一项，缺项标黄。 */
.bank-map-head { margin-top: var(--layout-space-4); }
.bank-map-adjust { min-height: 0; margin: 0; padding: 0; background: transparent; color: var(--ui-accent-strong); font-size: 24rpx; }
.bank-map-adjust::after { border: 0; }
.bank-map-lines { margin-top: 12rpx; padding: 16rpx 18rpx; border: 1rpx solid var(--ui-line); border-radius: var(--theme-radius-small, 12rpx); background: var(--ui-surface); }
.bank-map-line { display: block; color: var(--ui-ink); font-size: 24rpx; line-height: 1.7; }
.bank-map-line.is-missing { color: var(--theme-warning, #a76416); }
