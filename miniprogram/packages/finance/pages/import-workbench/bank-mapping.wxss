.bank-mapping-sheet { overflow: hidden; }
.bank-mapping-scroll { max-height: 62vh; margin-bottom: 24rpx; }
.bank-mapping-name { display: block; margin: 4rpx 0 8rpx; color: var(--ui-muted); font-size: 24rpx; word-break: break-all; }
.bank-mapping-copy { display: block; color: var(--ui-muted); font-size: 24rpx; line-height: 1.6; margin: 12rpx 0 18rpx; }
.bank-mapping-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 80rpx; color: var(--ui-ink); font-size: 26rpx; }
.bank-mapping-row > text:first-child { flex-shrink: 0; }
.bank-mapping-row > text:last-child { flex: 1; min-width: 0; max-width: 62%; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.bank-mapping-scroll picker > .bank-mapping-row { border-bottom: 1rpx solid var(--ui-line); }
.bank-mapping-field { border-bottom: 1rpx solid var(--ui-line); padding-bottom: 10rpx; }
.bank-mapping-example { display: block; font-size: 23rpx; line-height: 1.5; color: var(--ui-muted); word-break: break-all; }
.bank-mapping-header-row { border-bottom: 1rpx solid var(--ui-line); }
.bank-header-value { display: flex; align-items: center; gap: 12rpx; }
.bank-header-value input { width: 88rpx; padding: 10rpx; text-align: center; border: 1rpx solid var(--ui-line); border-radius: 10rpx; color: var(--ui-ink); font-size: inherit; }
.bank-header-status { display: block; margin: 8rpx 0; color: var(--ui-muted); font-size: 22rpx; text-align: right; }
.bank-mapping-sheet .bank-columns-toggle { display: flex; align-items: center; justify-content: center; width: 100%; max-width: none; min-height: 80rpx; height: auto; padding: 12rpx 0; line-height: 1.5; white-space: nowrap; }
.bank-mapping-actions { display: flex; gap: 20rpx; }
.bank-mapping-actions button { flex: 1; width: 0; min-width: 0; max-width: none; margin: 0; padding: 0 20rpx; border-radius: 999rpx; white-space: nowrap; }
.bank-mapping-actions .primary-button { flex: 2; }
