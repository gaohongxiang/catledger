.due-month { padding-bottom: 40rpx; }
.due-summary {
  display: flex; flex-direction: column; gap: 6rpx;
  margin: 8rpx 0 20rpx; padding: 28rpx 30rpx;
  background: var(--theme-surface, #fffdf9); border-radius: var(--theme-radius-xl, 32rpx);
  box-shadow: var(--theme-shadow-soft);
}
.due-summary-label { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.due-summary-value { color: var(--theme-ink, #29231e); font-size: 52rpx; font-weight: 600; line-height: 1.2; }
.due-summary-count { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.due-list { background: var(--theme-surface, #fffdf9); border-radius: var(--theme-radius-xl, 32rpx); box-shadow: var(--theme-shadow-soft); overflow: hidden; }
.due-row { display: flex; align-items: center; gap: var(--layout-space-3, 16rpx); padding: 26rpx 30rpx; border-bottom: 1rpx solid var(--theme-line, #eae4dc); }
.due-row:last-child { border-bottom: 0; }
.due-row-active { background: var(--theme-surface-muted, #efe9e1); }
.due-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.due-row-name { color: var(--theme-ink, #29231e); font-size: 30rpx; font-weight: 500; overflow-wrap: anywhere; }
.due-row-meta { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); overflow-wrap: anywhere; }
.due-row-amount { display: flex; flex: none; align-items: center; gap: 4rpx; }
.due-row-amount-val { color: var(--sem-expense, #b54738); font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.due-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; margin: 80rpx 30rpx; text-align: center; }
.due-empty-title { color: var(--theme-ink, #29231e); font-size: 34rpx; font-weight: 600; }
.due-empty-note { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.due-loading { padding: 60rpx 0; text-align: center; color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.due-retry { margin: 24rpx auto 0; }
