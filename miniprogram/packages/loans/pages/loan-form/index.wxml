<!-- 页面外壳使用统一主题快照；原生配色由主题生命周期提前同步，page-meta 维护根节点与声明式属性。 -->
<page-meta
  background-text-style="{{themeBackgroundTextStyle}}"
  background-color="{{themePageColor}}"
  background-color-top="{{themePageColor}}"
  background-color-bottom="{{themeCanvasBottom}}"
  root-background-color="{{themePageColor}}"
  page-style="{{themePageStyle}}"
>
  <navigation-bar front-color="{{themeNavFront}}" background-color="{{themeNavBackground}}" />
</page-meta>
<view class="page-canvas loan-form {{themeClass}}" style="{{themeStyle}}">
  <page-head class="content-inset" title="{{loan ? '编辑贷款' : '新增贷款'}}" copy="按合同利率或实际还款账单建立分期计划。" />
  <ui-state wx:if="{{sourceNote}}" description="{{sourceNote}}" />
  <ui-state wx:if="{{loading}}" description="正在读取账户与资料…" />
  <ui-state wx:if="{{errorMessage}}" error description="{{errorMessage}}" /><ui-state wx:if="{{savedMessage}}" description="{{savedMessage}}" />
  <button wx:if="{{errorMessage && !hasPending}}" class="ld-link ld-retry-top" bindtap="load" disabled="{{loading || saving}}">重新读取账户与资料</button>
  <view wx:if="{{!loading}}" class="ld-form-card">
    <view class="ld-card-head"><text class="ld-card-title">基本信息</text><text class="ld-card-note">填写并核对</text></view>
    <picker wx:if="{{!loan && !sourceLocked}}" class="ld-cell" range="{{baselineModes}}" value="{{baselineMode}}" bindchange="selectBaselineMode"><text>接入方式</text><text>{{baselineModes[baselineMode]}}</text></picker>
    <text wx:if="{{baselineMode === 1}}" class="ld-note">本次保存零本金起点。确认费用起源为现金借款后，实际到账请另行关联或登记一次转账。</text>
    <view class="ld-grid identity-grid">
      <label class="ld-cell name-field"><view class="ld-cell-label"><text>名称</text><text>方便区分</text></view><input class="ld-cell-input" data-field="name" value="{{name}}" maxlength="80" placeholder="例如：装修分期" bindinput="input" /></label>
      <picker class="ld-cell type-field" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="selectType"><view class="ld-cell-label"><text>类型</text><text>可选</text></view><view class="ld-cell-value"><text>{{typeIndex ? typeOptions[typeIndex].label : '选择类型'}}</text><chevron-icon size="{{22}}" /></view></picker>
    </view>
    <label wx:if="{{typeIndex === 4}}" class="ld-cell ld-cell-full"><view class="ld-cell-label"><text>自定义类型</text><text>选填</text></view><input class="ld-cell-input" data-field="customRecordType" value="{{customRecordType}}" maxlength="12" placeholder="例如：车贷、装修分期" bindinput="input" /></label>
    <view class="ld-block"><view class="ld-block-label"><text>关联负债账户</text><text>必选</text></view><picker wx:if="{{accounts.length}}" disabled="{{loan || sourceLocked || accountLocked}}" range="{{accounts}}" range-key="name" value="{{accountIndex < 0 ? 0 : accountIndex}}" bindchange="selectAccount"><view class="ld-picker"><text class="ld-picker-value">{{accountIndex >= 0 ? accounts[accountIndex].name : '请选择负债账户'}}</text><chevron-icon wx:if="{{!loan && !sourceLocked && !accountLocked}}" size="{{24}}" /></view></picker><text wx:elif="{{accountLocked}}" class="ld-note">原负债账户暂不可用</text><text wx:elif="{{errorMessage}}" class="ld-note">账户未读取，请先点上方「重新读取」</text><button wx:else class="secondary-button" bindtap="openAccounts">添加负债账户</button></view>
    <view class="ld-grid">
      <label class="ld-cell {{fieldErrors.principal ? 'ld-field-error' : ''}}"><view class="ld-cell-label"><text>借款金额</text></view><view class="ld-cell-amount"><input class="ld-cell-input money-number" type="digit" data-field="principalYuan" value="{{principalYuan}}" bindinput="input" /><text class="ld-cell-unit">元</text></view></label>
      <label class="ld-cell {{fieldErrors.terms ? 'ld-field-error' : ''}}"><view class="ld-cell-label"><text>总期数</text></view><view class="ld-cell-amount"><input class="ld-cell-input money-number" type="number" data-field="terms" value="{{schedule.terms}}" maxlength="3" bindinput="scheduleInput" /><text class="ld-cell-unit">期</text></view></label>
    </view>
    <view class="ld-grid">
      <label class="ld-cell"><view class="ld-cell-label"><text>已还期数</text></view><view class="ld-cell-amount"><input class="ld-cell-input money-number" type="number" data-field="paidTerms" value="{{paidTerms}}" maxlength="3" bindinput="input" /><text class="ld-cell-unit">期</text></view></label>
      <date-field class="ld-cell {{fieldErrors.date ? 'ld-field-error' : ''}}" granularity="date" value="{{schedule.firstPaymentDate}}" bindchange="scheduleInput" data-field="firstPaymentDate"><view class="ld-cell-label"><text>首期还款日</text></view><view class="ld-cell-value"><text>{{schedule.firstPaymentDate || '选择日期'}}</text><chevron-icon size="{{22}}" /></view></date-field>
    </view>
    <view class="ld-block {{fieldErrors.method ? 'ld-field-error' : ''}}"><view class="ld-block-label"><text>还款方式</text></view><view class="ld-segment"><view wx:for="{{methods}}" wx:key="value" class="ld-segment-option {{schedule.methodIndex === index ? 'ld-segment-on' : ''}} {{schedule.measurementIndex === 0 && quotes[schedule.quoteIndex].value === 'installment' && index !== 0 ? 'choice-disabled' : ''}}" data-index="{{index}}" bindtap="selectMethod">{{item.label}}</view></view></view>
    <view class="ld-block {{fieldErrors.rounding ? 'ld-field-error' : ''}}"><view class="ld-block-label"><text>本金取整</text><text>到元按整元平摊、尾差进末期，与银行账单一致</text></view><view class="ld-segment"><view wx:for="{{roundings}}" wx:key="value" class="ld-segment-option {{schedule.roundingIndex === index ? 'ld-segment-on' : ''}}" data-index="{{index}}" bindtap="selectRounding">{{item.label}}</view></view></view>
    <view class="ld-block"><view class="ld-block-label"><text>测算依据</text><text>按已有还款额或利率填写</text></view><view class="ld-segment"><view class="ld-segment-option {{schedule.measurementIndex === 1 ? 'ld-segment-on' : ''}}" data-index="1" bindtap="selectMeasurement">还款额</view><view class="ld-segment-option {{schedule.measurementIndex === 0 ? 'ld-segment-on' : ''}}" data-index="0" bindtap="selectMeasurement">利率</view></view></view>
    <view wx:if="{{schedule.measurementIndex === 0}}" class="ld-block {{fieldErrors.quote ? 'ld-field-error' : ''}}"><view class="ld-block-label"><text>利率口径</text><text>按账单给出的利率类型填写</text></view><view class="ld-segment"><view wx:for="{{quotes}}" wx:key="value" class="ld-segment-option {{schedule.quoteIndex === index ? 'ld-segment-on' : ''}} {{item.value === 'installment' && schedule.methodIndex !== 0 ? 'choice-disabled' : ''}}" data-index="{{index}}" bindtap="selectQuote">{{item.label}}</view></view></view>
    <!-- 还款额 + 等额本息：每期应还 + 可选日利率 并排一行 -->
    <view wx:if="{{schedule.measurementIndex === 1 && schedule.methodIndex === 1}}" class="ld-start-row {{(fieldErrors.repayment || fieldErrors.optionalDailyRate) ? 'ld-field-error' : ''}}">
      <view class="ld-start-half">
        <view class="ld-start-inner"><text class="ld-start-label">每期应还</text><view class="ld-start-days"><input class="ld-start-input money-number" type="digit" data-field="repaymentYuan" value="{{schedule.repaymentYuan}}" bindinput="scheduleInput" /><text class="ld-cell-unit">元</text></view></view>
      </view>
      <view class="ld-start-half">
        <view class="ld-start-inner"><text class="ld-start-label">日利率<text class="ld-start-opt">可选</text></text><view class="ld-start-days"><input class="ld-start-input money-number" type="digit" data-field="optionalDailyRate" value="{{schedule.optionalDailyRate}}" bindinput="scheduleInput" /><text class="ld-cell-unit">%</text></view></view>
      </view>
    </view>
    <text wx:if="{{schedule.measurementIndex === 1 && schedule.methodIndex === 1}}" class="ld-note form-hint">日利率可选：填了按「剩余本金×日利率×实际天数」算利息，配合起息日精确复现账单；留空则按每期应还反推。</text>
    <!-- 其它情况：单行输入（还款额/利率） -->
    <view wx:if="{{!(schedule.measurementIndex === 1 && schedule.methodIndex === 1)}}" class="measurement-row {{(fieldErrors.rate || fieldErrors.repayment) ? 'ld-field-error' : ''}}"><text class="measurement-label">{{schedule.measurementIndex === 0 ? quotes[schedule.quoteIndex].label : (schedule.methodIndex === 3 ? '每期利息 / 费' : schedule.methodIndex === 2 ? '首期应还' : '每期应还')}}</text><input class="money-number" type="digit" data-field="{{schedule.measurementIndex === 0 ? 'ratePercent' : 'repaymentYuan'}}" value="{{schedule.measurementIndex === 0 ? schedule.ratePercent : schedule.repaymentYuan}}" bindinput="scheduleInput" /><text class="ld-cell-unit">{{schedule.measurementIndex === 0 ? '%' : '元'}}</text></view>
    <text wx:if="{{schedule.measurementIndex === 0 && quotes[schedule.quoteIndex].value === 'installment'}}" class="ld-note form-hint">每期费率按最初借款金额计费，对应等本等息。</text>
    <view wx:if="{{schedule.measurementIndex === 1 || quotes[schedule.quoteIndex].value !== 'installment'}}" class="ld-block">
      <view class="ld-block-label"><text>首期计息</text><text>填其一即可，都留空则首期按整月</text></view>
      <view class="ld-start-row {{fieldErrors.interestStart ? 'ld-field-error' : ''}}">
        <view class="ld-start-half">
          <date-field class="ld-start-date" granularity="date" value="{{schedule.interestStartDate}}" bindchange="scheduleDateInput" data-field="interestStartDate"><view class="ld-start-inner"><text class="ld-start-label">起息日</text><view class="ld-start-value"><text>{{schedule.interestStartDate || '选择日期'}}</text><chevron-icon size="{{18}}" /></view></view></date-field>
        </view>
        <view class="ld-start-half">
          <label class="ld-start-inner"><text class="ld-start-label">首期天数</text><view class="ld-start-days"><input class="ld-start-input money-number" type="number" data-field="firstPeriodDays" value="{{schedule.firstPeriodDays}}" bindinput="scheduleDaysInput" /><text class="ld-cell-unit">天</text></view></label>
        </view>
      </view>
    </view>


    <view class="ld-advanced-toggle" bindtap="toggleAdvanced"><text class="ld-advanced-title">补充信息</text><text class="ld-advanced-symbol">{{advancedOpen ? '收起' : '展开'}}</text></view>
    <view wx:if="{{advancedOpen}}">
      <text class="ld-note form-hint">若利率或还款额尚未扣优惠再填；已是实付请留空。</text>
      <view class="measurement-row"><picker range="{{discountOptions}}" range-key="label" value="{{discountIndex}}" bindchange="selectDiscount"><view class="measurement-label"><text>{{discountOptions[discountIndex].label}}</text><chevron-icon size="{{22}}" /></view></picker><input type="digit" value="{{discountValue}}" data-field="discountValue" bindinput="input" /><text class="ld-cell-unit">{{discountIndex === 0 ? '折' : '元'}}</text></view>
      <text class="ld-note form-hint">额外另收的手续费、服务费；已含在还款额里的不填。</text>
      <view class="measurement-row"><picker range="{{feeOptions}}" value="{{feeIndex}}" bindchange="selectFee"><view class="measurement-label"><text>{{feeOptions[feeIndex]}}</text><chevron-icon size="{{22}}" /></view></picker><input type="digit" value="{{feeIndex === 0 ? schedule.feeUpfrontYuan : schedule.feePerTermYuan}}" data-field="{{feeIndex === 0 ? 'feeUpfrontYuan' : 'feePerTermYuan'}}" bindinput="scheduleInput" /><text class="ld-cell-unit">元</text></view>
    </view>
  </view>
  <view wx:if="{{preview}}" class="ld-form-card review-card">
    <view class="ld-card-head"><text class="ld-card-title">逐期还款</text><text class="ld-card-note">共 {{schedule.terms}} 期</text></view>
    <view class="plan-table-head"><text>期数 / 日期</text><text>应还</text><text>本金</text><text>利息 / 费</text></view>
    <view class="plan-list">
      <view wx:for="{{preview.rows}}" wx:key="periodNumber" class="plan-row {{item.paid ? 'plan-row-paid' : ''}}"><view class="plan-period"><text>第 {{item.periodNumber}} 期</text><text>{{item.dueDate}}</text><text wx:if="{{item.paid}}" class="plan-paid-tag">已还</text></view><text class="plan-col money-number">{{item.totalText}}</text><text class="plan-col money-number">{{item.principalText}}</text><text class="plan-col plan-interest money-number">{{item.interestText}}</text></view>
    </view>
    <text wx:if="{{preview.truncated}}" class="ld-note form-hint">此处展示前 {{preview.rows.length}} 期，保存后可查看全部期次。</text><text class="ld-note form-hint">{{preview.summaryText}}</text>
  </view>
  <text wx:if="{{hasPending}}" class="ld-note form-hint">上次保存结果待核实，再次保存将恢复原请求。</text>
  <button class="primary-button ld-action" bindtap="save" disabled="{{loading || saving || previewLoading || (!sourceReady && !hasPending)}}" loading="{{saving || previewLoading}}">{{hasPending ? '重试上次保存' : loan ? (structureDirty ? (preview ? '保存修改（重算期次）' : '核对重算结果') : '保存修改') : preview ? '保存贷款和还款计划' : '核对还款计划'}}</button>
  <button class="ld-link" bindtap="cancel" disabled="{{saving}}">取消</button><login-sheet id="page-login-sheet" />
</view>
