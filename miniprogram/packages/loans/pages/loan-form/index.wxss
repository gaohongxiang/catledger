@import "../../../../templates/historical-charge-coverage.wxss";
@import '../loan-detail/index.wxss';
.loan-form { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.loan-form .ld-cell-label { flex-wrap: wrap; gap: 0 8rpx; }
.loan-form .ld-cell-input { font-size: var(--font-body); }
.name-field { flex: 1.4; }
.type-field { flex: 1; }
.identity-grid .ld-cell { padding-left: var(--layout-space-4); padding-right: var(--layout-space-4); }
.measurement-row { display: flex; align-items: center; gap: var(--layout-space-2); min-height: 92rpx; margin-top: var(--layout-space-3); padding: 0 22rpx; border-radius: var(--layout-radius-medium); background: var(--theme-surface-muted); }
.measurement-label { display: flex; align-items: center; justify-content: space-between; gap: var(--layout-space-1); width: 200rpx; font-size: var(--font-caption); }
.measurement-row input { flex: 1; min-width: 0; text-align: right; font-size: var(--font-body); }
.form-hint { margin-top: 14rpx; }
.choice-disabled { opacity: .45; }
.remaining-principal { display: block; margin: 12rpx 0 24rpx; font-size: var(--font-display); color: var(--theme-ink); }
.plan-row { display: flex; align-items: center; justify-content: space-between; gap: var(--layout-space-2); padding: 16rpx 0; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-caption); }
.plan-period { flex: 1; min-width: 0; }
.plan-period text { display: block; }
.plan-period text + text { color: var(--theme-text-muted); font-size: 20rpx; }
.plan-row .money-number { white-space: nowrap; }
.plan-row .schedule-choice, .plan-pending { width: 112rpx; text-align: center; font-size: 22rpx; }
.plan-pending { color: var(--theme-text-muted); }
.confirm-row { display: flex; align-items: flex-start; margin-top: var(--layout-space-5); gap: var(--layout-space-2); font-size: var(--font-caption); line-height: 1.6; }
.confirm-row checkbox { flex-shrink: 0; }
.local-note { margin: 24rpx 8rpx 0; }

/* 已还期次勾选：自定义主题化勾选框，替代原生 checkbox。 */
.plan-row .schedule-choice { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; }
.schedule-check { width: 40rpx; height: 40rpx; box-sizing: border-box; border: 2rpx solid var(--theme-line, rgba(255,255,255,.35)); border-radius: 10rpx; background: transparent; display: flex; align-items: center; justify-content: center; }
.schedule-check.is-checked { background: var(--theme-accent, #be5b24); border-color: var(--theme-accent, #be5b24); }
.schedule-check.is-checked::after { content: ''; width: 10rpx; height: 18rpx; margin-top: -4rpx; border: solid #fff; border-width: 0 3rpx 3rpx 0; transform: rotate(45deg); }
.schedule-choice.is-paid text { color: var(--theme-text-muted, #958b82); }
