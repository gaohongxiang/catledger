page {
  --font-caption: 24rpx;
  --font-body: 28rpx;
  --font-section: 32rpx;
  --font-title: 40rpx;
  --font-display: 56rpx;
  min-height: 100%;
  color: #2c2823;
  background: #faf8f4;
  font-family: "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif;
  font-size: var(--font-body, 28rpx);
  line-height: 1.5;
  font-weight: 400;
}

button { font-family: inherit; }
button::after { border: 0; }

.serif-title { font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif; letter-spacing: 0; }

.money-number { font-family: "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0; }

.page-canvas,
.editor-page {
  --layout-page-gutter: 32rpx;
  --layout-content-inset: 20rpx;
  --layout-touch-min: 88rpx;
  --layout-radius-xl: var(--theme-radius-xl, 32rpx);
  --layout-radius-large: var(--theme-radius-large, 24rpx);
  --layout-radius-medium: var(--theme-radius-medium, 18rpx);
  --layout-radius-small: var(--theme-radius-small, 12rpx);
  --layout-nav-height: 116rpx;
  --layout-motion-fast: 120ms;
  --layout-motion-normal: 180ms;
  --layout-motion-slow: 240ms;
  --layout-motion-enter: 380ms;
  --layout-motion-shimmer: 1400ms;
  --motion-press-scale: .965;
  --motion-press-timing: cubic-bezier(.34, 1.56, .64, 1);
  --motion-ticker-timing: cubic-bezier(.22, 1, .36, 1);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx var(--layout-page-gutter) calc(148rpx + env(safe-area-inset-bottom));
  color: var(--theme-ink, #2c2823);
  background: var(--theme-page, #faf8f4);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: var(--layout-touch-min);
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
  line-height: 1.4;
  padding: 20rpx 28rpx;
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  border-radius: var(--layout-radius-medium);
  transition: transform var(--layout-motion-fast) var(--motion-press-timing), opacity var(--layout-motion-fast) ease;
}

.primary-button { border-radius: 999rpx; color: var(--theme-on-accent, #ffffff); background: var(--theme-accent, #be5b24); }
.primary-button-medium { border-radius: var(--layout-radius-medium, 18rpx); }
.secondary-button { color: var(--theme-secondary, #70685f); background: var(--theme-secondary-soft, #f1eee9); }
.danger-button { color: var(--theme-danger, #a95132); background: var(--theme-danger-soft, #f4e1d6); }
.primary-button:active,
.secondary-button:active,
.danger-button:active { transform: scale(var(--motion-press-scale, .965)); opacity: .9; }

/* 页头主操作：实色胶囊 CTA，替代各页自造的纯文本/描边按钮。 */
.head-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  min-height: 64rpx;
  margin: 0;
  padding: 12rpx 28rpx;
  color: var(--theme-on-accent, #ffffff);
  background: var(--theme-accent, #be5b24);
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  line-height: 1.4;
  border-radius: 999rpx;
  box-shadow: var(--theme-shadow-soft);
  transition: opacity var(--layout-motion-fast) ease;
}
.head-cta:active { opacity: .76; }
.head-cta image { width: 22rpx; height: 22rpx; flex: 0 0 auto; }

.empty-ledger {
  padding: 32rpx 0;
  color: var(--theme-text-muted, #70685f);
  text-align: left;
  border-top: 2rpx solid var(--theme-line, #eae4dc);
  border-bottom: 2rpx solid var(--theme-line, #eae4dc);
}

.empty-ledger-title,
.empty-ledger-copy { display: block; }
.empty-ledger-title { color: var(--theme-ink, #2c2823); font-size: var(--font-section, 32rpx); font-weight: 500; }
.empty-ledger-copy { margin-top: 10rpx; font-size: var(--font-caption, 24rpx); line-height: 1.6; }

/* 主题色表达状态，正文保持可读；小字号不再承担关键操作与业务解释。 */
.primary-button[disabled], .secondary-button[disabled] { color: var(--theme-text-muted, #70685f); background: var(--theme-surface-muted, #f1eee9); opacity: .65; }

/* 列表行错峰入场与校验抖动；reduced-motion 由下方全局媒体查询统一收敛。 */
@keyframes row-fade-up { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: none; } }
.row-enter { animation: row-fade-up var(--layout-motion-enter, 380ms) ease backwards; }
@keyframes field-error-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(3px); }
}
.field-error-shake { animation: field-error-shake 360ms ease; }
.field-error-inline { display: block; margin-top: 8rpx; color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); line-height: 1.5; }

@media (prefers-reduced-motion: reduce) {
  view, button { transition: none !important; animation-duration: .01ms !important; }
}

/* 卡片外沿与文字分两条基线；页面文字统一内收，卡片保留外宽。 */
.page-canvas .content-inset, .editor-page .content-inset { box-sizing: border-box; padding-left: var(--layout-content-inset, 20rpx); padding-right: var(--layout-content-inset, 20rpx); }

/* 刷新提示保留固定位置，只有图标透明度和旋转发生变化。 */
.heading-with-sync { display: flex; min-width: 0; align-items: center; }
.inline-sync {
  display: flex;
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  color: var(--theme-accent-strong, #a34d20);
  opacity: 0;
}
.inline-sync-active { opacity: 1; }
.inline-sync-icon {
  box-sizing: border-box;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
}
.inline-sync-active .inline-sync-icon { animation: inline-sync-spin .8s linear infinite; }
.summary-strip { position: relative; }
.summary-sync {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  margin: 0;
}
@keyframes inline-sync-spin { to { transform: rotate(360deg); } }

/* 全页面共用的状态与文本工具；不包含业务状态推断。 */
.page-secondary { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.ui-page-heading {
  display: block;
  margin: 4rpx 0 24rpx;
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.35;
}
.ui-state {
  box-sizing: border-box;
  padding: 28rpx;
  margin: 20rpx 0;
  color: var(--theme-text-muted, #70685f);
  background: var(--theme-surface, #fffefd);
  border: 1rpx solid var(--theme-line, #eae4dc);
  border-radius: var(--layout-radius-large, 24rpx);
  line-height: 1.6;
  font-size: var(--font-body, 28rpx);
  overflow-wrap: anywhere;
}
.ui-state-title {
  display: block;
  color: var(--theme-ink, #2c2823);
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.ui-state-error { color: var(--theme-danger, #a95132); }
.ui-state-action {
  box-sizing: border-box;
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  margin: 16rpx 0 0;
  border: 1rpx solid var(--theme-line, #eae4dc);
  border-radius: var(--layout-radius-medium, 18rpx);
  color: var(--theme-accent-strong, #a34d20);
  background: var(--theme-surface, #fffefd);
  font-size: var(--font-body, 28rpx);
  line-height: 1.4;
}
.ui-state-caption {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption, 24rpx);
  color: var(--theme-text-muted, #70685f);
}
input, textarea { font-family: inherit; font-weight: 400; }
input:focus, textarea:focus { border-color: var(--theme-accent); }
button[disabled] { opacity: .65; }
button[disabled].danger-button { color: var(--theme-text-muted); background: var(--theme-surface-muted); }

/* 次级页登录空状态，与首页共享浅色胶囊的视觉比例。 */
.page-canvas .guest-login-button { display: flex; align-items: center; justify-content: center; width: 112rpx; min-height: 88rpx; box-sizing: border-box; margin: 16rpx auto 0; padding: 0; background: transparent; border: 0; }
.guest-login-label { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 56rpx; border-radius: 999rpx; color: var(--theme-on-accent, #ffffff); background: var(--theme-accent, #be5b24); font-size: var(--font-body, 28rpx); font-weight: 500; line-height: 1; }
.guest-login-button:active { opacity: .78; }
