.detail-page { padding-top: 20rpx; }
.month-switcher,
.date-picker-content,
.date-filter-note,
.summary-strip,
.filter-toolbar,
.search-field,
.detail-item,
.detail-line { display: flex; }
.detail-line { gap: 16rpx; flex-wrap: wrap; }
.month-switcher {
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.month-arrow {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}
.month-arrow:active { opacity: .55; }
.date-picker { min-width: 0; flex: 0 1 auto; }
.date-picker-content { min-height: 72rpx; align-items: center; justify-content: center; }
.month-current {
  color: var(--theme-ink, #29231e);
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  text-align: center;
  min-width: 0;
  line-height: 1.4;
}
.date-filter-note {
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
}
.date-clear {
  min-height: 56rpx;
  margin-left: 14rpx;
  color: var(--theme-accent, #be5b24);
  line-height: 56rpx;
}

.summary-strip {
  position: relative;
  align-items: baseline;
  margin-top: 2rpx;
  padding: 0 var(--layout-content-inset, 20rpx);
  border-top: 0;
  border-bottom: 0;
  background: transparent;
  border: 0;
  gap: 28rpx;
  flex-wrap: wrap;
}
.summary-cell {
  display: flex;
  flex: 0 1 auto;
  min-width: 0;
  align-items: baseline;
  box-sizing: border-box;
  gap: 8rpx;
  padding: 0;
}
.summary-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--theme-line, rgba(41, 35, 30, .09));
  display: none;
}
.summary-label { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.summary-value {
  margin-top: 0;
  overflow: visible;
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.5;
}
.summary-income { color: var(--theme-income, #477153); }
.summary-expense { color: var(--theme-expense, #b54738); }

.filter-toolbar { align-items: center; gap: 12rpx; margin-top: 16rpx; }
.filter-search-toggle {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: var(--theme-text-muted);
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-medium, 18rpx);
}
.filter-search-toggle:active { opacity: .55; }
.filter-search-toggle-active { color: var(--theme-accent-strong); border-color: var(--theme-accent); }
.filter-search-toggle image { width: 32rpx; height: 32rpx; }
.filter-picker {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--theme-ink);
  font-size: var(--font-caption, 24rpx);
  background: var(--theme-surface);
  border-radius: var(--theme-radius-medium, 18rpx);
  border: 1rpx solid var(--theme-line);
}
.filter-content {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 16rpx;
  gap: 8rpx;
}
.filter-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.search-field {
  margin-top: 12rpx;
  align-items: center;
  color: var(--theme-text-muted);
  background: var(--theme-surface);
  border-radius: var(--theme-radius-medium, 18rpx);
  border: 1rpx solid var(--theme-line);
  box-sizing: border-box;
}
.search-submit,
.search-clear { display: flex; width: 88rpx; height: 88rpx; flex: 0 0 auto; align-items: center; justify-content: center; }
.search-submit:active,
.search-clear:active { opacity: .55; }
.search-icon-img { width: 32rpx; height: 32rpx; }
.search-input {
  flex: 1;
  height: 88rpx;
  font-size: var(--font-body, 28rpx);
  color: var(--theme-ink);
  min-width: 0;
  padding-right: 16rpx;
}
.clear-icon-img { width: 24rpx; height: 24rpx; }

.detail-timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--theme-line);
  border: 1rpx solid var(--theme-line);
  background: var(--theme-surface);
  border-radius: var(--theme-radius-large, 24rpx);
  padding: 0 8rpx;
}
.detail-group {
  display: block;
  padding: 26rpx 4rpx 8rpx;
  color: var(--theme-text-muted);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
  text-align: left;
}
.detail-group:first-child { padding-top: 12rpx; }
.detail-item {
  min-height: 124rpx;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--theme-line);
  transition: opacity 120ms ease;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}
.detail-item:active { opacity: .68; }
.detail-tile { flex: 0 0 auto; margin-right: 16rpx; }
.detail-main,
.detail-copy { min-width: 0; flex: 1; }
.detail-line { align-items: baseline; justify-content: space-between; }
.detail-label {
  overflow: hidden;
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.5;
  min-width: 0;
  flex: 1;
}
.detail-amount {
  margin-left: auto;
  flex: 0 0 auto;
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  max-width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}
.detail-meta,
.detail-note {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  text-overflow: ellipsis;
  white-space: normal;
  line-height: 1.5;
}
.amount-income { color: var(--theme-income, #477153); }
.amount-expense { color: var(--theme-expense, #b54738); }
.amount-neutral { color: var(--theme-text-muted, #746a60); }
.amount-refund { color: var(--theme-accent-strong, #a34d20); }
.detail-empty { margin-top: 20rpx; }
.detail-status,
.detail-error {
  min-height: 72rpx;
  margin-top: 12rpx;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  line-height: 72rpx;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}
.detail-error { color: var(--theme-danger, #a95132); }

.summary-strip-stacked { display: block; }

.summary-strip-stacked .summary-cell {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 6rpx;
  padding: 0;
}

.summary-strip-stacked .summary-value { min-width: 0; text-align: right; margin-top: 0; }

.filter-content > text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-action, .search-cancel {
  display: flex;
  align-items: center;
  min-width: 72rpx;
  min-height: 88rpx;
  padding-left: 14rpx;
  color: var(--theme-accent-strong);
  font-size: var(--font-caption, 24rpx);
}

.detail-item:last-child { border-bottom: 0; }

.detail-line-long { align-items: flex-start; flex-direction: column; }

.detail-line-long .detail-amount { margin-left: 0; text-align: left; }

.detail-error { line-height: 1.6; padding-top: 16rpx; padding-bottom: 16rpx; }

.filter-select-toggle {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: var(--theme-text-muted);
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-medium, 18rpx);
}
.filter-select-toggle:active { opacity: .55; }
.filter-select-toggle-active { color: var(--theme-accent-strong); border-color: var(--theme-accent); background: var(--theme-accent-soft, #f0e2ce); }
.filter-select-toggle image { width: 32rpx; height: 32rpx; }

.selection-bar {
  position: fixed;
  right: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 15;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  background: var(--theme-surface, #fffdf9);
  border-top: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  box-shadow: 0 -6rpx 20rpx rgba(74, 50, 30, .06);
}
.selection-bar-spacer { height: 132rpx; }
.selection-bar-count { flex: 0 0 auto; color: var(--theme-ink, #29231e); font-size: var(--font-caption, 24rpx); }
.selection-bar-link { min-height: 72rpx; margin: 0; padding: 0 12rpx; color: var(--theme-accent, #be5b24); background: transparent; font-size: var(--font-caption, 24rpx); line-height: 72rpx; }
.selection-bar-space { flex: 1; }
.selection-bar-delete { min-height: 72rpx; margin: 0; padding: 12rpx 32rpx; font-size: var(--font-caption, 24rpx); border-radius: 999rpx; }
.selection-bar-delete-block { flex: 1; }
.detail-check { display: flex; flex: 0 0 38rpx; width: 38rpx; height: 38rpx; margin-right: 20rpx; align-items: center; justify-content: center; border: 2rpx solid var(--theme-muted, #746a60); border-radius: 50%; }
.detail-check-selected { background: var(--theme-accent, #be5b24); border-color: var(--theme-accent, #be5b24); }
.detail-check-icon { width: 22rpx; height: 22rpx; }
.detail-check-disabled { opacity: .2; }

.detail-manage-link { min-height: 88rpx; margin: 0; padding: 20rpx; color: var(--theme-accent, #be5b24); background: transparent; font-size: var(--font-caption, 24rpx); line-height: 48rpx; }

.import-filter-title { display: block; font-size: var(--font-section, 32rpx); overflow-wrap: anywhere; }
.import-filter .detail-manage-link { margin-left: 0; }
