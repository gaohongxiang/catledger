.detail-page { padding-top: 20rpx; }
.month-switcher,
.date-picker-content,
.date-filter-note,
.summary-strip,
.filter-toolbar,
.search-strip,
.detail-item,
.detail-line { display: flex; }
.detail-line { gap: 16rpx; flex-wrap: wrap; }
.month-switcher {
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.month-arrow {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}
.month-arrow:active { opacity: .55; }
.arrow-left,
.arrow-right {
  width: 15rpx;
  height: 15rpx;
  border-top: 3rpx solid var(--theme-text-muted);
  border-right: 3rpx solid var(--theme-text-muted);
}
.arrow-left { transform: rotate(-135deg); }
.arrow-right { transform: rotate(45deg); }
.date-picker { min-width: 0; flex: 0 1 auto; }
.date-picker-content { min-height: 72rpx; align-items: center; justify-content: center; }
.month-current {
  color: var(--theme-ink, #29231e);
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  min-width: 0;
  line-height: 1.4;
}
.date-filter-note {
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
}
.date-clear {
  min-height: 56rpx;
  margin-left: 14rpx;
  color: var(--theme-accent, #d97732);
  line-height: 56rpx;
}

.summary-strip {
  align-items: stretch;
  margin-top: 8rpx;
  padding: 0;
  border-top: 0;
  border-bottom: 0;
  background: transparent;
  border-radius: var(--theme-radius-medium, 16rpx);
  border: 0;
  gap: 12rpx;
}
.summary-cell {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  padding: 22rpx 12rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: 20rpx;
}
.summary-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--theme-line, rgba(41, 35, 30, .09));
  display: none;
}
.summary-label { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.summary-value {
  margin-top: 4rpx;
  overflow: visible;
  font-size: 28rpx;
  font-weight: 500;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.5;
}
.summary-income { color: var(--theme-income, #477153); }
.summary-expense { color: var(--theme-expense, #b54738); }

.filter-toolbar { align-items: center; gap: 12rpx; margin-top: 16rpx; }
.filter-picker {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--theme-ink);
  font-size: var(--font-body-small, 26rpx);
  background: var(--theme-surface);
  border-radius: 16rpx;
  border: 1rpx solid var(--theme-line);
}
.filter-content {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx;
  gap: 10rpx;
}
.filter-chevron {
  width: 9rpx;
  height: 9rpx;
  margin-left: 8rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg) translateY(-3rpx);
  flex-shrink: 0;
}
.search-trigger {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: var(--theme-surface);
  border-radius: 16rpx;
  border: 1rpx solid var(--theme-line);
  box-sizing: border-box;
}
.search-trigger-active { color: var(--theme-accent-strong, #b85f2e); background: var(--theme-accent-soft, #f6e5d8); }
.search-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 3rpx;
  content: "";
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.search-strip {
  min-height: 88rpx;
  align-items: center;
  margin-top: 8rpx;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.search-input {
  flex: 1;
  height: 88rpx;
  font-size: var(--font-body, 28rpx);
  min-width: 0;
}
.search-action,
.search-cancel {
  min-height: 68rpx;
  padding-left: 22rpx;
  color: var(--theme-accent, #d97732);
  font-size: var(--font-body-small, 26rpx);
  font-weight: 500;
  line-height: 68rpx;
}

.detail-timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--theme-line);
  border: 1rpx solid var(--theme-line);
  background: var(--theme-surface);
  border-radius: 24rpx;
  padding: 0 8rpx;
}
.detail-item {
  min-height: 124rpx;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--theme-line);
  transition: opacity 120ms ease;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}
.detail-item:active { opacity: .68; }
.detail-main,
.detail-copy { min-width: 0; flex: 1; }
.detail-line { align-items: baseline; justify-content: space-between; }
.detail-label {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.5;
  min-width: 0;
  flex: 1;
}
.detail-amount {
  margin-left: auto;
  flex: 0 0 auto;
  font-size: 30rpx;
  font-weight: 500;
  max-width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
  text-align: right;
}
.detail-meta,
.detail-note {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  text-overflow: ellipsis;
  white-space: normal;
  line-height: 1.5;
}
.amount-income { color: var(--theme-income, #477153); }
.amount-expense { color: var(--theme-expense, #b54738); }
.amount-neutral { color: var(--theme-text-muted, #746a60); }
.amount-refund { color: var(--theme-accent-strong, #b85f2e); }
.detail-empty { margin-top: 20rpx; }
.detail-status,
.detail-error {
  min-height: 72rpx;
  margin-top: 12rpx;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-body-small, 26rpx);
  line-height: 72rpx;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}
.detail-error { color: var(--theme-danger, #a95132); }

.summary-strip-stacked { display: block; }

.summary-strip-stacked .summary-cell {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 10rpx;
  padding: 20rpx 24rpx;
}

.summary-strip-stacked .summary-value { min-width: 0; text-align: right; margin-top: 0; }

.filter-content > text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-action, .search-cancel {
  display: flex;
  align-items: center;
  min-width: 72rpx;
  min-height: 88rpx;
  padding-left: 14rpx;
  color: var(--theme-accent-strong);
  font-size: 26rpx;
}

.detail-item:last-child { border-bottom: 0; }

.detail-line-long { align-items: flex-start; flex-direction: column; }

.detail-line-long .detail-amount { margin-left: 0; text-align: left; }

.detail-error { line-height: 1.6; padding-top: 16rpx; padding-bottom: 16rpx; }
