.detail-page { padding-top: 20rpx; }
.month-switcher,
.date-picker-content,
.date-filter-note,
.summary-strip,
.filter-toolbar,
.search-strip,
.detail-item,
.detail-line { display: flex; }
.month-switcher { min-height: 88rpx; align-items: center; justify-content: space-between; }
.month-arrow { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; }
.month-arrow:active { opacity: .55; }
.arrow-left,
.arrow-right { width: 15rpx; height: 15rpx; border-top: 3rpx solid var(--theme-secondary, #64705d); border-left: 3rpx solid var(--theme-secondary, #64705d); }
.arrow-left { transform: rotate(-45deg); }
.arrow-right { transform: rotate(135deg); }
.date-picker { min-width: 0; flex: 1; }
.date-picker-content { min-height: 72rpx; align-items: center; justify-content: center; }
.month-current { color: var(--theme-ink, #29231e); font-size: 30rpx; font-weight: 600; text-align: center; }
.date-picker-chevron { width: 10rpx; height: 10rpx; margin-left: 12rpx; border-right: 3rpx solid var(--theme-text-muted, #746a60); border-bottom: 3rpx solid var(--theme-text-muted, #746a60); transform: rotate(45deg) translateY(-3rpx); }
.date-filter-note { align-items: center; justify-content: center; margin-top: -4rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.date-clear { min-height: 56rpx; margin-left: 14rpx; color: var(--theme-accent, #d97732); line-height: 56rpx; }

.summary-strip { align-items: center; margin-top: 8rpx; padding: 14rpx 0; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.summary-cell { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; }
.summary-divider { width: 2rpx; height: 40rpx; background: var(--theme-line, rgba(41, 35, 30, .09)); }
.summary-label { color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.summary-value { margin-top: 4rpx; overflow: hidden; font-size: 24rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.summary-income { color: var(--theme-income, #477153); }
.summary-expense { color: var(--theme-expense, #b54738); }

.filter-toolbar { align-items: center; gap: 12rpx; margin-top: 16rpx; }
.filter-picker { min-width: 0; flex: 1; overflow: hidden; color: var(--theme-secondary, #64705d); font-size: 24rpx; background: var(--theme-secondary-soft, #e8eadf); border-radius: 14rpx; }
.filter-content { display: flex; height: 64rpx; align-items: center; justify-content: space-between; box-sizing: border-box; padding: 0 18rpx; }
.filter-chevron { width: 9rpx; height: 9rpx; margin-left: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg) translateY(-3rpx); }
.search-trigger { position: relative; display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; flex: 0 0 auto; background: var(--theme-secondary-soft, #e8eadf); border-radius: 14rpx; }
.search-trigger-active { color: var(--theme-accent-strong, #b85f2e); background: var(--theme-accent-soft, #f6e5d8); }
.search-icon { position: relative; width: 20rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.search-icon::after { position: absolute; right: -9rpx; bottom: -6rpx; width: 10rpx; height: 3rpx; content: ""; background: currentColor; border-radius: 2rpx; transform: rotate(45deg); }
.search-strip { min-height: 72rpx; align-items: center; margin-top: 8rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.search-input { flex: 1; height: 68rpx; font-size: 26rpx; }
.search-action,
.search-cancel { min-height: 68rpx; padding-left: 22rpx; color: var(--theme-accent, #d97732); font-size: 24rpx; font-weight: 600; line-height: 68rpx; }

.detail-timeline { margin-top: 14rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.detail-item { min-height: 104rpx; align-items: center; padding: 12rpx 0; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); transition: opacity 120ms ease; }
.detail-item:active { opacity: .68; }
.detail-main,
.detail-copy { min-width: 0; flex: 1; }
.detail-line { align-items: baseline; justify-content: space-between; }
.detail-label { overflow: hidden; font-size: 26rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.detail-amount { margin-left: 20rpx; flex: 0 0 auto; font-size: 26rpx; font-weight: 500; }
.detail-meta,
.detail-note { display: block; margin-top: 6rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.amount-income { color: var(--theme-income, #477153); }
.amount-expense { color: var(--theme-expense, #b54738); }
.amount-neutral { color: var(--theme-text-muted, #746a60); }
.amount-refund { color: var(--theme-accent-strong, #b85f2e); }
.detail-empty { margin-top: 20rpx; }
.detail-status,
.detail-error { min-height: 72rpx; margin-top: 12rpx; color: var(--theme-secondary, #64705d); font-size: 24rpx; line-height: 72rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.detail-error { color: var(--theme-danger, #a95132); }
