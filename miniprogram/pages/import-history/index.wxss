.history-entry-heading, .history-actions { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.history-heading { display: block; padding-left: var(--layout-content-inset, 20rpx); padding-right: var(--layout-content-inset, 20rpx); box-sizing: border-box; }
.history-copy { display: block; font-size: var(--font-caption, 24rpx); color: var(--theme-muted, #746a60); line-height: 1.7; }
.history-entry { margin-top: 24rpx; padding: 24rpx 20rpx; border: 1rpx solid var(--theme-line, #e5ded4); border-radius: var(--theme-radius-large, 24rpx); background: var(--theme-surface, #fffefd); }
.history-file { display: block; flex: 1; min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
.history-status { flex-shrink: 0; color: var(--theme-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.history-link { display: inline-flex; align-items: center; min-height: 88rpx; margin: 0; padding: 16rpx 0; background: transparent; color: var(--theme-accent, #be5b24); font-size: var(--font-caption, 24rpx); line-height: 1.5; text-align: left; }
.history-error { color: var(--theme-danger, #a95132); }
.history-error { display: block; margin: 20rpx 0; font-size: var(--font-caption, 24rpx); }
