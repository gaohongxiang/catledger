<view class="page-canvas page-secondary statistics-page {{themeClass}}" style="{{themeStyle}}">
  <view class="month-switcher">
    <view class="month-arrow" role="button" aria-label="上一个月" bindtap="previousMonth"><view class="arrow-left"></view></view>
    <text class="month-current money-number">{{monthLabel}}</text>
    <view class="month-arrow" role="button" aria-label="下一个月" bindtap="nextMonth"><view class="arrow-right"></view></view>
  </view>

  <view class="summary-strip {{incomeText.length > 12 || expenseText.length > 12 || netText.length > 12 ? 'summary-strip-stacked' : ''}}">
    <view class="inline-sync summary-sync {{loading ? 'inline-sync-active' : ''}}" aria-role="status" aria-label="{{loading ? '正在更新' : ''}}"><view class="inline-sync-icon"></view></view>
    <view class="summary-cell"><text class="summary-label">收入</text><text class="summary-value money-number income-color">{{hasLoaded ? incomeText : '—'}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-cell"><text class="summary-label">支出</text><text class="summary-value money-number expense-color">{{hasLoaded ? expenseText : '—'}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-cell"><text class="summary-label">结余</text><text class="summary-value money-number">{{hasLoaded ? netText : '—'}}</text></view>
  </view>

  <view wx:if="{{!hasLoaded && !errorMessage}}" class="ui-state" aria-role="status">{{loading ? '正在汇总收支…' : '登录后读取收支统计'}}</view>
  <block wx:if="{{hasLoaded}}">
  <view class="metric-strip">
    <view><text class="metric-value money-number">{{metrics.transactionCount || 0}}</text><text class="metric-label">交易笔数</text></view>
    <view><text class="metric-value money-number">{{metrics.activeDayCount || 0}}</text><text class="metric-label">记账天数</text></view>
    <view><text class="metric-value money-number">{{metrics.averageDailyExpenseText}}</text><text class="metric-label">日均支出</text></view>
    <view><text class="metric-value money-number">{{metrics.largestExpenseText}}</text><text class="metric-label">单笔最高</text></view>
  </view>

  <view class="section-heading content-inset">
    <view><text class="section-title serif-title">近六个月</text></view>
    <view class="chart-legend"><text class="legend-income">收入</text><text class="legend-expense">支出</text></view>
  </view>
  <text class="ui-state-caption">点击月份查看金额</text>
  <view class="trend-chart">
    <view wx:for="{{cashFlowTrend}}" wx:key="month" class="trend-column" bindtap="selectTrend" data-index="{{index}}" aria-role="button" aria-label="{{item.month}}，收入{{item.incomeText}}，支出{{item.expenseText}}">
      <view class="trend-bars"><view class="trend-bar trend-income" style="height: {{item.incomeBarHeight}}rpx;"></view><view class="trend-bar trend-expense" style="height: {{item.expenseBarHeight}}rpx;"></view></view>
      <text class="chart-axis-label money-number">{{item.monthText}}月</text>
    </view>
  </view>

  <view wx:if="{{selectedTrend}}" class="chart-detail"><text>{{selectedTrend.month}}</text><text>收入 {{selectedTrend.incomeText}}</text><text>支出 {{selectedTrend.expenseText}}</text></view>
  <view class="section-heading content-inset">
    <view><text class="section-title serif-title">每日收支</text></view>
    <text class="section-note">按本地日期</text>
  </view>
  <scroll-view class="daily-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="daily-chart">
      <view wx:for="{{daily}}" wx:key="date" class="daily-column" bindtap="selectDay" data-index="{{index}}" aria-role="button" aria-label="{{item.date}}，收入{{item.incomeText}}，支出{{item.expenseText}}">
        <view class="daily-bars"><view class="daily-bar income-bar" style="height: {{item.incomeBarHeight}}rpx;"></view><view class="daily-bar expense-bar" style="height: {{item.expenseBarHeight}}rpx;"></view></view>
        <text class="chart-axis-label money-number">{{item.dayText}}</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{selectedDay}}" class="chart-detail"><text>{{selectedDay.date}}</text><text>收入 {{selectedDay.incomeText}}</text><text>支出 {{selectedDay.expenseText}}</text></view>

  <button wx:if="{{uncategorized.transactionCount > 0}}" class="category-quality" bindtap="openCategoryCompletion">
    <view><text class="category-quality-kicker">待分类</text><text class="category-quality-copy">补全后，分类统计才准确</text></view>
    <view class="category-quality-value"><text class="money-number">{{uncategorized.transactionCount}} 笔</text><text class="money-number">{{uncategorized.amountText}}</text></view>
  </button>

  <view class="section-heading category-heading content-inset"><view><text class="section-title serif-title">支出分类</text></view></view>
  <view wx:if="{{expenseCategories.length > 0}}" class="ranking-list">
    <view wx:for="{{expenseCategories}}" wx:key="categoryId" class="ranking-row"><view class="ranking-line"><text class="ranking-name">{{item.name}}</text><text class="ranking-amount money-number">{{item.amountText}} · {{item.shareText}}</text></view><view class="ranking-track"><view class="ranking-fill expense-fill" style="width: {{item.barWidth}};"></view></view></view>
  </view>
  <text wx:else class="empty-note content-inset">这个月还没有支出。</text>

  <view class="section-heading category-heading content-inset"><view><text class="section-title serif-title">收入分类</text></view></view>
  <view wx:if="{{incomeCategories.length > 0}}" class="ranking-list">
    <view wx:for="{{incomeCategories}}" wx:key="categoryId" class="ranking-row"><view class="ranking-line"><text class="ranking-name">{{item.name}}</text><text class="ranking-amount money-number">{{item.amountText}} · {{item.shareText}}</text></view><view class="ranking-track"><view class="ranking-fill income-fill" style="width: {{item.barWidth}};"></view></view></view>
  </view>
  <text wx:else class="empty-note content-inset">这个月还没有收入。</text>

  </block>
  <view wx:if="{{errorMessage && !categorySheetOpen}}" class="statistics-error content-inset" bindtap="loadStatistics">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{categorySheetOpen}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeCategoryCompletion"></view>
    <view class="category-sheet">
      <view class="sheet-handle"></view>
      <button class="sheet-back" bindtap="closeCategoryCompletion" disabled="{{categorySaving}}" aria-label="关闭分类面板">关闭</button>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view>
      <block wx:if="{{!selectedCategoryGroup}}">
        <text class="sheet-title serif-title">补全待分类账目</text><text class="sheet-copy">相同来源和交易特征已归为一组，一次选择即可整组补全。</text>
        <view wx:if="{{categorySheetLoading}}" class="sheet-status">正在整理待分类账目…</view>
        <view wx:elif="{{categoryGroups.length}}" class="category-group-list">
          <button wx:for="{{categoryGroups}}" wx:key="groupKey" class="category-group-row" data-key="{{item.groupKey}}" bindtap="selectCategoryGroup"><view class="category-group-copy"><text class="category-group-title">{{item.title}}</text><text class="category-group-meta">{{item.kindLabel}} · {{item.count}} 笔</text></view><text class="category-group-amount money-number">{{item.amountText}}</text><view class="row-chevron"></view></button>
        </view>
        <view wx:else class="sheet-empty">这个月的分类已经完整。</view>
      </block>
      <block wx:else>
        <button class="sheet-back" disabled="{{categorySaving}}" bindtap="returnToCategoryGroups">返回待分类账目</button><text class="sheet-kicker">{{selectedCategoryGroup.kindLabel}}分类</text><text class="sheet-title serif-title">{{selectedCategoryGroup.title}}</text><text class="sheet-copy">本组 {{selectedCategoryGroup.count}} 笔，共 {{selectedCategoryGroup.amountText}}</text>
        <view class="category-option-grid"><button wx:for="{{categoryOptions}}" wx:key="id" class="category-option {{selectedCategoryId === item.id ? 'category-option-selected' : ''}}" data-id="{{item.id}}" bindtap="selectCompletionCategory" disabled="{{categorySaving}}">{{item.name}}</button></view>
        <button class="primary-button sheet-save" disabled="{{!selectedCategoryId || categorySaving}}" loading="{{categorySaving}}" bindtap="saveCategoryCompletion">保存分类</button>
      </block>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
