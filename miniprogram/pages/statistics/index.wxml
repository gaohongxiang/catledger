<view class="page-canvas statistics-page {{themeClass}}" style="{{themeStyle}}">
  <view class="month-switcher">
    <view class="month-arrow" role="button" aria-label="上一个月" bindtap="previousMonth"><view class="arrow-left"></view></view>
    <picker mode="date" fields="month" value="{{month}}" bindchange="chooseMonth"><text class="month-current money-number">{{monthLabel}}</text></picker>
    <view class="month-arrow" role="button" aria-label="下一个月" bindtap="nextMonth"><view class="arrow-right"></view></view>
  </view>

  <view class="summary-strip {{incomeText.length > 12 || expenseText.length > 12 || netText.length > 12 ? 'summary-strip-stacked' : ''}}">
    <view class="inline-sync summary-sync {{loading ? 'inline-sync-active' : ''}}" aria-role="status" aria-label="{{loading ? '正在更新' : ''}}"><view class="inline-sync-icon"></view></view>
    <view class="summary-cell"><text class="summary-label">收入</text><text class="summary-value money-number income-color">{{hasLoaded ? incomeText : '—'}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-cell"><text class="summary-label">支出</text><text class="summary-value money-number expense-color">{{hasLoaded ? expenseText : '—'}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-cell"><text class="summary-label">结余</text><text class="summary-value money-number">{{hasLoaded ? netText : '—'}}</text></view>
  </view>

  <view wx:if="{{!loggedIn}}" class="ui-state guest-login-state"><text class="ui-state-title">登录后查看收支统计</text><button class="guest-login-button" size="mini" bindtap="promptLogin"><text class="guest-login-label">登录</text></button></view>
  <view wx:elif="{{!hasLoaded && !errorMessage}}" class="ui-state" aria-role="status">正在汇总收支…</view>
  <block wx:if="{{hasLoaded}}">
  <view class="section-heading category-heading content-inset"><text class="section-title serif-title">收支构成</text></view>
  <view class="composition-card">
    <view class="composition-pair">
      <view class="composition-column">
      <button class="composition-choice {{categoryKind === 'expense' ? 'composition-selected' : ''}}" data-kind="expense" bindtap="selectCategoryKind" aria-label="{{categoryKind === 'expense' ? '收起支出分类' : '展开支出分类'}}">
        <view class="ring-wrap"><image class="ring-image" src="{{charts.expenseRing.src}}" mode="aspectFit"/><view class="ring-center"><text>支出</text><text>{{charts.expenseRing.legend.length ? '分类构成' : '暂无数据'}}</text></view></view>
        <text class="composition-amount expense-color money-number">{{expenseText}}</text>
        <text class="composition-toggle">{{categoryKind === 'expense' ? '收起分类' : '展开分类'}}</text>
      </button>
      </view>
      <view class="composition-column">
      <button class="composition-choice {{categoryKind === 'income' ? 'composition-selected' : ''}}" data-kind="income" bindtap="selectCategoryKind" aria-label="{{categoryKind === 'income' ? '收起收入分类' : '展开收入分类'}}">
        <view class="ring-wrap"><image class="ring-image" src="{{charts.incomeRing.src}}" mode="aspectFit"/><view class="ring-center"><text>收入</text><text>{{charts.incomeRing.legend.length ? '分类构成' : '暂无数据'}}</text></view></view>
        <text class="composition-amount income-color money-number">{{incomeText}}</text>
        <text class="composition-toggle">{{categoryKind === 'income' ? '收起分类' : '展开分类'}}</text>
      </button>
      </view>
    </view>
    <view wx:if="{{categoryKind}}" class="composition-details">
      <text class="composition-detail-title">{{categoryKind === 'expense' ? '支出分类' : '收入分类'}}</text>
      <block wx:if="{{categoryKind === 'expense' ? expenseCategories.length : incomeCategories.length}}">
        <view wx:for="{{categoryKind === 'expense' ? expenseCategories : incomeCategories}}" wx:key="categoryId" class="ranking-row {{!item.categoryId ? 'ranking-unclassified' : ''}}" data-unclassified="{{!item.categoryId}}" bindtap="openUnclassifiedCategory" aria-role="{{!item.categoryId ? 'button' : 'text'}}">
          <view class="ranking-line"><view class="composition-category"><view class="ring-dot" style="background: {{item.color}};"></view><text class="ranking-name">{{!item.categoryId ? '待分类 ' + uncategorized.transactionCount + '笔' : item.name}}</text><view wx:if="{{!item.categoryId}}" class="ranking-unclassified-arrow" aria-hidden="true"></view></view><text class="ranking-amount money-number">{{item.amountText}} · {{item.shareText}}</text></view>
        </view>
      </block>
      <text wx:else class="composition-empty">这个月还没有{{categoryKind === 'expense' ? '支出' : '收入'}}。</text>
      <text wx:if="{{categoryKind === 'expense' ? charts.expenseRing.hasNegative : charts.incomeRing.hasNegative}}" class="ring-footnote">占比按正净额分类合计计算，退款抵减为负的分类单列。</text>
    </view>
  </view>

  <view class="section-heading content-inset">
    <view><text class="section-title serif-title">近六个月</text></view>
    <view class="chart-legend"><text class="legend-income">收入</text><text class="legend-expense">支出</text></view>
  </view>
  <view class="graph-surface">
    <view class="trend-selection" wx:if="{{selectedTrend}}">
      <text class="trend-selected-month">{{selectedTrend.monthLabel}}</text>
      <view class="trend-selection-values"><view><text class="trend-value-label">收入</text><text class="income-color money-number">{{selectedTrend.incomeText}}</text></view><view><text class="trend-value-label">支出</text><text class="expense-color money-number">{{selectedTrend.expenseText}}</text></view></view>
    </view>
    <view class="graph-scale"><text>上限 {{charts.monthlyChart.maxText}}</text><text>下限 {{charts.monthlyChart.minText}}</text></view>
    <view class="graph-image-wrap"><image class="graph-image" src="{{charts.monthlyChart.src}}" mode="scaleToFill" aria-label="近六个月收支柱状图" />
      <view class="graph-hit"><view wx:for="{{cashFlowTrend}}" wx:key="month" class="graph-hit-column {{selectedTrend.month === item.month ? 'graph-month-selected' : ''}}" bindtap="selectTrend" data-index="{{index}}" aria-role="button" aria-label="{{item.month}}，收入{{item.incomeText}}，支出{{item.expenseText}}"></view></view>
    </view>
    <view class="graph-axis"><text wx:for="{{cashFlowTrend}}" wx:key="month" class="{{selectedTrend.month === item.month ? 'axis-month-selected' : ''}}">{{item.monthText}}月</text></view>
  </view>

  <view class="section-heading content-inset"><text class="section-title">支出日历</text><text class="section-note">颜色越深，净支出越多</text></view>
  <view class="graph-surface calendar-surface">
    <view class="calendar-grid"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text></view>
    <view class="calendar-grid"><view wx:for="{{charts.calendar}}" wx:key="key" class="calendar-cell {{item.blank ? 'calendar-blank' : 'heat-' + item.level}}" bindtap="selectDay" data-index="{{item.index}}" aria-role="button" aria-label="{{item.blank ? '' : item.date + '净支出' + item.expenseText}}"><text>{{item.dayText}}</text></view></view>
    <view class="chart-detail"><text wx:if="{{selectedDay}}">{{selectedDay.date}} · 净支出 {{selectedDay.expenseText}}</text><text wx:else>点击日期查看金额；绿色表示当天退款抵减后净支出为负。</text></view>
  </view>




  </block>
  <view wx:if="{{errorMessage && !categorySheetOpen}}" class="statistics-error content-inset" bindtap="loadStatistics">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{categorySheetOpen}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeCategoryCompletion"></view>
    <view class="category-sheet">
      <view class="sheet-handle"></view>
      <button class="sheet-close-button" bindtap="closeCategoryCompletion" disabled="{{categorySaving}}" aria-label="关闭分类面板">关闭</button>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view>
      <block wx:if="{{!selectedCategoryGroup}}">
        <text class="sheet-title serif-title">补全待分类账目</text><text class="sheet-copy">相同来源和交易特征已归为一组，一次选择即可整组补全。</text>
        <view wx:if="{{categorySheetLoading}}" class="sheet-status">正在整理待分类账目…</view>
        <view wx:elif="{{categoryGroups.length}}" class="category-group-list">
          <button wx:for="{{categoryGroups}}" wx:key="groupKey" class="category-group-row" data-key="{{item.groupKey}}" bindtap="selectCategoryGroup"><view class="category-group-copy"><text class="category-group-title">{{item.title}}</text><text class="category-group-meta">{{item.kindLabel}} · {{item.count}} 笔</text></view><text class="category-group-amount money-number">{{item.amountText}}</text><view class="row-chevron"></view></button>
        </view>
        <view wx:else class="sheet-empty">这个月的分类已经完整。</view>
      </block>
      <block wx:else>
        <button class="sheet-back" disabled="{{categorySaving}}" bindtap="returnToCategoryGroups">返回待分类账目</button><text class="sheet-kicker">{{selectedCategoryGroup.kindLabel}}分类</text><text class="sheet-title serif-title">{{selectedCategoryGroup.title}}</text><text class="sheet-copy">本组 {{selectedCategoryGroup.count}} 笔，共 {{selectedCategoryGroup.amountText}}</text>
        <view class="category-option-grid"><button wx:for="{{categoryOptions}}" wx:key="id" class="category-option {{selectedCategoryId === item.id ? 'category-option-selected' : ''}}" data-id="{{item.id}}" bindtap="selectCompletionCategory" disabled="{{categorySaving}}">{{item.name}}</button></view>
        <button class="primary-button sheet-save" disabled="{{!selectedCategoryId || categorySaving}}" loading="{{categorySaving}}" bindtap="saveCategoryCompletion">保存分类</button>
      </block>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
