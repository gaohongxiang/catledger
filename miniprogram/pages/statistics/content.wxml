<view class="page-canvas statistics-page {{themeClass}}" style="{{themeStyle}}">
  <view wx:if="{{chargeSyncMessage}}" class="charge-sync-note">{{chargeSyncMessage}}；可下拉刷新，或在贷款详情继续同步。</view>
  <view class="stats-head">
    <text class="stats-head-title">收支统计</text>
    <text class="stats-head-sep">·</text>
    <text class="stats-head-year">{{monthYear}}年</text>
  </view>
  <scroll-view class="month-strip" scroll-x show-scrollbar="{{false}}">
    <view class="month-strip-inner">
      <view wx:for="{{monthOptions}}" wx:key="value" class="month-chip {{item.value === month ? 'month-chip-active' : ''}}" role="button" data-value="{{item.value}}" bindtap="pickMonth" aria-label="切换到 {{item.year}}年{{item.month}}月">{{item.month}}月</view>
    </view>
  </scroll-view>

  <view wx:if="{{errorMessage && !categorySheetOpen}}" class="statistics-error content-inset" bindtap="loadStatistics">{{errorMessage}} · 点此重试</view>
  <view class="inline-sync stats-sync {{loading ? 'inline-sync-active' : ''}}" aria-role="status" aria-label="{{loading ? '正在更新' : ''}}"><view class="inline-sync-icon"></view></view>

  <view class="hero-card">
    <text class="hero-label">{{summaryScopeAll ? '累计结余' : '本月结余'}}</text>
    <text class="hero-amount money-number {{netTone}}">{{hasLoaded ? netText : '—'}}</text>
    <view class="hero-split">
      <view class="hero-side">
        <text class="hero-side-label">收入</text>
        <text class="hero-side-value money-number income-color">{{hasLoaded ? incomeText : '—'}}</text>
        <view wx:if="{{hasLoaded && (metricsView.incomeVsPrevious || metricsView.incomeVsLastYear)}}" class="hero-side-cmp">
          <text wx:if="{{metricsView.incomeVsPrevious}}" class="cmp cmp-{{metricsView.incomeVsPrevious.tone}}">环比{{metricsView.incomeVsPrevious.arrow}}{{metricsView.incomeVsPrevious.text}}</text>
          <text wx:if="{{metricsView.incomeVsLastYear}}" class="cmp cmp-{{metricsView.incomeVsLastYear.tone}}">同比{{metricsView.incomeVsLastYear.arrow}}{{metricsView.incomeVsLastYear.text}}</text>
        </view>
      </view>
      <view class="hero-side-divider"></view>
      <view class="hero-side">
        <text class="hero-side-label">支出</text>
        <text class="hero-side-value money-number expense-color">{{hasLoaded ? expenseText : '—'}}</text>
        <view wx:if="{{hasLoaded && (metricsView.expenseVsPrevious || metricsView.expenseVsLastYear)}}" class="hero-side-cmp">
          <text wx:if="{{metricsView.expenseVsPrevious}}" class="cmp cmp-{{metricsView.expenseVsPrevious.tone}}">环比{{metricsView.expenseVsPrevious.arrow}}{{metricsView.expenseVsPrevious.text}}</text>
          <text wx:if="{{metricsView.expenseVsLastYear}}" class="cmp cmp-{{metricsView.expenseVsLastYear.tone}}">同比{{metricsView.expenseVsLastYear.arrow}}{{metricsView.expenseVsLastYear.text}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{hasLoaded}}" class="hero-metrics">
      <view class="hero-metric"><text class="hero-metric-v money-number">{{metricsView.transactionCount}}</text><text class="hero-metric-l">笔</text></view>
      <view class="hero-metric-dot"></view>
      <view class="hero-metric"><text class="hero-metric-l">日均支出</text><text class="hero-metric-v money-number">{{metricsView.averageDailyExpenseText}}</text></view>
      <view class="hero-metric-dot"></view>
      <view class="hero-metric"><text class="hero-metric-l">单笔最大</text><text class="hero-metric-v money-number">{{metricsView.largestExpenseText}}</text></view>
    </view>
  </view>

  <ui-state wx:if="{{!loggedIn}}" centered title="登录后查看收支统计"><button class="guest-login-button" size="mini" bindtap="promptLogin"><text class="guest-login-label">登录</text></button></ui-state>
  <skeleton-rows wx:elif="{{!hasLoaded && !errorMessage}}" rows="{{5}}" />
  <block wx:if="{{hasLoaded}}">
  <section-header class="stats-section" compact title="收支构成" />
  <view class="compose-card">
    <view class="segmented">
      <view class="segmented-item {{compositionKind === 'expense' ? 'segmented-active' : ''}}" role="button" data-kind="expense" bindtap="selectCompositionKind">支出</view>
      <view class="segmented-item {{compositionKind === 'income' ? 'segmented-active' : ''}}" role="button" data-kind="income" bindtap="selectCompositionKind">收入</view>
      <view class="segmented-item {{compositionKind === 'calendar' ? 'segmented-active' : ''}}" role="button" data-kind="calendar" bindtap="selectCompositionKind">日历</view>
    </view>
    <view wx:if="{{compositionKind !== 'calendar'}}" class="compose-body">
      <image wx:if="{{compositionKind === 'expense' ? rings.expense.src : rings.income.src}}" class="compose-ring" src="{{compositionKind === 'expense' ? rings.expense.src : rings.income.src}}" mode="aspectFit" aria-label="{{compositionKind === 'expense' ? '支出' : '收入'}}构成环图" />
      <view wx:else class="compose-ring compose-ring-empty">暂无数据</view>
      <view class="compose-legend">
        <view wx:for="{{compositionKind === 'expense' ? rings.expense.legend : rings.income.legend}}" wx:key="name" class="legend-item">
          <view class="legend-dot" style="background: {{item.color}};"></view>
          <text class="legend-name">{{item.name}}</text>
          <view class="legend-meta"><text class="legend-amount money-number">{{item.amountText}}</text><text class="legend-share">{{item.shareText}}</text><text wx:if="{{item.delta}}" class="legend-delta delta-{{item.delta.tone}}">{{item.delta.text}}</text></view>
        </view>
        <text wx:if="{{(compositionKind === 'expense' ? rings.expense.legend.length : rings.income.legend.length) === 0}}" class="legend-empty">这个月还没有{{compositionKind === 'expense' ? '支出' : '收入'}}。</text>
      </view>
    </view>
    <view wx:else class="compose-calendar">
      <view class="calendar-grid"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text></view>
      <view class="calendar-grid"><view wx:for="{{charts.calendar}}" wx:key="key" class="calendar-cell {{item.blank ? 'calendar-blank' : item.tone + ' heat-' + item.level}} {{item.today ? 'calendar-cell-today' : ''}}" bindtap="selectDay" data-index="{{item.index}}" aria-role="button" aria-label="{{item.blank ? '' : item.ariaText}}"><text>{{item.dayText}}</text><view wx:if="{{item.hasIncome && item.hasExpense}}" class="calendar-dot calendar-dot-both"></view><view wx:elif="{{item.hasIncome}}" class="calendar-dot calendar-dot-income"></view></view></view>
      <view wx:if="{{selectedDay}}" class="calendar-detail">
        <text class="calendar-detail-date">{{selectedDay.date}}</text>
        <view class="calendar-detail-row"><text class="cd-label">收入</text><text class="cd-value income-color money-number">{{selectedDay.incomeText}}</text></view>
        <view class="calendar-detail-row"><text class="cd-label">支出</text><text class="cd-value expense-color money-number">{{selectedDay.expenseText}}</text></view>
        <view class="calendar-detail-row"><text class="cd-label">净额</text><text class="cd-value money-number">{{selectedDay.netText}}</text></view>
      </view>
      <view wx:else class="chart-detail"><text>点日期看当天收支 · 绿=净收入 金=净支出</text></view>
    </view>
  </view>

  <section-header class="stats-section" compact title="近六个月"><view class="chart-legend"><text class="legend-income">收入</text><text class="legend-expense">支出</text></view></section-header>
  <view class="graph-surface">
    <view class="trend-selection" wx:if="{{selectedTrend}}">
      <text class="trend-selected-month">{{selectedTrend.monthLabel}}</text>
      <view class="trend-selection-values"><view><text class="trend-value-label">收入</text><text class="income-color money-number">{{selectedTrend.incomeText}}</text></view><view><text class="trend-value-label">支出</text><text class="expense-color money-number">{{selectedTrend.expenseText}}</text></view></view>
    </view>
    <view class="graph-scale"><text>上限 {{charts.monthlyChart.maxText}}</text><text>下限 {{charts.monthlyChart.minText}}</text></view>
    <view class="graph-image-wrap"><image class="graph-image" src="{{charts.monthlyChart.src}}" mode="scaleToFill" aria-label="近六个月收支柱状图" />
      <view class="graph-hit"><view wx:for="{{cashFlowTrend}}" wx:key="month" class="graph-hit-column" bindtap="selectTrend" data-index="{{index}}" aria-role="button" aria-label="{{item.month}}，收入{{item.incomeText}}，支出{{item.expenseText}}"></view></view>
    </view>
    <view class="graph-axis"><text wx:for="{{cashFlowTrend}}" wx:key="month" class="{{selectedTrend.month === item.month ? 'axis-month-selected' : ''}}">{{item.monthText}}月</text></view>
  </view>





  <view wx:if="{{hasLoaded && liabilityView.hasLiabilities}}" class="liability-block">
    <section-header class="stats-section" compact title="负债与分期"><text class="section-note">当前时点</text></section-header>
    <view class="liability-card">
      <view class="liability-group-title"><text>负债占比</text><text class="liability-group-total">合计 {{liabilityView.debtTotalText}}</text></view>
      <view class="liability-ring-row">
        <image wx:if="{{liabilityView.debtRing && !liabilityView.debtRing.empty}}" class="liability-ring" src="{{liabilityView.debtRing.src}}" mode="aspectFit" aria-label="负债占比环图" />
        <view class="liability-legend">
          <view wx:for="{{liabilityView.debtRing.legend}}" wx:key="name" class="liability-legend-row">
            <view class="liability-legend-dot" style="background: {{item.color}};"></view>
            <text class="liability-legend-name">{{item.name}}</text>
            <text class="liability-legend-share">{{item.shareText}}</text>
            <text class="liability-legend-amount money-number">{{item.amountText}}</text>
          </view>
        </view>
      </view>
      <block wx:if="{{liabilityView.hasInterest}}">
        <view class="liability-divider"></view>
        <view class="liability-group-title"><text>分期利息</text><text class="liability-group-total">全期合计 {{liabilityView.interestTotalText}}</text></view>
        <view class="liability-interest-note">含已还期次；已还 {{liabilityView.paidInterestTotalText}} · 待付 {{liabilityView.unpaidInterestTotalText}}</view>
        <view class="liability-ring-row">
          <image wx:if="{{liabilityView.interestRing && !liabilityView.interestRing.empty}}" class="liability-ring" src="{{liabilityView.interestRing.src}}" mode="aspectFit" aria-label="分期利息占比环图" />
          <view class="liability-legend">
            <view wx:for="{{liabilityView.interestRing.legend}}" wx:key="name" class="liability-legend-row">
              <view class="liability-legend-dot" style="background: {{item.color}};"></view>
              <text class="liability-legend-name">{{item.name}}</text>
              <text class="liability-legend-share">{{item.shareText}}</text>
              <text class="liability-legend-amount money-number">{{item.amountText}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
  </block>
  <view wx:if="{{errorMessage && !categorySheetOpen}}" class="statistics-error content-inset" bindtap="loadStatistics">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{categorySheetOpen}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeCategoryCompletion"></view>
    <view class="category-sheet">
      <view class="sheet-handle"></view>
      <button class="sheet-close-button" bindtap="closeCategoryCompletion" disabled="{{categorySaving}}" aria-label="关闭分类面板">关闭</button>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view>
      <block wx:if="{{!selectedCategoryGroup}}">
        <text class="sheet-title serif-title">补全待分类账目</text><text class="sheet-copy">相同来源和交易特征已归为一组，一次选择即可整组补全。</text>
        <view wx:if="{{categorySheetLoading}}" class="sheet-status">正在整理待分类账目…</view>
        <view wx:elif="{{categoryGroups.length}}" class="category-group-list">
          <list-row wx:for="{{categoryGroups}}" wx:key="groupKey" title="{{item.title}}" note="{{item.kindLabel}} · {{item.count}} 笔" divider="{{false}}" data-key="{{item.groupKey}}" bindtap="selectCategoryGroup"><text class="category-group-amount money-number">{{item.amountText}}</text></list-row>
        </view>
        <view wx:else class="sheet-empty">这个月的分类已经完整。</view>
      </block>
      <block wx:else>
        <button class="sheet-back" disabled="{{categorySaving}}" bindtap="returnToCategoryGroups">返回待分类账目</button><text class="sheet-kicker">{{selectedCategoryGroup.kindLabel}}分类</text><text class="sheet-title serif-title">{{selectedCategoryGroup.title}}</text><text class="sheet-copy">本组 {{selectedCategoryGroup.count}} 笔，共 {{selectedCategoryGroup.amountText}}</text>
        <category-picker class="category-picker-control" range="{{categoryOptions}}" value="{{completionCategoryIndex}}" bindchange="selectCompletionCategory" disabled="{{categorySaving}}"><view class="completion-category-trigger">{{completionCategoryIndex >= 0 ? categoryOptions[completionCategoryIndex].name : '选择大类或子类'}}<chevron-icon direction="down" size="{{24}}" /></view></category-picker>
        <button class="primary-button primary-button-medium sheet-save" disabled="{{!selectedCategoryId || categorySaving}}" loading="{{categorySaving}}" bindtap="saveCategoryCompletion">保存分类</button>
      </block>
    </view>
  </view>
</view>
