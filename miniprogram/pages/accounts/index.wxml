<view class="page-canvas page-secondary account-page {{themeClass}}" style="{{themeStyle}}">
  <page-head has-actions class="content-inset" title="账户总览" copy="资产和负债分开核对；点开账户可校正余额或停用。">
    <view class="heading-with-sync"><view class="inline-sync {{loading ? 'inline-sync-active' : ''}}" aria-role="status" aria-label="{{loading ? '正在更新' : ''}}"><view class="inline-sync-icon"></view></view></view>
    <button size="mini" class="head-cta" bindtap="openCreate" aria-label="新建账户"><view class="head-cta-label"><image src="/assets/icons/plus-on-accent.svg" mode="aspectFit" /><text>新建账户</text></view></button>
  </page-head>

  <skeleton-rows wx:if="{{loading && !hasLoaded}}" rows="{{3}}" />
  <view class="wealth-summary">
    <view class="wealth-primary content-inset"><text class="wealth-label">净资产</text><text class="wealth-value money-number {{totals.netWorthTone}}">{{hasLoaded ? totals.netWorthText : '—'}}</text><text class="wealth-caption">全部活动账户的账面合计</text></view>
    <view class="wealth-breakdown content-inset"><view><text>资产合计</text><text class="money-number">{{hasLoaded ? totals.assetsText : '—'}}</text></view><view><text>待还负债</text><text class="money-number liability-balance">{{hasLoaded ? totals.liabilitiesText : '—'}}</text></view></view>
  </view>

  <view wx:if="{{assets.length > 0}}" class="account-group">
    <view class="group-heading content-inset"><view class="group-title-wrap"><view class="group-mark asset-mark" aria-hidden="true"></view><text class="group-title serif-title">资产账户</text><text class="group-count money-number">{{assets.length}}</text></view><text wx:if="{{assetCorrectionCount > 0}}" class="group-alert">{{assetCorrectionCount}} 个待校正</text></view>
    <view class="account-list">
      <view wx:for="{{assets}}" wx:key="accountId" class="account-row row-enter" style="animation-delay: {{index < 10 ? index * 70 : 700}}ms" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看账户 {{item.name}}">
        <view class="account-type-icon"><image src="{{themeIconRoot}}/{{item.iconPath}}" mode="aspectFit" /></view>
        <view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}}</text></view>
        <view class="account-row-end"><text class="account-row-balance money-number {{item.amountTone}}">{{item.balanceText}}</text><text class="account-row-state {{item.stateTone}}">{{item.stateText}}</text></view>
        <view class="account-row-edit" data-id="{{item.accountId}}" catchtap="openRename" aria-role="button" aria-label="修改 {{item.name}} 名称"><image class="account-row-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view>
        <view class="account-row-edit" data-id="{{item.accountId}}" catchtap="archive" aria-role="button" aria-label="停用 {{item.name}}"><image class="account-row-edit-icon" src="/assets/icons/trash.svg" mode="aspectFit" /></view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasLoaded}}" class="account-group liability-group">
    <view class="group-heading content-inset"><view class="group-title-wrap"><view class="group-mark liability-mark" aria-hidden="true"></view><text class="group-title serif-title">负债账户</text><text class="group-count money-number">{{liabilities.length}}</text></view><text class="group-note">按待还金额汇总负债</text></view>
    <view class="account-list">
      <view class="account-row" bindtap="openAllLoans" hover-class="account-row-active" role="button" aria-label="全部贷款与还款"><view class="account-row-main"><text class="account-row-name">全部贷款与还款</text><text class="account-row-type">跨账户查看贷款和待关联还款</text></view><chevron-icon size="{{26}}" /></view>
      <view wx:for="{{liabilities}}" wx:key="accountId" class="account-row row-enter" style="animation-delay: {{index < 10 ? index * 70 : 700}}ms" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看账户 {{item.name}}">
        <view class="account-type-icon"><image src="{{themeIconRoot}}/{{item.iconPath}}" mode="aspectFit" /></view>
        <view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}}</text></view>
        <view class="account-row-end"><text class="account-row-balance money-number {{item.amountTone}}">{{item.balanceText}}</text><text class="account-row-state {{item.stateTone}}">{{item.stateText}}</text></view>
        <view class="account-row-edit" data-id="{{item.accountId}}" catchtap="openRename" aria-role="button" aria-label="修改 {{item.name}} 名称"><image class="account-row-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view>
        <view class="account-row-edit" data-id="{{item.accountId}}" catchtap="archive" aria-role="button" aria-label="停用 {{item.name}}"><image class="account-row-edit-icon" src="/assets/icons/trash.svg" mode="aspectFit" /></view>
      </view>
    </view>
  </view>

  <view wx:if="{{archivedAccounts.length > 0}}" class="account-group archived-group">
    <view class="archived-toggle content-inset" bindtap="toggleArchived" hover-class="account-row-active" role="button" aria-label="{{archivedExpanded ? '收起' : '展开'}}已停用账户"><view><text class="group-title serif-title">已停用账户</text><text class="archived-note">历史账目仍然保留</text></view><view class="archived-toggle-end"><text class="money-number">{{archivedAccounts.length}}</text><chevron-icon direction="{{archivedExpanded ? 'down' : 'right'}}" size="{{24}}" /></view></view>
    <view wx:if="{{archivedExpanded}}" class="archived-list">
      <view wx:for="{{archivedAccounts}}" wx:key="accountId" class="account-row account-row-archived row-enter" style="animation-delay: {{index < 10 ? index * 70 : 700}}ms" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看已停用账户 {{item.name}}"><view class="account-type-icon"><image src="{{themeIconRoot}}/{{item.iconPath}}" mode="aspectFit" /></view><view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}} · 历史保留</text></view><text class="account-row-balance money-number">{{item.balanceText}}</text><chevron-icon size="{{26}}" /></view>
    </view>
  </view>

  <empty-state wx:if="{{assets.length === 0 && liabilities.length === 0 && hasLoaded && !loading && !errorMessage}}" title="先创建第一个账户" description="填写现在的余额，系统会把它记成余额起点，不算作收入或支出。"><button class="primary-button primary-button-medium account-empty-action" bindtap="openCreate">创建账户</button></empty-state>
  <view wx:if="{{errorMessage && !formOpen}}" class="account-error content-inset" bindtap="loadAccounts">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{formOpen}}" class="sheet-mask" bindtap="closeForm">
    <view class="account-sheet" catchtap="stopBubble">
      <view class="sheet-handle"></view><text class="sheet-kicker">账户编辑</text><text class="sheet-title serif-title">{{formTitle}}</text>
      <picker wx:if="{{formMode === 'create'}}" mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="changeType" disabled="{{saving}}"><view class="sheet-field"><text>账户类型</text><text class="sheet-value">{{typeOptions[typeIndex].label}}</text></view></picker>
      <view wx:if="{{formMode !== 'correct'}}" class="sheet-field"><text>账户名称</text><input class="sheet-input" value="{{name}}" maxlength="32" placeholder="例如：日常银行卡" bindinput="bindName" aria-label="账户名称" cursor-spacing="32" disabled="{{saving}}" /></view>
      <view wx:if="{{formMode !== 'rename'}}" class="sheet-field"><text>{{formMode === 'create' ? '当前余额' : '正确余额'}}</text><input class="sheet-input money-number" type="digit" value="{{balanceYuan}}" placeholder="0.00" maxlength="18" bindinput="bindBalance" aria-label="账户余额（元）" cursor-spacing="32" disabled="{{saving}}" /></view>
      <text wx:if="{{formMode === 'correct'}}" class="sheet-note">系统会新增一笔差额调整，不改写旧交易，也不计入收支。</text>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view><button class="primary-button primary-button-medium sheet-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveForm">保存</button><button class="secondary-button sheet-cancel" disabled="{{saving}}" bindtap="closeForm">取消</button>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
