<view class="page-canvas account-page {{themeClass}}" style="{{themeStyle}}">
  <view class="account-heading">
    <view><text class="account-kicker">ACCOUNT BOOK</text><text class="account-title serif-title">账户总览</text></view>
    <button class="create-account-button" bindtap="openCreate" hover-class="create-account-active" aria-label="新建账户"><view class="create-plus" aria-hidden="true"></view><text>新建</text></button>
  </view>

  <view class="wealth-summary">
    <view class="wealth-primary"><text class="wealth-label">净资产</text><text class="wealth-value money-number {{totals.netWorthTone}}">{{totals.netWorthText}}</text><text class="wealth-caption">全部活动账户的账面合计</text></view>
    <view class="wealth-breakdown"><view><text>资产合计</text><text class="money-number">{{totals.assetsText}}</text></view><view><text>待还负债</text><text class="money-number liability-balance">{{totals.liabilitiesText}}</text></view></view>
  </view>

  <view wx:if="{{assets.length > 0}}" class="account-group">
    <view class="group-heading"><view class="group-title-wrap"><view class="group-mark asset-mark" aria-hidden="true"></view><text class="group-title serif-title">资产账户</text><text class="group-count money-number">{{assets.length}}</text></view><text wx:if="{{assetCorrectionCount > 0}}" class="group-alert">{{assetCorrectionCount}} 个待校正</text></view>
    <view class="account-list">
      <view wx:for="{{assets}}" wx:key="accountId" class="account-row" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看账户 {{item.name}}">
        <view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}}</text></view>
        <view class="account-row-end"><text class="account-row-balance money-number {{item.amountTone}}">{{item.balanceText}}</text><text class="account-row-state {{item.stateTone}}">{{item.stateText}}</text></view>
        <view class="row-chevron" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{liabilities.length > 0}}" class="account-group liability-group">
    <view class="group-heading"><view class="group-title-wrap"><view class="group-mark liability-mark" aria-hidden="true"></view><text class="group-title serif-title">负债账户</text><text class="group-count money-number">{{liabilities.length}}</text></view><text class="group-note">仅红色金额计入待还</text></view>
    <view class="account-list">
      <view wx:for="{{liabilities}}" wx:key="accountId" class="account-row" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看账户 {{item.name}}">
        <view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}}</text></view>
        <view class="account-row-end"><text class="account-row-balance money-number {{item.amountTone}}">{{item.balanceText}}</text><text class="account-row-state {{item.stateTone}}">{{item.stateText}}</text></view><view class="row-chevron" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{archivedAccounts.length > 0}}" class="account-group archived-group">
    <view class="archived-toggle" bindtap="toggleArchived" hover-class="account-row-active" role="button" aria-label="{{archivedExpanded ? '收起' : '展开'}}已停用账户"><view><text class="group-title serif-title">已停用账户</text><text class="archived-note">历史账目仍然保留</text></view><view class="archived-toggle-end"><text class="money-number">{{archivedAccounts.length}}</text><view class="toggle-chevron {{archivedExpanded ? 'toggle-chevron-open' : ''}}" aria-hidden="true"></view></view></view>
    <view wx:if="{{archivedExpanded}}" class="archived-list">
      <view wx:for="{{archivedAccounts}}" wx:key="accountId" class="account-row account-row-archived" data-id="{{item.accountId}}" bindtap="openAccountDetail" hover-class="account-row-active" role="button" aria-label="查看已停用账户 {{item.name}}"><view class="account-row-main"><text class="account-row-name">{{item.name}}</text><text class="account-row-type">{{item.typeLabel}} · 历史保留</text></view><text class="account-row-balance money-number">{{item.balanceText}}</text><view class="row-chevron" aria-hidden="true"></view></view>
    </view>
  </view>

  <view wx:if="{{assets.length === 0 && liabilities.length === 0 && !loading}}" class="empty-ledger account-empty"><text class="empty-ledger-title">先创建第一个账户</text><text class="empty-ledger-copy">填写现在的余额，系统会把它记成余额起点，不算作收入或支出。</text><button class="primary-button account-empty-action" bindtap="openCreate">创建账户</button></view>
  <view wx:if="{{loading}}" class="account-status">正在核对账户…</view>
  <view wx:if="{{errorMessage && !formOpen && !accountDetail}}" class="account-error" bindtap="loadAccounts">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{accountDetail}}" class="sheet-mask" bindtap="closeAccountDetail">
    <view class="account-sheet detail-sheet" catchtap="stopBubble">
      <view class="sheet-handle"></view>
      <view class="sheet-topline"><text class="sheet-kicker">账户详情</text><button class="sheet-close-button" bindtap="closeAccountDetail">关闭</button></view>
      <text class="sheet-title serif-title">{{accountDetail.name}}</text>
      <view class="detail-balance"><text>{{accountDetail.balanceLabel}}</text><text class="money-number {{accountDetail.amountTone}}">{{accountDetail.balanceText}}</text></view>
      <view class="detail-meta"><text>{{accountDetail.typeLabel}}</text><text>{{accountDetail.archived ? '已停用' : accountDetail.stateText}}</text></view>
      <view wx:if="{{accountDetail.needsCorrection}}" class="correction-callout"><text>待校正</text><text>资产账户出现负数，通常表示期初余额或漏记交易需要核对。</text></view>
      <view wx:if="{{!accountDetail.archived}}" class="detail-action-list">
        <view class="detail-action-row detail-action-primary" data-id="{{accountDetail.accountId}}" bindtap="openCorrection" hover-class="detail-action-active" role="button" aria-label="校正账户余额"><view><text class="detail-action-name">校正余额</text><text class="detail-action-note">按实际余额补记差额</text></view><view class="detail-action-chevron" aria-hidden="true"></view></view>
        <view class="detail-action-row" data-id="{{accountDetail.accountId}}" bindtap="openRename" hover-class="detail-action-active" role="button" aria-label="修改账户名称"><view><text class="detail-action-name">修改名称</text><text class="detail-action-note">只修改账户显示名称</text></view><view class="detail-action-chevron" aria-hidden="true"></view></view>
        <view class="detail-action-row detail-action-danger" data-id="{{accountDetail.accountId}}" bindtap="archive" hover-class="detail-action-active" role="button" aria-label="停用账户"><view><text class="detail-action-name">停用账户</text><text class="detail-action-note">历史账目和余额仍会保留</text></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{formOpen}}" class="sheet-mask" bindtap="closeForm">
    <view class="account-sheet" catchtap="stopBubble">
      <view class="sheet-handle"></view><text class="sheet-kicker">ACCOUNT FORM</text><text class="sheet-title serif-title">{{formTitle}}</text>
      <picker wx:if="{{formMode === 'create'}}" mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="changeType"><view class="sheet-field"><text>账户类型</text><text class="sheet-value">{{typeOptions[typeIndex].label}}</text></view></picker>
      <view wx:if="{{formMode !== 'correct'}}" class="sheet-field"><text>账户名称</text><input class="sheet-input" value="{{name}}" maxlength="32" placeholder="例如：日常银行卡" bindinput="bindName" /></view>
      <view wx:if="{{formMode !== 'rename'}}" class="sheet-field"><text>{{formMode === 'create' ? '当前余额' : '正确余额'}}</text><input class="sheet-input money-number" type="digit" value="{{balanceYuan}}" placeholder="0.00" maxlength="18" bindinput="bindBalance" /></view>
      <text wx:if="{{formMode === 'correct'}}" class="sheet-note">系统会新增一笔差额调整，不改写旧交易，也不计入收支。</text>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view><button class="primary-button sheet-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveForm">保存</button><button class="secondary-button sheet-cancel" disabled="{{saving}}" bindtap="closeForm">取消</button>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
