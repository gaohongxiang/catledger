.account-page { padding-top: 30rpx; padding-bottom: 48rpx; }
.account-heading, .group-heading, .group-title-wrap, .account-row, .archived-toggle, .wealth-primary, .wealth-breakdown, .create-account-button, .sheet-field, .detail-balance, .detail-meta, .sheet-topline, .detail-action-row { display: flex; }
.account-heading { align-items: flex-end; justify-content: space-between; }
.account-kicker, .sheet-kicker { display: block; color: var(--theme-secondary, #64705d); font-size: 18rpx; font-weight: 600; letter-spacing: 2rpx; }
.account-title { display: block; margin-top: 4rpx; font-size: 34rpx; font-weight: 650; line-height: 1.2; }
.create-account-button { box-sizing: border-box; width: auto; min-width: 128rpx; height: 88rpx; min-height: 88rpx; flex: 0 0 auto; align-items: flex-end; justify-content: flex-end; gap: 10rpx; margin: 0 -8rpx -17rpx 0; padding: 0 8rpx 18rpx 20rpx; color: var(--theme-accent-strong, #b95f21); font-size: 21rpx; font-weight: 600; line-height: 1; background: transparent; border: 0; border-radius: 0; }
.create-account-active { opacity: .58; }
.create-plus { position: relative; width: 18rpx; height: 18rpx; }
.create-plus::before, .create-plus::after { position: absolute; top: 8rpx; left: 1rpx; width: 16rpx; height: 2rpx; content: ''; background: currentColor; }
.create-plus::after { transform: rotate(90deg); }
.wealth-summary { margin-top: 34rpx; padding: 0 0 24rpx; background: transparent; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 0; }
.wealth-primary { display: block; }
.wealth-label, .wealth-caption, .wealth-value { display: block; }
.wealth-label { color: var(--theme-text-muted, #746a60); font-size: 20rpx; font-weight: 600; letter-spacing: 1rpx; }
.wealth-value { margin-top: 10rpx; font-size: 52rpx; font-weight: 650; line-height: 1.08; text-align: left; }
.wealth-caption { margin-top: 10rpx; color: var(--theme-text-subtle, #958b82); font-size: 17rpx; }
.wealth-breakdown { margin-top: 26rpx; padding-top: 20rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.wealth-breakdown > view { min-width: 0; flex: 1; }
.wealth-breakdown > view:last-child { padding-left: 24rpx; border-left: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.wealth-breakdown text { display: block; color: var(--theme-text-muted, #746a60); font-size: 18rpx; }
.wealth-breakdown .money-number { margin-top: 7rpx; color: var(--theme-ink, #29231e); font-size: 25rpx; font-weight: 650; }
.wealth-breakdown .liability-balance { color: var(--theme-expense, #b54738); }
.account-group { margin-top: 28rpx; }
.liability-group { margin-top: 36rpx; }
.group-heading { min-height: 56rpx; align-items: center; justify-content: space-between; gap: 20rpx; }
.group-title-wrap { min-width: 0; align-items: center; gap: 12rpx; }
.group-mark { width: 7rpx; height: 28rpx; flex: 0 0 7rpx; background: var(--theme-secondary, #64705d); border-radius: 4rpx; }
.liability-mark { background: var(--theme-expense, #b54738); }
.group-title { font-size: 26rpx; font-weight: 650; }
.group-count { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; color: var(--theme-text-muted, #746a60); font-size: 17rpx; line-height: 34rpx; text-align: center; background: var(--theme-surface, #fffdf9); border-radius: 17rpx; }
.group-alert, .group-note { color: var(--theme-danger, #a95132); font-size: 17rpx; white-space: nowrap; }
.group-note { color: var(--theme-text-subtle, #958b82); }
.account-list { overflow: hidden; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 18rpx; }
.account-row { position: relative; box-sizing: border-box; width: 100%; min-height: 112rpx; align-items: center; gap: 18rpx; padding: 18rpx 50rpx 18rpx 22rpx; color: var(--theme-ink, #29231e); background: transparent; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-row:last-child { border-bottom: 0; }
.account-row-active { background: var(--theme-accent-soft, #f5ddcb); }
.account-row-main { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.account-row-name { overflow: hidden; font-size: 24rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.account-row-type { margin-top: 7rpx; color: var(--theme-text-muted, #746a60); font-size: 18rpx; line-height: 1.25; }
.account-row-end { min-width: 154rpx; text-align: right; }
.account-row-balance { font-size: 24rpx; font-weight: 650; line-height: 1.25; }
.account-row-state { display: block; margin-top: 7rpx; color: var(--theme-text-subtle, #958b82); font-size: 17rpx; line-height: 1.2; }
.amount-liability, .amount-warning, .state-liability, .state-warning, .liability-balance { color: var(--theme-expense, #b54738); }
.amount-positive, .state-positive { color: var(--theme-income, #4f765f); }
.row-chevron { position: absolute; top: 49rpx; right: 22rpx; width: 11rpx; height: 11rpx; border-top: 3rpx solid var(--theme-text-subtle, #958b82); border-right: 3rpx solid var(--theme-text-subtle, #958b82); transform: rotate(45deg); }
.archived-group { padding-top: 8rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.archived-toggle { width: 100%; min-height: 88rpx; align-items: center; justify-content: space-between; color: var(--theme-ink, #29231e); }
.archived-note { display: block; margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 18rpx; }
.archived-toggle-end { display: flex; align-items: center; gap: 18rpx; color: var(--theme-text-subtle, #958b82); font-size: 20rpx; }
.toggle-chevron { width: 12rpx; height: 12rpx; border-right: 3rpx solid var(--theme-text-subtle, #958b82); border-bottom: 3rpx solid var(--theme-text-subtle, #958b82); transform: rotate(45deg); transition: transform 150ms ease; }
.toggle-chevron-open { transform: rotate(225deg); }
.archived-list { opacity: .72; }
.account-row-archived { min-height: 90rpx; }
.account-empty { margin-top: 32rpx; }
.account-empty-action { width: 220rpx; margin: 24rpx 0 0; }
.account-status, .account-error { min-height: 72rpx; margin-top: 16rpx; color: var(--theme-secondary, #64705d); font-size: 24rpx; line-height: 72rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-error { color: var(--theme-danger, #a95132); }
.sheet-mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; background: rgba(41, 35, 30, .38); }
.account-sheet { box-sizing: border-box; width: 100%; max-height: calc(100vh - 32rpx); overflow-y: auto; flex-shrink: 0; padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); background: var(--theme-surface, #fffdf9); border-radius: 28rpx 28rpx 0 0; }
.sheet-handle { width: 72rpx; height: 6rpx; margin: 0 auto 24rpx; background: var(--theme-line, #d7d0c6); border-radius: 4rpx; }
.sheet-topline { min-height: 56rpx; align-items: center; justify-content: space-between; }
.sheet-close-button { min-width: 88rpx; min-height: 56rpx; margin: 0 -14rpx 0 0; padding: 0 14rpx; color: var(--theme-text-muted, #746a60); font-size: 21rpx; line-height: 56rpx; text-align: right; background: transparent; border: 0; border-radius: 0; }
.sheet-close-button:active { opacity: .58; }
.sheet-title { display: block; margin: 6rpx 0 14rpx; font-size: 30rpx; font-weight: 650; }
.sheet-field { min-height: 92rpx; align-items: center; justify-content: space-between; color: var(--theme-text-muted, #746a60); font-size: 24rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.sheet-value { color: var(--theme-ink, #29231e); font-weight: 600; }
.sheet-input { width: 400rpx; height: 80rpx; color: var(--theme-ink, #29231e); font-size: 28rpx; text-align: right; }
.sheet-note { display: block; margin-top: 16rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; line-height: 1.6; }
.sheet-error { margin-top: 16rpx; color: var(--theme-danger, #a95132); font-size: 22rpx; }
.sheet-save { width: 100%; margin-top: 24rpx; }
.sheet-cancel { width: 100%; margin-top: 12rpx; }
.detail-balance { min-height: 94rpx; align-items: center; justify-content: space-between; margin-top: 8rpx; color: var(--theme-text-muted, #746a60); font-size: 21rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.detail-balance .money-number { color: var(--theme-ink, #29231e); font-size: 31rpx; font-weight: 650; }
.detail-balance .liability-balance { color: var(--theme-expense, #b54738); }
.detail-meta { min-height: 68rpx; align-items: center; justify-content: space-between; color: var(--theme-text-muted, #746a60); font-size: 20rpx; }
.correction-callout { padding: 16rpx 18rpx; color: var(--theme-danger, #a95132); background: var(--theme-danger-soft, #f4e1d6); border-left: 5rpx solid var(--theme-danger, #a95132); }
.correction-callout text { display: block; font-size: 20rpx; line-height: 1.5; }
.correction-callout text:first-child { font-weight: 650; }
.detail-action-list { margin-top: 18rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.detail-action-row { position: relative; min-height: 96rpx; align-items: center; justify-content: space-between; padding: 0 36rpx 0 2rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.detail-action-row:last-child { border-bottom: 0; }
.detail-action-active { background: var(--theme-surface-muted, #f3eee6); }
.detail-action-name, .detail-action-note { display: block; }
.detail-action-name { color: var(--theme-ink, #29231e); font-size: 24rpx; font-weight: 600; }
.detail-action-note { margin-top: 6rpx; color: var(--theme-text-muted, #746a60); font-size: 18rpx; }
.detail-action-primary .detail-action-name { color: var(--theme-accent-strong, #b95f21); }
.detail-action-danger .detail-action-name { color: var(--theme-danger, #a95132); }
.detail-action-chevron { position: absolute; top: 41rpx; right: 8rpx; width: 11rpx; height: 11rpx; border-top: 3rpx solid var(--theme-text-subtle, #958b82); border-right: 3rpx solid var(--theme-text-subtle, #958b82); transform: rotate(45deg); }
