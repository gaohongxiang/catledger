.account-page { padding-top: 30rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.group-heading, .group-title-wrap, .account-row, .archived-toggle, .wealth-primary, .wealth-breakdown, .sheet-field, .detail-balance, .detail-meta, .sheet-topline { display: flex; }
.account-kicker, .sheet-kicker {
  display: block;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.wealth-summary {
  margin-top: 24rpx;
  padding: 28rpx 12rpx 24rpx;
  background: var(--theme-surface);
  border-bottom: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
  border: 1rpx solid var(--theme-line);
}
.wealth-primary { display: block; }
.wealth-label, .wealth-caption, .wealth-value { display: block; }
.wealth-label {
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  letter-spacing: 0;
}
.wealth-value {
  margin-top: 10rpx;
  font-size: var(--font-display, 56rpx);
  font-weight: 500;
  line-height: 1.3;
  text-align: left;
  overflow-wrap: anywhere;
}
.wealth-caption { margin-top: 10rpx; color: var(--theme-text-subtle, #958b82); font-size: var(--font-caption, 24rpx); }
.wealth-breakdown { margin-top: 26rpx; padding-top: 20rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.wealth-breakdown > view { min-width: 0; flex: 1; }
.wealth-breakdown > view:last-child { padding-left: 24rpx; border-left: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.wealth-breakdown text { display: block; color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.wealth-breakdown .money-number {
  margin-top: 7rpx;
  color: var(--theme-ink, #29231e);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.wealth-breakdown .liability-balance { color: var(--theme-expense, #b54738); }
.account-group { margin-top: 28rpx; }
.liability-group { margin-top: 36rpx; }
.group-heading {
  min-height: 56rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.group-title-wrap { min-width: 0; align-items: center; gap: 12rpx; }
.group-mark {
  width: 7rpx;
  height: 28rpx;
  flex: 0 0 7rpx;
  background: var(--theme-secondary, #64705d);
  border-radius: var(--theme-radius-small, 12rpx);
}
.liability-mark { background: var(--theme-expense, #b54738); }
.group-title { font-size: var(--font-section, 32rpx); font-weight: 500; }
.group-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 34rpx;
  text-align: center;
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-medium, 18rpx);
}
.group-alert, .group-note { color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); white-space: nowrap; }
.group-note { color: var(--theme-text-subtle, #958b82); white-space: normal; }
.account-list {
  overflow: hidden;
  background: var(--theme-surface, #fffdf9);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
}
.account-row {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 116rpx;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  color: var(--theme-ink, #29231e);
  background: transparent;
  border-bottom: 1rpx solid var(--theme-line);
}
.account-row:last-child { border-bottom: 0; }
.account-row-active { background: var(--theme-accent-soft, #f0e2ce); }
.account-type-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  background: var(--theme-secondary-soft, #f4eee3);
  border-radius: var(--theme-radius-large, 24rpx);
}
.account-type-icon image { width: 36rpx; height: 36rpx; }
.account-row-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.account-row-name {
  overflow: hidden;
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
}
.account-row-type {
  margin-top: 7rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.25;
}
.account-row-end {
  min-width: 0;
  text-align: right;
  flex: 0 0 auto;
  max-width: 48%;
}
.account-row-balance {
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.account-row-state {
  display: block;
  margin-top: 7rpx;
  color: var(--theme-text-subtle, #958b82);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.2;
}
.amount-liability, .amount-warning, .state-liability, .state-warning, .liability-balance { color: var(--theme-expense, #b54738); }
.amount-positive, .state-positive { color: var(--theme-income, #4f765f); }
.archived-group { padding-top: 8rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.archived-toggle {
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--theme-ink, #29231e);
}
.archived-note {
  display: block;
  margin-top: 4rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
}
.archived-toggle-end {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: var(--theme-text-subtle, #958b82);
  font-size: var(--font-caption, 24rpx);
}
.archived-list {
  opacity: 1;
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
  overflow: hidden;
  background: var(--theme-surface);
}
.account-row-archived { min-height: 90rpx; }
.account-empty-action { width: 220rpx; margin: 24rpx 0 0; }
.account-status, .account-error {
  min-height: 72rpx;
  margin-top: 16rpx;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  line-height: 72rpx;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}
.account-error { color: var(--theme-danger, #a95132); }
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(41, 35, 30, .38);
}
.account-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: calc(92vh - env(safe-area-inset-top));
  overflow-y: auto;
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-xl, 32rpx) var(--theme-radius-xl, 32rpx) 0 0;
}
.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 24rpx;
  background: var(--theme-line, #d7d0c6);
  border-radius: var(--theme-radius-small, 12rpx);
}
.sheet-topline { min-height: 56rpx; align-items: center; justify-content: space-between; }
.account-sheet .sheet-close-button {
  width: auto;
  flex: none;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 -14rpx 0 0;
  padding: 0 14rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.5;
  text-align: right;
  background: transparent;
  border: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.sheet-close-button:active { opacity: .58; }
.sheet-title {
  display: block;
  margin: 6rpx 0 14rpx;
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.sheet-field {
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  border-top: 1rpx solid var(--theme-line);
  padding: 16rpx 0;
  gap: 12rpx;
  box-sizing: border-box;
  flex-wrap: wrap;
}
.sheet-value {
  color: var(--theme-ink, #29231e);
  font-weight: 400;
  max-width: 100%;
  overflow-wrap: anywhere;
}
.sheet-input {
  width: 100%;
  height: 88rpx;
  color: var(--theme-ink, #29231e);
  font-size: var(--font-body, 28rpx);
  text-align: left;
  box-sizing: border-box;
  border: 1rpx solid var(--theme-border);
  border-radius: var(--theme-radius-medium, 18rpx);
  padding: 0 20rpx;
  background: var(--theme-surface);
}
.sheet-note {
  display: block;
  margin-top: 16rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.6;
}
.sheet-error { margin-top: 16rpx; color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); }
.sheet-save { width: 100%; margin-top: 24rpx; }
.sheet-cancel { width: 100%; margin-top: 12rpx; }
.detail-balance {
  min-height: 94rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 22rpx 0;
}
.detail-balance .money-number {
  color: var(--theme-ink, #29231e);
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  overflow-wrap: anywhere;
  min-width: 0;
  max-width: 100%;
}
.detail-balance .liability-balance { color: var(--theme-expense, #b54738); }
.detail-meta {
  min-height: 68rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
}
.correction-callout {
  padding: 16rpx 18rpx;
  color: var(--theme-danger, #a95132);
  background: var(--theme-danger-soft, #f6e4d4);
  border-left: 5rpx solid var(--theme-danger, #a95132);
}
.correction-callout text { display: block; font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.correction-callout text:first-child { font-weight: 500; }
.detail-action-list { margin-top: 18rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }

.account-loans { margin: 20rpx 0; padding: 12rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.account-loans-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.account-loans-title { font-size: var(--font-section); font-weight: 500; }
.account-loans-heading .account-loans-add { display: flex; flex: none; align-items: center; justify-content: center; width: auto; min-height: 88rpx; margin: 0; padding: 0 12rpx; background: transparent; color: var(--theme-accent-strong); font-size: var(--font-body); line-height: 1.2; }
.account-loans-note { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.6; }
.account-loan-row { display: flex; align-items: center; gap: 16rpx; min-height: 104rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.account-loan-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.account-loan-amount { text-align: right; overflow-wrap: anywhere; max-width: 45%; }
.account-loans-error { padding: 20rpx 0; color: var(--theme-danger); font-size: var(--font-caption); }
