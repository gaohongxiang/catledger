.loan-detail { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.detail-kicker, .detail-title, .detail-muted, .principal-value, .form-note, .form-field > text { display: block; }
.detail-kicker, .detail-muted, .form-note { color: var(--theme-text-muted); font-size: var(--font-caption); }
.detail-title { font-size: var(--font-title); font-weight: 500; margin: 6rpx 0 28rpx; overflow-wrap: anywhere; }
.principal-panel { padding-top: 24rpx; border-top: 1rpx solid var(--theme-line); }
.principal-value { margin: 10rpx 0 12rpx; font-size: var(--font-display); overflow-wrap: anywhere; }
.detail-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-caption); }
.detail-row text:first-child { color: var(--theme-text-muted); flex-shrink: 0; }
.detail-row text:last-child { text-align: right; overflow-wrap: anywhere; }
.principal-panel button { margin-top: 28rpx; }
.form-note { line-height: 1.7; margin-bottom: 24rpx; }
.form-field { display: block; padding: 18rpx 0; }
.form-field > text { color: var(--theme-text-muted); margin-bottom: 12rpx; font-size: var(--font-caption); }
.form-field input, .picker-value { min-height: 88rpx; box-sizing: border-box; padding: 22rpx 20rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-small); font-size: var(--font-body); }
.loan-form .primary-button { margin-top: 28rpx; }
.schedule-section { margin-top: 16rpx; padding-top: 8rpx; border-top: 1rpx solid var(--theme-line); }
.schedule-section .section-title { display: block; margin: 20rpx 0 8rpx; font-size: var(--font-body); font-weight: 500; }
.detail-link { min-height: 88rpx; color: var(--theme-accent-strong); background: transparent; font-size: var(--font-caption); }

.loan-history { padding-top: 28rpx; }
.history-row { display: flex; justify-content: space-between; gap: 24rpx; text-align: left; padding: 24rpx 0; background: transparent; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-caption); line-height: 1.7; }
.history-row .money-number { overflow-wrap: anywhere; text-align: right; }
