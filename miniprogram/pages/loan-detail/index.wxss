.loan-detail { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.ld-heading { display: block; box-sizing: border-box; padding-left: var(--layout-content-inset, 20rpx); padding-right: var(--layout-content-inset, 20rpx); }
.ld-note-card { display: block; margin: 24rpx 0; padding: 24rpx; background: var(--theme-surface-muted); border-radius: var(--layout-radius-medium); }
.ld-note { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.7; }
.ld-note + .ld-note { margin-top: 12rpx; }
.ld-muted { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.6; }
.ld-panel { margin-top: 24rpx; padding: 28rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large); }
.ld-principal { display: block; margin: 10rpx 0 12rpx; font-size: var(--font-display); font-weight: 500; line-height: 1.2; overflow-wrap: anywhere; }
.ld-rows { margin-top: 20rpx; }
.ld-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-caption); }
.ld-row:last-child { border-bottom: 0; }
.ld-row text:first-child { color: var(--theme-text-muted); flex-shrink: 0; }
.ld-row text:last-child { text-align: right; overflow-wrap: anywhere; }
.ld-action { margin-top: 20rpx; }
.ld-form { margin-top: 8rpx; }
.ld-field { display: block; padding: 18rpx 0; }
.ld-field > text { display: block; color: var(--theme-text-muted); margin-bottom: 12rpx; font-size: var(--font-caption); }
.ld-input, .ld-picker { box-sizing: border-box; min-height: 88rpx; padding: 22rpx 24rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-medium); font-size: var(--font-body); }
.ld-picker { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.ld-picker-value { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.ld-schedule { margin-top: 16rpx; padding-top: 8rpx; border-top: 1rpx solid var(--theme-line); }
.ld-section-title { display: block; margin: 20rpx 0 8rpx; font-size: var(--font-section); font-weight: 500; }
.ld-link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 8rpx 0 0; padding: 12rpx 20rpx; background: transparent; color: var(--theme-accent-strong); font-size: var(--font-caption); }
.ld-history { margin-top: 28rpx; padding: 8rpx 28rpx 20rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large); }
.ld-history-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; width: 100%; margin: 0; padding: 24rpx 0; background: transparent; border-bottom: 1rpx solid var(--theme-line); text-align: left; font-size: var(--font-caption); line-height: 1.7; transition: opacity var(--layout-motion-fast) ease; }
.ld-history-hover { opacity: .72; }
.ld-history-row .ld-muted { margin-top: 4rpx; }
.ld-history-row .money-number { flex-shrink: 0; text-align: right; overflow-wrap: anywhere; }
.ld-history-main { min-width: 0; }
.ld-retry { margin-top: 20rpx; }
