<view wx:if="{{periodOpen}}" class="detail-guide-mask" bindtap="closeInstallment" catchtouchmove="stopGuideTap">
  <scroll-view scroll-y class="installment-sheet" catchtap="stopGuideTap">
    <view class="installment-sheet-head"><text>第 {{selectedPeriod.term || '—'}} 期</text><button bindtap="closeInstallment" disabled="{{saving}}">关闭</button></view>
    <ui-state wx:if="{{periodLoading}}" description="正在读取本期…" />
    <ui-state wx:if="{{periodError}}" error description="{{periodError}}" />
    <block wx:if="{{selectedPeriod}}">
      <text class="installment-note">{{selectedPeriod.date}} · {{selectedPeriod.state}}</text>
      <view class="installment-amounts"><view><text>应还</text><text>{{selectedPeriod.payment}}</text></view><view><text>本金</text><text>{{selectedPeriod.principal}}</text></view><view><text>利息 / 费</text><text class="detail-cost-ink">{{selectedPeriod.interestFee}}</text></view></view>
      <text wx:if="{{selectedPeriod.difference}}" class="installment-note">本期账单金额与方案不同。支出按账单金额记录，可在下方调整本期方案。</text>
      <text wx:if="{{selectedPeriod.completedByProgress}}" class="installment-note">按已确认进度完成，本期尚无单独账单。</text>
      <text wx:if="{{!periodSources.length && !periodLegacy.length}}" class="installment-note">本期还没有账单来源，可以导入账单，也可以直接确认进度。</text>
      <view wx:for="{{periodSources}}" wx:key="itemId" class="installment-source">
        <view><text>{{item.origin === 'import' ? '银行账单' : '手动补记'}} · {{item.label}}</text><text class="money-number">{{item.amount}}</text></view>
        <text class="installment-note">{{item.active ? item.occurredDate : '来源已撤销或修改，请核对'}}</text>
        <button wx:if="{{item.updateId}}" class="ld-link" data-id="{{item.itemId}}" bindtap="openInstallmentSource">查看原账单</button>
        <button wx:if="{{item.origin === 'manual' && item.active && !loan.archived}}" class="ld-link" data-id="{{item.itemId}}" bindtap="removeInstallmentSource" disabled="{{saving}}">撤销这笔补记费用</button>
      </view>
      <text wx:if="{{periodMoreSources}}" class="installment-note">显示最近 40 条来源；完整来源保留在已导入账单中。</text>
      <button wx:for="{{periodLegacy}}" wx:key="paymentId" class="ld-link" data-id="{{item.paymentId}}" bindtap="openPayment">查看本期已有关联还款</button>
      <block wx:if="{{!loan.archived}}">
        <button wx:if="{{!selectedPeriod.complete}}" class="primary-button" data-status="completed" bindtap="setPeriodStatus" disabled="{{saving}}" loading="{{saving}}">确认已完成至第 {{selectedPeriod.term}} 期</button>

        <text class="installment-note">确认进度只更新期次状态。消费本金不再计支出。</text>
        <button wx:if="{{periodCanBook}}" class="secondary-button" bindtap="bookPeriodCosts" disabled="{{saving}}">确认费用授权与覆盖</button>
        <button class="ld-link" bindtap="togglePeriodAdjust" disabled="{{saving}}">{{periodAdjustOpen ? '收起调整' : '调整本期记录'}}</button>
        <view wx:if="{{periodAdjustOpen}}" class="installment-inline"><button data-status="unpaid" bindtap="setPeriodStatus" disabled="{{saving}}">本期未还</button><button data-status="partial" bindtap="setPeriodStatus" disabled="{{saving}}">部分未还</button><button data-status="clear" bindtap="setPeriodStatus" disabled="{{saving}}">清除本期标记</button></view>
        <button wx:if="{{periodAdjustOpen}}" class="ld-link" bindtap="editInstallmentPeriod" disabled="{{saving}}">本期金额或日期有变化</button>
        <view wx:if="{{periodAdjustOpen && periodEditing}}" class="installment-period-edit">
          <text class="installment-note">修改本期约定金额；原账单和已入账费用保留，减免不会自动删除真实支出。</text>
          <picker mode="date" value="{{periodDraft.dueDate}}" data-field="dueDate" bindchange="periodDraftInput"><view class="installment-edit-row"><text>应还日期</text><text>{{periodDraft.dueDate}}</text></view></picker>
          <label class="installment-edit-row"><text>本金（元）</text><input type="digit" value="{{periodDraft.principal}}" data-field="principal" bindinput="periodDraftInput" /></label>
          <label class="installment-edit-row"><text>利息（元）</text><input type="digit" value="{{periodDraft.interest}}" data-field="interest" bindinput="periodDraftInput" /></label>
          <label class="installment-edit-row"><text>手续费（元）</text><input type="digit" value="{{periodDraft.fee}}" data-field="fee" bindinput="periodDraftInput" /></label>
          <view class="installment-edit-row"><text>取消本期</text><switch checked="{{periodDraft.cancelled}}" data-field="cancelled" bindchange="periodDraftInput" /></view>
          <button class="secondary-button" bindtap="saveInstallmentPeriod" disabled="{{saving}}">保存本期调整</button>
        </view>
      </block>
    </block>
  </scroll-view>
</view>
<view wx:if="{{progressOpen}}" class="detail-guide-mask" bindtap="closeProgress" catchtouchmove="stopGuideTap">
  <view class="detail-guide-sheet" catchtap="stopGuideTap">
    <text class="detail-guide-title">已完成至第几期</text>
    <input class="progress-input money-number" type="number" value="{{progressThrough}}" bindinput="progressInput" maxlength="3" />
    <text>填 10 即确认前 10 期完成，不需要逐期补填。已有关联账单和明确未还的期次会保留。</text>
    <ui-state wx:if="{{periodError}}" error description="{{periodError}}" />
    <button class="primary-button" bindtap="saveProgress" disabled="{{saving}}" loading="{{saving}}">保存进度</button>
    <button class="ld-link" bindtap="closeProgress" disabled="{{saving}}">取消</button>
  </view>
</view>
