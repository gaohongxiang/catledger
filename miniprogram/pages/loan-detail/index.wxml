<view class="page-canvas loan-detail {{themeClass}}" style="{{themeStyle}}">
  <section-header class="ld-heading" eyebrow="贷款资料" title="{{loan ? loan.name : '新增贷款'}}" />
  <view wx:if="{{sourceTransactionId}}" class="ld-note-card">
    <text class="ld-note">已保留原还款。这里只创建或补充贷款资料，保存后继续关联，不会重新登记付款。</text>
    <text wx:if="{{sourceContext}}" class="ld-note">还款发生于 {{sourceContext.occurredText}}；关联前须确认该日初或更早的本金基准，不是本次扣款金额。</text>
  </view>
  <ui-state wx:if="{{savedMessage}}" description="{{savedMessage}}" />
  <ui-state wx:if="{{errorMessage}}" error description="{{errorMessage}}" />
  <button wx:if="{{errorMessage && !saving}}" class="ld-link" bindtap="load">重新读取与核实</button>
  <button wx:if="{{hasPending && !formOpen}}" class="primary-button ld-retry" disabled="{{saving || loading}}" loading="{{saving}}" bindtap="save">重试上次操作</button>
  <ui-state wx:if="{{loading && !loan}}" description="正在读取资料…" />
  <view wx:if="{{loan && !formOpen}}" class="ld-panel">
    <text class="ld-muted">已确认剩余本金</text>
    <text class="ld-principal money-number">{{loan.principalText}}</text>
    <text class="ld-muted">{{loan.statusText}} · {{loan.accountName}}{{loan.accountArchived ? '（已停用）' : ''}}</text>
    <view class="ld-rows">
      <view class="ld-row"><text>本金基准</text><text>{{loan.baselineDate ? loan.baselineDate + ' 日初' : '待补充'}}</text></view>
      <view class="ld-row"><text>类型</text><text>{{loan.kindText}}</text></view>
      <view class="ld-row"><text>机构</text><text>{{loan.institution || '未填写'}}</text></view>
      <view class="ld-row"><text>起止日期</text><text>{{loan.startDate || '未填写'}} 至 {{loan.endDate || '未填写'}}</text></view>
      <view class="ld-row"><text>还款方式</text><text>{{loan.repaymentMethod || '未填写'}}</text></view>
      <view wx:if="{{loan.scheduleText}}" class="ld-row"><text>分期参数</text><text>{{loan.scheduleText}}</text></view>
    </view>
    <button class="primary-button ld-action" bindtap="recordPayment" disabled="{{saving || loading}}">{{sourceTransactionId ? '继续关联原还款（不重复扣款）' : '登记实际借还'}}</button>
    <button class="secondary-button ld-action" bindtap="openPlan" disabled="{{saving || loading}}">还款计划与对账</button>
    <button class="secondary-button ld-action" bindtap="edit" disabled="{{saving}}">编辑资料</button>
  </view>
  <view wx:if="{{loan && !formOpen}}" class="ld-history">
    <button class="ld-link" bindtap="loadHistory" disabled="{{historyLoading}}">{{historyLoaded ? '刷新实际记录（第一页）' : '查看实际借还记录'}}</button>
    <ui-state wx:if="{{historyError}}" error description="{{historyError}}" />
    <text wx:if="{{historyLoaded && !history.length}}" class="ld-note">还没有实际借还记录</text>
    <view wx:for="{{history}}" wx:key="paymentId" class="ld-history-row" hover-class="ld-history-hover" data-id="{{item.paymentId}}" bindtap="openPayment" aria-role="button"><view class="ld-history-main"><text>{{item.kindText}} · {{item.status === 'active' ? '已登记' : '已撤销'}}</text><text class="ld-muted">{{item.occurredText}}</text></view><text class="money-number">{{item.totalText}}</text></view>
    <button wx:if="{{historyNext}}" class="secondary-button ld-action" data-next="true" bindtap="loadHistory" disabled="{{historyLoading}}">下一页记录</button>
  </view>
  <view wx:if="{{formOpen}}" class="ld-form">
    <view class="ld-note-card"><text class="ld-note">只登记贷款资料，不会重复生成借款交易。金额留空表示尚不清楚，已知为零请填写 0。</text></view>
    <label class="ld-field"><text>贷款名称</text><input class="ld-input" value="{{name}}" data-field="name" bindinput="input" maxlength="80" placeholder="例如：住房贷款" /></label>
    <label class="ld-field"><text>机构（选填）</text><input class="ld-input" value="{{institution}}" data-field="institution" bindinput="input" maxlength="80" placeholder="无需填写合同号" /></label>
    <picker class="ld-field" range="{{kinds}}" value="{{kindIndex}}" bindchange="selectKind"><text>贷款类型</text><view class="ld-picker"><text class="ld-picker-value">{{kinds[kindIndex]}}</text><chevron-icon size="{{24}}" /></view></picker>
    <picker wx:if="{{accounts.length}}" class="ld-field" range="{{accounts}}" range-key="name" value="{{accountIndex < 0 ? 0 : accountIndex}}" bindchange="selectAccount"><text>关联负债账户</text><view class="ld-picker"><text class="ld-picker-value">{{accountIndex >= 0 ? accounts[accountIndex].name : '请选择负债账户'}}</text><chevron-icon size="{{24}}" /></view></picker>
    <button wx:else class="secondary-button ld-action" bindtap="openAccounts">先创建或启用负债账户</button>
    <label class="ld-field"><text>已确认本金（元）</text><input class="ld-input money-number" type="digit" value="{{principalYuan}}" data-field="principalYuan" bindinput="input" placeholder="不清楚可留空" /></label>
    <picker class="ld-field" mode="date" value="{{baselineDate}}" data-field="baselineDate" bindchange="input"><text>本金基准日期（日初）</text><view class="ld-picker"><text class="ld-picker-value">{{baselineDate || '有本金时必填'}}</text><chevron-icon size="{{24}}" /></view></picker>
    <picker class="ld-field" mode="date" value="{{startDate}}" data-field="startDate" bindchange="input"><text>开始日期（选填）</text><view class="ld-picker"><text class="ld-picker-value">{{startDate || '未填写'}}</text><chevron-icon size="{{24}}" /></view></picker>
    <button wx:if="{{startDate}}" class="ld-link" data-field="startDate" bindtap="clearDate">清除开始日期</button>
    <picker class="ld-field" mode="date" value="{{endDate}}" data-field="endDate" bindchange="input"><text>结束日期（选填）</text><view class="ld-picker"><text class="ld-picker-value">{{endDate || '未填写'}}</text><chevron-icon size="{{24}}" /></view></picker>
    <button wx:if="{{endDate}}" class="ld-link" data-field="endDate" bindtap="clearDate">清除结束日期</button>
    <label class="ld-field"><text>还款方式（选填）</text><input class="ld-input" value="{{repaymentMethod}}" data-field="repaymentMethod" bindinput="input" maxlength="80" placeholder="以已确认约定为准" /></label>
    <view class="ld-schedule">
      <text class="ld-section-title">分期参数（选填）</text>
      <view class="ld-note-card"><text class="ld-note">整区留空则只登记贷款资料。填写后保存，可到「还款计划与对账」按参数试算并生成期次；生成前不产生任何账目。</text></view>
      <label class="ld-field"><text>分期期数</text><input class="ld-input money-number" type="number" value="{{schedule.terms}}" data-field="terms" bindinput="scheduleInput" maxlength="3" placeholder="1 到 600 的整数" /></label>
      <picker class="ld-field" range="{{scheduleMethods}}" range-key="label" value="{{schedule.methodIndex}}" bindchange="selectScheduleMethod"><text>还款方式</text><view class="ld-picker"><text class="ld-picker-value">{{scheduleMethods[schedule.methodIndex].label}}</text><chevron-icon size="{{24}}" /></view></picker>
      <picker class="ld-field" range="{{scheduleMeasurements}}" range-key="label" value="{{schedule.measurementIndex}}" bindchange="selectScheduleMeasurement"><text>测算依据</text><view class="ld-picker"><text class="ld-picker-value">{{scheduleMeasurements[schedule.measurementIndex].label}}</text><chevron-icon size="{{24}}" /></view></picker>
      <block wx:if="{{schedule.measurementIndex === 0}}">
        <picker class="ld-field" range="{{scheduleQuotes}}" range-key="label" value="{{schedule.quoteIndex}}" bindchange="selectScheduleQuote"><text>利率口径</text><view class="ld-picker"><text class="ld-picker-value">{{scheduleQuotes[schedule.quoteIndex].label}}</text><chevron-icon size="{{24}}" /></view></picker>
        <label class="ld-field"><text>{{scheduleQuotes[schedule.quoteIndex].label}}（%）</text><input class="ld-input money-number" type="digit" value="{{schedule.ratePercent}}" data-field="ratePercent" bindinput="scheduleInput" maxlength="12" placeholder="例如 12.5 表示 12.5%" /></label>
      </block>
      <label wx:else class="ld-field"><text>{{schedule.measurementIndex === 1 && schedule.methodIndex === 3 ? '每期利息（元）' : schedule.methodIndex === 2 ? '首期应还（元）' : '每期应还（元）'}}</text><input class="ld-input money-number" type="digit" value="{{schedule.repaymentYuan}}" data-field="repaymentYuan" bindinput="scheduleInput" maxlength="22" placeholder="按合同或账单填写" /></label>
      <label class="ld-field"><text>每期费用（元，选填）</text><input class="ld-input money-number" type="digit" value="{{schedule.feePerTermYuan}}" data-field="feePerTermYuan" bindinput="scheduleInput" maxlength="22" placeholder="没有可留空" /></label>
      <label class="ld-field"><text>一次性费用（元，选填）</text><input class="ld-input money-number" type="digit" value="{{schedule.feeUpfrontYuan}}" data-field="feeUpfrontYuan" bindinput="scheduleInput" maxlength="22" placeholder="没有可留空；只作资料与试算汇总" /></label>
      <picker class="ld-field" mode="date" value="{{schedule.firstPaymentDate}}" data-field="firstPaymentDate" bindchange="scheduleInput"><text>首次还款日</text><view class="ld-picker"><text class="ld-picker-value">{{schedule.firstPaymentDate || '按还款额测算时必选'}}</text><chevron-icon size="{{24}}" /></view></picker>
    </view>
    <text wx:if="{{hasPending}}" class="ld-note">上次保存结果待核实，再次提交会沿用原请求和原内容。</text>
    <button class="primary-button ld-action" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="save">{{hasPending ? '重试上次保存' : '保存贷款资料'}}</button>
    <button class="ld-link" disabled="{{saving}}" bindtap="cancelEdit">取消</button>
  </view>
  <login-sheet id="page-login-sheet" />
</view>
