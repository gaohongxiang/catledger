.ledger-page { padding-top: 32rpx; }
.ledger-overview { display: flex; }
.ledger-count {
  margin-top: -4rpx;
  color: var(--theme-text-muted);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1;
  opacity: 1;
  margin: 0;
  background: var(--theme-surface);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}

.ledger-overview {
  align-items: center;
  margin-top: 0;
  padding: 28rpx 12rpx;
  border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
}
.overview-item {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  flex-direction: column;
}
.overview-line { width: 2rpx; height: 42rpx; background: var(--theme-line, rgba(41, 35, 30, .09)); }
.overview-value {
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.overview-label { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }

.management-list {
  margin-top: 28rpx;
  padding: 0 8rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
  overflow: hidden;
}
.management-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  background: var(--theme-surface-muted);
  border-radius: var(--theme-radius-medium, 18rpx);
  flex: 0 0 64rpx;
}
.management-icon image { width: 30rpx; height: 30rpx; }
.management-icon-category { background: var(--theme-surface-muted); }
.ledger-status,
.ledger-error {
  min-height: 72rpx;
  margin-top: 14rpx;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  line-height: 72rpx;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}
.ledger-error { color: var(--theme-danger, #a95132); }
