.ledger-page { padding-top: 36rpx; }
.ledger-heading, .ledger-overview, .management-row { display: flex; }
.ledger-heading { align-items: flex-start; justify-content: space-between; }
.ledger-kicker { display: block; color: var(--theme-secondary, #64705d); font-family: "DIN Alternate", sans-serif; font-size: 19rpx; font-weight: 600; letter-spacing: 4rpx; }
.ledger-title { display: block; margin-top: 10rpx; font-size: 36rpx; font-weight: 650; }
.ledger-count { margin-top: -8rpx; color: var(--theme-accent, #cf7439); font-size: 82rpx; font-weight: 650; line-height: 1; opacity: .18; }
.ledger-overview { align-items: center; margin-top: 30rpx; padding: 24rpx 10rpx; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-border, rgba(111, 88, 65, 0.08)); border-radius: var(--theme-radius-medium, 24rpx); box-shadow: var(--theme-shadow-soft, 0 8rpx 24rpx rgba(74, 50, 30, 0.05)); }
.overview-item { flex: 1; text-align: center; }
.overview-value, .overview-label { display: block; }
.overview-value { color: var(--theme-ink, #332e2a); font-size: 31rpx; font-weight: 650; }
.overview-label { margin-top: 5rpx; color: var(--theme-text-muted, #746a60); font-size: 19rpx; }
.overview-line { width: 2rpx; height: 44rpx; background: var(--theme-line, rgba(41, 35, 30, 0.08)); }
.management-list { margin-top: 26rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.09)); }
.management-row { position: relative; align-items: center; min-height: 116rpx; padding: 10rpx 8rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.09)); }
.management-icon { display: flex; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; background: var(--theme-accent-soft, #f8eee7); border-radius: var(--theme-radius-small, 20rpx); }
.management-icon-category { background: var(--theme-secondary-soft, #e8eadf); }
.management-icon image { width: 34rpx; height: 34rpx; }
.management-copy { display: flex; flex: 1; min-width: 0; margin-left: 20rpx; flex-direction: column; }
.management-title { color: var(--theme-ink, #332e2a); font-size: 27rpx; font-weight: 600; }
.management-note { overflow: hidden; margin-top: 7rpx; color: var(--theme-text-muted, #746a60); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-chevron { width: 14rpx; height: 14rpx; margin-right: 10rpx; border-top: 3rpx solid var(--theme-text-subtle, #a49b92); border-right: 3rpx solid var(--theme-text-subtle, #a49b92); transform: rotate(45deg); }
.ledger-status, .ledger-error { margin-top: 24rpx; padding: 18rpx 0; color: var(--theme-secondary, #64705d); font-size: 21rpx; border-bottom: 2rpx solid rgba(100, 112, 93, 0.14); }
.ledger-error { color: var(--theme-danger, #8a4534); border-bottom-color: rgba(138, 69, 52, 0.14); }
