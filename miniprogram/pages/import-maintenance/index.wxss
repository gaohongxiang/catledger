.maintenance-title { display: block; font-size: var(--font-title, 36rpx); font-weight: 600; margin: 12rpx 0; }
.maintenance-copy { display: block; font-size: var(--font-body-small, 26rpx); line-height: 1.7; color: var(--theme-text-muted, #746a60); margin: 16rpx 0 24rpx; overflow-wrap: break-word; }
.maintenance-section { padding: 24rpx 0; border-top: 1rpx solid var(--theme-border, #dfd5c7); }
.section-title { display: block; font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; }
.field-label { display: block; font-size: var(--font-body-small, 26rpx); margin-top: 24rpx; color: var(--theme-text-muted, #746a60); }
.field-value, .field-input { box-sizing: border-box; min-height: 88rpx; padding: 24rpx; border-radius: 12rpx; background: var(--theme-surface, #fffdf9); color: var(--theme-ink, #29231e); margin: 12rpx 0 24rpx; overflow-wrap: break-word; }
.field-input { height: 92rpx; }
.maintenance-error { display: block; padding: 24rpx 0; color: var(--theme-danger, #a95132); line-height: 1.6; }
.refresh-button { margin: 24rpx 0; text-align: left; font-size: var(--font-body-small, 26rpx); padding: 0; background: transparent; color: var(--theme-accent, #d97732); }
.impact-section { border-top: 4rpx solid var(--theme-accent, #d97732); }
.impact-row { padding: 12rpx 0; }
.impact-row > text { display: block; margin: 12rpx 0; }
