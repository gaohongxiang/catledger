<view class="editor-page {{themeClass}}" style="{{themeStyle}}">
  <view wx:if="{{!readonlyDetail}}" class="editor-heading content-inset">

    <text class="editor-title serif-title">{{mode === 'link-refund' ? '关联原消费' : (mode === 'edit' ? '编辑账单' : '记一笔')}}</text>
  </view>

  <view wx:if="{{!formReady && !errorMessage}}" class="ui-state" aria-role="status">登录后开始记账</view>
  <block wx:if="{{formReady && !readonlyDetail}}">
  <view wx:if="{{mode !== 'link-refund'}}" class="type-switch">
    <view
      wx:for="{{typeOptions}}"
      wx:key="value"
      class="type-option {{typeIndex === index ? 'type-option-selected' : ''}}"
      data-index="{{index}}"
      bindtap="changeType"
    >{{item.label}}</view>
  </view>

  <view class="amount-panel">
    <text class="amount-caption">金额 · CNY</text>
    <view class="amount-input-row">
      <text class="amount-currency money-number">¥</text>
      <input wx:if="{{mode !== 'link-refund'}}" class="amount-input money-number" type="digit" value="{{amountYuan}}" placeholder="0.00" maxlength="18" bindinput="bindAmount" aria-label="金额（元）" cursor-spacing="32" disabled="{{saving}}" />
      <text wx:else class="amount-input money-number">{{amountYuan}}</text>
    </view>
  </view>

  <view class="form-sheet">
    <picker wx:if="{{mode !== 'link-refund' && (typeOptions[typeIndex].value === 'expense' || typeOptions[typeIndex].value === 'transfer')}}" mode="selector" range="{{accounts}}" range-key="name" value="{{sourceIndex < 0 ? 0 : sourceIndex}}" bindchange="changeSource" disabled="{{saving || !catalogReady}}">
      <view class="form-row content-inset">
        <text class="form-label">{{typeOptions[typeIndex].value === 'transfer' ? '转出账户' : '付款账户'}}</text>
        <text class="form-value">{{accounts[sourceIndex].name || '请选择'}}</text>
      </view>
    </picker>

    <picker wx:if="{{mode !== 'link-refund' && typeOptions[typeIndex].value !== 'expense'}}" mode="selector" range="{{accounts}}" range-key="name" value="{{destinationIndex < 0 ? 0 : destinationIndex}}" bindchange="changeDestination" disabled="{{saving || !catalogReady}}">
      <view class="form-row content-inset">
        <text class="form-label">{{typeOptions[typeIndex].value === 'transfer' ? '转入账户' : (typeOptions[typeIndex].value === 'refund' ? '退款到账' : '收款账户')}}</text>
        <text class="form-value">{{accounts[destinationIndex].name || '请选择'}}</text>
      </view>
    </picker>

    <picker wx:if="{{mode !== 'link-refund' && (typeOptions[typeIndex].value === 'expense' || typeOptions[typeIndex].value === 'income')}}" mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex < 0 ? 0 : categoryIndex}}" bindchange="changeCategory" disabled="{{saving || !catalogReady}}">
      <view class="form-row content-inset">
        <text class="form-label">分类</text>
        <text class="form-value">{{categories[categoryIndex].name || '请选择'}}</text>
      </view>
    </picker>

    <picker wx:if="{{typeOptions[typeIndex].value === 'refund'}}" mode="selector" range="{{refundableTransactions}}" range-key="pickerLabel" value="{{originalIndex < 0 ? 0 : originalIndex}}" bindchange="changeOriginal" disabled="{{saving || !refundablesReady}}">
      <view class="form-row content-inset">
        <text class="form-label">原支出</text>
        <text class="form-value form-value-compact">{{refundablesLoading ? '正在读取原支出…' : (refundableTransactions[originalIndex].pickerLabel || '请选择可退款支出')}}</text>
      </view>
    </picker>

    <view wx:if="{{mode !== 'link-refund'}}" class="form-row form-row-pair content-inset">
      <picker class="half-picker" mode="date" value="{{date}}" bindchange="changeDate" disabled="{{saving}}">
        <view><text class="form-label">日期</text><text class="form-value">{{date}}</text></view>
      </picker>
      <picker class="half-picker" mode="time" value="{{clock}}" bindchange="changeClock" disabled="{{saving}}">
        <view><text class="form-label">时间</text><text class="form-value">{{clock}}</text></view>
      </picker>
    </view>

    <view wx:if="{{mode !== 'link-refund'}}" class="note-row content-inset">
      <text class="form-label">备注</text>
      <textarea class="note-input" value="{{note}}" maxlength="200" placeholder="可选，写下这笔钱的来处" auto-height="true" bindinput="bindNote" aria-label="交易备注" cursor-spacing="32" disabled="{{saving}}" />
    </view>
  </view>

  </block>
  <block wx:if="{{formReady && readonlyDetail}}">
    <view class="readonly-amount">
      <text class="readonly-source">{{detail.sourceLabel}}</text>
      <text class="readonly-money money-number {{detail.typeClass}}">{{detail.amountText}}</text>
    </view>
    <view class="form-sheet readonly-sheet">
      <view wx:for="{{detail.rows}}" wx:key="label" class="readonly-row content-inset"><text class="form-label">{{item.label}}</text><text class="readonly-value">{{item.value}}</text></view>
      <picker wx:if="{{detail.canEditCategory}}" mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex < 0 ? 0 : categoryIndex}}" bindchange="changeDetailCategory" disabled="{{saving || !catalogReady}}">
        <view class="readonly-row readonly-category content-inset" aria-label="修改分类"><text class="form-label">分类</text><view class="readonly-category-value"><text>{{categoryIndex < 0 ? (categoryDirty ? '请选择' : detail.categoryName) : categories[categoryIndex].name}}</text><view class="readonly-chevron"></view></view></view>
      </picker>
      <view wx:elif="{{detail.categoryName !== '未分类'}}" class="readonly-row content-inset"><text class="form-label">分类</text><text class="readonly-value">{{detail.categoryName}}</text></view>
    </view>
    <button wx:if="{{detail.canEditCategory && categoryDirty}}" class="primary-button save-button" loading="{{saving}}" disabled="{{saving || !catalogReady || categoryIndex < 0}}" bindtap="saveDetailCategory">保存分类</button>
  </block>
  <view wx:if="{{formReady && preparing}}" class="ui-state" aria-role="status">{{readonlyDetail ? '正在读取可选分类…' : '正在读取账户和分类，可先填写金额和备注'}}</view>
  <view wx:if="{{catalogError}}" class="editor-error content-inset">{{catalogError}}</view>
  <button wx:if="{{formReady && catalogError}}" class="secondary-button save-button" disabled="{{preparing}}" bindtap="prepareForm">重新读取账户和分类</button>
  <button wx:if="{{formReady && !readonlyDetail && catalogReady && !hasAccounts}}" class="secondary-button save-button" bindtap="openAccounts">创建账户，返回后继续记账</button>
  <view wx:if="{{errorMessage}}" class="editor-error content-inset">{{errorMessage}}</view>
  <button wx:if="{{!formReady && errorMessage}}" class="secondary-button save-button" loading="{{preparing}}" disabled="{{preparing}}" bindtap="prepareForm">重新读取</button>
  <button wx:if="{{formReady && errorMessage && typeOptions[typeIndex].value === 'refund' && !refundablesReady}}" class="secondary-button save-button" loading="{{refundablesLoading}}" disabled="{{refundablesLoading}}" bindtap="loadRefundables">重新读取原支出</button>
  <button wx:if="{{formReady && !readonlyDetail}}" class="primary-button save-button" loading="{{saving}}" disabled="{{saving || !catalogReady || editingBlocked || !hasAccounts || (typeOptions[typeIndex].value === 'refund' && !refundablesReady)}}" bindtap="save">{{mode === 'link-refund' ? '关联原消费' : (mode === 'edit' ? '保存修改' : '确认记账')}}</button>
  <button wx:if="{{formReady && mode === 'edit'}}" class="danger-button delete-button" disabled="{{saving}}" bindtap="remove">删除这笔账</button>
</view>
<login-sheet id="page-login-sheet" />
