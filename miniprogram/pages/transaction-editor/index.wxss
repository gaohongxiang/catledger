.editor-page { padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.editor-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.35;
}
.type-switch {
  display: flex;
  flex-wrap: nowrap;
  gap: 6rpx;
  margin-top: 24rpx;
  padding: 6rpx;
  background: var(--theme-surface-muted);
  border-radius: 18rpx;
}
.type-option {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  color: var(--theme-text-muted);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
  border-radius: 14rpx;
}
.type-option-selected {
  color: var(--theme-accent-strong);
  background: var(--theme-surface);
  box-shadow: var(--theme-shadow-soft);
  font-weight: 500;
}
.amount-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  color: var(--theme-ink);
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: 26rpx;
}
.amount-caption { display: block; color: var(--theme-text-muted); font-size: 26rpx; }
.amount-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.amount-currency { flex: 0 0 auto; font-size: 40rpx; color: var(--theme-accent-strong); }
.amount-input {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 96rpx;
  color: var(--theme-ink);
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1.4;
}
.form-sheet {
  margin-top: 20rpx;
  padding: 0 8rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: 24rpx;
}
.form-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--theme-line);
}
.form-label {
  display: block;
  color: var(--theme-text-muted);
  font-size: 26rpx;
  flex: 0 0 auto;
}
.form-value {
  display: block;
  min-width: 0;
  max-width: 72%;
  text-align: right;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.form-value-compact { font-size: 26rpx; }
.form-row-pair { gap: 24rpx; align-items: stretch; }
.half-picker {
  display: flex;
  min-width: 0;
  min-height: 96rpx;
  align-items: center;
  flex: 1;
}
.half-picker:last-child { border-left: 1rpx solid var(--theme-line); padding-left: 24rpx; }
.half-picker .form-value { max-width: 100%; text-align: left; margin-top: 6rpx; }
.note-row { padding: 24rpx; }
.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 144rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  color: var(--theme-ink);
  font-size: 28rpx;
  line-height: 1.6;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-border);
  border-radius: 14rpx;
}
.editor-error {
  padding: 22rpx;
  margin-top: 18rpx;
  color: var(--theme-danger);
  background: var(--theme-danger-soft);
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.save-button { width: 100%; margin-top: 28rpx; }
.delete-button {
  width: 100%;
  margin-top: 16rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
}

.readonly-amount { padding: 38rpx 20rpx 44rpx; text-align: center; }
.readonly-source { display: block; color: var(--theme-text-muted); font-size: 24rpx; }
.readonly-money { display: block; margin-top: 14rpx; font-size: 56rpx; font-weight: 500; overflow-wrap: anywhere; }
.detail-expense { color: var(--theme-expense); }
.detail-income { color: var(--theme-income); }
.readonly-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 32rpx; min-height: 96rpx; box-sizing: border-box; padding-top: 24rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--theme-line); font-size: 28rpx; line-height: 1.6; }
.readonly-row .form-label { flex: 0 0 auto; min-width: 112rpx; }
.readonly-value { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.readonly-category { align-items: center; }
.readonly-category-value { display: flex; align-items: center; gap: 18rpx; color: var(--theme-accent-strong); }
.readonly-chevron { width: 12rpx; height: 12rpx; flex: 0 0 auto; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(45deg); }
