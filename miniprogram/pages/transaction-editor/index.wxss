.editor-page { padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.editor-page .editor-import {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  min-height: 112rpx;
  margin: 20rpx 0 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--theme-accent-soft);
  border-radius: var(--theme-radius-medium, 18rpx);
  color: var(--theme-accent-strong);
  background: var(--theme-accent-soft);
  text-align: left;
  font-weight: 400;
  line-height: 1.5;
}
.editor-import-copy { flex: 1; min-width: 0; }
.editor-import-title { display: block; font-size: var(--font-body, 28rpx); font-weight: 500; }
.editor-import-note { display: block; margin-top: 4rpx; color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); }
.editor-import::after { border: 0; }
.editor-import:active { opacity: .7; }
.editor-import[disabled] { opacity: .5; }
.editor-title {
  display: block;
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.35;
}
.type-switch {
  display: flex;
  flex-wrap: nowrap;
  gap: 6rpx;
  margin-top: 24rpx;
  padding: 6rpx;
  background: var(--theme-surface-muted);
  border-radius: var(--theme-radius-medium, 18rpx);
}
.type-option {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  color: var(--theme-text-muted);
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  line-height: 1.4;
  border-radius: var(--theme-radius-medium, 18rpx);
}
.type-option-selected {
  color: var(--theme-accent-strong);
  background: var(--theme-surface);
  box-shadow: var(--theme-shadow-soft);
  font-weight: 500;
}
.amount-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  color: var(--theme-ink);
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
}
.amount-caption { display: block; color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); }
.amount-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.amount-currency { flex: 0 0 auto; font-size: var(--font-title, 40rpx); color: var(--theme-accent-strong); }
.amount-input {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 96rpx;
  color: var(--theme-ink);
  font-size: var(--font-display, 56rpx);
  font-weight: 400;
  line-height: 1.4;
}
.form-sheet {
  margin-top: 20rpx;
  padding: 0 8rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
}
.form-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--theme-line);
}
.form-label {
  display: block;
  color: var(--theme-text-muted);
  font-size: var(--font-caption, 24rpx);
  flex: 0 0 auto;
}
.form-value {
  display: block;
  min-width: 0;
  max-width: 72%;
  text-align: right;
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.form-value-compact { font-size: var(--font-caption, 24rpx); }
.form-row-pair { gap: 24rpx; align-items: stretch; }
.half-picker {
  display: flex;
  min-width: 0;
  min-height: 96rpx;
  align-items: center;
  flex: 1;
}
.half-picker:last-child { border-left: 1rpx solid var(--theme-line); padding-left: 24rpx; }
.half-picker .form-value { max-width: 100%; text-align: left; margin-top: 6rpx; }
.note-row { padding: 24rpx; }
.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 144rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  color: var(--theme-ink);
  font-size: var(--font-body, 28rpx);
  line-height: 1.6;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-border);
  border-radius: var(--theme-radius-medium, 18rpx);
}
.editor-error {
  padding: 22rpx;
  margin-top: 18rpx;
  color: var(--theme-danger);
  background: var(--theme-danger-soft);
  border-radius: var(--theme-radius-medium, 18rpx);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.6;
}
.catalog-retry { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); }
.catalog-retry-message { flex: 1; min-width: 0; }
.editor-page .catalog-retry-button {
  flex: 0 0 auto;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  background: transparent;
  color: var(--theme-accent-strong);
  font-size: var(--font-caption, 24rpx);
  line-height: 88rpx;
}
.catalog-retry-button:active { opacity: .7; }
.save-button { width: 100%; margin-top: 28rpx; }
.delete-button {
  width: 100%;
  margin-top: 16rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
}

.readonly-amount { padding: 38rpx 20rpx 44rpx; text-align: center; }
.readonly-source { display: block; color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); }
.readonly-money { display: block; margin-top: 14rpx; font-size: var(--font-display, 56rpx); font-weight: 500; overflow-wrap: anywhere; }
.detail-expense { color: var(--theme-expense); }
.detail-income { color: var(--theme-income); }
.readonly-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 32rpx; min-height: 96rpx; box-sizing: border-box; padding-top: 24rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--theme-line); font-size: var(--font-body, 28rpx); line-height: 1.6; }
.readonly-row .form-label { flex: 0 0 auto; min-width: 112rpx; }
.readonly-value { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.readonly-category { align-items: center; }
.readonly-category-value { display: flex; align-items: center; gap: 18rpx; color: var(--theme-accent-strong); }

.loan-context { margin-top: 32rpx; padding: 28rpx; background: var(--theme-surface); border: 1rpx solid var(--theme-line); border-radius: var(--layout-radius-large, 24rpx); }
.loan-context-title, .loan-context-name, .loan-context-note { display: block; overflow-wrap: anywhere; }
.loan-context-title { font-size: var(--font-section, 32rpx); font-weight: 500; }
.loan-context-name { font-size: var(--font-body, 28rpx); }
.loan-context-note { color: var(--theme-text-muted); font-size: var(--font-caption, 24rpx); line-height: 1.8; margin: 12rpx 0; }
.loan-context-allocation { padding: 20rpx 0; border-top: 1rpx solid var(--theme-line); margin-top: 20rpx; }
.loan-context-link { color: var(--theme-accent-strong); background: transparent; min-height: 88rpx; font-size: var(--font-caption, 24rpx); text-align: left; }
