<view class="page-canvas page-secondary account-detail-page {{themeClass}}" style="{{themeStyle}}">
  <view class="ad-head content-inset">
    <view wx:if="{{!editingName}}" class="ad-title-line">
      <text class="ad-title serif-title">{{account ? account.name : '账户详情'}}</text>
      <view wx:if="{{account && !account.archived}}" class="ad-icon-button" bindtap="startEditName" aria-role="button" aria-label="修改名称"><image class="ad-icon-image" src="/assets/icons/pencil.svg" mode="aspectFit" /></view>
    </view>
    <view wx:else class="ad-name-form">
      <input class="ad-name-input {{nameError ? 'field-error-shake' : ''}}" value="{{nameDraft}}" maxlength="32" aria-label="账户名称" cursor-spacing="32" disabled="{{saving}}" bindinput="bindNameDraft" />
      <view class="ad-icon-button" aria-role="button" aria-label="取消修改名称" bindtap="cancelEditName"><image class="ad-icon-image" src="/assets/icons/close.svg" mode="aspectFit" /></view>
      <view class="ad-icon-button" aria-role="button" aria-label="保存名称" bindtap="saveName"><view wx:if="{{!saving}}" class="ad-icon-confirm"><image class="ad-icon-image" src="/assets/icons/check.svg" mode="aspectFit" /></view></view>
    </view>
    <text wx:if="{{nameError}}" class="field-error-inline">{{nameError}}</text>
    <text wx:if="{{account}}" class="ad-copy">{{account.typeLabel}}{{account.archived ? ' · 已停用' : ''}}</text>
  </view>

  <skeleton-rows wx:if="{{loading && !account}}" rows="{{3}}" />
  <block wx:if="{{account}}">
    <view wx:if="{{debtHintOpen}}" class="ad-hint-mask" bindtap="closeDebtHint" catchtouchmove="stopBubble"></view>
    <view class="ad-card">
      <view class="ad-balance-row {{account.nature === 'liability' && accountLoansLoaded && accountLoansTotalCount > 0 ? 'has-side' : ''}}">
        <view class="ad-balance-col ad-balance-col-main">
          <view class="ad-balance-label-row">
            <text class="ad-balance-label">{{account.balanceLabel}}</text>
            <view wx:if="{{account.nature === 'liability'}}" class="ad-info-btn {{debtHintOpen ? 'is-on' : ''}}" catchtap="toggleDebtHint" aria-role="button" aria-label="查看总欠款口径说明">
              <text class="ad-info-i">i</text>
            </view>
            <view wx:if="{{account.nature === 'liability' && debtHintOpen}}" class="ad-debt-tip" catchtap="stopBubble"><text class="ad-debt-tip-title">总欠款 = 最近一期账单应还总额 + 之后分期未到期期次的剩余本息</text><text class="ad-debt-tip-note">账单应还总额已含本期消费、已出账分期等；已还部分会扣掉，没导入账单时按 0 计。</text></view>
          </view>
          <text class="ad-balance-value money-number {{account.amountTone}}">{{account.balanceText}}</text>
        </view>
        <view wx:if="{{account.nature === 'liability' && accountLoansLoaded && accountLoansTotalCount > 0}}" class="ad-balance-col ad-balance-col-side">
          <text class="ad-balance-label">全部 {{accountLoansTotalCount}} 笔分期总利息</text>
          <text class="ad-balance-side-value money-number">{{accountLoansTotalInterestText}}<text wx:if="{{accountLoansTotalFeeText && accountLoansTotalFeeText !== '¥0.00' && accountLoansTotalFeeText !== '¥0'}}" class="ad-balance-fee"> · 费用 {{accountLoansTotalFeeText}}</text></text>
        </view>
      </view>
      <block wx:if="{{account.nature === 'liability'}}">
        <view class="ad-billing-line">
          <view class="ad-billing-cell"><text class="ad-billing-name">账单日</text><view wx:if="{{editingBilling !== 'statementDay'}}" class="ad-billing-val-row"><text class="ad-billing-val">{{account.statementDayText}}</text><view wx:if="{{!account.archived}}" class="ad-billing-edit" data-field="statementDay" catchtap="startEditBilling" aria-role="button" aria-label="编辑账单日"><image class="ad-billing-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view></view><view wx:else class="ad-billing-edit-row"><input class="ad-billing-input {{billingFieldError ? 'field-error-shake' : ''}}" type="number" value="{{billingFieldDraft}}" maxlength="2" placeholder="1–31" disabled="{{saving}}" bindinput="bindBillingField" cursor-spacing="32" aria-label="账单日" /><view class="ad-billing-mini" bindtap="cancelEditBilling" aria-role="button" aria-label="取消"><image class="ad-billing-mini-icon" src="/assets/icons/close.svg" mode="aspectFit" /></view><view class="ad-billing-mini" bindtap="saveBillingField" aria-role="button" aria-label="保存"><view wx:if="{{!saving}}" class="ad-billing-mini-confirm"><image class="ad-billing-mini-icon" src="/assets/icons/check.svg" mode="aspectFit" /></view></view></view></view>
          <view class="ad-billing-cell"><text class="ad-billing-name">还款日</text><view wx:if="{{editingBilling !== 'repaymentDay'}}" class="ad-billing-val-row"><text class="ad-billing-val">{{account.repaymentDayText}}</text><view wx:if="{{!account.archived}}" class="ad-billing-edit" data-field="repaymentDay" catchtap="startEditBilling" aria-role="button" aria-label="编辑还款日"><image class="ad-billing-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view></view><view wx:else class="ad-billing-edit-row"><input class="ad-billing-input {{billingFieldError ? 'field-error-shake' : ''}}" type="number" value="{{billingFieldDraft}}" maxlength="2" placeholder="1–31" disabled="{{saving}}" bindinput="bindBillingField" cursor-spacing="32" aria-label="还款日" /><view class="ad-billing-mini" bindtap="cancelEditBilling" aria-role="button" aria-label="取消"><image class="ad-billing-mini-icon" src="/assets/icons/close.svg" mode="aspectFit" /></view><view class="ad-billing-mini" bindtap="saveBillingField" aria-role="button" aria-label="保存"><view wx:if="{{!saving}}" class="ad-billing-mini-confirm"><image class="ad-billing-mini-icon" src="/assets/icons/check.svg" mode="aspectFit" /></view></view></view></view>
          <view class="ad-billing-cell"><text class="ad-billing-name">信用额度</text><view wx:if="{{editingBilling !== 'creditLimit'}}" class="ad-billing-val-row"><text class="ad-billing-val money-number">{{account.creditLimitText}}</text><view wx:if="{{!account.archived}}" class="ad-billing-edit" data-field="creditLimit" catchtap="startEditBilling" aria-role="button" aria-label="编辑信用额度"><image class="ad-billing-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view></view><view wx:else class="ad-billing-edit-row"><input class="ad-billing-input {{billingFieldError ? 'field-error-shake' : ''}}" type="digit" value="{{billingFieldDraft}}" maxlength="18" placeholder="未设置" disabled="{{saving}}" bindinput="bindBillingField" cursor-spacing="32" aria-label="信用额度" /><view class="ad-billing-mini" bindtap="cancelEditBilling" aria-role="button" aria-label="取消"><image class="ad-billing-mini-icon" src="/assets/icons/close.svg" mode="aspectFit" /></view><view class="ad-billing-mini" bindtap="saveBillingField" aria-role="button" aria-label="保存"><view wx:if="{{!saving}}" class="ad-billing-mini-confirm"><image class="ad-billing-mini-icon" src="/assets/icons/check.svg" mode="aspectFit" /></view></view></view></view>
        </view>
        <text wx:if="{{billingFieldError}}" class="field-error-inline">{{billingFieldError}}</text>
      </block>
    </view>

    <view wx:if="{{account.nature === 'liability'}}" class="account-loans account-statement">
      <view class="account-loans-heading"><text class="account-loans-title">最近账单<text wx:if="{{account.statementMonthText}}" class="account-statement-month"> · {{account.statementMonthText}}</text></text><text wx:if="{{!account.hasStatementData}}" class="account-sources-count">未录入</text></view>
      <view class="ad-billing-line">
        <view class="ad-billing-cell"><text class="ad-billing-name">本期应还</text><view wx:if="{{editingBilling !== 'statementDue'}}" class="ad-billing-val-row"><text class="ad-billing-val money-number">{{account.statementDueText}}</text><view wx:if="{{!account.archived}}" class="ad-billing-edit" data-field="statementDue" catchtap="startEditBilling" aria-role="button" aria-label="编辑本期应还"><image class="ad-billing-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view></view><view wx:else class="ad-billing-edit-row"><input class="ad-billing-input {{billingFieldError ? 'field-error-shake' : ''}}" type="digit" value="{{billingFieldDraft}}" maxlength="18" placeholder="本期应还（元）" disabled="{{saving}}" bindinput="bindBillingField" cursor-spacing="32" aria-label="本期应还" /><view class="ad-billing-mini" bindtap="cancelEditBilling" aria-role="button" aria-label="取消"><image class="ad-billing-mini-icon" src="/assets/icons/close.svg" mode="aspectFit" /></view><view class="ad-billing-mini" bindtap="saveBillingField" aria-role="button" aria-label="保存"><view wx:if="{{!saving}}" class="ad-billing-mini-confirm"><image class="ad-billing-mini-icon" src="/assets/icons/check.svg" mode="aspectFit" /></view></view></view></view>
        <view class="ad-billing-cell"><text class="ad-billing-name">最低还款</text><view wx:if="{{editingBilling !== 'statementMinimum'}}" class="ad-billing-val-row"><text class="ad-billing-val money-number">{{account.statementMinimumText}}</text><view wx:if="{{!account.archived}}" class="ad-billing-edit" data-field="statementMinimum" catchtap="startEditBilling" aria-role="button" aria-label="编辑最低还款"><image class="ad-billing-edit-icon" src="/assets/icons/pencil.svg" mode="aspectFit" /></view></view><view wx:else class="ad-billing-edit-row"><input class="ad-billing-input {{billingFieldError ? 'field-error-shake' : ''}}" type="digit" value="{{billingFieldDraft}}" maxlength="18" placeholder="最低还款（元）" disabled="{{saving}}" bindinput="bindBillingField" cursor-spacing="32" aria-label="最低还款" /><view class="ad-billing-mini" bindtap="cancelEditBilling" aria-role="button" aria-label="取消"><image class="ad-billing-mini-icon" src="/assets/icons/close.svg" mode="aspectFit" /></view><view class="ad-billing-mini" bindtap="saveBillingField" aria-role="button" aria-label="保存"><view wx:if="{{!saving}}" class="ad-billing-mini-confirm"><image class="ad-billing-mini-icon" src="/assets/icons/check.svg" mode="aspectFit" /></view></view></view></view>
      </view>
      <text wx:if="{{billingFieldError}}" class="field-error-inline">{{billingFieldError}}</text>

      <view wx:if="{{accountSourcesLoading || accountSources.length > 0 || accountSourcesError}}" class="account-statement-sources">
        <view class="account-sources-subhead"><view class="account-sources-title-wrap"><view class="account-sources-dot"></view><text class="account-statement-subtitle">账单里的分期</text><text wx:if="{{accountSourcesLoaded && accountSources.length}}" class="account-sources-badge">{{accountSources.length}} 笔待处理</text></view></view>
        <text class="account-sources-hint">识别到的分期还没建计划，新建或归入已有后算进欠款。</text>
        <text wx:if="{{accountSourcesLoading && !accountSourcesLoaded}}" class="account-loans-note">正在读取账单分期…</text>
        <view wx:for="{{accountSources}}" wx:key="key" class="account-source-row">
          <view class="account-loan-copy"><text>{{item.name}}</text><text class="account-loans-note">{{item.periodText}} · {{item.amountText}}</text></view>
          <view wx:if="{{!account.archived}}" class="account-source-actions"><button class="account-source-btn" data-id="{{item.sourceItemId}}" bindtap="createLoanFromSource">新建</button><button class="account-source-btn" data-id="{{item.sourceItemId}}" bindtap="chooseLoanForSource" disabled="{{saving}}">归入</button></view>
        </view>
        <view wx:if="{{accountSourcesError}}" class="account-loans-error" bindtap="loadAccountSources" role="button">{{accountSourcesError}} · 重试</view>
      </view>
    </view>

    <view wx:if="{{account.nature === 'liability'}}" class="account-loans">
      <view class="account-loans-heading"><view class="account-loans-title-group"><text class="account-loans-title">贷款与分期</text></view><button wx:if="{{!account.archived}}" size="mini" class="ad-loans-add" bindtap="createAccountLoan" aria-label="为当前账户新增贷款"><view class="ad-loans-add-icon"><image src="{{themeIconRoot}}/plus.svg" mode="aspectFit" /></view></button></view>
      <view wx:if="{{accountLoansLoaded && accountLoans.length}}" class="account-loans-subhead"><text class="account-loans-count">{{accountLoansActive.length ? accountLoansActive.length + ' 笔进行中' : ''}}{{accountLoansActive.length && accountLoansDone.length ? ' · ' : ''}}{{accountLoansDone.length ? accountLoansDone.length + ' 笔已完成' : ''}}</text><view wx:if="{{accountLoans.length > 1}}" class="ad-loan-sort"><view class="ad-loan-sort-opt {{accountLoanSort === 'time' ? 'is-on' : ''}}" data-mode="time" bindtap="setLoanSort" role="button" aria-label="按时间排序">按时间</view><view class="ad-loan-sort-opt {{accountLoanSort === 'amount' ? 'is-on' : ''}}" data-mode="amount" bindtap="setLoanSort" role="button" aria-label="按金额排序">按金额</view></view></view>
      <text wx:if="{{accountLoansLoading && !accountLoansLoaded}}" class="account-loans-note">正在读取贷款…</text>
      <text wx:if="{{accountLoansLoaded && !accountLoans.length && !accountLoansError}}" class="account-loans-note">{{account.archived ? '此账户没有贷款资料' : '还没有贷款或分期，需要时再添加。'}}普通欠款可直接按账户记账。</text>
      <view wx:for="{{accountLoansActive}}" wx:key="loanId" class="account-loan-row" data-id="{{item.loanId}}" bindtap="openAccountLoan" hover-class="account-row-active" role="button" aria-label="查看贷款 {{item.name}}"><view class="account-loan-copy"><text>{{item.name}}</text><text class="account-loans-note">{{item.scheduleText || item.kindText}} · {{item.statusText}}</text></view><view class="account-loan-amount"><text class="account-loans-note">剩余本金</text><text class="money-number">{{item.principalText}}</text></view><chevron-icon size="{{24}}" /></view>
      <view wx:if="{{accountLoansDone.length}}" class="account-loans-done-heading"><text>已完成</text></view>
      <view wx:for="{{accountLoansDone}}" wx:key="loanId" class="account-loan-row" data-id="{{item.loanId}}" bindtap="openAccountLoan" hover-class="account-row-active" role="button" aria-label="查看贷款 {{item.name}}"><view class="account-loan-copy"><text>{{item.name}}</text><text class="account-loans-note">{{item.scheduleText || item.kindText}} · {{item.statusText}}</text></view><view class="account-loan-amount"><text class="account-loans-note">剩余本金</text><text class="money-number">{{item.principalText}}</text></view><chevron-icon size="{{24}}" /></view>
      <view wx:if="{{accountLoansError}}" class="account-loans-error" bindtap="loadAccountLoans" role="button">{{accountLoansError}} · 重试</view>
    </view>

    <view wx:if="{{sourceChoosing}}" class="sources-mask" catchtouchmove="stopPropagation" bindtap="closeSourceChoosing">
      <view class="sources-sheet" catchtap="stopPropagation">
        <text class="sources-title">归入哪笔分期计划</text>
        <text class="account-loans-note">{{sourceChoosing.source.name}} · {{sourceChoosing.source.periodText}}</text>
        <text wx:if="{{sourceChoosing.loading}}" class="account-loans-note">正在读取…</text>
        <view wx:for="{{sourceChoosing.loans}}" wx:key="loanId" class="sources-choice" data-id="{{item.loanId}}" bindtap="confirmSourceLink"><text>{{item.name}} · {{item.scheduleText}}{{item.samePlan ? ' · 计划名相同' : ''}}</text></view>
        <text wx:if="{{!sourceChoosing.loading && !sourceChoosing.loans.length}}" class="account-loans-note">本卡没有期数相符的分期计划，可先新建分期。</text>
        <text wx:if="{{sourceChoosing.error}}" class="account-loans-error">{{sourceChoosing.error}}</text>
        <button class="secondary-button" bindtap="closeSourceChoosing" disabled="{{saving}}">取消</button>
      </view>
    </view>

    <view wx:if="{{account.needsCorrection}}" class="correction-callout"><text>待校正</text><text>资产账户出现负数，通常表示期初余额或漏记交易需要核对。</text></view>
    <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view>
    <view wx:if="{{accountStatusMessage}}" class="account-loans-note">{{accountStatusMessage}}</view>
    <view wx:if="{{accountStatusRefresh}}" class="ad-actions"><button class="secondary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="loadAccount">刷新账户详情</button></view>
    <view wx:elif="{{pendingAccountAction}}" class="ad-actions"><button class="primary-button primary-button-medium" loading="{{saving}}" disabled="{{saving}}" bindtap="retryAccountStatus">继续原操作</button></view>
    <view wx:elif="{{account.archived}}" class="ad-actions">
      <view class="ad-danger-row">
        <button class="primary-button primary-button-medium ad-danger-row-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="restore">恢复使用</button>
        <button class="secondary-button ad-danger-row-btn ad-danger-action" disabled="{{saving}}" bindtap="removeAccount">彻底删除</button>
      </view>
      <text class="account-loans-note">恢复原账户后可继续转账、还款及维护资料，现有余额、欠款和贷款本金会保留；彻底删除仅适用于没有任何流水或关联记录的账户，删除后不可恢复，有流水请保留归档。</text>
      <view wx:if="{{removeBlockedByRecords}}" class="ad-record-block">
        <text class="ad-record-block-text">该账户仍有流水或关联记录，无法直接删除。下面列出该账户流水，勾选删除后若账户已无记录，会自动继续彻底删除账户。</text>
        <view wx:if="{{removeRecordsLoading}}" class="ad-record-empty"><text>正在读取流水…</text></view>
        <view wx:elif="{{removeRecordsError}}" class="ad-record-empty"><text>{{removeRecordsError}}</text></view>
        <block wx:elif="{{removeRecords.length}}">
          <view class="ad-record-head">
            <text>共 {{removeRecords.length}} 笔</text>
            <switch checked="{{true}}" bindchange="selectAllRemoveRecords" color="#be5b24"></switch>
          </view>
          <scroll-view scroll-y class="ad-record-list">
            <view wx:for="{{removeRecords}}" wx:key="transactionId" class="ad-record-row {{item.selected ? 'ad-record-row-on' : ''}} {{item.selectable ? '' : 'ad-record-row-locked'}}" data-index="{{index}}" bindtap="toggleRemoveRecord" hover-class="ad-record-row-hover">
              <view class="ad-record-check {{item.selected ? 'ad-record-check-on' : ''}}"></view>
              <view class="ad-record-main">
                <text class="ad-record-title">{{item.typeLabel}} · {{item.dateText}}</text>
                <text wx:if="{{item.noteText}}" class="ad-record-note">{{item.noteText}}</text>
                <text wx:else class="ad-record-note">无备注</text>
              </view>
              <text class="ad-record-amount">{{item.amountText}}</text>
            </view>
          </scroll-view>
          <button class="primary-button ad-record-delete" loading="{{removingRecords}}" disabled="{{removingRecords || saving}}" bindtap="deleteRemoveRecords">{{removeRecords.length ? '删除所选流水并删除账户' : '彻底删除账户'}}</button>
        </block>
        <view wx:else class="ad-record-empty"><text>该账户仅剩余额调整等系统记录，可直接删除账户。</text><button class="primary-button ad-record-delete" loading="{{removingRecords}}" disabled="{{removingRecords || saving}}" bindtap="deleteRemoveRecords">彻底删除账户</button></view>
      </view>
    </view>
    <view wx:else class="ad-actions">
      <list-row wx:if="{{account.nature === 'asset'}}" title="校正余额" note="按实际余额补记差额" tone="primary" aria-label="校正账户余额" bindtap="openCorrection" />
      <list-row title="停用账户" note="历史账目和余额仍会保留" tone="danger" aria-label="停用账户" chevron="{{false}}" divider="{{false}}" bindtap="archive" />
    </view>
  </block>
  <view wx:if="{{errorMessage && !account && !loading}}" class="account-error content-inset" bindtap="loadAccount">{{errorMessage}} · 点此重试</view>

  <view wx:if="{{formOpen}}" class="sheet-mask" bindtap="closeForm">
    <view class="account-sheet" catchtap="stopBubble">
      <view class="sheet-handle"></view><text class="sheet-kicker">账户编辑</text><text class="sheet-title serif-title">校正账户余额</text>
      <view class="sheet-field"><text>正确余额</text><input class="sheet-input money-number" type="digit" value="{{balanceYuan}}" placeholder="0.00" maxlength="18" bindinput="bindBalance" aria-label="账户余额（元）" cursor-spacing="32" disabled="{{saving}}" /></view>
      <text class="sheet-note">系统会新增一笔差额调整，不改写旧交易，也不计入收支。</text>
      <view wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</view><button class="primary-button primary-button-medium sheet-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveCorrection">保存</button><button class="secondary-button sheet-cancel" disabled="{{saving}}" bindtap="closeForm">取消</button>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
