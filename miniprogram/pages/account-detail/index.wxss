.account-detail-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.account-error { color: var(--theme-danger, #a95132); }
.account-row-active { background: var(--theme-accent-soft, #f0e2ce); }

.ad-head { padding: 12rpx 0 8rpx; }
.ad-title-line { display: flex; align-items: center; gap: 8rpx; }
.ad-title {
  display: block;
  min-width: 0;
  flex: 0 1 auto;
  font-size: var(--font-title, 40rpx);
  font-weight: 600;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.ad-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.7;
}
.ad-icon-button {
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: var(--theme-text-muted, #746a60);
}
.ad-icon-button:active { opacity: .6; }
.ad-icon-image { width: 32rpx; height: 32rpx; }
.ad-icon-confirm {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  background: var(--theme-accent, #be5b24);
  border-radius: 50%;
}
.ad-icon-confirm .ad-icon-image { width: 28rpx; height: 28rpx; }
.ad-name-form { display: flex; align-items: center; min-width: 0; }
.ad-name-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  color: var(--theme-ink, #29231e);
  font-size: var(--font-body, 28rpx);
  background: var(--theme-surface, #fffdf9);
  border: 1rpx solid var(--theme-border, #d4ccc3);
  border-radius: var(--theme-radius-medium, 18rpx);
}

.ad-card {
  display: flex;
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  align-items: flex-start;
  flex-direction: column;
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-xl, 32rpx);
  box-shadow: var(--theme-shadow-soft);
}
.ad-balance-label { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.ad-balance-value {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  color: var(--theme-ink, #29231e);
  font-size: var(--font-display, 56rpx);
  font-weight: 500;
  line-height: 1.22;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.ad-card-top { display: flex; align-self: stretch; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.ad-card-link { display: flex; flex: 0 0 auto; align-items: center; gap: 4rpx; min-height: 56rpx; color: var(--theme-accent-strong, #a34d20); font-size: var(--font-caption, 24rpx); }
.ad-card-link:active { opacity: .72; }

.ad-billing-line { display: flex; align-self: stretch; align-items: flex-start; gap: 16rpx; padding-top: 20rpx; border-top: 1rpx solid var(--theme-line); }
.ad-billing-cell { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ad-billing-name { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); white-space: nowrap; }
.ad-billing-val-row { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.ad-billing-val { color: var(--theme-ink, #29231e); font-size: var(--font-caption, 24rpx); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ad-billing-edit { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; }
.ad-billing-edit-icon { width: 24rpx; height: 24rpx; opacity: .55; }
.ad-billing-edit:active .ad-billing-edit-icon { opacity: 1; }
.ad-billing-edit-row { display: flex; align-items: center; gap: 6rpx; min-width: 0; }
.ad-billing-input { flex: 1; min-width: 0; height: 40rpx; padding: 0 2rpx; border: 0; border-bottom: 1rpx solid var(--theme-accent, #be5b24); border-radius: 0; background: transparent; color: var(--theme-ink); font-size: var(--font-caption, 24rpx); }
.ad-billing-mini { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; }
.ad-billing-mini-icon { width: 24rpx; height: 24rpx; opacity: .6; }
.ad-billing-mini-confirm { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; background: var(--theme-accent, #be5b24); border-radius: 50%; }
.ad-billing-mini-confirm .ad-billing-mini-icon { width: 22rpx; height: 22rpx; opacity: 1; }

.ad-actions {
  margin-top: 20rpx;
  padding: 0 12rpx;
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-large, 24rpx);
  box-shadow: var(--theme-shadow-soft);
}

.correction-callout {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  color: var(--theme-danger, #a95132);
  background: var(--theme-danger-soft, #f6e4d4);
  border-left: 5rpx solid var(--theme-danger, #a95132);
  border-radius: var(--theme-radius-small, 12rpx);
}
.correction-callout text { display: block; font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.correction-callout text:first-child { font-weight: 500; }

.account-loans { margin-top: 20rpx; padding: 12rpx 24rpx; background: var(--theme-surface, #fffdf9); border-radius: var(--theme-radius-large, 24rpx); box-shadow: var(--theme-shadow-soft); }
.account-loans-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.account-loans-title { font-size: var(--font-section); font-weight: 500; }
.account-loans-heading .ad-loans-add {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 -16rpx 0 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}
.ad-loans-add-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--theme-line, #eae4dc);
  border-radius: 50%;
}
.ad-loans-add-icon image { width: 28rpx; height: 28rpx; }
.account-loans-heading .ad-loans-add:active { opacity: .6; }
.account-loans-note { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.6; }
.account-loan-row { display: flex; align-items: center; gap: 16rpx; min-height: 104rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.account-loan-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.account-loan-amount { text-align: right; overflow-wrap: anywhere; max-width: 45%; }
.account-loans-error { padding: 20rpx 0; color: var(--theme-danger); font-size: var(--font-caption); }
