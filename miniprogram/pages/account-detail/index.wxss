.account-detail-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.account-error { color: var(--theme-danger, #a95132); }
.account-row-active { background: var(--theme-accent-soft, #f0e2ce); }

.ad-card {
  display: flex;
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  align-items: flex-start;
  flex-direction: column;
  background: var(--theme-surface, #fffdf9);
  border-radius: var(--theme-radius-xl, 32rpx);
  box-shadow: var(--theme-shadow-soft);
}
.ad-balance-label { color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.ad-balance-value {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  color: var(--theme-ink, #29231e);
  font-size: var(--font-display, 56rpx);
  font-weight: 500;
  line-height: 1.22;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.ad-balance-state { display: block; margin-top: 10rpx; color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.5; }

.ad-list { margin-top: 20rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }

.detail-action-list { margin-top: 18rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }

.correction-callout {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  color: var(--theme-danger, #a95132);
  background: var(--theme-danger-soft, #f6e4d4);
  border-left: 5rpx solid var(--theme-danger, #a95132);
  border-radius: var(--theme-radius-small, 12rpx);
}
.correction-callout text { display: block; font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.correction-callout text:first-child { font-weight: 500; }

.account-loans { margin-top: 20rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.account-loans-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.account-loans-title { font-size: var(--font-section); font-weight: 500; }
.account-loans-heading .account-loans-add {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: var(--theme-accent, #be5b24);
  border: 0;
  border-radius: 50%;
  line-height: 1;
}
.account-loans-heading .account-loans-add image { width: 36rpx; height: 36rpx; }
.account-loans-heading .account-loans-add:active { opacity: .78; }
.account-loans-note { display: block; color: var(--theme-text-muted); font-size: var(--font-caption); line-height: 1.6; }
.account-loan-row { display: flex; align-items: center; gap: 16rpx; min-height: 104rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.account-loan-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.account-loan-amount { text-align: right; overflow-wrap: anywhere; max-width: 45%; }
.account-loans-error { padding: 20rpx 0; color: var(--theme-danger); font-size: var(--font-caption); }
