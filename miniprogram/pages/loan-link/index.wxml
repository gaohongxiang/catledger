<view class="page-canvas loan-link-page {{themeClass}}" style="{{themeStyle}}">
  <page-head class="content-inset" badge="贷款管理" title="{{transactionId ? (context.state === 'none' ? '账目关联' : '关联这笔还款') : '待关联还款'}}" copy="信用卡整单还款按转账记账，无需关联贷款。这里核对其他借款还款及已有贷款关联。" />
  <block wx:if="{{!transactionId}}">
    <picker class="ll-field" mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><text>查询月份</text><view class="ll-picker"><text class="ll-picker-value">{{month || '全部月份'}}</text><chevron-icon size="{{24}}" /></view></picker>
    <button wx:if="{{month}}" class="ll-link" bindtap="clearMonth">查看全部月份</button>
    <picker class="ll-field" range="{{accounts}}" range-key="name" value="{{accountIndex}}" bindchange="changeAccount"><text>借款账户</text><view class="ll-picker"><text class="ll-picker-value">{{accounts[accountIndex].name || '全部借款账户'}}</text><chevron-icon size="{{24}}" /></view></picker>
  </block>
  <ui-state wx:if="{{loading}}" description="正在核对还款与关联…" />
  <ui-state wx:if="{{errorMessage}}" error description="{{errorMessage}}" />
  <button wx:if="{{errorMessage}}" class="secondary-button ll-action" bindtap="load" disabled="{{loading}}">重新读取，不修改账目</button>
  <block wx:if="{{!transactionId && !errorMessage}}">
    <block wx:if="{{hasLoaded && !loading && items.length === 0}}">
      <ui-state description="当前筛选没有可关联的还款。已经关联的记录请在贷款详情中查看。" />
    </block>
    <view wx:for="{{items}}" wx:key="transactionId" class="ll-candidate" hover-class="ll-candidate-hover" data-id="{{item.transactionId}}" bindtap="selectTransaction" aria-role="button" aria-label="{{item.businessText}} {{item.amountText}}">
      <view class="ll-candidate-top"><text class="ll-candidate-title">{{item.businessText}}</text><text class="ll-candidate-amount money-number">{{item.amountText}}</text></view>
      <text class="ll-note">{{item.accountText}}</text>
      <text class="ll-note">{{item.occurredText}}</text>
      <text wx:if="{{item.inactive}}" class="ll-note ll-warning">关联账户已停用，请核对账户状态</text>
    </view>
  </block>
  <block wx:if="{{context && !errorMessage}}">
    <view class="ll-summary">
      <text class="ll-principal money-number">{{context.amountText}}</text>
      <text class="ll-note">{{context.occurredText}} · {{context.accountText}}</text>
      <text class="ll-note">{{context.businessText}}</text>
    </view>
    <block wx:if="{{context.state === 'candidate'}}">
      <view class="ll-note-card"><text class="ll-note">本金、利息、费用和期次均需确认。不能直接把扣款总额当本金；混有普通账单的扣款不能全部摊给某笔分期。</text></view>
      <ui-state wx:if="{{context.targetAccount.inactive}}" description="付款或负债账户已停用，请在账户管理核对状态；当前不能建立关联。" />
      <block wx:else>
        <button class="primary-button ll-action" bindtap="createLoan" disabled="{{loading}}">新建分期资料并继续关联</button>
        <text class="ll-section-title">选择 {{context.targetAccount.name}} 下的贷款</text>
        <text wx:if="{{!loading && !loans.length}}" class="ll-note">还没有对应贷款资料。创建资料不会重复生成消费或借款。</text>
        <view wx:for="{{loans}}" wx:key="loanId" class="ll-candidate" hover-class="ll-candidate-hover" data-id="{{item.loanId}}" bindtap="selectLoan" aria-role="button" aria-label="{{item.name}} {{item.kindText}}">
          <view class="ll-candidate-top"><text class="ll-candidate-title">{{item.name}} · {{item.kindText}}</text><text class="ll-note">剩余本金 {{item.principalText}}</text></view>
          <text class="ll-action-text">{{item.canLink ? '关联这笔还款' : item.issue + ' · 补全资料'}}</text>
        </view>
      </block>
    </block>
    <button wx:elif="{{context.linked}}" class="primary-button ll-action" bindtap="openPayment" disabled="{{loading}}">{{context.state === 'replaced' ? '原账目已更正，查看当前借还记录' : '已有关联，查看实际借还'}}</button>
    <view wx:else class="ll-note-card"><text class="ll-note">这笔账目无需处理贷款关联，原账目已保留。</text></view>
    <view wx:if="{{context.evidence.items.length}}" class="ll-evidence">
      <text class="ll-section-title">导入来源提供的信息 · 待核对</text>
      <view wx:for="{{context.evidence.items}}" wx:key="index" wx:for-item="evidence"><text class="ll-note">{{evidence.description}}</text>
        <view wx:for="{{evidence.fields}}" wx:key="index" class="ll-row"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
      <text class="ll-note">这些是来源原文，不代表本息费或已付期次已经确认。未提供的字段保持待补充。</text>
      <text wx:if="{{context.evidence.hasMore}}" class="ll-note">这里只展示部分来源信息，原始证据保持不变。</text>
    </view>
  </block>
  <view wx:if="{{!errorMessage && (canPrevious || nextCursor)}}" class="ll-paging">
    <button class="ll-page-button" bindtap="previousPage" disabled="{{loading || !canPrevious}}" aria-label="上一页"><chevron-icon direction="left" size="{{24}}" /><text>上一页</text></button>
    <button class="ll-page-button" bindtap="nextPage" disabled="{{loading || !nextCursor}}" aria-label="下一页"><text>下一页</text><chevron-icon size="{{24}}" /></button>
  </view>
  <login-sheet id="page-login-sheet" />
</view>
