<!-- 页面外壳使用统一主题快照；原生配色由主题生命周期提前同步，page-meta 维护根节点与声明式属性。 -->
<page-meta
  background-text-style="{{themeBackgroundTextStyle}}"
  background-color="{{themePageColor}}"
  background-color-top="{{themePageColor}}"
  background-color-bottom="{{themeCanvasBottom}}"
  root-background-color="{{themePageColor}}"
  page-style="{{themePageStyle}}"
>
  <navigation-bar front-color="{{themeNavFront}}" background-color="{{themeNavBackground}}" />
</page-meta>
<view class="page-canvas about-page {{themeClass}}" style="{{themeStyle}}">
  <view class="content-inset">
    <page-head title="招财猫记账本" copy="把账，记得有温度。以账单导入为主、手动记账为辅。" />
  </view>

  <view class="about-section content-inset">
    <section-header compact title="版本说明" />
    <text class="about-copy">当前为开发版。</text>
  </view>
</view>
