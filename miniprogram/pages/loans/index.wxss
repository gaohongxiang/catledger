.loan-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.loan-row-top, .loan-paging { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.loan-heading { display: block; padding-left: var(--layout-content-inset, 20rpx); padding-right: var(--layout-content-inset, 20rpx); box-sizing: border-box; }
.loan-note, .loan-principal { display: block; }
.loan-note { color: var(--theme-text-muted); font-size: var(--font-caption); }
.loan-create, .loan-link { color: var(--theme-accent-strong); background: transparent; font-size: var(--font-caption); padding: 20rpx; margin: 0; min-height: 88rpx; }
.loan-list { margin-top: 30rpx; }
.loan-row { padding-top: 26rpx; padding-bottom: 26rpx; border-top: 1rpx solid var(--theme-line); }
.loan-name { font-size: var(--font-section); font-weight: 500; overflow-wrap: anywhere; }
.loan-state { color: var(--theme-secondary); font-size: var(--font-caption); flex-shrink: 0; }
.loan-principal { margin: 16rpx 0 8rpx; font-size: var(--font-title); overflow-wrap: anywhere; }
.loan-paging { margin-top: 28rpx; }
.loan-paging button { flex: 1; }
