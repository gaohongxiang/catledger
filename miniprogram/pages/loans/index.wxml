<view class="page-canvas loan-page {{themeClass}}" style="{{themeStyle}}">
  <page-head has-actions class="content-inset" title="{{scopeAccount ? scopeAccount.name : scoped ? '账户贷款' : '全部贷款与还款'}}" copy="{{scoped ? '本账户的贷款与分期，每笔单独核对还款。' : '跨账户查看贷款、分期和待关联还款。'}}"><button wx:if="{{!scoped || (scopeAccount && !scopeAccount.archived)}}" disabled="{{loading}}" size="mini" class="head-cta" bindtap="createLoan" aria-label="新增贷款"><view class="head-cta-label"><image src="/assets/icons/plus-on-accent.svg" mode="aspectFit" /><text>新增贷款</text></view></button></page-head>
  <view wx:if="{{pendingInstallmentCount}}" class="loan-entry" bindtap="openInstallmentSources" aria-role="button"><view class="loan-entry-main"><text class="loan-entry-title">账单里的分期待补充</text><text class="loan-entry-note">新建分期或归入已有记录</text></view><chevron-icon size="{{24}}" /></view>
  <view wx:if="{{pendingRepaymentCount > 0}}" class="loan-entry" bindtap="openUnassigned" hover-class="loan-entry-hover" aria-role="button" aria-label="待关联还款，{{pendingRepaymentCount}}笔">
    <view class="loan-entry-main"><text class="loan-entry-title">待关联还款 · {{pendingRepaymentCount}} 笔</text><text class="loan-entry-note">已入账，待补充贷款关联</text></view>
    <chevron-icon size="{{24}}" />
  </view>
  <ui-state wx:if="{{errorMessage}}" error description="{{errorMessage}} · 重试" bindtap="firstPage" />
  <ui-state wx:if="{{loading && !hasLoaded}}" description="正在读取贷款…" />
  <empty-cat wx:if="{{hasLoaded && !items.length}}" hide-art title="还没有贷款资料" description="{{scoped ? '此账户尚未添加贷款资料。普通欠款可直接按账户记账，需要分期计划时再添加。' : '从负债账户添加贷款，也可在这里选择账户后建立分期计划。'}}" />
  <view class="loan-list">
    <view wx:for="{{items}}" wx:key="loanId" class="loan-row" data-id="{{item.loanId}}" bindtap="openLoan" aria-role="button" aria-label="查看{{item.name}}">
      <view class="loan-row-top"><text class="loan-name">{{item.name}}</text><text class="loan-state">{{item.statusText}}</text></view>
      <text class="loan-note">{{item.kindText}} · {{item.accountName}}</text>
      <text class="loan-principal money-number">{{item.principalText}}</text>
      <text class="loan-note">{{item.progressText || (item.baselineDate ? '本金基准：' + item.baselineDate + ' 日初' : '尚未提供本金基准')}}</text>
      <text wx:if="{{item.scheduleText}}" class="loan-note">分期参数：{{item.scheduleText}}</text>
    </view>
  </view>
  <view wx:if="{{canPrevious || nextCursor}}" class="loan-paging">
    <button class="loan-page-button" disabled="{{loading || !canPrevious}}" bindtap="previousPage" aria-label="上一页"><chevron-icon direction="left" size="{{24}}" /><text>上一页</text></button>
    <button class="loan-page-button" disabled="{{loading || !nextCursor}}" bindtap="nextPage" aria-label="下一页"><text>下一页</text><chevron-icon size="{{24}}" /></button>
  </view>
  <button wx:if="{{canPrevious}}" class="loan-first" disabled="{{loading}}" bindtap="firstPage">回到第一页</button>
  <login-sheet id="page-login-sheet" />
</view>
