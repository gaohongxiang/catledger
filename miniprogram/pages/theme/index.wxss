.theme-page { padding-top: 30rpx; }
.theme-card-kicker,
.theme-card-name,
.theme-card-description,
.theme-footnote { display: block; }
.theme-list { margin-top: 28rpx; }
.theme-card {
  display: flex;
  box-sizing: border-box;
  min-height: 256rpx;
  margin-bottom: var(--layout-space-4);
  overflow: hidden;
  color: var(--preview-ink);
  background: var(--preview-surface);
  border: 2rpx solid var(--preview-line);
  border-radius: var(--preview-radius-large, 24rpx);
  transition: opacity 120ms ease, border-color 120ms ease;
  border-width: 1rpx;
  align-items: stretch;
}
.theme-card:active { opacity: .72; }
.theme-card-selected { border-color: var(--preview-accent); border-width: 2rpx; }
.theme-card-copy {
  display: flex;
  min-width: 0;
  padding: 24rpx 12rpx 24rpx 24rpx;
  flex: 1;
  flex-direction: column;
}
.theme-card-heading {
  position: relative;
  box-sizing: border-box;
  min-height: 0;
  padding-right: 0;
}
.theme-card-kicker {
  color: var(--preview-secondary);
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  letter-spacing: 2rpx;
  display: none;
}
.theme-card-name {
  margin-top: 0;
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.theme-current {
  position: static;
  top: 0;
  right: 0;
  box-sizing: border-box;
  width: auto;
  margin-left: 0;
  padding: 4rpx 12rpx;
  text-align: center;
  color: var(--preview-on-accent);
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  background: var(--preview-accent);
  border-radius: var(--preview-radius-small);
  white-space: nowrap;
  display: inline-block;
  margin-top: 10rpx;
}
.theme-select-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 14rpx;
  height: 14rpx;
  margin: 8rpx 6rpx 0 10rpx;
  border: 2rpx solid var(--preview-border);
  border-radius: 50%;
  display: none;
}
.theme-card-description {
  max-width: none;
  margin-top: var(--layout-space-2);
  color: var(--preview-text-muted);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.6;
}
.theme-swatches {
  display: flex;
  gap: var(--layout-space-1);
  margin-top: auto;
  padding-top: var(--layout-space-3);
}
.theme-swatch { width: 28rpx; height: 8rpx; border-radius: var(--preview-radius-small, 12rpx); }
.theme-swatch-accent { width: 54rpx; background: var(--preview-accent); }
.theme-swatch-secondary { background: var(--preview-secondary); }
.theme-swatch-paper { background: var(--preview-surface-muted); border: 2rpx solid var(--preview-line); }
.ledger-preview {
  box-sizing: border-box;
  width: 190rpx;
  min-width: 190rpx;
  margin: var(--layout-space-3);
  padding: 16rpx 14rpx 12rpx;
  color: var(--preview-hero-ink);
  background: var(--preview-hero-start);
  border-radius: var(--preview-radius-medium, 18rpx);
  align-self: center;
}
.preview-topline {
  display: flex;
  justify-content: space-between;
  color: var(--preview-hero-muted);
  font-size: var(--font-caption, 24rpx);
}
.preview-balance {
  display: block;
  margin-top: var(--layout-space-2);
  color: var(--preview-hero-value-ink);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.preview-chart {
  display: flex;
  height: 74rpx;
  margin-top: var(--layout-space-3);
  align-items: flex-end;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--preview-hero-muted);
}
.preview-column {
  display: flex;
  height: 68rpx;
  align-items: flex-end;
  gap: 4rpx;
}
.preview-income,
.preview-expense { width: 8rpx; min-height: 10rpx; border-radius: var(--preview-radius-small, 12rpx) var(--preview-radius-small, 12rpx) 0 0; }
.preview-income { background: var(--preview-income, #477153); }
.preview-expense { background: var(--preview-expense, #b54738); }
.preview-bar-height-1 { height: 25%; }
.preview-bar-height-2 { height: 43%; }
.preview-bar-height-3 { height: 62%; }
.preview-bar-height-4 { height: 82%; }
.theme-footnote {
  padding: 8rpx 0 18rpx;
  color: var(--theme-text-subtle, #958b82);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.58;
}
