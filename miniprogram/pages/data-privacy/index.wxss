.privacy-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.privacy-section { margin-top: 40rpx; padding: 0 var(--layout-content-inset, 20rpx); }
.privacy-copy { display: block; color: var(--theme-text-muted); font-size: var(--font-body); line-height: 1.75; margin-bottom: var(--layout-space-5); }
.privacy-status { display: block; color: var(--theme-text); font-size: var(--font-body); line-height: 1.6; margin: 20rpx 0; }
.privacy-section button { margin-top: var(--layout-space-3); }
.privacy-section .danger-button { margin-top: 28rpx; }
