@import '../loan-detail/index.wxss';
.source-option { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--theme-line); }
.source-option > view { flex: 1; min-width: 0; }
.loan-payment { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.allocation-panel { border-top: 1rpx solid var(--theme-line); padding: 28rpx 0 12rpx; margin-top: 28rpx; }
.allocation-name, .section-title { display: block; font-size: 30rpx; font-weight: 500; overflow-wrap: anywhere; }
.allocation-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.allocation-heading .detail-link { flex-shrink: 0; margin: 0; padding: 0 12rpx; }
.time-fields { display: flex; gap: 24rpx; }
.time-fields .form-field:first-child { flex: 2; }
.time-fields .form-field:last-child { flex: 1; }
.payment-review { border-left: 6rpx solid var(--theme-accent); padding: 8rpx 24rpx; margin: 32rpx 0; }
.payment-review .section-title { margin-bottom: 18rpx; }
.confirm-label { display: flex; gap: 12rpx; align-items: center; font-size: 26rpx; line-height: 1.6; }
.loan-payment .secondary-button { margin-top: 28rpx; }
.loan-choices { max-height: 600rpx; overflow: auto; border: 1rpx solid var(--theme-line); }
