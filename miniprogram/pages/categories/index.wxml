<view class="page-canvas category-page {{themeClass}}" style="{{themeStyle}}">
  <view class="category-heading">
    <view><text class="category-kicker">CATEGORY BOOK</text><text class="category-title serif-title">分类管理</text></view>
    <button class="category-add" bindtap="openCreate">＋ 新建</button>
  </view>
  <text class="category-intro">分类用于账单导入、手动记账和统计；停用不会改变历史账目。</text>
  <view class="kind-switch">
    <view class="kind-option {{selectedKind === 'expense' ? 'kind-option-selected' : ''}}" data-kind="expense" bindtap="selectKind">支出 {{expenseCategories.length}}</view>
    <view class="kind-option {{selectedKind === 'income' ? 'kind-option-selected' : ''}}" data-kind="income" bindtap="selectKind">收入 {{incomeCategories.length}}</view>
  </view>
  <view class="category-list">
    <view wx:for="{{visibleCategories}}" wx:key="id" class="category-row">
      <view class="category-mark {{selectedKind === 'income' ? 'category-mark-income' : ''}}">{{item.initial}}</view>
      <view class="category-copy" data-id="{{item.id}}" bindtap="openEdit"><text class="category-name">{{item.name}}</text><text class="category-order money-number">{{item.orderText}}</text></view>
      <view class="category-actions">
        <text class="category-action {{item.canMoveUp ? '' : 'category-action-disabled'}}" data-index="{{index}}" data-delta="-1" bindtap="move">↑</text>
        <text class="category-action {{item.canMoveDown ? '' : 'category-action-disabled'}}" data-index="{{index}}" data-delta="1" bindtap="move">↓</text>
        <text class="category-action category-action-danger" data-id="{{item.id}}" bindtap="setArchived">停用</text>
      </view>
    </view>
  </view>
  <view wx:if="{{archivedCategories.length}}" class="archived-section">
    <text class="archived-title">已停用</text>
    <view wx:for="{{archivedCategories}}" wx:key="id" class="archived-row"><text>{{item.name}}</text><text class="restore-action" data-id="{{item.id}}" bindtap="setArchived">恢复</text></view>
  </view>
  <view wx:if="{{loading}}" class="category-status">正在整理分类…</view>
  <view wx:if="{{errorMessage && !formOpen}}" class="category-error" bindtap="loadCategories">{{errorMessage}} · 点此重试</view>
  <view wx:if="{{formOpen}}" class="sheet-backdrop" bindtap="closeForm">
    <view class="category-sheet" catchtap="stopBubble">
      <text class="sheet-kicker">CATEGORY</text><text class="sheet-title">{{formTitle}}</text>
      <input class="category-input" value="{{categoryName}}" maxlength="32" focus="{{formOpen}}" placeholder="例如：宠物、旅行" bindinput="bindCategoryName" />
      <text wx:if="{{errorMessage}}" class="sheet-error">{{errorMessage}}</text>
      <button class="primary-button sheet-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveForm">保存</button>
      <button class="secondary-button sheet-cancel" disabled="{{saving}}" bindtap="closeForm">取消</button>
    </view>
  </view>
</view>
<login-sheet id="page-login-sheet" />
