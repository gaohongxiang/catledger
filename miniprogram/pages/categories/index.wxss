.category-page { padding-top: 30rpx; }
.category-heading,
.kind-switch,
.category-row,
.category-copy,
.category-actions,
.archived-row { display: flex; }
.category-heading { align-items: flex-start; justify-content: space-between; }
.category-kicker,
.category-title,
.category-intro,
.category-name,
.category-order,
.archived-title,
.sheet-kicker,
.sheet-title,
.sheet-error { display: block; }
.category-kicker,
.sheet-kicker { color: var(--theme-secondary, #64705d); font-size: 18rpx; font-weight: 500; letter-spacing: 2rpx; }
.category-title { margin-top: 6rpx; font-size: 32rpx; font-weight: 600; }
.category-add { min-width: 126rpx; min-height: 72rpx; margin: 0; padding: 0 18rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 24rpx; font-weight: 600; line-height: 72rpx; background: var(--theme-accent-soft, #f6e5d8); border-radius: 16rpx; }
.category-add:active { opacity: .7; }
.category-intro { margin-top: 14rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; line-height: 1.55; }
.kind-switch { margin-top: 22rpx; padding: 4rpx; background: var(--theme-surface-muted, #f3eee6); border-radius: 16rpx; }
.kind-option { flex: 1; min-height: 64rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; line-height: 64rpx; text-align: center; border-radius: 12rpx; }
.kind-option-selected { color: var(--theme-accent-strong, #b85f2e); font-weight: 600; background: var(--theme-surface, #fffdf9); }
.category-list { margin-top: 16rpx; border-top: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.category-row { min-height: 96rpx; align-items: center; border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.category-mark { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; flex: 0 0 52rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 22rpx; font-weight: 600; background: var(--theme-accent-soft, #f6e5d8); border-radius: 14rpx; }
.category-mark-income { color: var(--theme-income, #477153); background: var(--theme-secondary-soft, #e8eadf); }
.category-copy { min-width: 0; min-height: 88rpx; margin-left: 14rpx; align-items: center; flex: 1; }
.category-name { min-width: 0; overflow: hidden; font-size: 25rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.category-order { margin-left: 10rpx; color: var(--theme-text-subtle, #958b82); font-size: 20rpx; }
.category-actions { align-items: center; }
.category-action { min-width: 48rpx; min-height: 64rpx; color: var(--theme-secondary, #64705d); font-size: 24rpx; line-height: 64rpx; text-align: center; }
.category-action-danger { min-width: 72rpx; color: var(--theme-danger, #a95132); }
.category-action-disabled { pointer-events: none; opacity: .24; }
.archived-section { margin-top: 30rpx; }
.archived-title { color: var(--theme-text-subtle, #958b82); font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; }
.archived-row { min-height: 88rpx; align-items: center; justify-content: space-between; color: var(--theme-text-muted, #746a60); font-size: 24rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .08)); }
.restore-action { min-width: 88rpx; min-height: 88rpx; color: var(--theme-accent, #d97732); line-height: 88rpx; text-align: right; }
.category-status,
.category-error { min-height: 72rpx; margin-top: 16rpx; color: var(--theme-secondary, #64705d); font-size: 24rpx; line-height: 72rpx; }
.category-error,
.sheet-error { color: var(--theme-danger, #a95132); }
.sheet-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 60; display: flex; align-items: flex-end; background: rgba(38, 31, 26, .36); }
.category-sheet { box-sizing: border-box; width: 100%; padding: 34rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); background: var(--theme-surface, #fffdf9); border-radius: 28rpx 28rpx 0 0; }
.sheet-title { margin-top: 6rpx; font-size: 30rpx; font-weight: 600; }
.category-input { box-sizing: border-box; height: 88rpx; margin-top: 22rpx; padding: 0 20rpx; color: var(--theme-ink, #29231e); font-size: 28rpx; background: var(--theme-surface-muted, #f3eee6); border-radius: 16rpx; }
.sheet-error { margin-top: 14rpx; font-size: 24rpx; }
.sheet-save { margin-top: 24rpx; }
.sheet-cancel { margin-top: 12rpx; }
