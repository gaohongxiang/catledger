<view class="page-shell">
  <view class="ledger-sheet">
    <view class="brand-row">
      <image
        class="brand-logo"
        mode="aspectFill"
        src="/assets/catledger-logo.png"
      />
      <view class="brand-copy">
        <text class="eyebrow">个人账单整理</text>
        <text class="brand-name">猫账</text>
      </view>
    </view>

    <view class="hero-copy">
      <text class="hero-title">账单很多，核对要少。</text>
      <text class="hero-description">
        上传支付宝和微信账单，猫账负责整理；只有真正拿不准的地方，再交给你确认。
      </text>
    </view>

    <view class="rule-line"></view>

    <view class="foundation-card">
      <view class="card-heading">
        <text class="card-index">01</text>
        <view>
          <text class="card-title">你的账本</text>
          <text class="card-caption">首次打开会创建独立账本，并准备常用的收入与支出分类。</text>
        </view>
      </view>

      <view class="status-row">
        <view class="status-mark {{categoryCount > 0 ? 'status-mark-ready' : ''}}"></view>
        <text class="status-label">{{initializationState}}</text>
      </view>

      <text wx:if="{{categoryCount > 0}}" class="category-summary">
        已准备 {{categoryCount}} 个常用分类
      </text>

      <button
        class="connection-button"
        disabled="{{!cloudAvailable || initializing}}"
        loading="{{initializing}}"
        bindtap="initializeLedger"
      >
        重新准备
      </button>
    </view>

    <view class="next-note">
      <text class="next-label">下一步</text>
      <text class="next-copy">上传账单 · 自动整理 · 逐项确认</text>
    </view>
  </view>
</view>
