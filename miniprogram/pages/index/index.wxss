.home-page { padding-top: 24rpx; }
.home-content-line,
.home-flow { box-sizing: border-box; padding-right: 20rpx; padding-left: 20rpx; }
.home-header,
.section-heading,
.timeline-item,
.month-strip,
.month-stat-heading { display: flex; }
.home-header { align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.home-kicker { display: block; color: var(--theme-secondary, #64705d); font-size: 18rpx; font-weight: 500; letter-spacing: 2rpx; }
.section-kicker { display: none; }
.home-title { display: block; margin-top: 6rpx; font-size: 34rpx; font-weight: 600; line-height: 1.26; letter-spacing: -1rpx; }
.home-logo { width: 64rpx; height: 64rpx; border-radius: 16rpx; }

.net-worth-card {
  position: relative;
  box-sizing: border-box;
  min-height: 166rpx;
  padding: 22rpx 26rpx;
  overflow: hidden;
  color: var(--theme-hero-ink, #29231e);
  background: var(--theme-hero-start, #d97732);
  border-radius: var(--theme-radius-large, 24rpx);
}
.net-worth-label,
.net-worth-note { display: block; color: var(--theme-hero-muted, rgba(41, 35, 30, .66)); font-size: 21rpx; }
.net-worth-number { display: block; margin-top: 4rpx; color: var(--theme-hero-value-ink, #fff); font-size: 46rpx; font-weight: 600; letter-spacing: -1rpx; }
.net-worth-note { margin-top: 8rpx; padding-right: 102rpx; }
.cat-stamp {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 96rpx;
  height: 64rpx;
  padding-top: 20rpx;
  color: rgba(255, 250, 241, .82);
  font-size: 16rpx;
  font-weight: 500;
  line-height: 1.05;
  text-align: center;
  letter-spacing: 2rpx;
  background: var(--theme-accent-strong, #b85f2e);
  border-radius: 48rpx 0 0 0;
}
.cat-stamp text { display: block; }

.month-strip {
  position: relative;
  margin-top: 0;
  border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09));
}
.month-stat { flex: 1; min-width: 0; padding: 14rpx 12rpx 16rpx; }
.month-stat-divider { border-right: 1rpx solid var(--theme-line, rgba(41, 35, 30, .08)); }
.month-stat-heading { align-items: center; }
.month-stat-icon { width: 22rpx; height: 22rpx; margin-right: 5rpx; }
.month-stat-label,
.month-stat-value { display: block; }
.month-stat-label { color: var(--theme-text-muted, #746a60); font-size: 20rpx; }
.month-stat-value { margin-top: 4rpx; overflow: hidden; font-size: 24rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.home-login-button {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  color: var(--theme-accent-strong, #b85f2e);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--theme-accent-soft, #f6e5d8);
  border-radius: 16rpx;
}
.home-login-button:active { opacity: .72; }

.section-heading { min-height: 56rpx; align-items: center; justify-content: space-between; margin-top: 24rpx; margin-bottom: 2rpx; }
.section-title { display: block; font-size: 25rpx; font-weight: 500; }
.section-link { min-width: 88rpx; min-height: 56rpx; color: var(--theme-accent, #d97732); font-size: 22rpx; line-height: 56rpx; text-align: right; }
.statistics-heading { margin-top: 20rpx; }

.statistics-card { padding: 12rpx 0 6rpx; border-top: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.statistics-card:active { opacity: .78; }
.statistics-card-heading { display: flex; align-items: center; justify-content: space-between; }
.statistics-card-title { display: flex; min-width: 0; align-items: center; font-size: 22rpx; font-weight: 400; }
.statistics-icon { display: flex; width: 32rpx; height: 32rpx; margin-right: 8rpx; align-items: center; justify-content: center; }
.statistics-icon image { width: 22rpx; height: 22rpx; }
.trend-legend,
.trend-legend-item { display: flex; align-items: center; }
.trend-legend { margin-left: 12rpx; gap: 12rpx; color: var(--theme-text-muted, #746a60); font-size: 20rpx; }
.trend-legend-item { gap: 5rpx; }
.trend-dot { width: 8rpx; height: 8rpx; border-radius: 50%; }
.trend-dot-income { background: var(--theme-income, #477153); }
.trend-dot-expense { background: var(--theme-expense, #b54738); }
.trend-chart { position: relative; height: 126rpx; margin-top: 6rpx; }
.trend-grid { position: absolute; right: 0; left: 0; height: 2rpx; background: var(--theme-line, rgba(41, 35, 30, .06)); }
.trend-grid-top { top: 28rpx; }
.trend-grid-middle { top: 62rpx; }
.trend-columns { position: relative; z-index: 1; display: flex; height: 126rpx; }
.trend-column { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; }
.trend-bars { display: flex; width: 100%; height: 90rpx; align-items: flex-end; justify-content: center; gap: 4rpx; border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .1)); }
.trend-bar { width: 8rpx; min-height: 0; border-radius: 5rpx 5rpx 1rpx 1rpx; }
.trend-bar-income { background: var(--theme-income, #477153); }
.trend-bar-expense { background: var(--theme-expense, #b54738); }
.trend-month { display: block; height: 30rpx; margin-top: 6rpx; color: var(--theme-text-subtle, #958b82); font-size: 20rpx; line-height: 30rpx; }
.statistics-card-empty { padding: 28rpx 0 20rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; text-align: center; }

.account-list { border-top: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-row { display: flex; min-height: 88rpx; align-items: center; border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-row:active,
.timeline-item:active { opacity: .68; }
.account-icon { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; flex: 0 0 auto; background: var(--theme-accent-soft, #f6e5d8); border-radius: 11rpx; }
.account-icon image { width: 25rpx; height: 25rpx; }
.account-name { flex: 1; min-width: 0; margin-left: 12rpx; overflow: hidden; font-size: 23rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.account-value { display: flex; margin-left: 20rpx; align-items: flex-end; flex-direction: column; }
.account-direction,
.account-balance { display: block; }
.account-direction { color: var(--theme-text-muted, #746a60); font-size: 20rpx; }
.account-balance { margin-top: 2rpx; font-size: 23rpx; font-weight: 500; }
.account-empty { padding: 26rpx 0; color: var(--theme-text-muted, #746a60); font-size: 24rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }

.recent-heading { margin-top: 24rpx; }
.timeline { position: relative; }
.timeline::before { display: none; }
.timeline-item { position: relative; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); transition: opacity 120ms ease; }
.timeline-dot { display: none; }
.timeline-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.timeline-label { font-size: 23rpx; font-weight: 400; }
.timeline-meta { margin-top: 3rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.timeline-amount { margin-left: 16rpx; font-size: 23rpx; font-weight: 500; }
.amount-income { color: var(--theme-income, #477153); }
.amount-expense { color: var(--theme-expense, #b54738); }
.amount-neutral { color: var(--theme-text-muted, #746a60); }
.amount-refund { color: var(--theme-accent-strong, #b85f2e); }
.recent-empty { padding: 24rpx 0 28rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.recent-empty-title,
.recent-empty-copy { display: block; }
.recent-empty-title { color: var(--theme-text-muted, #746a60); font-size: 24rpx; font-weight: 400; }
.recent-empty-copy { margin-top: 8rpx; color: var(--theme-text-subtle, #958b82); font-size: 22rpx; line-height: 1.55; }
.sync-note { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; margin-top: 12rpx; color: var(--theme-danger, #a95132); font-size: 24rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.sync-action { color: var(--theme-accent, #d97732); font-weight: 600; }
.sync-note-loading { color: var(--theme-secondary, #64705d); }
