.home-page { padding-top: 36rpx; }
.home-header, .section-heading, .timeline-item, .month-strip, .month-stat-heading { display: flex; }
.home-header { align-items: flex-start; justify-content: space-between; margin-bottom: 28rpx; }
.home-kicker, .section-kicker { display: block; color: var(--theme-secondary, #64705d); font-family: "IBM Plex Sans Condensed", "DIN Alternate", sans-serif; font-weight: 600; letter-spacing: 4rpx; }
.home-kicker { font-size: 19rpx; }
.section-kicker { font-size: 16rpx; }
.home-title { display: block; margin-top: 10rpx; font-size: 36rpx; font-weight: 650; }
.home-logo { width: 78rpx; height: 78rpx; border-radius: var(--theme-radius-small, 20rpx); box-shadow: var(--theme-shadow-soft, 0 8rpx 20rpx rgba(207, 116, 57, 0.14)); }
.net-worth-card { position: relative; box-sizing: border-box; min-height: 244rpx; padding: 34rpx 32rpx; overflow: hidden; color: var(--theme-hero-ink, #29231e); background: linear-gradient(135deg, var(--theme-hero-start, #eca33d) 0%, var(--theme-hero-end, #df7f35) 100%); border-radius: var(--theme-radius-large, 30rpx); box-shadow: var(--theme-shadow-lifted, 0 16rpx 38rpx rgba(145, 87, 36, 0.16)); }
.net-worth-label, .net-worth-note { display: block; color: var(--theme-hero-muted, rgba(51, 38, 23, 0.68)); font-size: 23rpx; }
.net-worth-number { display: block; margin-top: 16rpx; color: var(--theme-hero-ink, #29231e); font-size: 58rpx; font-weight: 650; letter-spacing: -2rpx; }
.net-worth-note { margin-top: 20rpx; }
.cat-stamp { position: absolute; right: -14rpx; bottom: -8rpx; width: 122rpx; height: 92rpx; padding-top: 28rpx; color: rgba(255, 250, 241, 0.72); font-family: "IBM Plex Sans Condensed", "DIN Alternate", sans-serif; font-size: 18rpx; font-weight: 600; line-height: 1.05; text-align: center; letter-spacing: 2rpx; background: var(--theme-accent, #cf7439); border-radius: 64rpx 0 0 0; transform: rotate(-4deg); }
.cat-stamp text { display: block; }
.month-strip { position: relative; z-index: 2; margin: -20rpx 18rpx 0; overflow: hidden; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-border, rgba(111, 88, 65, 0.08)); border-radius: var(--theme-radius-medium, 24rpx); box-shadow: var(--theme-shadow-soft, 0 10rpx 24rpx rgba(74, 50, 30, 0.08)); }
.month-stat { flex: 1; min-width: 0; padding: 18rpx 16rpx; }
.month-stat-divider { border-right: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.month-stat-heading { align-items: center; }
.month-stat-icon { width: 27rpx; height: 27rpx; margin-right: 7rpx; }
.month-stat-label, .month-stat-value { display: block; }
.month-stat-label { color: var(--theme-text-muted, #746a60); font-size: 19rpx; }
.month-stat-value { margin-top: 8rpx; overflow: hidden; color: var(--theme-ink, #29231e); font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.home-login-button { display: flex; min-height: 68rpx; align-items: center; justify-content: center; margin-top: 18rpx; color: #a95a32; font-size: 21rpx; font-weight: 600; background: var(--theme-accent-soft, #f4e4d8); border-radius: var(--theme-radius-small, 18rpx); }
.home-login-button::after { border: 0; }
.section-heading { align-items: flex-end; justify-content: space-between; margin-top: 34rpx; margin-bottom: 12rpx; }
.section-title { display: block; margin-top: 4rpx; font-size: 27rpx; font-weight: 650; }
.section-link { padding: 14rpx 0 2rpx 28rpx; color: var(--theme-accent, #cf7439); font-size: 20rpx; }
.statistics-heading { margin-top: 28rpx; }
.statistics-card { padding: 16rpx 18rpx 14rpx; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-border, rgba(111, 88, 65, 0.1)); border-radius: var(--theme-radius-small, 20rpx); box-shadow: var(--theme-shadow-soft, 0 6rpx 18rpx rgba(74, 50, 30, 0.04)); }
.statistics-card-heading { display: flex; align-items: center; justify-content: space-between; }
.statistics-card-title { display: flex; min-width: 0; align-items: center; color: var(--theme-ink, #332e2a); font-size: 21rpx; font-weight: 600; }
.statistics-icon { display: flex; width: 36rpx; height: 36rpx; margin-right: 10rpx; align-items: center; justify-content: center; background: var(--theme-secondary-soft, #e8eadf); border-radius: 11rpx; }
.statistics-icon image { width: 22rpx; height: 22rpx; }
.trend-legend, .trend-legend-item { display: flex; align-items: center; }
.trend-legend { margin-left: 12rpx; gap: 12rpx; color: var(--theme-text-muted, #8a8179); font-size: 15rpx; }
.trend-legend-item { gap: 5rpx; }
.trend-dot { width: 7rpx; height: 7rpx; border-radius: 50%; }
.trend-dot-income { background: var(--theme-income, #64705d); }
.trend-dot-expense { background: var(--theme-expense, #cf7439); }
.trend-chart { position: relative; height: 150rpx; margin-top: 12rpx; }
.trend-grid { position: absolute; right: 0; left: 0; height: 2rpx; background: var(--theme-line, rgba(41, 35, 30, 0.055)); }
.trend-grid-top { top: 31rpx; }
.trend-grid-middle { top: 67rpx; }
.trend-columns { position: relative; z-index: 1; display: flex; height: 150rpx; }
.trend-column { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; }
.trend-bars { display: flex; width: 100%; height: 108rpx; align-items: flex-end; justify-content: center; gap: 3rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.09)); }
.trend-bar { width: 8rpx; min-height: 0; border-radius: 4rpx 4rpx 1rpx 1rpx; }
.trend-bar-income { background: var(--theme-income, #64705d); }
.trend-bar-expense { background: var(--theme-expense, #cf7439); }
.trend-month { display: block; height: 28rpx; margin-top: 7rpx; color: var(--theme-text-subtle, #958b82); font-size: 15rpx; line-height: 28rpx; }
.statistics-card-empty { padding: 24rpx 0 12rpx; color: var(--theme-text-muted, #8a8179); font-size: 18rpx; text-align: center; }
.account-list { border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.account-row { display: flex; min-height: 76rpx; align-items: center; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.account-icon { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; flex: 0 0 auto; background: var(--theme-accent-soft, #f8e9dc); border-radius: var(--theme-radius-small, 14rpx); }
.account-icon image { width: 25rpx; height: 25rpx; }
.account-name { flex: 1; min-width: 0; margin-left: 14rpx; overflow: hidden; font-size: 22rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.account-value { display: flex; margin-left: 20rpx; align-items: flex-end; flex-direction: column; }
.account-direction, .account-balance { display: block; }
.account-direction { color: var(--theme-text-muted, #8a8179); font-size: 15rpx; }
.account-balance { margin-top: 1rpx; font-size: 22rpx; font-weight: 600; }
.account-empty { padding: 20rpx 0 22rpx; color: var(--theme-text-muted, #8a8179); font-size: 19rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.recent-heading { margin-top: 34rpx; }
.timeline { position: relative; padding-left: 24rpx; }
.timeline::before { position: absolute; top: 24rpx; bottom: 24rpx; left: 5rpx; width: 2rpx; content: ""; background: var(--theme-line, rgba(100, 112, 93, 0.2)); }
.timeline-item { position: relative; align-items: center; min-height: 82rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.timeline-dot { position: absolute; left: -24rpx; width: 10rpx; height: 10rpx; background: var(--theme-accent, #e2913a); border: 4rpx solid var(--theme-page, #f8f3ea); border-radius: 50%; }
.timeline-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.timeline-label { font-size: 23rpx; font-weight: 600; }
.timeline-meta { margin-top: 5rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.timeline-amount { margin-left: 16rpx; font-size: 23rpx; font-weight: 600; }
.amount-income { color: var(--theme-income, #64705d); }
.amount-expense { color: var(--theme-expense, #b25e36); }
.amount-neutral { color: var(--theme-text-muted, #746a60); }
.amount-refund { color: var(--theme-accent-strong, #9b522f); }
.recent-empty { padding: 10rpx 0 20rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, 0.08)); }
.recent-empty-title, .recent-empty-copy { display: block; }
.recent-empty-title { color: var(--theme-ink, #332e2a); font-size: 26rpx; font-weight: 600; }
.recent-empty-copy { margin-top: 9rpx; color: var(--theme-text-muted, #746a60); font-size: 21rpx; line-height: 1.55; }
.recent-empty-pending { opacity: 0.78; }
.sync-note { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 16rpx 2rpx; color: var(--theme-danger, #8a4534); font-size: 21rpx; border-bottom: 2rpx solid rgba(138, 69, 52, 0.12); }
.sync-action { color: var(--theme-accent, #cf7439); font-weight: 600; }
.sync-note-loading { color: var(--theme-secondary, #64705d); }
