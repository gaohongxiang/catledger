.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  background:
    linear-gradient(rgba(71, 96, 74, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(71, 96, 74, 0.045) 1rpx, transparent 1rpx),
    #f4f0e8;
  background-size: 32rpx 32rpx;
}

.ledger-sheet {
  box-sizing: border-box;
  min-height: calc(100vh - 112rpx);
  padding: 48rpx 40rpx 40rpx;
  overflow: hidden;
  background: rgba(255, 253, 248, 0.94);
  border: 2rpx solid rgba(56, 70, 55, 0.12);
  border-radius: 36rpx 36rpx 88rpx 36rpx;
  box-shadow: 0 28rpx 80rpx rgba(76, 55, 34, 0.1);
}

.brand-row,
.card-heading,
.status-row,
.next-note {
  display: flex;
  align-items: center;
}

.brand-logo {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(205, 111, 50, 0.18);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.eyebrow,
.next-label {
  color: #657260;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-name {
  margin-top: 6rpx;
  color: #29231e;
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  margin-top: 88rpx;
}

.hero-title {
  max-width: 560rpx;
  color: #28231f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.16;
}

.hero-description {
  max-width: 580rpx;
  margin-top: 32rpx;
  color: #6e655c;
  font-size: 28rpx;
  line-height: 1.85;
}

.rule-line {
  width: 100%;
  height: 2rpx;
  margin: 56rpx 0 40rpx;
  background: linear-gradient(90deg, #cf7439 0 18%, rgba(56, 70, 55, 0.12) 18% 100%);
}

.foundation-card {
  padding: 34rpx 32rpx 30rpx;
  background: #eef0e8;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
}

.card-heading {
  align-items: flex-start;
}

.card-index {
  flex: 0 0 auto;
  margin-right: 24rpx;
  color: #cf7439;
  font-family: Georgia, serif;
  font-size: 34rpx;
  line-height: 1.2;
}

.card-heading view {
  display: flex;
  flex-direction: column;
}

.card-title {
  color: #2d342c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-caption {
  margin-top: 12rpx;
  color: #737b70;
  font-size: 23rpx;
  line-height: 1.6;
}

.status-row {
  margin-top: 30rpx;
}

.status-mark {
  width: 14rpx;
  height: 14rpx;
  background: #a9aaa4;
  border-radius: 50%;
}

.status-mark-ready {
  background: #cf7439;
  box-shadow: 0 0 0 8rpx rgba(207, 116, 57, 0.12);
}

.status-label {
  margin-left: 18rpx;
  color: #596156;
  font-size: 24rpx;
}

.category-summary {
  display: block;
  margin-top: 18rpx;
  color: #737b70;
  font-size: 23rpx;
}

.connection-button {
  height: 84rpx;
  margin-top: 30rpx;
  color: #fffaf3;
  font-size: 27rpx;
  line-height: 84rpx;
  background: #3f5140;
  border-radius: 42rpx;
}

.connection-button[disabled] {
  color: rgba(255, 250, 243, 0.72);
  background: #7f897d;
}

.next-note {
  align-items: baseline;
  margin-top: 48rpx;
}

.next-copy {
  margin-left: 24rpx;
  color: #73685e;
  font-size: 24rpx;
}
