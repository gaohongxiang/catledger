/* 首页：沿用已确认的清秀样式，业务状态保持原有口径。 */
.home-page {
  padding-top: var(--layout-space-5);
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  color: var(--home-ink, var(--theme-ink, #29231e));
  background: var(--home-page, var(--theme-page, #f7f6f3));
  font-weight: 400;
  line-height: 1.5;
}

/* 首页所有表面都走 --home-* → --theme-* 的既有回退链，
   不为任何单一主题写页面级覆盖：覆盖会让新主题各自长一套私色，也会反向遮蔽基础规则。
   净值卡的渐变同样只从 hero token 取色，换主题即换卡面。 */

.home-page .money-number { font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0; }

.home-content-line,
.home-flow { box-sizing: border-box; padding-right: var(--layout-space-4); padding-left: var(--layout-space-4); }

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: var(--layout-space-3);
}
.home-intro { flex: 1; min-width: 0; padding-right: var(--layout-space-5); }
.home-greeting {
  display: block;
  margin-bottom: 6rpx;
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  line-height: 1.4;
}
.home-title {
  display: block;
  margin-top: 0;
  font-size: var(--font-title, 40rpx);
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
}
.home-logo {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: var(--theme-radius-medium, 18rpx);
}
.home-title-row { display: flex; align-items: center; gap: var(--layout-space-2); }
.home-title-spin { flex-shrink: 0; color: var(--home-muted, var(--theme-text-muted, #726d66)); }

.net-worth-card {
  position: relative;
  box-sizing: border-box;
  /* 与 .home-flow 里的模块卡同一条内容线：卡边一律落在 52rpx 内缩处，不再比下面的卡宽一圈。 */
  margin-right: var(--layout-space-4);
  margin-left: var(--layout-space-4);
  min-height: 224rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  color: var(--theme-hero-ink, #FFFFFF);
  background-color: var(--theme-hero-start, #be5b24);
  background-image: linear-gradient(135deg, var(--theme-hero-start, #be5b24) 0%, var(--theme-hero-end, #be5b24) 100%);
  border: 1rpx solid rgba(0, 0, 0, .035);
  border-radius: var(--theme-radius-xl, 32rpx);
  box-shadow: var(--theme-shadow-lifted);
}
.net-worth-label {
  display: block;
  color: var(--theme-hero-muted, #FFFFFF);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  line-height: 1.4;
}
.net-worth-number {
  display: block;
  margin-top: 14rpx;
  color: var(--theme-hero-value-ink, #FFFFFF);
  font-size: var(--font-display, 56rpx);
  font-weight: 500;
  line-height: 1.22;
  letter-spacing: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}
/* 净值卡：净资产一行，下面资产／负债各一行构成——标签 + 构成条 + 该侧总额，图例再一行横滑。
   本月收支不上首屏：账单滞后一个月导入，本月数字结构性为 0，摆在净资产旁边会被读成没花钱。 */
.net-worth-asof {
  color: var(--theme-hero-muted, #FFFFFF);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
  opacity: .78;
}
/* 两行共用一套网格：第三列（金额）由两条金额里更宽的那条定宽，条取剩余宽度，
   所以金额短的那行条自动变长，两行的条仍然起点、终点对齐；超长金额时条保底 120rpx。 */
.mix-grid {
  display: grid;
  grid-template-columns: auto minmax(120rpx, 1fr) auto;
  column-gap: 12rpx;
  align-items: center;
  margin-top: 16rpx;
}
.mix-label {
  color: var(--theme-hero-muted, #FFFFFF);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
}
.mix-track {
  display: flex;
  min-width: 0;
  height: 12rpx;
  overflow: hidden;
  gap: 2rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .08);
}
.mix-seg {
  min-width: 2rpx;
  height: 100%;
  border-radius: 2rpx;
  background: var(--theme-hero-value-ink, #FFFFFF);
}
/* 构成条与图例圆点共用同一组色阶：只从 hero 令牌派生明暗，不给任何主题写私有颜色。 */
.mix-tone-1 { opacity: 1; }
.mix-tone-2 { opacity: .74; }
.mix-tone-3 { opacity: .54; }
.mix-tone-4 { opacity: .38; }
.mix-tone-5 { opacity: .26; }
.mix-tone-other { background: var(--theme-hero-ink, #FFFFFF); opacity: .15; }
/* 金额列不再写死宽度：网格按两条金额里更长的那条给整列定宽，两行共用同一列，
   数字右端自然对齐，条也能吃掉原来白留的那段。没有这一侧时「—」在列内居中，不顶到最右。 */
.mix-total {
  color: var(--theme-hero-value-ink, #FFFFFF);
  font-size: var(--font-caption, 26rpx);
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.mix-total-empty { text-align: center; }
.mix-legend-scroll { grid-column: 1 / -1; min-width: 0; margin: 8rpx 0; white-space: nowrap; }
.mix-legend { display: inline-flex; align-items: center; gap: 20rpx; min-height: 40rpx; }
.mix-legend-item { display: inline-flex; align-items: center; flex: 0 0 auto; gap: 8rpx; }
.mix-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--theme-hero-value-ink, #FFFFFF);
}
/* 图例是构成条的注释，比正文再低一档：账户名和占比不跟标签、金额抢同一层大小。 */
.mix-legend-text {
  color: var(--theme-hero-muted, #FFFFFF);
  font-size: 22rpx;
  line-height: 1.4;
}

.home-page .home-header .home-login-button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  width: 112rpx;
  min-width: 112rpx;
  min-height: 88rpx;
  flex: 0 0 112rpx;
  margin: 0;
  padding: 0;
  color: var(--theme-accent-strong, #a34d20);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.35;
  background: transparent;
  border: 0;
  border-radius: 0;
}
.home-login-button::after { border: 0; }
.home-login-button:active { opacity: .78; }

/* 首页只有一种容器：模块卡。hero 是它唯一的放大版例外，
   其余三个模块共用同一圆角、同一内边距、同一条 1rpx 分隔线，
   不再各自长一套底色或负边距出血。 */
.home-card {
  margin-top: 24rpx;
  padding: 0 26rpx;
  overflow: hidden;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border: 1rpx solid var(--home-line, var(--theme-line, #eae4dc));
  border-radius: var(--theme-radius-large, 24rpx);
  /* 不用投影：深色主题上黑投影只会把卡压进底色，卡与页面的分界由 1rpx 线和明度差承担。 */
  box-shadow: none;
}
.home-card-head {
  display: block;
  border-bottom: 1rpx solid var(--home-line, var(--theme-line, #eae4dc));
}
.section-link {
  display: flex;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: flex-end;
  padding-left: var(--layout-space-2);
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
  flex-shrink: 0;
}
.statistics-body { padding: 12rpx 0 4rpx; }
.statistics-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}
.statistics-card-title {
  display: flex;
  min-width: 0;
  align-items: center;
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
}
.statistics-icon {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  margin-right: var(--layout-space-1);
  align-items: center;
  justify-content: center;
}
.statistics-icon image { width: 24rpx; height: 24rpx; }
.trend-legend {
  display: flex;
  align-items: center;
  margin: 8rpx 0 8rpx 12rpx;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
}
.trend-legend-item { display: flex; align-items: center; margin-left: 14rpx; }
.trend-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 6rpx;
  border-radius: 50%;
}
.trend-dot-income { background: var(--sem-income, #477153); }
.trend-dot-expense { background: var(--sem-expense, #b54738); }
.trend-chart { position: relative; height: 204rpx; margin-top: var(--layout-space-2); }
.trend-grid {
  position: absolute;
  right: 0;
  left: 0;
  height: 1rpx;
  background: var(--home-line, var(--theme-line, #e5dfd7));
}
.trend-grid-top { top: 12rpx; }
.trend-grid-middle { top: 88rpx; }
.trend-columns { position: relative; display: flex; height: 204rpx; }
.trend-column {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  flex-direction: column;
}
.trend-bars {
  display: flex;
  width: 100%;
  height: 164rpx;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  border-bottom: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7));
}
.trend-bar { width: 12rpx; min-height: 0; border-radius: var(--theme-radius-small, 12rpx) var(--theme-radius-small, 12rpx) 0 0; }
.trend-bar-income { background: var(--sem-income, #477153); }
.trend-bar-expense { background: var(--sem-expense, #b54738); }
.trend-month {
  display: block;
  margin-top: 10rpx;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
}
.statistics-card-empty {
  display: flex;
  min-height: 208rpx;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  text-align: center;
}

.trend-guide {
  display: flex;
  min-height: 208rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 8rpx 0 8rpx;
  text-align: center;
}
.trend-guide-copy {
  display: block;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.7;
}
.trend-guide-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--layout-space-3);
  width: 480rpx;
  max-width: 100%;
  margin: 8rpx auto 0;
}
.trend-guide-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: var(--layout-touch-min, 88rpx);
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 0;
  border-radius: 999rpx;
  color: var(--theme-secondary, #70685f);
  background: transparent;
  font-size: var(--font-caption, 24rpx);
  font-weight: 500;
  line-height: 1.4;
}
.trend-guide-label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 64rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--theme-line, #eae4dc);
  border-radius: 999rpx;
  background: var(--theme-secondary-soft, #f4eee3);
}
.trend-guide-btn:active { opacity: .76; }
.trend-guide-label-soft {
  border-color: transparent;
  color: var(--theme-accent-strong, #a34d20);
  background: var(--theme-accent-soft, #f0e2ce);
}

/* 账户与账目都不再自带容器：它们只是模块卡里的行。 */
.account-list { min-height: 208rpx; }
.account-row {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  padding: 12rpx 0;
  box-sizing: border-box;
}
.account-row + .account-row { border-top: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7)); }
.account-row:active, .timeline-item:active { opacity: .78; }
.account-icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border-radius: var(--theme-radius-small, 12rpx);
}
.account-icon image { width: 28rpx; height: 28rpx; }
.account-name {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  overflow-wrap: anywhere;
  line-height: 1.5;
}
.account-value {
  display: flex;
  min-width: 0;
  max-width: 48%;
  margin-left: var(--layout-space-3);
  align-items: flex-end;
  flex-direction: column;
}
.account-direction {
  display: block;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.4;
}
.account-balance {
  display: block;
  max-width: 100%;
  margin-top: 2rpx;
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.5;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.account-empty {
  display: flex;
  min-height: 208rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 32rpx 0;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.6;
}

.timeline { display: block; }
.timeline-item {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.timeline-item + .timeline-item { border-top: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7)); }
.timeline-dot { display: none; }
.timeline-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}
.timeline-label {
  font-size: var(--font-body, 28rpx);
  font-weight: 400;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.timeline-meta {
  margin-top: 6rpx;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: var(--font-caption, 24rpx);
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.timeline-amount {
  max-width: 48%;
  min-width: 0;
  margin-left: var(--layout-space-3);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1.5;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.amount-income { color: var(--sem-income, #477153); }
.amount-expense { color: var(--sem-expense, #b54738); }
.amount-neutral { color: var(--home-muted, var(--theme-text-muted, #726d66)); }
.amount-refund { color: var(--theme-accent-strong, #a34d20); }

.home-read-status {
  display: flex;
  align-items: center;
  gap: var(--layout-space-3);
  min-height: 64rpx;
  margin: 12rpx 20rpx 0;
  color: var(--theme-text-muted, #726d66);
  font-size: var(--font-caption, 24rpx);
  line-height: 1.5;
}
.home-read-state { display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0; }
.home-read-message { flex: 1; min-width: 0; }
.home-read-status-error { color: var(--theme-danger, #a95132); }
.dashboard-refresh {
  display: flex;
  box-sizing: border-box;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
}
.dashboard-refresh-icon {
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  opacity: 0;
}
.dashboard-refresh-spinning { opacity: 1; animation: dashboard-refresh-spin .8s linear infinite; }
.dashboard-refresh-label { font-size: var(--font-caption, 24rpx); }
@keyframes dashboard-refresh-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
  .dashboard-refresh-spinning { animation: none; }
}

.net-worth-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--layout-space-4); }

.home-login-label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 112rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--theme-accent, #be5b24);
  color: var(--theme-on-accent, #fffaf1);
  font-size: var(--font-body, 28rpx);
  font-weight: 500;
  line-height: 1;
}
