/* 首页视觉样板：只在本页收敛排版，不改全局主题或业务状态。 */
.home-page {
  padding-top: 24rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  color: var(--home-ink, var(--theme-ink, #29231e));
  background: var(--home-page, var(--theme-page, #f7f6f3));
  font-weight: 400;
  line-height: 1.5;
}

/* 样板确认前，其他页面继续使用原来的六主题 token。 */
.home-page.theme-warm-ledger {
  --home-page: #faf8f4;
  --home-surface: #fffefd;
  --home-surface-muted: #f1eee9;
  --home-ink: #2c2823;
  --home-muted: #70685f;
  --home-line: #eae4dc;
  --home-hero-image: linear-gradient(112deg, #d27435, #d97836);
  --home-hero-ink: #291e16;
  --home-hero-value: #ffffff;
  --home-shadow: 0 4rpx 16rpx rgba(61, 44, 28, .035);
}

.home-page .money-number {
  font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.home-content-line,
.home-flow {
  box-sizing: border-box;
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  margin-bottom: 24rpx;
}
.home-intro { flex: 1; min-width: 0; padding-right: 24rpx; }
.home-kicker {
  display: block;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
}
.home-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
}
.home-logo {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
}
.section-kicker { display: none; }

.net-worth-card {
  position: relative;
  box-sizing: border-box;
  min-height: 224rpx;
  padding: 30rpx 32rpx;
  color: var(--home-hero-ink, var(--theme-hero-ink, #29231e));
  background-color: var(--theme-hero-start, #d97732);
  background-image: var(--home-hero-image, none);
  border: 1rpx solid rgba(0, 0, 0, .035);
  border-radius: 30rpx;
  box-shadow: var(--home-shadow, var(--theme-shadow-soft));
}
.net-worth-label {
  display: block;
  color: var(--home-hero-ink, var(--theme-hero-muted, #392718));
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}
.net-worth-number {
  display: block;
  margin-top: 14rpx;
  color: var(--home-hero-value, var(--theme-hero-value-ink, #633921));
  font-size: 64rpx;
  font-weight: 500;
  line-height: 1.22;
  letter-spacing: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.net-worth-note {
  display: block;
  margin-top: 14rpx;
  color: var(--home-hero-ink, var(--theme-hero-muted, #392718));
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

/* 三个摘要不再共用一排表格边线；长金额换行，不省略。 */
.month-strip { display: flex; align-items: stretch; margin: 18rpx -20rpx 0; }
.month-stat {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7));
  border-radius: 22rpx;
  box-shadow: var(--home-shadow, var(--theme-shadow-soft));
}
.month-stat + .month-stat { margin-left: 12rpx; }
.month-stat-heading { display: flex; align-items: center; flex-wrap: wrap; }
.month-stat-icon { width: 24rpx; height: 24rpx; flex-shrink: 0; margin-right: 6rpx; }
.month-stat-label { color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; line-height: 1.4; }
.month-stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}
/* 长金额只改变排列，不截断、不改单位，也不把负号孤立成一行。 */
.month-strip-stacked { display: block; }
.month-strip-stacked .month-stat { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 16rpx 20rpx; }
.month-strip-stacked .month-stat + .month-stat { margin-top: 12rpx; margin-left: 0; }
.month-strip-stacked .month-stat-heading { flex-shrink: 0; }
.month-strip-stacked .month-stat-value { min-width: 0; margin-top: 0; margin-left: 20rpx; text-align: right; }

.home-login-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 24rpx 0 0;
  padding: 16rpx 24rpx;
  color: var(--theme-accent-strong, #a85b2e);
  font-size: 28rpx;
  font-weight: 500;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7));
  border-radius: 22rpx;
}
.home-login-button:active { opacity: .78; }

.section-heading {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}
.section-title { display: block; font-size: 32rpx; font-weight: 500; line-height: 1.4; letter-spacing: 0; }
.section-link {
  display: flex;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: flex-end;
  padding-left: 12rpx;
  color: var(--home-muted, var(--theme-text-muted, #726d66));
  font-size: 24rpx;
  line-height: 1.4;
  flex-shrink: 0;
}
.statistics-heading { margin-top: 24rpx; }
.statistics-card { padding: 8rpx 0 4rpx; }
.statistics-card-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.statistics-card-title { display: flex; min-width: 0; align-items: center; font-size: 24rpx; font-weight: 400; }
.statistics-icon { display: flex; width: 28rpx; height: 28rpx; margin-right: 8rpx; align-items: center; justify-content: center; }
.statistics-icon image { width: 24rpx; height: 24rpx; }
.trend-legend { display: flex; align-items: center; margin: 8rpx 0 8rpx 12rpx; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; }
.trend-legend-item { display: flex; align-items: center; margin-left: 14rpx; }
.trend-dot { width: 10rpx; height: 10rpx; margin-right: 6rpx; border-radius: 50%; }
.trend-dot-income { background: var(--theme-income, #477153); }
.trend-dot-expense { background: var(--theme-expense, #b54738); }
.trend-chart { position: relative; height: 204rpx; margin-top: 12rpx; }
.trend-grid { position: absolute; right: 0; left: 0; height: 1rpx; background: var(--home-line, var(--theme-line, #e5dfd7)); }
.trend-grid-top { top: 12rpx; }
.trend-grid-middle { top: 88rpx; }
.trend-columns { position: relative; display: flex; height: 204rpx; }
.trend-column { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; }
.trend-bars { display: flex; width: 100%; height: 164rpx; align-items: flex-end; justify-content: center; gap: 6rpx; border-bottom: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7)); }
.trend-bar { width: 12rpx; min-height: 0; border-radius: 6rpx 6rpx 0 0; }
.trend-bar-income { background: var(--theme-income, #477153); }
.trend-bar-expense { background: var(--theme-expense, #b54738); }
.trend-month { display: block; margin-top: 10rpx; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; line-height: 1.4; }
.statistics-card-empty { padding: 36rpx 0; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 26rpx; text-align: center; }

.account-list {
  padding: 0 20rpx;
  margin: 0 -20rpx;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7));
  border-radius: 24rpx;
  box-shadow: var(--home-shadow, var(--theme-shadow-soft));
}
.account-row { display: flex; min-height: 96rpx; align-items: center; padding: 12rpx 0; box-sizing: border-box; }
.account-row + .account-row { border-top: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7)); }
.account-row:active, .timeline-item:active { opacity: .78; }
.account-icon { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; flex: 0 0 44rpx; background: var(--home-surface-muted, var(--theme-secondary-soft, #f1eee9)); border-radius: 12rpx; }
.account-icon image { width: 28rpx; height: 28rpx; }
.account-name { flex: 1; min-width: 0; margin-left: 14rpx; font-size: 28rpx; font-weight: 400; overflow-wrap: anywhere; line-height: 1.5; }
.account-value { display: flex; min-width: 0; max-width: 48%; margin-left: 16rpx; align-items: flex-end; flex-direction: column; }
.account-direction { display: block; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 22rpx; line-height: 1.4; }
.account-balance { display: block; max-width: 100%; margin-top: 2rpx; font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: right; overflow-wrap: anywhere; word-break: break-word; }
.account-empty { padding: 32rpx 0; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: var(--font-body-small, 26rpx); line-height: 1.6; }

.recent-heading { margin-top: 28rpx; }
.timeline {
  margin: 0 -20rpx;
  padding: 0 20rpx;
  background: var(--home-surface, var(--theme-surface, #fffefd));
  border: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7));
  border-radius: 24rpx;
  box-shadow: var(--home-shadow, var(--theme-shadow-soft));
}
.timeline-item { display: flex; min-height: 104rpx; align-items: center; padding: 16rpx 0; box-sizing: border-box; }
.timeline-item + .timeline-item { border-top: 1rpx solid var(--home-line, var(--theme-line, #e5dfd7)); }
.timeline-dot { display: none; }
.timeline-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.timeline-label { font-size: 28rpx; font-weight: 400; line-height: 1.5; overflow-wrap: anywhere; }
.timeline-meta { margin-top: 6rpx; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.timeline-amount { max-width: 48%; min-width: 0; margin-left: 16rpx; font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: right; overflow-wrap: anywhere; word-break: break-word; }
.amount-income { color: var(--theme-income, #477153); }
.amount-expense { color: var(--theme-expense, #b54738); }
.amount-neutral { color: var(--home-muted, var(--theme-text-muted, #726d66)); }
.amount-refund { color: var(--theme-accent-strong, #a85b2e); }
.recent-empty { padding: 24rpx 0 32rpx; }
.recent-empty-title { display: block; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: var(--font-body-small, 26rpx); font-weight: 400; line-height: 1.6; }
.recent-empty-copy { display: block; margin-top: 8rpx; color: var(--home-muted, var(--theme-text-muted, #726d66)); font-size: 24rpx; line-height: 1.6; }

.account-heading-title { display: flex; min-width: 0; align-items: center; }
.dashboard-refresh { display: flex; box-sizing: border-box; width: 88rpx; min-width: 88rpx; height: 88rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: var(--home-muted, var(--theme-text-muted, #726d66)); background: transparent; border: 0; border-radius: 0; line-height: 1; }
.dashboard-refresh-icon { box-sizing: border-box; width: 22rpx; height: 22rpx; border: 2rpx solid currentColor; border-right-color: transparent; border-radius: 50%; opacity: 0; }
.dashboard-refresh-spinning { opacity: 1; animation: dashboard-refresh-spin .8s linear infinite; }
.dashboard-refresh-error { color: var(--theme-danger, #a95132); }
.dashboard-refresh-label { font-size: 24rpx; }
@keyframes dashboard-refresh-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
  .dashboard-refresh-spinning { animation: none; }
}
