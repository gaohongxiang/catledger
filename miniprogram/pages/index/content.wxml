<view class="page-canvas home-page {{themeClass}}" style="{{themeStyle}}">
  <view class="home-header home-content-line">
    <view class="home-intro">
      <text class="home-greeting">{{todayLabel}}</text>
      <view class="home-title-row"><text class="home-title serif-title">{{greeting}}</text><view wx:if="{{loggedIn && loading}}" class="dashboard-refresh-icon dashboard-refresh-spinning home-title-spin" aria-role="status" aria-label="正在更新" /></view>
    </view>
    <button wx:if="{{!loggedIn}}" class="home-login-button" size="mini" bindtap="promptWechatLogin"><text class="home-login-label">登录</text></button>
    <image wx:else class="home-logo" src="{{displayAvatarUrl}}" mode="aspectFill" />
  </view>

  <empty-state wx:if="{{!cloudAvailable}}" title="当前基础库不支持云开发" description="请升级微信开发者工具或小程序基础库后再打开招财猫记账本。" />

  <block wx:else>
    <view class="net-worth-card">
      <view class="net-worth-columns">
        <view class="net-worth-main">
          <view class="net-worth-heading">
            <text class="net-worth-label">当前净资产</text>
          </view>
          <ticker-number class="net-worth-number money-number" value="{{loggedIn && hasDashboard ? netWorthText : '—'}}" />
          <view class="net-worth-parts">
            <view class="net-worth-part"><text class="net-worth-part-label">总资产</text><text class="net-worth-part-value money-number">{{loggedIn && hasDashboard ? assetsText : '—'}}</text></view>
            <view class="net-worth-part"><text class="net-worth-part-label">总负债</text><text class="net-worth-part-value money-number">{{loggedIn && hasDashboard ? liabilitiesText : '—'}}</text></view>
          </view>
        </view>
        <view class="net-worth-split" aria-hidden="true"></view>
        <view class="net-worth-side">
          <text class="net-worth-label">本月收支</text>
          <ticker-number class="net-worth-number money-number" value="{{loggedIn && hasDashboard ? monthNetText : '—'}}" />
          <view class="net-worth-parts">
            <view class="net-worth-part"><text class="net-worth-part-label">支出</text><text class="net-worth-part-value money-number">{{loggedIn && hasDashboard ? monthExpenseText : '—'}}</text></view>
            <view class="net-worth-part"><text class="net-worth-part-label">收入</text><text class="net-worth-part-value money-number">{{loggedIn && hasDashboard ? monthIncomeText : '—'}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loggedIn && !loading && (errorMessage || dashboardStatus || chargeSyncMessage)}}" class="home-read-status {{(errorMessage || chargeSyncMessage) ? 'home-read-status-error' : ''}}" aria-role="{{errorMessage ? 'alert' : 'status'}}">
      <view class="home-read-state">
        <text class="home-read-message">{{errorMessage || chargeSyncMessage || dashboardStatus}}</text>
      </view>
      <view class="dashboard-refresh" bindtap="loadDashboard" hover-class="none" aria-role="button" aria-label="重新读取首页全部数据"><text class="dashboard-refresh-label">重试</text></view>
    </view>
    <view class="home-flow">


    <section-header class="section-heading statistics-heading" compact title="统计分析">
        <text class="section-link" bindtap="openStatistics">全部</text>
    </section-header>

    <view class="statistics-card" role="button" aria-label="查看全部统计" bindtap="openStatistics">
        <view class="statistics-card-heading">
          <view class="statistics-card-title">
            <view class="statistics-icon"><image src="{{themeIconRoot}}/statistics.svg" mode="aspectFit" /></view>
            <text>近半年收支趋势</text>
          </view>
          <view class="trend-legend">
            <view class="trend-legend-item"><view class="trend-dot trend-dot-income"></view><text>收入</text></view>
            <view class="trend-legend-item"><view class="trend-dot trend-dot-expense"></view><text>支出</text></view>
          </view>
        </view>
        <view wx:if="{{cashFlowTrend.length > 0 && !trendSparse}}" class="trend-chart">
          <view class="trend-grid trend-grid-top"></view>
          <view class="trend-grid trend-grid-middle"></view>
          <view class="trend-columns">
            <view wx:for="{{cashFlowTrend}}" wx:key="month" class="trend-column">
              <view class="trend-bars">
                <view class="trend-bar trend-bar-income" style="height: {{item.incomeHeight}}%;"></view>
                <view class="trend-bar trend-bar-expense" style="height: {{item.expenseHeight}}%;"></view>
              </view>
              <text class="trend-month money-number">{{item.showMonth ? item.monthText : ''}}</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{cashFlowTrend.length > 0 && trendSparse}}" class="trend-guide">
          <text class="trend-guide-copy">记几笔之后，这里会长出趋势。</text>
          <view class="trend-guide-actions">
            <button id="trend-manual-entry" class="trend-guide-btn" catchtap="createTransaction"><text class="trend-guide-label trend-guide-label-soft">记一笔</text></button>
            <button id="trend-import-entry" class="trend-guide-btn" catchtap="openImport"><text class="trend-guide-label trend-guide-label-soft">导入账单</text></button>
          </view>
        </view>
        <skeleton-rows wx:elif="{{!loggedIn && identityPending}}" rows="{{2}}" />
        <view wx:elif="{{!loggedIn}}" class="statistics-card-empty">暂无收支数据</view>
        <view wx:elif="{{loading}}" class="statistics-card-empty">正在汇总收支趋势…</view>
        <view wx:elif="{{trendReady}}" class="statistics-card-empty">近半年还没有收支</view>
        <view wx:else class="statistics-card-empty">统计数据暂未连接</view>
    </view>

    <section-header class="section-heading" compact title="账户余额">
        <text class="section-link" bindtap="openAccounts">全部</text>
    </section-header>

    <view wx:if="{{accounts.length > 0}}" class="account-list">
        <view wx:for="{{accounts}}" wx:key="accountId" class="account-row" bindtap="openAccounts">
          <view class="account-icon"><image src="{{themeIconRoot}}/{{item.iconPath}}" mode="aspectFit" /></view>
          <text class="account-name">{{item.name}}</text>
          <view class="account-value">
            <text class="account-direction">{{item.directionText}}</text>
            <text class="account-balance money-number">{{item.balanceText}}</text>
          </view>
        </view>
    </view>
    <skeleton-rows wx:elif="{{loading && !hasDashboard}}" rows="{{2}}" />
    <skeleton-rows wx:elif="{{!loggedIn && identityPending}}" rows="{{2}}" />
    <view wx:elif="{{loggedIn && !hasDashboard}}" class="account-empty">账户暂未读取</view>
    <view wx:else class="account-empty">{{loggedIn ? '还没有账户，添加后会显示在这里' : '登录后查看你的账户'}}</view>

    <section-header class="section-heading recent-heading" compact title="最近账目">
        <text wx:if="{{hasDashboard}}" class="section-link" bindtap="openTransactions">全部</text>
    </section-header>

    <block wx:if="{{hasDashboard}}">
      <view wx:if="{{recentTransactions.length > 0}}" class="timeline">
        <view
          wx:for="{{recentTransactions}}"
          wx:key="transactionId"
          class="timeline-item row-enter"
          style="animation-delay: {{index < 10 ? index * 70 : 700}}ms"
          data-index="{{index}}"
          bindtap="editTransaction"
        >
          <view class="timeline-dot {{item.amountClass}}"></view>
          <view class="timeline-copy">
            <text class="timeline-label">{{item.label}}</text>
            <text class="timeline-meta">{{item.accountLine}} · {{item.timeText}}</text>
          </view>
          <text class="timeline-amount money-number {{item.amountClass}}">{{item.amountText}}</text>
        </view>
      </view>
      <empty-cat wx:else title="还没有账目" description="导入或手动记录后，最新账目会出现在这里。" />
    </block>
    <skeleton-rows wx:elif="{{loading}}" rows="{{3}}" />
    <skeleton-rows wx:elif="{{!loggedIn && identityPending}}" rows="{{3}}" />
    <empty-cat wx:else title="{{errorMessage ? '账目暂未读取' : '登录后查看最近账目'}}" description="导入或手动记录后，最新账目会出现在这里。" />
    </view>
  </block>
</view>
