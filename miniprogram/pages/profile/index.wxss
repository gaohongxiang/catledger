.profile-page { padding-top: 30rpx; }
.profile-hero,
.identity-status,
.profile-summary,
.profile-row { display: flex; }
.profile-hero { min-height: 112rpx; align-items: center; }
.profile-logo { width: 96rpx; height: 96rpx; flex: 0 0 auto; border-radius: 24rpx; }
.profile-logo { object-fit: cover; }
.profile-copy { min-width: 0; margin-left: 18rpx; flex: 1; }
.profile-kicker,
.profile-section-kicker { display: block; color: var(--theme-secondary, #64705d); font-size: 18rpx; font-weight: 500; letter-spacing: 2rpx; }
.profile-title { display: block; margin-top: 4rpx; overflow: hidden; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.identity-status { align-items: center; margin-top: 6rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.identity-status-retryable { transition: opacity 120ms ease; }
.identity-status-retryable:active { opacity: .58; }
.identity-retry { margin-left: 10rpx; color: var(--theme-accent-strong, #b85f2e); font-weight: 500; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 8rpx; background: var(--theme-text-subtle, #958b82); border-radius: 50%; }
.status-dot-connected { background: var(--theme-secondary, #64705d); }
.profile-login-button { display: flex; min-width: 112rpx; min-height: 72rpx; align-items: center; justify-content: center; margin-left: 12rpx; color: var(--theme-on-accent, #fffaf1); font-size: 24rpx; font-weight: 600; background: var(--theme-accent, #d97732); border-radius: 16rpx; }
.profile-login-button:active { opacity: .74; }

.profile-summary { align-items: center; margin-top: 24rpx; padding: 18rpx 0; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.summary-cell { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; }
.summary-divider { width: 2rpx; height: 42rpx; background: var(--theme-line, rgba(41, 35, 30, .09)); }
.summary-number { font-size: 28rpx; font-weight: 500; }
.summary-cloud { font-size: 26rpx; line-height: 40rpx; }
.summary-label { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }

.profile-section-kicker { margin-top: 40rpx; }
.profile-menu { margin-top: 8rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.profile-row { min-height: 104rpx; align-items: center; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); transition: opacity 120ms ease; }
.profile-row:active { opacity: .65; }
.row-copy { min-width: 0; flex: 1; }
.row-title,
.row-note { display: block; }
.row-title { font-size: 26rpx; font-weight: 500; }
.row-note { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.row-chevron { width: 14rpx; height: 14rpx; margin-left: 18rpx; border-top: 3rpx solid var(--theme-text-subtle, #958b82); border-right: 3rpx solid var(--theme-text-subtle, #958b82); transform: rotate(45deg); }
.profile-logout-row { margin-top: 12rpx; }
.profile-logout-title { color: var(--theme-danger, #a95132); }
.profile-logout-chevron { border-color: var(--theme-danger, #a95132); opacity: .56; }
