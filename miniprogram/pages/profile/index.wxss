.profile-page { padding-top: 30rpx; }
.profile-hero {
  display: flex;
  min-height: 160rpx;
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.profile-logo {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: var(--theme-radius-large, 24rpx);
}
.profile-logo { object-fit: cover; }
.profile-copy { min-width: 0; margin-left: 18rpx; flex: 1; }
.profile-kicker,
.profile-section-kicker {
  display: block;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  letter-spacing: 0;
  margin-top: 36rpx;
}
.profile-title {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.4;
}
.profile-page .profile-hero .profile-login-button {
  display: flex;
  width: 112rpx;
  min-width: 112rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 12rpx;
  padding: 0;
  background: transparent;
  border: 0;
  flex: 0 0 112rpx;
}
.profile-login-label { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 56rpx; border-radius: 999rpx; color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #be5b24); font-size: var(--font-body, 28rpx); font-weight: 500; line-height: 1; }
.profile-login-button:active { opacity: .74; }

.profile-section-kicker { margin-top: 40rpx; }
.profile-menu {
  margin-top: 12rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
  overflow: hidden;
  padding: 0 8rpx;
}

.profile-page .profile-hero .profile-id {
  display: flex; align-items: flex-start; box-sizing: border-box; width: 100%; min-height: 64rpx;
  margin: 4rpx 0 0; padding: 8rpx 0; border: 0; border-radius: 0; background: transparent;
  color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); font-weight: 400;
  line-height: 1.5; text-align: left;
}
.profile-id::after { border: 0; }
.profile-id:active { opacity: .65; }
.profile-id-label { flex: 0 0 auto; margin-right: 10rpx; }
.profile-id-value { flex: 0 1 auto; min-width: 0; font-variant-numeric: tabular-nums; word-break: break-all; }
.profile-id-copy { flex: 0 0 auto; margin-left: 12rpx; color: var(--theme-accent-strong, #a34d20); }

.profile-id-pending { display: flex; align-items: center; min-height: 64rpx; color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.profile-id-retry { display: flex; align-items: center; min-height: 64rpx; margin-left: 12rpx; padding: 0 8rpx; color: var(--theme-accent-strong, #a34d20); }
