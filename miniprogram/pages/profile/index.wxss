.profile-page { padding-top: 30rpx; }
.profile-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--theme-surface, #fffefd);
  border-radius: var(--theme-radius-xl, 32rpx);
  box-shadow: var(--theme-shadow-soft);
}
.profile-hero {
  display: flex;
  align-items: center;
}
.profile-logo {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: var(--theme-radius-large, 24rpx);
}
.profile-logo { object-fit: cover; }
.profile-logo-static { display: block; }
.profile-page .profile-avatar-button {
  display: flex;
  width: 96rpx;
  min-width: 96rpx;
  height: 96rpx;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 96rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: var(--theme-radius-large, 24rpx);
  line-height: 1;
}
.profile-avatar-button::after { border: 0; }
.profile-avatar-button:active { opacity: .72; }
.profile-avatar-saving { opacity: .55; }
.profile-copy { min-width: 0; margin-left: 20rpx; flex: 1; }
.profile-kicker,
.profile-section-kicker {
  display: block;
  color: var(--theme-secondary, #64705d);
  font-size: var(--font-caption, 24rpx);
  font-weight: 400;
  letter-spacing: 0;
  margin-top: 36rpx;
}
.profile-title {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: var(--font-section, 32rpx);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.4;
}
.profile-name-line { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.profile-name-line .profile-title { flex: 0 1 auto; min-width: 0; }
.profile-page .profile-icon-button {
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  margin: 0;
  padding: 0;
  color: var(--theme-text-muted, #746a60);
  background: transparent;
  border: 0;
  line-height: 1;
}
.profile-icon-button::after { border: 0; }
.profile-icon-button:active { opacity: .6; }
.profile-icon-hover { opacity: .6; }
.profile-icon-image { width: 32rpx; height: 32rpx; }
.profile-icon-confirm {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  background: var(--theme-accent, #be5b24);
  border-radius: 50%;
}
.profile-icon-confirm .profile-icon-image { width: 28rpx; height: 28rpx; }
.profile-name-form { display: flex; align-items: center; flex-wrap: nowrap; gap: 12rpx; min-width: 0; }
.profile-name-input {
  flex: 1; min-width: 0; height: 72rpx; padding: 0 16rpx;
  border: 1rpx solid var(--theme-line); border-radius: var(--theme-radius-small, 12rpx);
  color: var(--theme-ink); font-size: var(--font-body, 28rpx);
}
.profile-name-error { display: block; margin-top: 4rpx; color: var(--theme-danger, #a95132); font-size: var(--font-caption, 24rpx); }
.profile-page .profile-login-button {
  display: flex;
  width: 112rpx;
  min-width: 112rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  flex: 0 0 112rpx;
}
.profile-login-label { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 56rpx; border-radius: 999rpx; color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #be5b24); font-size: var(--font-body, 28rpx); font-weight: 500; line-height: 1; }
.profile-login-button:active { opacity: .74; }

.profile-section-kicker { margin-top: 40rpx; }
.profile-menu {
  margin-top: 12rpx;
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: var(--theme-radius-large, 24rpx);
  overflow: hidden;
  padding: 0 8rpx;
}

.profile-id-line {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--theme-line, #eae4dc);
  color: var(--theme-text-muted, #746a60);
  font-size: var(--font-caption, 24rpx);
}
.profile-id-label { flex: 0 0 auto; }
.profile-id-value { flex: 1; min-width: 0; font-variant-numeric: tabular-nums; word-break: break-all; }
.profile-id-line .profile-icon-button { flex: 0 0 88rpx; margin-right: -20rpx; }

.profile-id-pending { display: flex; align-items: center; min-height: 88rpx; margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid var(--theme-line, #eae4dc); color: var(--theme-text-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.profile-id-retry { display: flex; align-items: center; min-height: 88rpx; margin-left: 12rpx; padding: 0 8rpx; color: var(--theme-accent-strong, #a34d20); }
