.profile-page { padding-top: 30rpx; }
.profile-hero,
.profile-row { display: flex; }
.profile-row {
  min-height: 124rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--theme-line);
}
.profile-hero {
  min-height: 160rpx;
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.profile-logo {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: 24rpx;
}
.profile-logo { object-fit: cover; }
.profile-copy { min-width: 0; margin-left: 18rpx; flex: 1; }
.profile-kicker,
.profile-section-kicker {
  display: block;
  color: var(--theme-secondary, #64705d);
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 0;
  margin-top: 36rpx;
}
.profile-title {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.4;
}
.profile-page .profile-hero .profile-login-button {
  display: flex;
  width: 112rpx;
  min-width: 112rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 12rpx;
  padding: 0;
  background: transparent;
  border: 0;
  flex: 0 0 112rpx;
}
.profile-login-label { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 56rpx; border-radius: 999rpx; color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #d97732); font-size: 28rpx; font-weight: 500; line-height: 1; }
.profile-login-button:active { opacity: .74; }

.profile-section-kicker { margin-top: 40rpx; }
.profile-menu {
  margin-top: 12rpx;
  border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  background: var(--theme-surface);
  border: 1rpx solid var(--theme-line);
  border-radius: 24rpx;
  overflow: hidden;
  padding: 0 8rpx;
}
.profile-row {
  min-height: 96rpx;
  align-items: center;
  border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09));
  transition: opacity 120ms ease;
}
.profile-row:active { opacity: .65; }
.row-copy { min-width: 0; flex: 1; }
.row-title,
.row-note { display: block; line-height: 1.5; }
.row-title { font-size: var(--font-body, 28rpx); font-weight: 400; line-height: 1.5; }
.row-note { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; }
.row-chevron {
  width: 14rpx;
  height: 14rpx;
  margin-left: 18rpx;
  border-top: 3rpx solid var(--theme-text-subtle, #958b82);
  border-right: 3rpx solid var(--theme-text-subtle, #958b82);
  transform: rotate(45deg);
}
.profile-logout-row { margin-top: 0; }
.profile-logout-title { color: var(--theme-danger, #a95132); }
.profile-logout-chevron { border-color: var(--theme-danger, #a95132); opacity: .56; }


.profile-row:last-child { border-bottom: 0; }

.profile-page .profile-hero .profile-id {
  display: flex; align-items: flex-start; box-sizing: border-box; width: 100%; min-height: 64rpx;
  margin: 4rpx 0 0; padding: 8rpx 0; border: 0; border-radius: 0; background: transparent;
  color: var(--theme-text-muted, #746a60); font-size: 22rpx; font-weight: 400;
  line-height: 1.5; text-align: left;
}
.profile-id::after { border: 0; }
.profile-id:active { opacity: .65; }
.profile-id-label { flex: 0 0 auto; margin-right: 10rpx; }
.profile-id-value { flex: 0 1 auto; min-width: 0; word-break: break-all; }
.profile-id-copy { flex: 0 0 auto; margin-left: 12rpx; color: var(--theme-accent-strong, #a85b2e); }

.profile-id-pending { display: flex; align-items: center; min-height: 64rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.profile-id-retry { display: flex; align-items: center; min-height: 64rpx; margin-left: 12rpx; padding: 0 8rpx; color: var(--theme-accent-strong, #a85b2e); }
