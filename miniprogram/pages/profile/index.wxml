<view class="page-canvas profile-page {{themeClass}}" style="{{themeStyle}}">
  <view class="profile-hero">
    <image class="profile-logo" src="{{displayAvatarUrl}}" mode="aspectFill" />
    <view class="profile-copy">
      <text class="profile-kicker">MY PROFILE</text>
      <text class="profile-title serif-title">{{loggedIn ? (nickname || '微信用户') : '尚未登录'}}</text>
      <view class="identity-status {{syncActionText ? 'identity-status-retryable' : ''}}" bindtap="retryProfile">
        <view class="status-dot {{connected ? 'status-dot-connected' : ''}}"></view>
        <text>{{identityStatusText}}</text>
        <text wx:if="{{syncActionText}}" class="identity-retry">{{syncActionText}}</text>
      </view>
    </view>
    <button wx:if="{{!loggedIn}}" class="profile-login-button" bindtap="promptWechatLogin">登录</button>
  </view>

  <view class="profile-summary">
    <view class="summary-cell">
      <text class="summary-number money-number">{{loggedIn ? accountCount : '—'}}</text>
      <text class="summary-label">活动账户</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-cell">
      <text class="summary-number money-number">{{loggedIn ? categoryCount : '—'}}</text>
      <text class="summary-label">收支分类</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-cell">
      <text class="summary-number summary-cloud">{{loggedIn ? '云端' : '—'}}</text>
      <text class="summary-label">数据位置</text>
    </view>
  </view>

  <text class="profile-section-kicker">ACCOUNT & DATA</text>
  <view class="profile-menu">
    <view class="profile-row" role="button" aria-label="选择视觉主题" bindtap="openTheme">
      <view class="row-copy">
        <text class="row-title">主题</text>
        <text class="row-note">{{themeName}}</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view class="profile-row" role="button" aria-label="查看数据与隐私" bindtap="showPrivacy">
      <view class="row-copy">
        <text class="row-title">数据与隐私</text>
        <text class="row-note">身份与账单文件说明</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view class="profile-row" role="button" aria-label="查看关于猫账" bindtap="showAbout">
      <view class="row-copy">
        <text class="row-title">关于猫账</text>
        <text class="row-note">开发版</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view wx:if="{{loggedIn}}" class="profile-row profile-logout-row" role="button" aria-label="退出登录" bindtap="logoutAccount">
      <view class="row-copy">
        <text class="row-title profile-logout-title">退出登录</text>
        <text class="row-note">只退出本机，不删除云端账本</text>
      </view>
      <view class="row-chevron profile-logout-chevron"></view>
    </view>
  </view>

</view>
