<view class="page-canvas profile-page {{themeClass}}" style="{{themeStyle}}">
  <view class="profile-hero content-inset">
    <image class="profile-logo" src="{{displayAvatarUrl}}" mode="aspectFill" />
    <view class="profile-copy">

      <text class="profile-title serif-title">{{loggedIn ? (nickname || '微信用户') : '尚未登录'}}</text>
      <button wx:if="{{loggedIn && uid}}" class="profile-id" aria-label="复制完整 ID" bindtap="copyId">
        <text class="profile-id-label">ID</text>
        <text class="profile-id-value">{{displayUid}}</text>
        <text class="profile-id-copy">复制</text>
      </button>
      <view wx:elif="{{loggedIn}}" class="profile-id-pending">
        <text>ID {{loading ? '读取中…' : '暂未获取'}}</text>
        <text wx:if="{{!loading}}" class="profile-id-retry" bindtap="retryProfile" aria-role="button">重试</text>
      </view>
    </view>
    <button wx:if="{{!loggedIn}}" class="profile-login-button" size="mini" bindtap="promptWechatLogin"><text class="profile-login-label">登录</text></button>
  </view>

  <view wx:if="{{errorMessage}}" class="ui-state ui-state-error" bindtap="retryProfile" aria-role="button">{{errorMessage}} · 点此重试</view>

  <text class="profile-section-kicker content-inset">账本管理</text>
  <view class="profile-menu">
    <view class="profile-row content-inset" role="button" aria-label="进入账户管理" bindtap="openAccounts">
      <view class="row-copy"><text class="row-title">账户管理</text><text class="row-note">{{loggedIn && hasLoaded ? accountCount + ' 个活动账户' : '管理资产与负债账户'}}</text></view><view class="row-chevron"></view>
    </view>
    <view class="profile-row content-inset" role="button" aria-label="进入分类管理" bindtap="openCategories">
      <view class="row-copy"><text class="row-title">分类管理</text><text class="row-note">{{loggedIn && hasLoaded ? categoryCount + ' 个收支分类' : '管理收入与支出分类'}}</text></view><view class="row-chevron"></view>
    </view>
  </view>

  <text class="profile-section-kicker content-inset">设置与资料</text>
  <view class="profile-menu">
    <view class="profile-row content-inset" role="button" aria-label="选择视觉主题" bindtap="openTheme">
      <view class="row-copy">
        <text class="row-title">主题</text>
        <text class="row-note">{{themeName}}</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view class="profile-row content-inset" role="button" aria-label="查看数据与隐私" bindtap="showPrivacy">
      <view class="row-copy">
        <text class="row-title">数据与隐私</text>
        <text class="row-note">身份与账单文件说明</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view class="profile-row content-inset" role="button" aria-label="查看关于招财猫记账本" bindtap="showAbout">
      <view class="row-copy">
        <text class="row-title">关于招财猫记账本</text>
        <text class="row-note">开发版</text>
      </view>
      <view class="row-chevron"></view>
    </view>
    <view wx:if="{{loggedIn}}" class="profile-row profile-logout-row content-inset" role="button" aria-label="退出登录" bindtap="logoutAccount">
      <view class="row-copy">
        <text class="row-title profile-logout-title">退出登录</text>
        <text class="row-note">只退出本机，不删除云端账本</text>
      </view>
      <view class="row-chevron profile-logout-chevron"></view>
    </view>
  </view>

</view>
