<view class="page-canvas profile-page {{themeClass}}" style="{{themeStyle}}">
  <view class="profile-card">
    <view class="profile-hero">
      <button wx:if="{{loggedIn}}" class="profile-avatar-button {{savingAvatar ? 'profile-avatar-saving' : ''}}" aria-label="修改头像" open-type="chooseAvatar" disabled="{{savingAvatar || savingNickname}}" bindchooseavatar="chooseAvatar">
        <image class="profile-logo" src="{{displayAvatarUrl}}" mode="aspectFill" />
      </button>
      <image wx:else class="profile-logo profile-logo-static" src="{{displayAvatarUrl}}" mode="aspectFill" />
      <view class="profile-copy">
        <view wx:if="{{loggedIn && !editingNickname}}" class="profile-name-line">
          <text class="profile-title serif-title">{{nickname || '微信用户'}}</text>
          <button class="profile-icon-button" aria-label="修改昵称" disabled="{{savingAvatar}}" bindtap="startEditNickname"><image class="profile-icon-image" src="/assets/icons/pencil.svg" mode="aspectFit" /></button>
        </view>
        <view wx:elif="{{loggedIn}}" class="profile-name-form">
          <input class="profile-name-input {{nicknameError ? 'field-error-shake' : ''}}" name="nickname" aria-label="昵称" type="nickname" value="{{nicknameDraft}}" maxlength="{{nicknameMaxLength}}" placeholder="1～6 个字" disabled="{{savingNickname}}" bindinput="bindNicknameDraft" bindblur="bindNicknameDraft" />
          <view class="profile-icon-button" hover-class="profile-icon-hover" aria-role="button" aria-label="取消修改昵称" bindtap="cancelEditNickname"><image class="profile-icon-image" src="/assets/icons/close.svg" mode="aspectFit" /></view>
          <view class="profile-icon-button" hover-class="profile-icon-hover" aria-role="button" aria-label="保存昵称" bindtap="saveNickname"><view wx:if="{{!savingNickname}}" class="profile-icon-confirm"><image class="profile-icon-image" src="/assets/icons/check.svg" mode="aspectFit" /></view></view>
        </view>
        <view wx:else class="profile-name-line">
          <text class="profile-title serif-title">尚未登录</text>
          <button class="profile-login-button" size="mini" bindtap="promptWechatLogin"><text class="profile-login-label">登录</text></button>
        </view>
        <text wx:if="{{nicknameError}}" class="profile-name-error">{{nicknameError}}</text>
        <text wx:if="{{avatarError}}" class="profile-name-error">{{avatarError}}</text>
      </view>
    </view>
    <view wx:if="{{loggedIn && uid}}" class="profile-id-line">
      <view class="profile-id-text">
        <text class="profile-id-label">ID</text>
        <text class="profile-id-value">{{displayUid}}</text>
      </view>
      <button class="profile-icon-button" aria-label="复制完整 ID" bindtap="copyId"><image class="profile-icon-image" src="/assets/icons/copy.svg" mode="aspectFit" /></button>
    </view>
    <view wx:elif="{{loggedIn}}" class="profile-id-pending">
      <text>ID {{loading ? '读取中…' : '暂未获取'}}</text>
      <text wx:if="{{!loading}}" class="profile-id-retry" bindtap="retryProfile" aria-role="button">重试</text>
    </view>
  </view>

  <ui-state wx:if="{{errorMessage}}" error description="{{errorMessage}} · 点此重试" bindtap="retryProfile" />

  <text class="profile-section-kicker content-inset">账本管理</text>
  <view class="profile-menu">
    <list-row title="账户管理" note="{{loggedIn && hasLoaded ? accountCount + ' 个活动账户' : '管理资产与负债账户'}}" aria-label="进入账户管理" bindtap="openAccounts" />
    <list-row title="分类管理" note="{{loggedIn && hasLoaded ? categoryCount + ' 个收支分类' : '管理收入与支出分类'}}" aria-label="进入分类管理" bindtap="openCategories" />
    <list-row title="贷款管理" note="借款与分期，核对本金和实际还款" aria-label="进入贷款管理" bindtap="openLoans" divider="{{false}}" />
  </view>

  <text class="profile-section-kicker content-inset">设置与资料</text>
  <view class="profile-menu">
    <list-row title="主题" note="{{themeName}}" aria-label="选择视觉主题" bindtap="openTheme" />
    <list-row title="数据与隐私" note="身份与账单文件说明" aria-label="查看数据与隐私" bindtap="showPrivacy" />
    <list-row id="about-entry" title="关于" note="开发版" aria-label="查看关于" bindtap="openAbout" />
    <list-row wx:if="{{loggedIn}}" title="退出登录" note="只退出本机，不删除云端账本" tone="danger" aria-label="退出登录" bindtap="logoutAccount" divider="{{false}}" />
  </view>

</view>
