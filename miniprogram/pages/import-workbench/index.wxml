        <view class="account-choice-search">
          <image class="account-choice-search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
          <input class="account-choice-search-input" value="{{accountChoiceQuery}}" bindinput="bindAccountChoiceSearch" data-input-key="bindAccountChoiceSearch" bindfocus="beginInputEditing" bindblur="finishInputEditing" placeholder="搜索账户名称" confirm-type="search" aria-label="搜索账户名称" />
        </view>
        <scroll-view class="account-choice-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <skeleton-rows wx:if="{{choiceLoading && !accountChoiceResults.length}}" rows="{{4}}" />
