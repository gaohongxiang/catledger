              <text class="account-choice-account-name">{{item.name}}</text>
              <text class="account-choice-account-detail">{{item.detail}}</text>
            </view>
            <view class="account-choice-chevron"></view>
          </button>
          <view wx:if="{{!choiceLoading && !choiceError && !accountChoiceResults.length}}" class="account-choice-empty">没有匹配的账户</view>
