<import src="detail-fields.wxml" />
<template name="record-count-formula">
  <view wx:if="{{chargeSyncMessage}}" class="charge-sync-note">{{chargeSyncMessage}}；可下拉刷新，或在贷款详情继续同步。</view>
  <text class="record-count-equation">有效交易 {{activeCount}}＝全部 {{totalCount}}－已排除 {{excludedCount}}－重复 {{duplicateCount}}</text>
  <text class="record-count-equation record-count-chain">有效交易＝待核对＋已核对＝待分类＋已分类＋无需分类</text>
</template>

<template name="record-source-fields">
          <text wx:if="{{record.evidenceLoading}}" class="account-source-meta">正在读取原始记录…</text>
          <view wx:for="{{record.evidence}}" wx:for-item="source" wx:key="evidenceId" class="account-record-original">
            <text class="account-original-caption">原始账单 · {{source.fileName}} · 第 {{source.rowNumber}} 行</text>
            <view wx:for="{{source.fields}}" wx:for-item="field" wx:key="key" class="account-original-field">
              <text class="account-original-key">{{field.name}}</text><text class="account-original-value" selectable>{{field.value === '' ? '（空）' : field.value}}</text>
            </view>
            <text wx:if="{{source.incomplete}}" class="account-source-meta">原始记录较长或暂时无法完整展示，当前已展示 {{source.fields.length}} 项。</text>
            <button wx:if="{{source.incomplete}}" class="account-source-link" data-id="{{record.eventId}}" data-evidence-id="{{source.evidenceId}}" bindtap="openEvidence">查看完整原文</button>
          </view>
          <view wx:if="{{record.evidencePage.count > 1}}" class="list-pagination">
            <button wx:if="{{record.evidencePage.canFirst}}" class="stage-previous" data-scope="{{scope}}" data-id="{{record.eventId}}" data-direction="first" bindtap="changeInlineSource" disabled="{{record.evidenceLoading}}">首份</button>
            <button class="stage-previous" data-scope="{{scope}}" data-id="{{record.eventId}}" data-direction="-1" bindtap="changeInlineSource" disabled="{{record.evidenceLoading || !record.evidencePage.hasPrevious}}">上份</button>
            <text>来源 {{record.evidencePage.start}} / {{record.evidencePage.count}}</text>
            <button class="stage-previous" data-scope="{{scope}}" data-id="{{record.eventId}}" data-direction="1" bindtap="changeInlineSource" disabled="{{record.evidenceLoading || !record.evidencePage.hasNext}}">下份</button>
          </view>
          <button wx:if="{{external}}" class="account-source-link" data-id="{{record.eventId}}" bindtap="openEvidence">查看原始记录</button>
</template>



<view class="page-canvas import-page {{themeClass}}" style="{{themeStyle}}">
  <text wx:if="{{pageError}}" class="stage-action-error">{{pageError}}</text>
  <button wx:if="{{pageError || refreshRequired}}" class="stage-previous" bindtap="retryPagedView">刷新</button>
  <view class="stage-track" aria-label="账单导入进度">
    <button class="stage-item {{currentStep === 1 ? 'stage-current' : 'stage-done'}}" data-step="1" bindtap="goToStep" disabled="{{busy}}" hover-class="none">
      <text class="stage-number money-number">1</text>
      <view class="stage-copy"><text class="stage-title">选择账单</text></view>
    </button>
    <view class="stage-connector {{unlockedStep > 1 ? 'stage-connector-done' : ''}}"></view>
    <button class="stage-item {{currentStep === 2 ? 'stage-current' : (unlockedStep >= 2 ? 'stage-done' : 'stage-locked')}}" data-step="2" bindtap="goToStep" disabled="{{busy || unlockedStep < 2}}" hover-class="none">
      <text class="stage-number money-number">2</text>
      <view class="stage-copy"><text class="stage-title">确认账户</text></view>
    </button>
    <view class="stage-connector {{unlockedStep > 2 ? 'stage-connector-done' : ''}}"></view>
    <button class="stage-item {{currentStep === 3 ? 'stage-current' : (unlockedStep >= 3 ? 'stage-done' : 'stage-locked')}}" data-step="3" bindtap="goToStep" disabled="{{busy || unlockedStep < 3 || accountStepSummary.pending > 0}}" hover-class="none">
      <text class="stage-number money-number">3</text>
      <view class="stage-copy"><text class="stage-title">整理账目</text></view>
    </button>
    <view class="stage-connector {{unlockedStep > 3 ? 'stage-connector-done' : ''}}"></view>
    <button class="stage-item {{currentStep === 4 ? 'stage-current' : (unlockedStep >= 4 ? 'stage-done' : 'stage-locked')}}" data-step="4" bindtap="goToStep" disabled="{{busy || unlockedStep < 4 || accountStepSummary.pending > 0}}" hover-class="none">
      <text class="stage-number money-number">4</text>
      <view class="stage-copy"><text class="stage-title">确认入账</text></view>
    </button>
    <view class="stage-refresh-slot" aria-hidden="true"><view wx:if="{{pageLoading}}" class="stage-refresh-spinner"></view></view>
  </view>

  <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
  <button wx:if="{{preparePending && !update}}" class="primary-button" bindtap="createFinanceUpdate" disabled="{{busy}}">继续整理上次账单</button>

  <block wx:if="{{currentStep === 1 && (!update || phase === 'organizing')}}">
    <view wx:if="{{!files.length && phase !== 'loading' && phase !== 'organizing' && !restoreUpdateId && !preparePending}}" data-ui="empty-picker" class="file-picker-empty">
      <view class="file-picker-symbol" aria-hidden="true"><view class="file-picker-paper"></view><text>＋</text></view>
      <text class="stage-panel-title">选择账单文件</text>
      <text class="stage-panel-copy">支持银行、支付宝、微信账单（CSV/XLS/XLSX）。</text>
      <button class="primary-button file-picker-primary" bindtap="chooseFiles" disabled="{{busy}}">＋ 选择账单</button>
      <text class="file-limit">上限 5 份 · 单份 5 MB</text>
    </view>
    <view wx:if="{{files.length}}" class="file-stage-heading content-inset">
      <text class="stage-panel-title">{{phase === 'uploading' ? '正在读取账单' : (phase === 'organizing' ? '正在准备账户' : (uploadSummary.queued ? '已选择 ' + files.length + ' 份账单' : '账单文件'))}}</text>
      <text class="stage-panel-copy">每份文件独立处理，请稍候。</text>
    </view>

    <view wx:if="{{files.length}}" class="file-batch">
      <view class="file-batch-head content-inset">
        <text class="file-batch-title">账单文件</text>
        <text class="file-batch-count money-number">{{files.length}} / 5 份</text>
      </view>
      <view class="file-list">
        <view wx:for="{{files}}" wx:key="clientId" class="file-strip" data-id="{{item.clientId}}" bindtap="tapFileRow" hover-class="{{item.state === 'mapping' || item.state === 'failed' ? 'file-strip-hover' : 'none'}}">
          <view class="file-mark file-mark-{{item.state}}"><text>{{index + 1}}</text></view>
          <view class="file-copy">
            <text class="file-name">{{item.name}}</text>
            <text class="file-meta {{item.state === 'mapping' || item.state === 'failed' ? 'file-meta-action' : ''}}">{{item.sizeText}} · {{item.stateText}}{{item.summary ? ' · ' + item.summary.valid + ' 条' : ''}}</text>
            <text wx:if="{{item.errorMessage}}" class="file-error">{{item.errorMessage}}</text>
            <view class="file-progress {{item.state === 'preparing' || item.state === 'uploading' || item.state === 'parsing' ? 'file-progress-active' : 'file-progress-idle'}}"><view class="file-progress-value" style="width: {{item.state === 'preparing' ? 8 : item.progress}}%;"></view></view>
          </view>
          <view class="file-row-side">
            <view wx:if="{{item.state === 'queued' || item.state === 'failed' || item.state === 'ready' || item.state === 'duplicate' || item.state === 'mapping'}}" class="file-row-actions">
              <view class="file-small-action file-remove {{busy ? 'file-small-action-disabled' : ''}}" data-id="{{item.clientId}}" catchtap="removeFile" aria-role="button">删除</view>
            </view>
            <text wx:else class="file-row-state">{{item.stateText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{files.length && (phase === 'idle' || phase === 'selected' || phase === 'uploading' || phase === 'files_ready' || phase === 'organizing')}}" class="file-picker-actions">
      <view class="file-picker-action">
        <button class="choose-button choose-button-secondary" bindtap="chooseFiles" disabled="{{busy || files.length >= maxFiles}}">继续添加</button>
        <text class="file-limit">上限 5 份 · 单份 5 MB</text>
      </view>
      <view wx:if="{{uploadSummary.queued > 0 || phase === 'uploading'}}" class="file-picker-action">
        <button data-ui="parse-action" wx:if="{{uploadSummary.queued > 0 || phase === 'uploading'}}" class="primary-button stage-primary parse-button {{phase === 'uploading' ? 'parse-button-loading' : ''}}" bindtap="startUpload" disabled="{{busy || uploadSummary.queued === 0 || files.length > maxFiles}}">
          <view class="parse-button-content"><view wx:if="{{phase === 'uploading'}}" class="parse-button-spinner"></view><text>{{phase === 'uploading' ? '解析中' : '开始解析'}}</text></view>
        </button>
        <text class="stage-action-summary file-picker-summary content-inset">{{phase === 'uploading' ? '解析中…' : (uploadSummary.queued ? '待解析 ' + uploadSummary.queued + ' 份' : (uploadSummary.failed ? '请重试失败文件或继续添加' : '文件已读取'))}}</text>
      </view>
    </view>

    <view wx:if="{{phase === 'loading' || restoreUpdateId || (phase === 'organizing' && !files.length)}}" class="processing-stage">
      <view class="processing-mark"><view class="processing-ring"></view><text class="processing-value money-number">01</text></view>
      <text class="processing-title">{{phase === 'organizing' ? '正在准备账户' : abandoningRestore ? '正在放弃上次导入' : restoreUpdateId ? '正在恢复上次导入' : '正在读取导入进度'}}</text>
      <text class="processing-copy">{{phase === 'organizing' ? '正在整理账户归属与待确认记录。' : abandoningRestore ? '恢复已停止，正在清理本批导入。' : restoreUpdateId ? '上次有尚未入账的导入，正在恢复处理进度。' : '正在恢复这批账单的处理状态。'}}</text>
      <button wx:if="{{restoreUpdateId}}" class="text-action restore-abandon-button" bindtap="abandonRestoringUpdate" disabled="{{abandoningRestore}}">{{abandoningRestore ? '正在放弃…' : '放弃上次导入'}}</button>
    </view>

    <view data-ui="parse-result" wx:if="{{phase === 'files_ready' || phase === 'organizing' || (phase === 'selected' && !uploadSummary.queued && files.length > 0)}}" class="step-section parse-stage">
      <text class="stage-panel-kicker">解析摘要 · STEP 01</text>
      <text class="step-title serif-title">{{uploadSummary.mapping ? '还差一步：确认银行账单列' : (uploadSummary.ready ? '已读取 ' + uploadSummary.ready + ' 份账单' : (uploadSummary.failed ? '账单未能读取' : '这些账单已经入账'))}}</text>
      <text class="step-copy">{{uploadSummary.mapping ? '点“待确认列”，核对日期、金额和收支方向后即可继续。' : (uploadSummary.failed ? '点“读取失败”查看具体原因和处理方式；只继续整理读取成功的账单。' : (uploadSummary.ready ? '确认这些记录对应的账户' : '无需重复导入，也不会重复记账。'))}}</text>
      <view class="parse-summary">
        <view class="parse-summary-item"><text class="parse-summary-value money-number">{{uploadSummary.total}}</text><text class="parse-summary-label">已选文件</text></view>
        <view class="parse-summary-item"><text class="parse-summary-value money-number">{{uploadSummary.ready}}</text><text class="parse-summary-label">解析成功</text></view>
        <button wx:if="{{uploadSummary.mapping}}" class="parse-summary-item parse-summary-action" data-state="mapping" bindtap="openFileAttention" disabled="{{busy}}"><text class="parse-summary-value money-number">{{uploadSummary.mapping}}</text><text class="parse-summary-label">待确认列 ›</text></button>
        <button wx:if="{{uploadSummary.failed}}" class="parse-summary-item parse-summary-action" data-state="failed" bindtap="openFileAttention" disabled="{{busy}}"><text class="parse-summary-value money-number">{{uploadSummary.failed}}</text><text class="parse-summary-label">读取失败 ›</text></button>
        <view wx:if="{{uploadSummary.duplicate}}" class="parse-summary-item"><text class="parse-summary-value money-number">{{uploadSummary.duplicate}}</text><text class="parse-summary-label">已入账</text></view>
      </view>
      <view class="stage-action">
        <text class="stage-action-summary content-inset">{{uploadSummary.ready ? (uploadSummary.attention ? '可以先整理已读取成功的账单' : '全部解析完成，可以确认账户') : (uploadSummary.mapping ? '先确认账单列，再确认账户' : '至少成功解析 1 份账单后才可继续')}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{currentStep === 1 && update && phase !== 'organizing'}}" class="step-section parse-stage">
    <text class="stage-panel-kicker">解析摘要 · STEP 01</text>
    <text class="step-title serif-title">{{accountStepSummary.pending > 0 ? '账单已读取，请确认账户。' : (reviewStatusTabs[0].count ? '还有 ' + reviewStatusTabs[0].count + ' 笔交易待核对。' : (coverage.selectedEventsReadyToPost ? '本批账单已核对完成。' : '账单已读取。'))}}</text>
    <text class="step-copy">{{accountStepSummary.pending > 0 ? '还有 ' + accountStepSummary.pending + ' 项账户待确认。' : (reviewStatusTabs[0].count ? '继续整理剩余交易，已核对和已排除的结果会保留。' : (coverage.selectedEventsReadyToPost ? '可以继续确认入账，待分类不影响入账。' : '请继续查看当前整理结果。'))}}</text>
    <view class="parse-summary">
      <view class="parse-summary-item"><text class="parse-summary-value money-number">{{update.counts.sources}}</text><text class="parse-summary-label">账单来源</text></view>
      <view class="parse-summary-item"><text class="parse-summary-value money-number">{{recordSummary.totalCount}}</text><text class="parse-summary-label">全部记录</text></view>
      <view class="parse-summary-item"><text class="parse-summary-value money-number">{{reviewStatusTabs[0].count}}</text><text class="parse-summary-label">待核对交易</text></view>
    </view>
    <view class="file-batch parsed-sources">
      <view class="file-batch-head content-inset"><text class="file-batch-title">来源文件</text><text class="file-batch-count money-number">{{sources.length}} 份</text></view>
      <view class="file-list">
        <view wx:for="{{sources}}" wx:key="sourceId" class="file-strip">
          <view class="file-mark"><text>{{index + 1}}</text></view>
          <view class="file-copy"><text class="file-name">{{item.fileName}}</text><text class="file-meta">{{item.sourceType}} · {{item.summary.valid}} 条记录</text></view>
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{currentStep === 1 && !restoreUpdateId && ((update && phase === 'review') || phase === 'files_ready' || phase === 'organizing' || (phase === 'selected' && !uploadSummary.queued && files.length > 0))}}">
    <view class="stage-navigation-spacer"></view>
    <view class="stage-action stage-navigation">
      <view class="stage-navigation-buttons">
        <block wx:if="{{update}}">
          <button class="stage-previous" bindtap="abandonUpdate" disabled="{{busy}}">放弃本批</button>
          <button class="primary-button stage-primary" data-step="2" bindtap="goToStep" disabled="{{busy || unlockedStep < 2}}">下一步：确认账户</button>
        </block>
        <button wx:else data-ui="next-accounts" class="primary-button stage-primary" bindtap="createFinanceUpdate" loading="{{phase === 'organizing'}}" disabled="{{busy || uploadSummary.ready === 0}}">{{phase === 'organizing' ? '正在准备账户' : '下一步：确认账户'}}</button>
      </view>
    </view>
  </block>

  <view wx:if="{{update && phase === 'review' && (currentStep === 2 || currentStep === 3) && draftSync.error}}" class="draft-sync-note">
    <text>{{draftSync.error || '正在自动保存…'}}</text>
    <button wx:if="{{draftSync.conflicts}}" class="text-action" bindtap="recheckDraftConflicts" disabled="{{busy}}">重新核对</button>
    <button wx:if="{{draftSync.error && !draftSync.conflicts}}" class="text-action" bindtap="retryDraftSync" disabled="{{busy || draftSync.syncing}}">重试</button>
  </view>
  <view wx:if="{{currentStep === 2 && update}}" class="step-section account-stage">
    <view class="step-heading content-inset">
      <view><text class="step-title serif-title">确认账户</text></view>
      <text class="step-count money-number">已确认 {{accountStepSummary.confirmed}} / {{accountStepSummary.total}}</text>
    </view>
    <text class="step-copy content-inset">核对建议，不合适可更改</text>

    <skeleton-rows wx:if="{{pageLoading && !accountMappings.length}}" rows="{{3}}" />
    <view wx:if="{{accountMappings.length}}" class="account-proof-list">
      <view wx:for="{{accountMappings}}" wx:key="issueId" class="account-proof-item">
        <view class="account-proof-head">
          <view class="account-proof-title-line"><text class="account-proof-title">{{item.label}}</text><text wx:if="{{item.needsConfirmation}}" class="account-pending-label">{{item.dirty && item.status === 'resolved' ? '待确认' : (item.suggestedExisting ? '建议 · 待确认' : '待确认')}}</text></view>
          <view wx:if="{{item.memberCount > 0}}" class="account-evidence-trigger {{item.choiceValue === 'pending' ? 'account-proof-pending' : ''}}" data-id="{{item.issueId}}" bindtap="openAccountRecords" aria-role="button" aria-disabled="{{busy}}" aria-label="查看{{item.label}}的{{item.memberCount}}笔交易"><text class="money-number">{{item.memberCount}} 笔</text><chevron-icon size="{{20}}" /></view>
          <text wx:else class="account-proof-meta">{{item.memberCount}} 条记录</text>
        </view>

        <view wx:if="{{item.inline && !item.needsConfirmation}}" class="account-summary-row"><text class="account-summary-text">{{item.summaryText}}</text><button class="account-change" data-id="{{item.issueId}}" bindtap="openAccountChoice" disabled="{{busy}}">更改</button></view>
        <block wx:else>
        <view wx:if="{{item.inline}}" class="account-decision-row {{item.choiceValue === 'create' ? 'account-decision-create' : ''}}">
          <button class="account-mode-trigger {{item.choiceValue === 'create' ? 'account-mode-trigger-create' : 'account-mode-trigger-wide'}} {{item.choiceValue === 'pending' ? 'account-mode-trigger-pending' : ''}}" data-id="{{item.issueId}}" bindtap="openAccountChoice" disabled="{{accountStepBusy}}" aria-label="选择{{item.label}}的处理方式">
            <view class="account-mode-control">
              <text class="account-mode-value">{{item.choiceValue === 'create' ? '新建账户' : item.choiceName}}</text>
              <view class="account-dropdown-chevron"></view>
            </view>
          </button>
          <block wx:if="{{item.choiceValue === 'create'}}">
            <view class="account-decision-divider"></view>
            <input class="account-compact-name" maxlength="32" value="{{item.draftName}}" placeholder="账户名称" data-id="{{item.issueId}}" bindinput="bindAccountDraftName" data-input-key="bindAccountDraftName-{{index}}" bindfocus="beginInputEditing" bindblur="finishInputEditing" disabled="{{accountStepBusy}}" aria-label="{{item.label}}的新账户名称" />
            <view class="account-decision-divider"></view>
            <picker class="account-compact-type" mode="selector" range="{{accountTypeOptions}}" range-key="label" value="{{item.draftTypeIndex}}" data-id="{{item.issueId}}" bindchange="changeAccountDraftType" disabled="{{accountStepBusy}}" aria-label="{{item.label}}的账户类型，{{accountTypeOptions[item.draftTypeIndex].label}}">
              <view class="account-compact-type-control">
                <text class="account-compact-type-value">{{accountTypeOptions[item.draftTypeIndex].value === 'credit' ? '信用卡/信贷' : accountTypeOptions[item.draftTypeIndex].label}}</text>
                <view class="account-dropdown-chevron"></view>
              </view>
            </picker>
          </block>
        </view>
        <button wx:else class="account-decision-row account-transfer-control" data-id="{{item.issueId}}" bindtap="openIssue">
          <text class="account-mode-value">确认转出与转入账户</text>
          <view class="account-dropdown-chevron"></view>
        </button>
        <view wx:if="{{item.inline}}" class="account-confirm-row">
          <view class="account-confirm-note">
            <text wx:if="{{item.choiceValue === 'pending'}}" class="account-inline-note">{{item.paymentNeedsReview ? '多账户共同支付，请核对金额与性质。' : '请选择归属账户；信息不足请核对后确认。'}}</text>
            <text wx:if="{{item.choiceValue === 'create' && !item.draftNameValid}}" class="account-inline-note">填写账户名称，或改选已有账户 / 不计入。</text>
            <text wx:if="{{item.suggestedExisting}}" class="account-state-note">已按名称、银行和尾号推荐，请核对。</text>
            <text wx:if="{{item.choiceValue === 'ignore'}}" class="account-state-note">保留证据，本次不创建账户与账目。</text>
            <text wx:if="{{item.choiceValue === 'ignore_future' && item.status === 'open'}}" class="account-state-note">本次不计入；入账后同类将自动排除。</text>
            <text wx:if="{{item.choiceValue === 'ignore_future' && item.status === 'resolved'}}" class="account-state-note">已按你的规则不计入，入账前仍可修改。</text>
          </view>
          <button class="account-confirm" data-id="{{item.issueId}}" bindtap="completeAccountMapping" disabled="{{busy || accountStepBusy || !item.canConfirm}}">{{item.status === 'resolved' ? '确认修改' : '确认此账户'}}</button>
        </view>
        </block>
      </view>
    </view>

    <text class="account-shared-note">入账后才生效，此前不改动现有账户</text>
<view wx:if="{{reviewPage && (reviewPage.hasPrevious || reviewPage.hasNext)}}" class="list-pagination">
        <button class="stage-previous" data-direction="first" bindtap="changeReviewPage" disabled="{{!reviewPage.canFirst}}">首页</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeReviewPage" disabled="{{!reviewPage.hasPrevious}}">上一页</button>
        <text>{{reviewPage.start}}–{{reviewPage.end}} / {{reviewPage.count}} 项</text>
        <button class="stage-previous" data-direction="1" bindtap="changeReviewPage" disabled="{{!reviewPage.hasNext}}">下一页</button>
      </view>
    <view class="stage-action stage-navigation">
      <text wx:if="{{accountStepError}}" class="stage-action-error">{{accountStepError}}</text>
      <text wx:elif="{{accountStepProgressText}}" class="stage-action-progress">{{accountStepProgressText}}</text>
      <view class="stage-navigation-buttons">
        <button class="stage-previous" data-step="1" bindtap="goToStep" disabled="{{busy}}">上一步</button>
        <button class="primary-button stage-primary" data-step="3" bindtap="goToStep" disabled="{{busy || accountStepSummary.pending > 0 || unlockedStep < 3}}">下一步：整理账目{{accountStepSummary.pending ? '（剩 ' + accountStepSummary.pending + ' 项）' : ''}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{currentStep === 3 && update}}" class="review-stage">
    <view class="step-heading content-inset">
      <view>
        <text class="stage-panel-kicker">账单整理 · STEP 03</text>
        <text class="step-title serif-title review-slogan">核对交易，按需补分类</text>
      </view>
    </view>
    <view class="review-count-formulas">
      <template is="record-count-formula" data="{{totalCount: recordSummary.totalCount, activeCount: recordSummary.activeCount, excludedCount: recordSummary.excludedCount, duplicateCount: recordSummary.duplicateCount}}" />
    </view>
    <view class="review-main-tabs" aria-role="tablist">
      <button class="review-main-tab {{activeReviewTab === 'review' ? 'review-main-tab-active' : ''}}" data-tab="review" bindtap="switchReviewTab" aria-role="tab" aria-selected="{{activeReviewTab === 'review'}}">交易核对</button>
      <button class="review-main-tab {{activeReviewTab === 'category' ? 'review-main-tab-active' : ''}}" data-tab="category" bindtap="switchReviewTab" aria-role="tab" aria-selected="{{activeReviewTab === 'category'}}">分类</button>
    </view>

    <block wx:if="{{activeReviewTab === 'review'}}">
      <view class="review-status-tabs" aria-role="tablist">
        <button wx:for="{{reviewStatusTabs}}" wx:key="value" class="review-status-tab {{activeReviewStatus === item.value ? 'review-status-tab-active' : ''}}" data-status="{{item.value}}" bindtap="switchReviewStatus" hover-class="none" aria-role="tab" aria-selected="{{activeReviewStatus === item.value}}" aria-label="{{item.label}}，{{item.count}}条">
          <text class="review-status-tab-label">{{item.label}}</text><text class="review-status-tab-count money-number">{{item.count}}</text>
        </button>
      </view>
      <input wx:if="{{recordSummary.totalCount}}" class="category-search" value="{{reviewQuery}}" maxlength="80" placeholder="搜索商户、交易、分类或日期" bindinput="searchReviewIssues" data-input-key="searchReviewIssues" bindfocus="beginInputEditing" bindblur="finishInputEditing" aria-label="搜索当前交易核对列表，日期可输入2026-10-03或10-03" />
      <block wx:if="{{activeReviewStatus === 'pending'}}">
        <button wx:if="{{pairingEntry && !reviewQuery}}" class="review-decision-card pairing-entry" bindtap="openPairingEntry" disabled="{{busy || pairingEntry.total === 0}}" aria-label="判断是否同一笔，{{pairingEntry.total === null ? '多组建议配对' : pairingEntry.total + '组建议配对'}}，批量核对">
          <view class="review-decision-heading">
            <view class="review-decision-copy"><text class="review-decision-title">判断是否同一笔</text></view>
            <view class="review-decision-action"><text class="review-action-button">批量核对</text><chevron-icon size="{{22}}" /></view>
          </view>
          <view class="pairing-entry-body">
            <view class="pairing-entry-total"><text wx:if="{{pairingEntry.total !== null}}" class="pairing-entry-number money-number">{{pairingEntry.total}}</text><text class="pairing-entry-title">{{pairingEntry.total === null ? '多组建议配对' : '组建议配对'}}</text></view>
            <text class="pairing-entry-copy">银行卡与微信／支付宝，逐组对照两边账单。</text>
            <text class="pairing-entry-note">{{pairingEntry.loading ? '正在核验组数，可先打开查看…' : pairingEntry.error ? '组数暂未读到，点击重新核验。' : pairingEntry.total === 0 ? '暂无唯一建议，其他候选仍可在下方逐笔核对。' : '已包含在下方待核对中，这里可成批确认。'}}</text>
          </view>
        </button>
        <skeleton-rows wx:if="{{pageLoading && !reviewGroups.length}}" rows="{{3}}" />
        <view wx:if="{{reviewGroups.length}}" class="review-batch-list">
          <view wx:for="{{reviewGroups}}" wx:key="key" class="review-batch">
            <button wx:for="{{item.issues}}" wx:for-item="issue" wx:key="eventId" class="review-decision-card {{issue.groupPos ? 'card-group-' + issue.groupPos : ''}}" data-id="{{issue.eventId}}" data-issue-id="{{issue.issueId}}" bindtap="openPendingRecord" aria-label="{{issue.batchDecision}} {{issue.label}}">
              <view class="review-decision-heading">
                <view class="review-decision-copy"><text class="review-decision-title">{{issue.label}}</text><text class="review-decision-note">{{issue.decisionText}}</text></view>
                <view class="review-decision-action"><text wx:if="{{issue.groupCount > 1 && issue.groupPos !== 'middle' && issue.groupPos !== 'last'}}" class="review-action-count money-number">同组 {{issue.groupCount}} 笔</text><text class="review-action-button">{{issue.batchDecision}}</text><chevron-icon size="{{22}}" /></view>
              </view>
              <view class="review-preview-list review-decision-previews">
                <view wx:for="{{issue.subjects}}" wx:for-item="preview" wx:key="eventId" class="review-preview-row">
                  <view wx:if="{{preview.displayDate}}" class="review-preview-date"><text class="review-preview-day money-number">{{preview.displayDate}}</text></view>
                  <view class="review-preview-copy"><text class="review-preview-title">{{preview.displayTitle}}</text><text class="review-preview-meta">{{preview.displayDetailMeta || preview.displayMeta}}</text><text wx:if="{{preview.pairingDecision}}" class="review-text-action" data-id="{{preview.eventId}}" catchtap="openDuplicateEdit">修改同笔判断</text></view>
                  <text class="review-preview-amount money-number {{preview.directionClass}}">{{preview.amountText}}</text>
                </view>
                <text wx:if="{{issue.hiddenSubjectCount}}" class="review-preview-more">另有 {{issue.hiddenSubjectCount}} 笔将应用同一决定</text>
              </view>
            </button>
          </view>
        </view>
        <view wx:elif="{{!pageLoading && !pageError}}" class="tab-empty"><text class="tab-empty-title">{{reviewQuery ? '没有匹配的交易' : '交易核对已完成'}}</text><text class="tab-empty-copy">{{reviewQuery ? '试试其他关键词或交易日期。' : (categoryEventCount ? '还有 ' + categoryEventCount + ' 笔需要分类。' : '可以继续查看整批入账汇总。')}}</text></view>
      </block>
      <block wx:elif="{{activeReviewStatus === 'completed'}}">
        <text class="record-list-note content-inset">包含自动通过和已确认的交易。</text>
        <skeleton-rows wx:if="{{pageLoading && !reviewedEvents.length}}" rows="{{3}}" />
        <view wx:for="{{reviewedEvents}}" wx:key="eventId" class="review-decision-card category-decision-card" data-id="{{item.eventId}}" bindtap="openReviewDetails" aria-role="button" aria-label="查看已核对交易">
          <view class="review-decision-heading review-completed-heading"><text class="review-decision-title">{{item.natureLabel}}{{item.needsCategory ? ' · 待分类' : ''}}</text><view class="review-completed-side"><text class="review-action-button">查看</text><chevron-icon size="{{22}}" /></view></view>
          <view class="review-preview-list review-decision-previews"><view class="review-preview-row">
            <view wx:if="{{item.displayDate}}" class="review-preview-date"><text class="review-preview-day money-number">{{item.displayDate}}</text></view>
            <view class="review-preview-copy"><text class="review-preview-title">{{item.displayTitle}}</text><text class="review-preview-meta">{{item.displayDetailMeta || item.displayMeta}}</text></view>
            <text class="review-preview-amount money-number {{item.directionClass}}">{{item.amountText}}</text>
          </view></view>
        </view>
        <view wx:if="{{!pageLoading && !pageError && !reviewedEvents.length}}" class="tab-empty"><text class="tab-empty-title">{{reviewQuery ? '没有匹配的交易' : '暂无已核对交易'}}</text></view>
      </block>
    </block>

    <block wx:else>
      <view class="review-status-tabs review-status-tabs-category" aria-role="tablist">
        <button wx:for="{{categoryStatusTabs}}" wx:key="value" class="review-status-tab {{activeCategoryStatus === item.value ? 'review-status-tab-active' : ''}}" data-status="{{item.value}}" bindtap="switchCategoryStatus" hover-class="none" aria-role="tab" aria-selected="{{activeCategoryStatus === item.value}}">
          <text class="review-status-tab-label">{{item.label}}</text><text class="review-status-tab-count money-number">{{item.count}}</text>
        </button>
      </view>
      <input wx:if="{{recordSummary.activeCount}}" class="category-search" value="{{categoryQuery}}" maxlength="80" placeholder="搜索商户、交易、分类或日期" bindinput="searchCategoryIssues" data-input-key="searchCategoryIssues" bindfocus="beginInputEditing" bindblur="finishInputEditing" aria-label="搜索当前分类列表，日期可输入2026-10-03或10-03" />
      <block wx:if="{{activeCategoryStatus === 'pending'}}">
        <skeleton-rows wx:if="{{pageLoading && !categoryCards.length && !categoryWaitingEvents.length}}" rows="{{3}}" />
        <view wx:for="{{categoryCards}}" wx:key="eventId" class="review-decision-card category-decision-card {{item.groupPos ? 'card-group-' + item.groupPos : ''}}" data-id="{{item.eventId}}" data-issue-id="{{item.issueId}}" bindtap="openPendingRecord" aria-role="button" aria-label="{{item.natureLabel}}待分类，{{item.subjectCount}}笔">
          <view class="review-decision-heading">
            <view class="review-decision-copy"><text class="review-decision-title">{{item.issueId ? item.natureLabel + '待分类' : item.label}}</text></view>
            <view class="review-decision-action"><text wx:if="{{item.groupCount > 1 && item.groupPos !== 'middle' && item.groupPos !== 'last'}}" class="review-action-count money-number">同组 {{item.groupCount}} 笔</text><text class="review-action-button">{{item.batchDecision}}</text><chevron-icon size="{{22}}" /></view>
          </view>
          <view class="review-preview-list review-decision-previews">
            <view wx:for="{{item.subjects}}" wx:for-item="record" wx:key="eventId" class="review-preview-row" data-id="{{record.eventId}}" catchtap="openEvidence" aria-role="button" aria-label="查看交易证据">
              <view wx:if="{{record.displayDate}}" class="review-preview-date"><text class="review-preview-day money-number">{{record.displayDate}}</text></view>
              <view class="review-preview-copy"><text class="review-preview-title">{{record.displayTitle}}</text><text class="review-preview-meta">{{record.displayDetailMeta || record.displayMeta}}</text></view>
              <text class="review-preview-amount money-number {{record.directionClass}}">{{record.amountText}}</text>
            </view>
            <text wx:if="{{item.hiddenSubjectCount}}" class="review-preview-more">另有 {{item.hiddenSubjectCount}} 笔将应用同一分类</text>
          </view>
        </view>
        <view wx:for="{{categoryWaitingEvents}}" wx:key="eventId" class="review-decision-card category-decision-card">
          <view class="review-decision-heading"><text class="review-decision-title">待分类 · 先核对交易</text><button class="review-inline-action" data-id="{{item.reviewIssueId}}" bindtap="reviewBeforeCategory">去核对<chevron-icon size="{{22}}" /></button></view>
          <view class="review-preview-list review-decision-previews"><view class="review-preview-row" data-id="{{item.eventId}}" bindtap="openEvidence" aria-role="button" aria-label="查看交易证据">
            <view wx:if="{{item.displayDate}}" class="review-preview-date"><text class="review-preview-day money-number">{{item.displayDate}}</text></view>
            <view class="review-preview-copy"><text class="review-preview-title">{{item.displayTitle}}</text><text class="review-preview-meta">{{item.displayDetailMeta || item.displayMeta}}</text></view>
            <text class="review-preview-amount money-number {{item.directionClass}}">{{item.amountText}}</text>
          </view></view>
        </view>
        <view wx:if="{{!pageLoading && !pageError && !categoryCards.length && !categoryWaitingEvents.length}}" class="tab-empty"><text class="tab-empty-title">{{categoryEventCount ? '没有匹配的交易' : '当前分类已完成'}}</text><text class="tab-empty-copy">{{categoryEventCount ? '试试其他商户或交易关键词。' : (verificationIssueCount ? '收支确定后可能需补分类。' : '分类已整理完。')}}</text></view>
      </block>
      <block wx:elif="{{activeCategoryStatus === 'completed' || activeCategoryStatus === 'none'}}">
        <skeleton-rows wx:if="{{pageLoading && !(activeCategoryStatus === 'completed' ? categorizedEvents.length : noCategoryEvents.length)}}" rows="{{3}}" />
        <view wx:for="{{activeCategoryStatus === 'completed' ? categorizedEvents : noCategoryEvents}}" wx:key="eventId" class="review-decision-card category-decision-card" data-id="{{item.eventId}}" bindtap="openEvidence" aria-role="button" aria-label="查看交易证据">
          <view class="review-decision-heading review-completed-heading">
            <view class="review-decision-copy"><text class="review-decision-title category-completed-title">{{activeCategoryStatus === 'completed' ? (item.categoryName ? item.natureLabel + ' · ' + item.categoryName : item.natureLabel) : '无需分类 · ' + item.natureLabel}}{{item.pendingReview ? ' · 待核对' : ''}}</text></view>
            <view wx:if="{{activeCategoryStatus === 'completed' && update.status === 'review'}}" class="review-decision-action category-edit-action" data-id="{{item.eventId}}" catchtap="openCategoryEdit" aria-role="button" aria-label="修改分类"><text class="review-action-button">修改分类</text><chevron-icon size="{{22}}" /></view>
            <view wx:else class="review-completed-side"><text class="review-action-button">查看</text><chevron-icon size="{{22}}" /></view>
          </view>
          <view class="review-preview-list review-decision-previews"><view class="review-preview-row">
            <view wx:if="{{item.displayDate}}" class="review-preview-date"><text class="review-preview-day money-number">{{item.displayDate}}</text></view>
            <view class="review-preview-copy"><text class="review-preview-title">{{item.displayTitle}}</text><text class="review-preview-meta">{{item.displayDetailMeta || item.displayMeta}}</text></view>
            <text class="review-preview-amount money-number {{item.directionClass}}">{{item.amountText}}</text>
          </view></view>
        </view>
        <view wx:if="{{!pageLoading && !pageError && !(activeCategoryStatus === 'completed' ? categorizedEvents.length : noCategoryEvents.length)}}" class="tab-empty"><text class="tab-empty-title">{{categoryQuery ? '没有匹配的交易' : '暂无这类交易'}}</text></view>
      </block>
    </block>

    <block wx:if="{{activeReviewTab === 'review' && activeReviewStatus === 'excluded'}}">
      <skeleton-rows wx:if="{{pageLoading && !excludedReviewGroups.length}}" rows="{{3}}" />
      <view wx:if="{{excludedReviewGroups.length}}" class="excluded-group-list">
        <view wx:for="{{excludedReviewGroups}}" wx:key="key" class="excluded-group-card">
          <view class="excluded-group-toggle" data-key="{{item.key}}" bindtap="toggleExcludedGroup" hover-class="excluded-group-toggle-pressed" aria-role="button" aria-label="{{item.expanded ? '收起' : '展开'}} {{item.label}}，{{item.count}}笔">
            <view class="excluded-group-copy"><text class="excluded-group-title">{{item.label}}</text><text class="excluded-group-note">{{item.note}}</text></view><view class="excluded-group-side"><text class="excluded-group-count money-number">{{item.count}} 笔</text><view class="excluded-group-chevron {{item.expanded ? 'excluded-group-chevron-expanded' : ''}}"></view></view>
          </view>
          <view wx:if="{{item.expanded}}" class="excluded-group-records">
            <text wx:if="{{item.loading}}" class="record-list-note">正在读取交易</text>
            <view wx:if="{{item.error}}" class="excluded-group-error"><text>{{item.error}}</text><button class="text-action" data-key="{{item.key}}" data-direction="retry" bindtap="changeExcludedGroupPage">重试</button></view>
            <view wx:for="{{item.events}}" wx:for-item="record" wx:key="eventId" class="review-audit-row" data-id="{{record.eventId}}" bindtap="openEvidence" aria-role="button" aria-label="查看原始证据">
              <view class="review-preview-copy"><text class="review-preview-title">{{record.displayTitle}}</text><text class="review-preview-meta">{{record.displayMeta}}</text><text class="review-preview-meta excluded-record-reason">排除原因：{{record.exclusionReasonText}}</text><text wx:if="{{record.sourceStatus}}" class="review-preview-meta excluded-record-status">原账单状态：{{record.sourceStatus}}</text></view><text class="review-preview-amount money-number {{record.directionClass}}">{{record.amountText}}</text>
            </view>
            <view wx:if="{{item.page && (item.page.canFirst || item.page.hasNext)}}" class="list-pagination excluded-group-pagination">
              <button class="stage-previous" data-key="{{item.key}}" data-direction="first" bindtap="changeExcludedGroupPage" disabled="{{item.loading || !item.page.canFirst}}">首页</button>
              <button class="stage-previous" data-key="{{item.key}}" data-direction="-1" bindtap="changeExcludedGroupPage" disabled="{{item.loading || !item.page.hasPrevious}}">上一页</button>
              <text>{{item.page.start}}–{{item.page.end}} / {{item.count}} 笔</text>
              <button class="stage-previous excluded-group-next" data-key="{{item.key}}" data-direction="1" bindtap="changeExcludedGroupPage" disabled="{{item.loading || !item.page.hasNext}}">下一页</button>
            </view>
          </view>
        </view>
      </view>
      <view wx:elif="{{!pageLoading && !pageError}}" class="tab-empty"><text class="tab-empty-title">{{reviewQuery ? '没有匹配的交易' : '没有已排除记录'}}</text></view>
    </block>
    <block wx:if="{{activeReviewTab === 'review' && activeReviewStatus === 'duplicate'}}">
      <view wx:if="{{duplicateReviewLoading}}" class="tab-empty"><text class="tab-empty-title">正在核对重复来源</text></view>
      <skeleton-rows wx:elif="{{pageLoading && !duplicateReviewEvents.length}}" rows="{{3}}" />
      <view wx:elif="{{duplicateReviewError}}" class="tab-empty"><text class="tab-empty-copy">{{duplicateReviewError}}</text><button class="text-action" bindtap="loadDuplicateRecords">重试</button></view>
      <view wx:elif="{{duplicateReviewEvents.length}}" class="review-audit-list">
        <view wx:for="{{duplicateReviewEvents}}" wx:key="eventId" class="review-audit-card" data-id="{{item.eventId}}" bindtap="openReviewDetails" aria-role="button" aria-label="查看重复交易与原始来源">
          <view class="review-decision-heading review-completed-heading">
            <text class="review-audit-badge">重复来源 {{item.duplicateCount}} 条</text>
            <view class="review-completed-side"><text class="review-action-button">查看</text><chevron-icon size="{{22}}" /></view>
          </view>
          <view class="review-audit-row"><view class="review-preview-copy"><text class="review-preview-title">{{item.displayTitle}}</text><text class="review-preview-meta">{{item.displayMeta}}</text></view><text class="review-preview-amount money-number {{item.directionClass}}">{{item.amountText}}</text></view>
          <view class="review-audit-footer"><text class="review-audit-note">{{item.auditNote}}</text></view>
        </view>
      </view>
      <view wx:elif="{{!pageLoading && !pageError}}" class="tab-empty"><text class="tab-empty-title">{{reviewQuery ? '没有匹配的交易' : '没有重复交易'}}</text></view>
    </block>
<view wx:if="{{reviewPage && (reviewPage.hasPrevious || reviewPage.hasNext)}}" class="list-pagination">
        <button class="stage-previous" data-direction="first" bindtap="changeReviewPage" disabled="{{!reviewPage.canFirst}}">首页</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeReviewPage" disabled="{{!reviewPage.hasPrevious}}">上一页</button>
        <text>{{reviewPage.start}}–{{reviewPage.end}} / {{reviewPage.count}} {{reviewPage.unit || '项'}}</text>
        <button class="stage-previous review-page-next" data-direction="1" bindtap="changeReviewPage" disabled="{{!reviewPage.hasNext}}">下一页</button>
      </view>
    <view class="stage-action stage-navigation"><view class="stage-navigation-buttons">
      <button class="stage-previous" data-step="2" bindtap="goToStep" disabled="{{busy}}">上一步</button>
      <button class="primary-button stage-primary" data-step="4" bindtap="goToStep" disabled="{{busy || reviewStatusTabs[0].count || accountStepSummary.pending > 0}}">下一步：确认入账{{reviewStatusTabs[0].count ? '（剩 ' + reviewStatusTabs[0].count + ' 笔）' : ''}}</button>
    </view></view>
  </view>


  <view wx:if="{{currentStep === 4 && update && phase === 'review'}}" class="step-section final-stage">
    <view class="review-heading content-inset"><text class="review-title">确认入账</text></view>
    <view class="review-count-formulas final-count-formulas">
      <template is="record-count-formula" data="{{totalCount: recordSummary.totalCount, activeCount: recordSummary.activeCount, excludedCount: recordSummary.excludedCount, duplicateCount: recordSummary.duplicateCount}}" />
    </view>
    <view class="final-summary">
      <view class="final-money-row">
        <view data-kind="expense" bindtap="openFinalDetail" aria-role="button" aria-label="查看本批支出"><text class="final-money-label">本批支出</text><text class="final-money-value money-number expense-color">{{finalSummary.expenseText}}</text><view class="funds-flow-count"><text class="money-number">{{finalSummary.expenseCount}} 笔</text><chevron-icon size="{{20}}" /></view></view>
        <view data-kind="income" bindtap="openFinalDetail" aria-role="button" aria-label="查看本批收入"><text class="final-money-label">本批收入</text><text class="final-money-value money-number income-color">{{finalSummary.incomeText}}</text><view class="funds-flow-count"><text class="money-number">{{finalSummary.incomeCount}} 笔</text><chevron-icon size="{{20}}" /></view></view>
        <view data-kind="refund" bindtap="openFinalDetail" aria-role="button" aria-label="查看本批退款"><text class="final-money-label">本批退款</text><text class="final-money-value money-number income-color">{{finalSummary.refundText}}</text><view class="funds-flow-count"><text class="money-number">{{finalSummary.refundCount}} 笔</text><chevron-icon size="{{20}}" /></view></view>
      </view>
      <view class="final-category-heading"><text class="review-title">资金流转</text></view>
      <view class="final-money-row funds-flow-grid">
        <view wx:for="{{fundsFlowGroups}}" wx:key="nature" class="funds-flow-cell" data-kind="{{item.nature}}" bindtap="openFinalDetail" aria-role="button" aria-label="{{item.label}}，{{item.count}}笔，查看记录">
          <text class="final-money-label">{{item.label}}</text><text class="final-money-value money-number">{{item.amountText}}</text>
          <view class="funds-flow-count"><text class="money-number">{{item.count}} 笔</text><chevron-icon size="{{20}}" /></view>
        </view>
      </view>

      <view class="final-summary-row" data-kind="new_accounts" bindtap="openFinalDetail" aria-role="button" aria-label="查看新建账户"><text>新建账户</text><view class="final-summary-side"><text class="money-number">{{finalSummary.newAccountCount}} 个</text><chevron-icon size="{{22}}" /></view></view>
      <view class="final-summary-row" data-kind="affected_accounts" bindtap="openFinalDetail" aria-role="button" aria-label="查看受影响账户"><text>受影响账户</text><view class="final-summary-side"><text class="money-number">{{finalSummary.affectedAccountCount}} 个</text><chevron-icon size="{{22}}" /></view></view>
      <view class="final-summary-row" data-kind="all" bindtap="openFinalDetail" aria-role="button" aria-label="查看本次入账"><text>本次入账</text><view class="final-summary-side"><text class="money-number">{{recordSummary.activeCount}} 笔有效交易</text><chevron-icon size="{{22}}" /></view></view>
      <view class="final-category-heading"><text class="review-title">交易分类</text></view>
      <view class="final-money-row">
        <view data-kind="categorized" bindtap="openFinalDetail" aria-role="button" aria-label="查看已分类"><text class="final-money-label">已分类</text><view class="funds-flow-count"><text class="money-number">{{categoryStatusTabs[1].count}} 笔</text><chevron-icon size="{{20}}" /></view></view>
        <view data-kind="uncategorized" bindtap="openFinalDetail" aria-role="button" aria-label="查看未分类"><text class="final-money-label">未分类</text><view class="funds-flow-count"><text class="money-number">{{categoryStatusTabs[0].count}} 笔</text><chevron-icon size="{{20}}" /></view></view>
        <view data-kind="no_category" bindtap="openFinalDetail" aria-role="button" aria-label="查看无需分类"><text class="final-money-label">无需分类</text><view class="funds-flow-count"><text class="money-number">{{categoryStatusTabs[2].count}} 笔</text><chevron-icon size="{{20}}" /></view></view>
      </view>
      <text class="final-category-note">未分类可入账后再补</text>
    </view>
    <view class="stage-action stage-navigation"><view class="stage-navigation-buttons">
      <button class="stage-previous" data-step="3" bindtap="goToStep" disabled="{{busy}}">上一步</button>
      <button class="primary-button stage-primary" bindtap="postUpdate" loading="{{busy}}" disabled="{{busy || openIssueCount || accountStepSummary.pending > 0 || !coverage.selectedEventsReadyToPost}}">确认整批入账</button>
    </view></view>
  </view>

  <view wx:if="{{currentStep === 4 && phase === 'done'}}" class="done-section">
    <view class="done-mark"><view class="done-check"></view></view>
    <text class="done-title serif-title">这批账单已经入账。</text>
    <button wx:if="{{pendingInstallments}}" class="secondary-button" bindtap="openInstallmentSources">补充分期记录</button>
    <view class="review-count-formulas final-count-formulas">
