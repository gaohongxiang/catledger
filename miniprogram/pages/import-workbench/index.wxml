        <button class="stage-previous" data-direction="-1" bindtap="changeChoicePage" disabled="{{!choicePage.hasPrevious}}">上一页</button>
        <text>{{choicePage.start}}–{{choicePage.end}} / {{choicePage.count}} 项</text>
        <button class="stage-previous" data-direction="1" bindtap="changeChoicePage" disabled="{{!choicePage.hasNext}}">下一页</button>
      </view>
