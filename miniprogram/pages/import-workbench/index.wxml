          <button wx:for="{{accountChoiceResults}}" wx:key="accountId" class="account-choice-account-row {{accountChoiceSheet.selectedValue === item.value ? 'account-choice-selected' : ''}}" data-value="{{item.value}}" bindtap="selectAccountChoice" aria-role="radio" aria-checked="{{accountChoiceSheet.selectedValue === item.value}}">
