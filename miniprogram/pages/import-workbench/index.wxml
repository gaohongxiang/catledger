      <text class="sheet-kicker">核对账户归属</text>
      <text class="sheet-title serif-title">{{accountRecordsSheet.label}}</text>
      <text wx:if="{{!accountRecordsSheet.loading && !accountRecordsSheet.error}}" class="sheet-copy">共 {{accountRecordsSheet.count}} 笔 · {{accountRecordsSheet.dateRange}}</text>
      <text wx:if="{{accountRecordsSheet.error}}" class="stage-action-error">{{accountRecordsSheet.error}}</text>
      <scroll-view class="account-records-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <skeleton-rows wx:if="{{accountRecordsSheet.loading && !accountRecordsSheet.records.length}}" rows="{{4}}" />
        <view wx:for="{{accountRecordsSheet.records}}" wx:key="eventId" class="account-record-item">
          <view class="account-source-heading"><text class="account-source-title">{{item.displayTitle}}</text><text class="account-source-amount money-number">{{item.flowText}} {{item.amountText}}</text></view>
          <template is="record-source-fields" data="{{record: item, scope: 'account'}}" />
          <text wx:if="{{item.evidenceError}}" class="stage-action-error">{{item.evidenceError}}</text>
          <button wx:if="{{item.evidenceError}}" size="mini" class="account-source-link" data-id="{{item.eventId}}" bindtap="retryAccountRecordEvidence" disabled="{{item.evidenceLoading}}">重新读取原始记录</button>
        </view>
<view wx:if="{{accountRecordsSheet.page && (accountRecordsSheet.page.hasPrevious || accountRecordsSheet.page.hasNext)}}" class="list-pagination">
        <button class="stage-previous" data-direction="first" bindtap="changeAccountMembers" disabled="{{!accountRecordsSheet.page.canFirst}}">首页</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeAccountMembers" disabled="{{!accountRecordsSheet.page.hasPrevious}}">上一页</button>
        <text>{{accountRecordsSheet.page.start}}–{{accountRecordsSheet.page.end}} / {{accountRecordsSheet.page.count}} 项</text>
        <button class="stage-previous" data-direction="1" bindtap="changeAccountMembers" disabled="{{!accountRecordsSheet.page.hasNext}}">下一页</button>
      </view>
      </scroll-view>
      <button wx:if="{{accountRecordsSheet.error}}" class="evidence-return" bindtap="changeAccountMembers">重新读取当前页</button>
      <button size="mini" class="account-records-return" bindtap="closeAccountRecords" disabled="{{busy}}">返回账户列表</button>
    </view>
  </view>

  <view wx:if="{{finalDetailSheet}}" class="sheet-layer final-detail-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeFinalDetail"></view>
    <view class="workflow-sheet editor-sheet final-detail-sheet">
      <view class="sheet-handle"></view>
      <view class="final-detail-heading"><text class="sheet-title">{{finalDetailSheet.title}}</text><button class="final-detail-close" bindtap="closeFinalDetail" aria-label="关闭明细">关闭</button></view>
      <text wx:if="{{!finalDetailSheet.loading}}" class="sheet-copy">共 {{finalDetailSheet.count}} {{finalDetailSheet.mode === 'accounts' ? '个账户' : '笔交易'}}</text>
<view wx:if="{{finalDetailSheet.page && (finalDetailSheet.page.hasPrevious || finalDetailSheet.page.hasNext)}}" class="list-pagination">
        <button class="stage-previous" data-direction="first" bindtap="changeFinalPage" disabled="{{!finalDetailSheet.page.canFirst}}">首页</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeFinalPage" disabled="{{!finalDetailSheet.page.hasPrevious}}">上一页</button>
        <text>{{finalDetailSheet.page.start}}–{{finalDetailSheet.page.end}} / {{finalDetailSheet.page.count}} 项</text>
        <button class="stage-previous" data-direction="1" bindtap="changeFinalPage" disabled="{{!finalDetailSheet.page.hasNext}}">下一页</button>
      </view>
      <scroll-view class="final-detail-scroll" scroll-top="{{finalDetailScrollTop}}" scroll-y enhanced show-scrollbar="{{false}}">
        <skeleton-rows wx:if="{{finalDetailSheet.loading}}" rows="{{4}}" />
        <view wx:for="{{finalDetailSheet.accounts}}" wx:key="accountId" class="funds-flow-record" data-id="{{item.accountId}}" bindtap="openFinalAccount" aria-role="button" aria-label="查看账户关联交易">
          <view class="funds-flow-record-head"><text class="funds-flow-record-title">{{item.name}}</text><view class="funds-flow-record-side"><text class="money-number">{{item.count}} 笔</text><chevron-icon size="{{20}}" /></view></view>
          <text class="funds-flow-record-meta">{{item.typeLabel}}{{item.isDraft ? ' · 本批新建' : ''}}</text>
        </view>
        <view wx:for="{{finalDetailSheet.records}}" wx:key="eventId" class="funds-flow-record">
          <view class="funds-flow-record-head"><text class="funds-flow-record-title">{{item.displayTitle}}</text><text class="money-number">{{item.amountText}}</text></view>
          <text class="funds-flow-record-meta">{{item.displayMeta}}</text>
          <text wx:if="{{item.accountText}}" class="funds-flow-record-meta">关联账户：{{item.accountText}}</text>
        </view>
        <text wx:if="{{!finalDetailSheet.loading && !finalDetailSheet.count}}" class="funds-flow-record-meta">本批暂无相关{{finalDetailSheet.mode === 'accounts' ? '账户' : '交易'}}。</text>
      </scroll-view>
      <button wx:if="{{finalDetailParent}}" class="evidence-return" bindtap="backFinalDetail">返回账户列表</button>
    </view>
  </view>

  <include src="pairing-review.wxml" />
  <view wx:if="{{currentIssue || evidenceSheet}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeReviewSheet"></view>
    <view class="workflow-sheet editor-sheet {{currentIssue && !evidenceSheet ? 'review-editor-sheet' : ''}}">
      <view class="sheet-handle"></view>
      <view wx:if="{{evidenceSheet}}" class="evidence-drilldown">
        <text wx:if="{{evidenceSheet.installmentNote}}" class="sheet-copy">{{evidenceSheet.installmentNote}}</text>
        <view class="evidence-sheet-heading">
          <view><text class="sheet-kicker">来源证据</text><text class="sheet-title serif-title">原始交易</text></view>
        </view>
        <scroll-view class="evidence-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <skeleton-rows wx:if="{{evidenceSheet.loading && !evidenceSheet.evidence.length}}" rows="{{3}}" />
          <view wx:for="{{evidenceSheet.evidence}}" wx:key="evidenceId" class="evidence-card">
            <view class="evidence-card-head"><text class="evidence-role">{{item.roleLabel}}</text><text class="evidence-source">{{item.fileName}} · 第 {{item.rowNumber}} 行</text></view>
          </view>
          <view wx:if="{{evidenceSheet.error}}" class="relation-empty"><text>{{evidenceSheet.error}}</text><button class="account-source-link" bindtap="changeEvidencePage">重试读取来源</button></view>
          <view wx:elif="{{!evidenceSheet.loading && !evidenceSheet.evidence.length}}" class="relation-empty">没有可显示的原始交易。</view>
          <skeleton-rows wx:if="{{evidenceSheet.partLoading}}" rows="{{3}}" />
          <view wx:if="{{evidenceSheet.partError}}" class="relation-empty"><text>{{evidenceSheet.partError}}</text><button class="account-source-link" bindtap="changeEvidencePart">重试读取原文</button></view>
          <view wx:if="{{evidenceSheet.partFields.length}}" class="evidence-fields">
            <view wx:for="{{evidenceSheet.partFields}}" wx:key="key" class="evidence-field"><text class="evidence-key">{{item.name}}</text><text selectable class="evidence-value">{{item.value === '' ? '（空）' : item.value}}</text></view>
          </view>
          <view wx:elif="{{evidenceSheet.part}}" class="evidence-fields"><text class="evidence-source">原文片段</text><text selectable class="evidence-value">{{evidenceSheet.part}}</text></view>
        </scroll-view>
<view wx:if="{{evidenceSheet.page && (evidenceSheet.page.hasPrevious || evidenceSheet.page.hasNext)}}" class="list-pagination">
        <button wx:if="{{evidenceSheet.page.canFirst}}" class="stage-previous" data-direction="first" bindtap="changeEvidencePage" disabled="{{evidenceSheet.loading || evidenceSheet.error}}">首份</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeEvidencePage" disabled="{{evidenceSheet.loading || evidenceSheet.error || !evidenceSheet.page.hasPrevious}}">上份</button>
        <text>来源 {{evidenceSheet.page.start}} / {{evidenceSheet.page.count}}</text>
        <button class="stage-previous" data-direction="1" bindtap="changeEvidencePage" disabled="{{evidenceSheet.loading || evidenceSheet.error || !evidenceSheet.page.hasNext}}">下份</button>
      </view>
        <view wx:if="{{evidenceSheet.partPage && (evidenceSheet.partPage.hasPrevious || evidenceSheet.partPage.hasNext)}}" class="list-pagination">
          <button class="stage-previous" data-direction="first" bindtap="changeEvidencePart" disabled="{{evidenceSheet.partLoading || evidenceSheet.partError || !evidenceSheet.partPage.canFirst}}">首段</button>
          <button class="stage-previous" data-direction="-1" bindtap="changeEvidencePart" disabled="{{evidenceSheet.partLoading || evidenceSheet.partError || !evidenceSheet.partPage.hasPrevious}}">上一段</button>
          <text>第 {{evidenceSheet.partPage.index + 1}} 段</text>
          <button class="stage-previous" data-direction="1" bindtap="changeEvidencePart" disabled="{{evidenceSheet.partLoading || evidenceSheet.partError || !evidenceSheet.partPage.hasNext}}">下一段</button>
        </view>
        <button class="evidence-return" bindtap="closeEvidence">{{currentIssue ? '返回处理' : '返回列表'}}</button>
      </view>
      <block wx:else>
      <view class="review-sheet-heading"><text class="sheet-title">{{currentIssue.label}}</text><button class="review-sheet-close" bindtap="closeIssue" disabled="{{busy}}" aria-label="关闭核对，暂不保存"><image class="review-sheet-close-icon" src="/assets/icons/close.svg" mode="aspectFit" /></button></view>
      <text class="sheet-copy">{{currentIssue.decisionText}}</text>

      <scroll-view class="review-editor-body" style="{{issueBodyLayout && issueBodyLayout.issueId === currentIssue.issueId ? 'height:' + issueBodyLayout.height + 'px' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="review-editor-content">
      <skeleton-rows wx:if="{{issueDetailsLoading}}" rows="{{3}}" />
      <view wx:if="{{issueDetailsError || issueStale}}" class="relation-empty">
        <text>{{issueStale ? '整理结果已变化，当前输入已保留；请重新核验后保存。' : issueDetailsError}}</text>
        <button class="review-text-action" bindtap="retryIssueDetails" disabled="{{issueDetailsLoading && !issueStale}}">重新核验此项</button>
      </view>
      <block wx:if="{{issueDetailsReady}}">
      <text class="sheet-copy">本组涉及 {{issueScopeCount}} 笔记录。普通字段请从下方对应记录进入修改。</text>
      <view wx:if="{{currentIssue.issueType === 'account_mapping'}}" class="mapping-fields">
        <button class="mapping-field" data-target="account" bindtap="openDirectory" disabled="{{busy || issueStale}}"><text class="mapping-label">对应账本账户</text><text class="mapping-value">{{accountChoices[issueDraft.accountIndex].name}}</text></button>
        <block wx:if="{{accountChoices[issueDraft.accountIndex].isCreate}}">
          <text class="draft-account-note">本批新建账户在入账时创建，入账前不改动正式账户。</text>
          <input class="mapping-input" value="{{issueDraft.newAccountName}}" maxlength="32" placeholder="新账户名称" bindinput="changeDraftAccountName" bindfocus="beginInputEditing" bindblur="finishInputEditing" disabled="{{busy}}" />
          <picker mode="selector" range="{{accountTypeOptions}}" range-key="label" value="{{issueDraft.accountTypeIndex}}" bindchange="changeDraftAccountType" disabled="{{busy}}"><view class="mapping-field"><text class="mapping-label">账户类型</text><text>{{accountTypeOptions[issueDraft.accountTypeIndex].label}}</text></view></picker>
        </block>
      </view>
      <view wx:if="{{currentIssue.issueType === 'category_assignment'}}" class="mapping-fields">
        <button class="mapping-field" data-target="category" bindtap="openDirectory" disabled="{{busy || issueStale}}"><text class="mapping-label">整组交易分类</text><text>{{issueCategories[issueDraft.categoryIndex].name}}</text></button>
      </view>
      <view wx:if="{{issueFactsLoading}}" class="sheet-copy">正在补充关联信息…</view>
      <view wx:if="{{issueFactsError}}" class="relation-empty"><text>记账关联信息尚未完整读取</text><button class="account-source-link" bindtap="retryIssueFacts">重新读取记账信息</button></view>
      </block>
      <text wx:if="{{issueRelationsLoading}}" class="sheet-copy">正在读取候选原消费…</text>
      <view wx:if="{{issueRelationsError}}" class="relation-empty"><text>{{issueRelationsError}}</text><button class="review-text-action" bindtap="changeIssueRelations">重新读取候选</button></view>
      <view wx:if="{{currentIssue.refundSourceConflict}}" class="relation-list">
        <view class="relation-heading"><text>状态矛盾的原消费</text><text>{{relationPage.count}} 笔</text></view>
        <text class="relation-help">点击原消费查看原始账单，与下方退款到账记录逐项核对。</text>
        <button wx:for="{{issueRelations}}" wx:key="targetEventId" class="relation-row" data-id="{{item.targetEventId}}" bindtap="openEvidence" aria-label="查看原消费原始记录">
          <view class="relation-main"><text class="relation-title">{{item.title}}</text><text class="relation-meta">{{item.meta}}</text></view>
          <text class="relation-amount money-number">{{item.amountText}}</text>
        </button>
        <view wx:if="{{relationPage && (relationPage.hasPrevious || relationPage.hasNext)}}" class="list-pagination">
          <button class="stage-previous" data-direction="-1" bindtap="changeIssueRelations" disabled="{{!relationPage.hasPrevious}}">上一页</button>
          <text>{{relationPage.start}}–{{relationPage.end}} / {{relationPage.count}} 项</text>
          <button class="stage-previous" data-direction="1" bindtap="changeIssueRelations" disabled="{{!relationPage.hasNext}}">下一页</button>
        </view>
      </view>
      <view wx:if="{{currentIssue.historicalDuplicate}}" class="review-source-section">
        <text class="review-section-label">已入账的相似记录 · {{currentIssue.candidateCount}} 笔</text>
        <text wx:if="{{historicalLoading}}" class="sheet-copy">正在读取已入账记录…</text>
        <text wx:if="{{historicalError}}" class="stage-action-error">{{historicalError}}</text>
        <button wx:if="{{historicalError}}" class="review-text-action" data-direction="first" bindtap="changeHistoricalPage">重新读取相似记录</button>
        <text class="sheet-copy">选择同一笔已入账记录，避免重复记账。</text>
        <text wx:if="{{historicalSelection && !historicalSelectionVerified && !historicalLoading}}" class="sheet-copy">原选择已保留，请在候选页中重新核验或选择有效账目。</text>
        <button class="review-text-action" bindtap="refreshHistoricalReview" disabled="{{busy || historicalLoading}}">重新比对历史账目</button>
        <button wx:for="{{historicalCandidates}}" wx:key="transactionId" class="relation-row {{historicalSelection === item.transactionId ? 'relation-selected' : ''}}"
          data-id="{{item.transactionId}}" bindtap="selectHistoricalTransaction" disabled="{{busy || item.stale}}" aria-role="radio" aria-checked="{{historicalSelection === item.transactionId}}">
          <view class="relation-main"><text class="relation-title">{{item.note || '已入账记录'}}</text><text class="relation-meta">{{item.localAt}} · {{item.accountText}}</text><text wx:if="{{item.stale}}" class="file-error">记录已变更，请重新核对</text></view>
          <view class="relation-side"><text class="relation-amount money-number">{{item.amountText}}</text><view class="relation-radio"></view></view>
        </button>
        <view wx:if="{{historicalPage && (historicalPage.hasPrevious || historicalPage.hasNext)}}" class="list-pagination">
          <button class="stage-previous" data-direction="first" bindtap="changeHistoricalPage" disabled="{{historicalLoading || !historicalPage.canFirst}}">首页</button>
          <button class="stage-previous" data-direction="-1" bindtap="changeHistoricalPage" disabled="{{historicalLoading || !historicalPage.hasPrevious}}">上一页</button>
          <text>{{historicalPage.start}}–{{historicalPage.end}} / {{historicalPage.count}} 笔</text>
          <button class="stage-previous" data-direction="1" bindtap="changeHistoricalPage" disabled="{{historicalLoading || !historicalPage.hasNext}}">下一页</button>
        </view>
      </view>
      <view class="review-source-section">
        <text wx:if="{{issueEvidenceLoading}}" class="sheet-copy">正在读取当前页交易…</text>
        <view wx:if="{{issueMembersError}}" class="relation-empty"><text>{{issueMembersError}}</text><button class="review-text-action" bindtap="changeIssueMembers">重新读取当前页</button></view>
        <button wx:if="{{currentIssue.paymentNeedsReview}}" class="review-source-toggle" bindtap="toggleIssueSource" aria-expanded="{{issueSourceExpanded}}">{{issueSourceExpanded ? '收起' : '查看'}}交易与原始账单 · {{issueEvidenceTotal}} 笔</button>
        <text wx:else class="review-section-label">交易与原始账单 · {{issueEvidenceTotal}} 笔</text>
        <block wx:if="{{!currentIssue.paymentNeedsReview || issueSourceExpanded}}">
        <view wx:for="{{issueVisibleEvents}}" wx:key="eventId" class="review-source-record">
          <text wx:if="{{currentIssue.issueType === 'refund_relation'}}" class="review-section-label">{{item.recordRole}}</text>
          <view class="event-record-primary"><text class="event-title">{{item.displayTitle}}</text><text class="event-amount money-number">{{item.amountText}}</text></view>
          <text class="event-meta">{{item.displayMeta}}</text>
          <button wx:if="{{currentIssue.canConfirmSame}}" size="mini" class="review-text-action" data-id="{{item.eventId}}" bindtap="selectPrimaryEvent">{{issueDraft.primaryEventId === item.eventId ? '已选为主记录' : '选为主记录'}}</button>
          <template is="record-source-fields" data="{{record: item}}" />
          <button wx:if="{{currentIssue.canConfirmSame}}" class="account-source-link" data-id="{{item.eventId}}" bindtap="selectPrimaryMember">{{issueDraft.primaryEventId === item.eventId ? '已选为主记录' : '选为主记录'}}</button>
          <button class="account-source-link" data-id="{{item.eventId}}" data-issue-id="{{currentIssue.issueId}}" bindtap="openPendingRecord" disabled="{{busy}}">查看并修改本笔 ›</button>
          <view wx:if="{{item.evidenceError}}" class="review-source-feedback">
            <text class="stage-action-error">{{item.evidenceError}}</text>
            <button size="mini" class="review-text-action" data-id="{{item.eventId}}" bindtap="retryIssueRecordEvidence" disabled="{{item.evidenceLoading}}" aria-label="重新读取原始记录">重新读取</button>
          </view>
        </view>
<view wx:if="{{memberPage && (memberPage.hasPrevious || memberPage.hasNext)}}" class="list-pagination">
        <button class="stage-previous" data-direction="first" bindtap="changeIssueMembers" disabled="{{!memberPage.canFirst}}">首页</button>
        <button class="stage-previous" data-direction="-1" bindtap="changeIssueMembers" disabled="{{!memberPage.hasPrevious}}">上一页</button>
        <text>{{memberPage.start}}–{{memberPage.end}} / {{memberPage.count}} 项</text>
        <button class="stage-previous" data-direction="1" bindtap="changeIssueMembers" disabled="{{!memberPage.hasNext}}">下一页</button>
      </view>
        </block>
      </view>
      </view>
      </scroll-view>

      <view class="sheet-actions">
        <text wx:if="{{(currentIssue.issueType === 'account_mapping' || currentIssue.issueType === 'category_assignment') && !issueFieldsCanSave && !busy}}" class="sheet-save-hint">{{issueFieldsReason}}</text>
        <button wx:if="{{currentIssue.issueType === 'account_mapping' || currentIssue.issueType === 'category_assignment'}}" class="sheet-confirm sheet-confirm-wide" bindtap="resolveWithFields" loading="{{busy}}" disabled="{{!issueCanSubmit || busy || !issueFieldsCanSave}}">保存本组选择 · {{issueScopeCount}} 笔</button>
        <button wx:if="{{currentIssue.canConfirmSame}}" class="sheet-confirm sheet-confirm-wide" bindtap="confirmSame" disabled="{{busy || !issueCanSubmit}}">是同一笔</button>
        <button wx:if="{{currentIssue.historicalDuplicate}}" class="sheet-confirm sheet-confirm-wide" bindtap="linkHistoricalTransaction" disabled="{{!issueCanSubmit || busy || historicalLoading || !historicalSelectionVerified}}">与选中记录是同一笔，不再入账</button>
        <button wx:if="{{currentIssue.issueType === 'same_event' || currentIssue.issueType === 'identity_conflict'}}" class="sheet-confirm sheet-confirm-wide" bindtap="confirmDistinct" disabled="{{!issueCanSubmit || busy || historicalLoading || (currentIssue.historicalDuplicate && (historicalError || !historicalCandidates.length))}}">{{currentIssue.historicalDuplicate ? '都不是同一笔，保留本次记录' : '是多笔独立记录'}}</button>
        <text wx:if="{{currentIssue.issueType === 'installment_origin'}}" class="sheet-copy">这是旧版分期核对记录。请查看本笔来源并重新整理本批；本金出账只登记来源，入账后可关联分期计划。</text>
        <view class="sheet-utility-actions">
          <button size="mini" class="sheet-secondary" bindtap="closeIssue">稍后处理</button>
          <button size="mini" class="sheet-danger" bindtap="excludeIssueEvents" disabled="{{busy || !issueCanSubmit}}">不计入本次账本</button>
        </view>
      </view>
      </block>
    </view>
  </view>

  <include src="category-edit.wxml" />
  <include src="review-detail.wxml" />
  <include src="duplicate-edit.wxml" />
  <include src="review-edit.wxml" />
  <view wx:if="{{directorySheet}}" class="sheet-layer directory-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeDirectory"></view>
    <view class="workflow-sheet directory-sheet">
      <view class="sheet-handle"></view>
      <view class="directory-heading"><text class="directory-title">{{directorySheet.title || (directorySheet.kind === 'categories' ? '选择分类' : '选择账户')}}</text><button class="review-sheet-close" bindtap="closeDirectory" aria-label="返回编辑"><image class="review-sheet-close-icon" src="/assets/icons/close.svg" mode="aspectFit" /></button></view>
      <view wx:if="{{directorySheet.kind === 'accounts' || directorySheet.kind === 'accountDrafts'}}" class="directory-tabs">
        <button class="directory-tab {{directorySheet.kind === 'accounts' ? 'directory-tab-selected' : ''}}" data-kind="accounts" bindtap="changeDirectoryKind" aria-pressed="{{directorySheet.kind === 'accounts'}}">已有账户</button>
        <button class="directory-tab {{directorySheet.kind === 'accountDrafts' ? 'directory-tab-selected' : ''}}" data-kind="accountDrafts" bindtap="changeDirectoryKind" aria-pressed="{{directorySheet.kind === 'accountDrafts'}}">本批新建</button>
      </view>
      <view class="directory-search"><image src="/assets/icons/search.svg" class="directory-search-icon" mode="aspectFit" /><input class="directory-search-input" value="{{directorySheet.query}}" maxlength="80" placeholder="{{directorySheet.kind === 'categories' ? '搜索分类名称' : directorySheet.kind === 'loans' ? '搜索贷款名称' : '搜索账户名称'}}" bindinput="searchDirectory" /></view>
      <scroll-view class="directory-list" style="{{directoryBodyLayout && directoryBodyLayout.target === directorySheet.target ? 'height:' + directoryBodyLayout.height + 'px' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="directory-list-content">
        <skeleton-rows wx:if="{{directorySheet.loading && !directorySheet.items.length}}" rows="{{4}}" />
        <view wx:if="{{directorySheet.error}}" class="directory-empty"><text>{{directorySheet.error}}</text><button class="directory-text-action" bindtap="changeDirectoryPage">重新读取</button></view>
        <text wx:if="{{!directorySheet.loading && !directorySheet.error && !directorySheet.items.length}}" class="directory-empty">{{directorySheet.query ? '没有找到匹配项' : directorySheet.kind === 'accountDrafts' ? '本批还没有新建账户' : directorySheet.kind === 'categories' ? '暂无可选分类' : directorySheet.kind === 'loans' ? '暂无可选贷款' : '暂无可选账户'}}</text>
        <button wx:for="{{directorySheet.items}}" wx:key="index" class="directory-row {{item.directorySelected ? 'directory-row-selected' : ''}} {{item.directoryDisabled ? 'directory-row-unavailable' : ''}}" data-index="{{index}}" bindtap="selectDirectory" disabled="{{directorySheet.loading || busy || item.directoryDisabled}}" aria-pressed="{{item.directorySelected}}">
          <view class="directory-row-copy"><text class="directory-row-name">{{item.parentName ? item.parentName + ' / ' : ''}}{{item.name}}</text><text wx:if="{{item.directoryMeta}}" class="directory-row-meta">{{item.directoryMeta}}</text></view>
          <view wx:if="{{!item.directoryDisabled}}" class="directory-check {{item.directorySelected ? 'directory-check-selected' : ''}}"><image wx:if="{{item.directorySelected}}" src="/assets/icons/check.svg" mode="aspectFit" /></view>
        </button>
        </view>
      </scroll-view>
      <view wx:if="{{directorySheet.page && directorySheet.page.canFirst}}" class="directory-pagination">
        <button class="directory-text-action" data-direction="{{directorySheet.page.hasPrevious ? '-1' : 'first'}}" bindtap="changeDirectoryPage" disabled="{{directorySheet.loading}}">{{directorySheet.page.hasPrevious ? '上一页' : '回首页'}}</button>
        <text>{{directorySheet.page.start}}–{{directorySheet.page.end}} / {{directorySheet.page.count}}</text>
        <button class="directory-text-action" data-direction="1" bindtap="changeDirectoryPage" disabled="{{directorySheet.loading || !directorySheet.page.hasNext}}">下一页</button>
      </view>
      <view wx:elif="{{directorySheet.page && directorySheet.page.hasNext}}" class="directory-pagination"><text>{{directorySheet.page.start}}–{{directorySheet.page.end}} / {{directorySheet.page.count}}</text><button class="directory-text-action" data-direction="1" bindtap="changeDirectoryPage" disabled="{{directorySheet.loading}}">下一页</button></view>
      <view wx:if="{{directorySheet.issueDirectory && (directorySheet.canCreate || directorySheet.canClear)}}" class="directory-local-actions">
        <button wx:if="{{directorySheet.canCreate}}" class="directory-text-action directory-create" data-choice="create" bindtap="selectDirectory" disabled="{{busy}}">＋ {{directorySheet.liabilityOnly ? '新建负债账户' : '新建账户'}}</button>
        <button wx:if="{{directorySheet.canClear}}" class="directory-text-action directory-clear" data-choice="clear" bindtap="selectDirectory" disabled="{{busy}}">清除选择</button>
      </view>
    </view>
  </view>
  <login-sheet id="page-login-sheet" />
</view>
