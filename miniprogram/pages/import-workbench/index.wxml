      <button class="account-choice-create" data-value="create" bindtap="selectAccountChoice"><text class="account-choice-create-plus">＋</text><text>创建新账户</text></button>
    </view>
  </view>

  <view wx:if="{{accountRecordsSheet}}" class="sheet-layer" catchtouchmove="preventTouchMove">
    <view class="sheet-scrim" bindtap="closeAccountRecords"></view>
    <view class="workflow-sheet editor-sheet account-records-sheet">
