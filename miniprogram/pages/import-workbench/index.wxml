      <text class="bank-mapping-name">{{fileAttentionSheet.name}}</text>
      <text class="file-failure-reason">{{fileAttentionSheet.reason}}</text>
      <text class="sheet-copy">这份文件尚未入账。其他读取成功的账单可以继续整理。</text>
