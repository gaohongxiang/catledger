/* MINI-1906UI：仅展示层。品牌色、资金含义和业务状态保持分离。 */
.import-page {
  --ui-page: var(--theme-page);
  --ui-surface: var(--theme-surface);
  --ui-surface-muted: var(--theme-surface-muted);
  --ui-ink: var(--theme-ink);
  --ui-muted: var(--theme-text-muted);
  --ui-subtle: var(--theme-text-subtle);
  --ui-accent: var(--theme-accent);
  --ui-accent-strong: var(--theme-accent-strong);
  --ui-accent-soft: var(--theme-accent-soft);
  --ui-on-accent: var(--theme-on-accent);
  --ui-line: var(--theme-line);
  --ui-border: var(--theme-border);
  --ui-secondary: var(--theme-secondary);
  --ui-secondary-soft: var(--theme-secondary-soft);
  --ui-account-create-bg: var(--ui-accent-soft);
  --ui-account-create-ink: var(--ui-accent-strong);
  --font-body: 28rpx;
  --font-body-small: 26rpx;
  --font-caption: 24rpx;
}
.import-page.theme-warm-ledger {
  --ui-page: #faf8f4;
  --ui-surface: #fffefd;
  --ui-surface-muted: #f1eee9;
  --ui-ink: #2c2823;
  --ui-muted: #70685f;
  --ui-subtle: #79716a;
  --ui-line: #eae4dc;
  --ui-border: #d4ccc3;
  --ui-accent: #be5b24;
  --ui-accent-strong: #a34d20;
  --ui-accent-soft: #fceee3;
  --ui-on-accent: #ffffff;
  --ui-secondary: #70685f;
  --ui-secondary-soft: #f1eee9;
  --ui-account-create-bg: #b35f32;
  --ui-account-create-ink: #ffffff;
}
.import-page .serif-title { font-weight: 500; letter-spacing: 0; }
.import-page .money-number { font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0; }
.import-page {
  --sheet-scrim: rgba(41, 35, 30, .42);
  padding-top: 20rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
 background: var(--ui-page); font-weight: 400; line-height: 1.5;}
button::after { border: 0; }
.import-kicker,
.import-title,
.import-copy,
.stage-number,
.stage-title,
.stage-state,
.stage-panel-kicker,
.stage-panel-title,
.stage-panel-copy,
.file-limit,
.file-batch-title,
.file-batch-count,
.file-name,
.file-meta,
.processing-value,
.processing-title,
.processing-copy,
.step-title,
.step-copy,
.step-count,
.step-footnote,
.parse-summary-value,
.parse-summary-label,
.account-proof-title,
.account-proof-meta,
.account-mode-value,
.account-compact-type-value,
.account-inline-note,
.account-state-note,
.stage-action-error,
.stage-action-progress,
.stage-action-summary,
.review-title,
.review-progress,
.row-title,
.row-detail,
.row-status,
.row-direction,
.row-amount,
.tab-empty-title,
.tab-empty-copy,
.done-title,
.done-copy,
.sheet-kicker,
.sheet-title,
.sheet-copy,
.editor-title,
.editor-detail,
.editor-amount text,
.editor-error,
.readonly-title,
.readonly-copy { display: block; }

.import-heading { padding-bottom: 16rpx; }
.import-kicker,
.stage-panel-kicker,
.sheet-kicker { color: var(--ui-secondary, #64705d); font-size: var(--font-caption, 24rpx); font-weight: 500; letter-spacing: 3rpx; }
.import-title { margin-top: 7rpx; color: var(--ui-ink, #29231e); font-size: var(--font-title, 36rpx); font-weight: 500; }
.import-copy { margin-top: 0; color: var(--ui-muted, #746a60); font-size: 26rpx; line-height: 1.5; }

.stage-track { display: flex; align-items: flex-start; padding: 0 0 20rpx; background: transparent; border: 0; border-radius: 0; }
.stage-item { position: relative; display: flex; min-width: 0; min-height: 112rpx; align-items: center; justify-content: center; gap: 10rpx; margin: 0; padding: 10rpx 0; flex: 1 1 0; color: inherit; text-align: center; line-height: normal; background-color: transparent !important; border-radius: 12rpx;  flex-direction: column;}
.stage-item[disabled] { color: inherit; background-color: transparent !important; opacity: 1; }
.stage-number { display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; box-sizing: border-box; flex: 0 0 38rpx; color: var(--ui-subtle, #958b82); font-size: 24rpx; border: 0; border-radius: 50%;  background: var(--ui-surface-muted);}
.stage-copy { min-width: 0; }
.stage-title { overflow: visible; color: var(--ui-muted, #746a60); font-size: 22rpx; font-weight: 400; text-overflow: clip; white-space: normal;  line-height: 1.4;}
.stage-state { margin-top: 2rpx; color: var(--ui-subtle, #958b82); font-size: var(--font-caption, 24rpx); white-space: nowrap; }
.stage-connector { width: 18rpx; height: 2rpx; margin: 30rpx 2rpx 0; flex: 0 0 auto; background: var(--ui-line, rgba(41, 35, 30, .09)); }
.stage-current { background-color: transparent !important; }
.stage-current .stage-number { color: var(--ui-on-accent, #fffaf1); background: var(--ui-accent, #d97732); border-color: var(--ui-accent, #d97732); }
.stage-current .stage-title { color: var(--ui-ink); font-weight: 500; }
.stage-current .stage-state { color: var(--ui-accent-strong, #b85f2e); }
.stage-done .stage-number { color: var(--ui-secondary, #64705d); background: var(--ui-secondary-soft, #e8eadf); border-color: var(--ui-secondary-soft, #e8eadf); }
.stage-done .stage-state { color: var(--ui-secondary, #64705d); }
.stage-connector-done { background: var(--ui-secondary, #64705d); }
.stage-locked { opacity: .75; }
.stage-item.stage-locked[disabled] { opacity: .75; }

.idle-stage { padding: 54rpx 0 10rpx; }
.stage-panel-title { margin-top: 0; color: var(--ui-ink, #29231e); font-size: 34rpx; font-weight: 500;  line-height: 1.4;}
.stage-panel-copy { max-width: none; margin-top: 10rpx; color: var(--ui-muted, #746a60); font-size: 26rpx; line-height: 1.6; }
.file-picker-actions { display: flex; align-items: stretch; gap: 16rpx; margin-top: 24rpx;  flex-wrap: wrap;}
.file-picker-action { min-width: 0; flex: 1 1 0; }
.file-picker-actions .choose-button,
.file-picker-actions .parse-button { width: 100%; min-width: 0; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; box-sizing: border-box; }
.parse-button-content { display: flex; height: 100%; align-items: center; justify-content: center; gap: 12rpx; }
.parse-button-spinner { width: 24rpx; height: 24rpx; box-sizing: border-box; border: 3rpx solid rgba(255, 250, 241, .42); border-top-color: var(--ui-on-accent, #fffaf1); border-radius: 50%; animation: processing-spin 760ms linear infinite; }
.stage-primary.parse-button-loading[disabled] { color: var(--ui-on-accent, #fffaf1); background: var(--ui-accent, #d97732); opacity: 1; }
.choose-button-secondary { display: flex; align-items: center; justify-content: center; color: var(--ui-accent-strong); font-size: 28rpx; font-weight: 500; line-height: normal; background: var(--ui-surface, #fffdf9); border: 1rpx solid var(--ui-border); border-radius: 20rpx; }
.choose-button-secondary[disabled] { color: var(--ui-subtle, #958b82); background-color: var(--ui-surface-muted) !important; border-color: var(--ui-line); opacity: .65; }
.file-limit { margin-top: 14rpx; color: var(--ui-subtle, #958b82); font-size: var(--font-caption, 24rpx); line-height: 1.45; text-align: center; }
.file-picker-summary { margin-top: 14rpx; font-size: var(--font-caption, 24rpx); line-height: 1.45; }

.text-action { min-height: 88rpx; margin: 0; padding: 0; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); line-height: 88rpx; background: transparent; border-radius: 0; }
.file-batch { padding: 10rpx 0 8rpx; border-bottom: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09));  margin-top: 20rpx;}
.file-batch-head { display: flex; min-height: 38rpx; align-items: center; gap: 8rpx;  border: 0; padding-bottom: 12rpx;}
.file-batch-title { color: var(--ui-secondary, #64705d); font-size: 24rpx; font-weight: 400; letter-spacing: 2rpx; }
.file-batch-count { color: var(--ui-subtle, #958b82); font-size: var(--font-caption, 24rpx); }
.file-list { border-top: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09));  padding: 0 22rpx; background: var(--ui-surface); border: 1rpx solid var(--ui-line); border-radius: 24rpx;}
.file-strip { display: flex; min-height: 112rpx; align-items: flex-start; gap: 12rpx; padding: 22rpx 0; box-sizing: border-box; }
.file-mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; flex: 0 0 auto; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); font-weight: 500; background: var(--ui-surface-muted); border-radius: 12rpx; }
.file-copy { width: 0; min-width: 0; overflow: hidden; flex: 1 1 0%; }
.file-name { display: block; width: 100%; overflow: hidden; font-size: 27rpx; font-weight: 400; text-overflow: ellipsis; white-space: normal;  line-height: 1.5; overflow-wrap: anywhere;}
.file-meta { display: block; width: 100%; margin-top: 2rpx; overflow: hidden; color: var(--ui-muted, #746a60); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap;  line-height: 1.55;}
.file-reselect { min-width: 88rpx; font-size: var(--font-caption, 24rpx); text-align: right; }

.processing-stage { display: flex; min-height: 440rpx; align-items: center; justify-content: center; flex-direction: column; text-align: center; }
.processing-mark { position: relative; display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; }
.processing-ring { position: absolute; inset: 0; box-sizing: border-box; border: 3rpx solid var(--ui-line, rgba(41, 35, 30, .09)); border-top-color: var(--ui-accent, #d97732); border-radius: 50%; animation: processing-spin 900ms linear infinite; }
.processing-value { color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); font-weight: 500; }
.processing-title { margin-top: 24rpx; color: var(--ui-ink, #29231e); font-size: var(--font-section, 30rpx); font-weight: 500; }
.processing-copy { max-width: 520rpx; margin-top: 9rpx; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.6; }
.committing-stage { min-height: 500rpx; }
@keyframes processing-spin { to { transform: rotate(360deg); } }

.step-section { padding-top: 24rpx; }
.step-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx 18rpx;  flex-wrap: wrap;}
.step-heading > view { min-width: 0; }
.step-title { margin-top: 6rpx; color: var(--ui-ink, #29231e); font-size: 34rpx; font-weight: 500; line-height: 1.4; }
.step-copy { max-width: 620rpx; margin-top: 8rpx; color: var(--ui-muted, #746a60); font-size: 26rpx; line-height: 1.6; }
.step-count { flex: 0 0 auto; padding-bottom: 2rpx; color: var(--ui-muted); font-size: 24rpx;  font-weight: 400; white-space: nowrap;}
.step-footnote { margin-top: 20rpx; color: var(--ui-subtle, #958b82); font-size: var(--font-caption, 24rpx); line-height: 1.5; }

.parse-summary { display: flex; margin-top: 18rpx; border-top: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09));  border: 1rpx solid var(--ui-line); border-radius: 20rpx; background: var(--ui-surface);}
.parse-summary-item { flex: 1; padding: 22rpx 12rpx 20rpx; text-align: center; border-right: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09)); }
.parse-summary-item:last-child { border-right: 0; }
.parse-summary-value { color: var(--ui-ink, #29231e); font-size: var(--font-body, 28rpx); font-weight: 500; }
.parse-summary-label { margin-top: 4rpx; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); }

.account-stage .stage-panel-kicker,
.review-stage .stage-panel-kicker { font-size: var(--font-caption, 24rpx); letter-spacing: 2rpx; }
.account-stage .step-title { font-size: var(--font-body, 28rpx); font-weight: 500; }
.account-stage .step-copy { margin-top: 6rpx; font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.account-stage .step-count { font-size: var(--font-caption, 24rpx); }
.account-proof-list { margin-top: 24rpx; border-top: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09));  border: 0;}
.account-proof-item { padding: 22rpx; border-bottom: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09));  margin-bottom: 16rpx; border: 1rpx solid var(--ui-line); border-radius: 22rpx; background: var(--ui-surface);}
.account-proof-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.account-proof-title { min-width: 0; overflow: hidden; color: var(--ui-ink, #29231e); font-size: 28rpx; font-weight: 500; text-overflow: ellipsis; white-space: normal;  line-height: 1.5; overflow-wrap: anywhere;}
.account-proof-meta { flex: 0 0 auto; color: var(--ui-subtle, #958b82); font-size: var(--font-caption, 24rpx); white-space: nowrap; }
.account-decision-row { display: flex; min-height: 88rpx; align-items: stretch; margin-top: 12rpx; overflow: visible; background: var(--ui-surface); border: 1rpx solid var(--ui-line); border-radius: 16rpx; }
.account-mode-trigger { min-width: 0; margin: 0; padding: 0; flex: 0 0 188rpx; color: var(--ui-ink, #29231e); text-align: left; line-height: normal; background: transparent; border-radius: 0; }
.account-mode-trigger.account-mode-trigger-pending,
.account-mode-trigger.account-mode-trigger-pending[disabled] { color: var(--ui-accent-strong, #b85f2e); background-color: var(--ui-accent-soft, #f6e5d8) !important; opacity: 1; }
.account-proof-pending { color: var(--ui-accent-strong, #b85f2e); font-weight: 500; }
.account-mode-trigger-wide { flex: 1 1 auto; }
.account-mode-control,
.account-compact-type-control { display: flex; height: auto; min-height: 88rpx; align-items: center; box-sizing: border-box; padding: 12rpx 18rpx;  justify-content: space-between;}
.account-mode-value,
.account-compact-type-value { min-width: 0; overflow: visible; color: var(--ui-ink, #29231e); font-size: 28rpx; font-weight: 400; text-overflow: clip; white-space: normal;  line-height: 1.5;}
.account-mode-trigger-create .account-mode-value,
.account-mode-trigger-pending .account-mode-value { color: var(--ui-accent-strong, #b85f2e); }
.account-dropdown-chevron { width: 10rpx; height: 10rpx; margin: 0 0 5rpx 12rpx; flex: 0 0 10rpx; color: var(--ui-subtle, #958b82); border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.account-mode-trigger-create .account-dropdown-chevron,
.account-mode-trigger-pending .account-dropdown-chevron { color: var(--ui-accent-strong, #b85f2e); }
.account-decision-divider { width: 2rpx; margin: 14rpx 0; flex: 0 0 2rpx; background: var(--ui-line, rgba(41, 35, 30, .09)); }
.account-compact-name { min-width: 0; height: 88rpx; padding: 0 18rpx; flex: none; color: var(--ui-ink, #29231e); font-size: 28rpx; font-weight: 400; line-height: normal;  width: 100%; box-sizing: border-box;}
.account-compact-type { min-width: 0; flex: none;  width: 100%;}
.account-decision-row:active { opacity: .76; }
.account-transfer-control { width: 100%; align-items: center; justify-content: space-between; padding: 0 18rpx; color: var(--ui-ink, #29231e); text-align: left; line-height: normal; }
.account-inline-note,
.account-state-note { width: 100%; margin-top: 12rpx; color: var(--ui-subtle, #958b82); font-size: 24rpx; line-height: 1.6; }

.account-evidence-trigger { flex: 0 0 auto; color: var(--ui-muted, #746a60); font-size: 24rpx; white-space: nowrap;  min-height: 88rpx; display: flex; align-items: center;}
.account-evidence-trigger.account-proof-pending { color: var(--ui-accent-strong, #b85f2e); }
.account-evidence-trigger:active { opacity: .65; }
.account-source-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.account-source-title { min-width: 0; color: var(--ui-ink, #29231e); font-size: var(--font-caption, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.account-source-amount { flex: 0 0 auto; color: var(--ui-ink, #29231e); font-size: var(--font-caption, 24rpx); }
.account-source-meta,
.account-source-payment { display: block; margin-top: 6rpx; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.account-source-link { width: 100%; min-height: 64rpx; margin: 0; padding: 12rpx 0; text-align: left; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); line-height: 1.5; background: transparent; border-radius: 0; }
.account-records-sheet { max-height: 88vh; }
.account-records-sheet .sheet-copy { font-size: var(--font-caption, 24rpx); }
.account-records-sheet .account-source-link { display: flex; align-items: center; justify-content: flex-end; width: 100%; min-width: 0; height: 64rpx; margin: 0; padding: 0; text-align: right; font-size: var(--font-caption, 24rpx); font-weight: 400; line-height: 1.5; background: transparent; }
.account-records-sheet .account-records-return { display: block; width: 100%; min-width: 0; height: 72rpx; margin: 12rpx 0 0; padding: 0; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); font-weight: 400; line-height: 72rpx; background: transparent; border-radius: 0; }
.account-records-scroll { height: 48vh; margin: 12rpx 0; }
.account-record-item { padding: 20rpx 0 8rpx; border-bottom: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09)); }

.stage-action { padding: 24rpx 0 4rpx; }
.stage-action-error,
.stage-action-progress,
.stage-action-summary { min-height: 32rpx; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); line-height: 1.5; text-align: center; }
.stage-action-error { color: var(--theme-expense, #b54738); }
.stage-action-progress { color: var(--ui-secondary, #64705d); }
.stage-primary { width: 100%; min-height: 88rpx; margin-top: 12rpx;  font-size: 28rpx; font-weight: 500; border-radius: 20rpx; color: var(--ui-on-accent); background: var(--ui-accent);}
.stage-primary[disabled],
.final-primary[disabled] { color: var(--ui-subtle, #958b82); background-color: var(--ui-surface-muted) !important; opacity: 1; }

.review-stage { padding-top: 24rpx; }
.review-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.review-title { margin-top: 4rpx; font-size: 32rpx; font-weight: 500; }
.review-progress { color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.record-count-breakdown { margin: 0; color: var(--ui-muted, #746a60); font-size: 18rpx; line-height: 1.8;  padding: 0; border: 0;}
.record-count-equation { display: block; white-space: normal; overflow-wrap: anywhere;  font-size: 24rpx; line-height: 1.65;}
.step-title.review-slogan { font-size: 34rpx; font-weight: 500; line-height: 1.4; white-space: normal; }
.record-list-note { display: block; margin: 18rpx 0 12rpx; color: var(--ui-muted, #746a60); font-size: var(--font-caption, 24rpx); }
.review-status-tabs { display: flex; flex-wrap: nowrap; gap: 8rpx; width: 100%; margin-top: 18rpx; }
.review-status-tab { position: relative; display: flex; width: 0; min-width: 0; min-height: 88rpx; align-items: center; justify-content: center; gap: 4rpx; margin: 0; padding: 12rpx 6rpx; flex: 1 1 0%; box-sizing: border-box; color: var(--ui-muted, #746a60); font-size: 22rpx; line-height: 76rpx; white-space: nowrap; background: var(--ui-surface, #fffdf9); border-radius: 16rpx; }
.review-decision-heading.review-completed-heading { justify-content: space-between; background: var(--ui-surface, #fffdf9); }
.review-inline-action { margin: 0 0 0 auto; padding: 0 4rpx; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); line-height: 1.4; background: transparent; }
.review-status-tab-active { color: var(--ui-accent-strong, #b85f2e); font-weight: 500; background: var(--ui-surface-muted, #f3eee6); }
.review-status-tab-label { line-height: 1; }
.review-status-tab-count { flex: none; color: var(--ui-subtle, #958b82); font-size: 22rpx; line-height: 1; }
.review-status-tab-active .review-status-tab-count { color: var(--ui-accent-strong, #b85f2e); background: transparent; }
.review-batch-list { margin-top: 18rpx; }
.review-batch { padding: 0 0 16rpx; }
.review-batch + .review-batch { margin-top: 4rpx; }
.review-decision-card { width: 100%; min-width: 100%; max-width: 100%; margin: 0; box-sizing: border-box; color: var(--ui-ink, #29231e); text-align: left; line-height: normal; border-radius: 22rpx;  border: 1rpx solid var(--ui-line); box-shadow: 0 3rpx 12rpx rgba(40, 32, 24, .025);}
.review-decision-card:active { opacity: .76; }
.review-decision-copy,
.review-preview-copy { min-width: 0; flex: 1; }
.review-decision-title,
.review-decision-note,
.review-preview-title,
.review-preview-meta,
.review-preview-more { display: block; }
.review-decision-action { display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); font-weight: 500; }
.review-action-count { padding: 4rpx 8rpx; color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); font-weight: 500; line-height: 1; background: var(--ui-accent-soft, #f6e5d8); border-radius: 12rpx; }
.review-action-button { color: var(--ui-accent-strong, #b85f2e); font-size: var(--font-caption, 24rpx); font-weight: 400; line-height: 1.4; }
.review-preview-list { padding: 0 14rpx; background: var(--ui-surface, #fffdf9); border: 2rpx solid var(--ui-line, rgba(41, 35, 30, .09)); border-top: 0; border-radius: 0 0 12rpx 12rpx; }
