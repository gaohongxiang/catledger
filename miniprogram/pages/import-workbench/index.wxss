.import-page {
  --sheet-scrim: rgba(41, 35, 30, .42);
  padding-top: 24rpx;
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}
button::after { border: 0; }
.import-kicker,
.import-title,
.import-copy,
.stage-number,
.stage-title,
.stage-state,
.stage-panel-kicker,
.stage-panel-title,
.stage-panel-copy,
.file-limit,
.file-batch-title,
.file-batch-count,
.file-name,
.file-meta,
.processing-value,
.processing-title,
.processing-copy,
.step-title,
.step-copy,
.step-count,
.step-footnote,
.parse-summary-value,
.parse-summary-label,
.account-proof-title,
.account-proof-meta,
.account-mode-value,
.account-compact-type-value,
.account-inline-note,
.account-state-note,
.stage-action-error,
.stage-action-progress,
.stage-action-summary,
.review-title,
.review-progress,
.row-title,
.row-detail,
.row-status,
.row-direction,
.row-amount,
.tab-empty-title,
.tab-empty-copy,
.done-title,
.done-copy,
.sheet-kicker,
.sheet-title,
.sheet-copy,
.editor-title,
.editor-detail,
.editor-amount text,
.editor-error,
.readonly-title,
.readonly-copy { display: block; }

.import-heading { padding-bottom: 22rpx; }
.import-kicker,
.stage-panel-kicker,
.sheet-kicker { color: var(--theme-secondary, #64705d); font-size: 19rpx; font-weight: 600; letter-spacing: 3rpx; }
.import-title { margin-top: 7rpx; color: var(--theme-ink, #29231e); font-size: 33rpx; font-weight: 600; }
.import-copy { margin-top: 8rpx; color: var(--theme-text-muted, #746a60); font-size: 23rpx; line-height: 1.5; }

.stage-track { display: flex; align-items: center; padding: 8rpx; background: var(--theme-surface-muted, #f3eee6); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 16rpx; }
.stage-item { position: relative; display: flex; min-width: 0; min-height: 88rpx; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 0 6rpx; flex: 1 1 0; color: inherit; text-align: left; line-height: normal; background-color: transparent !important; border-radius: 12rpx; }
.stage-item[disabled] { color: inherit; background-color: transparent !important; opacity: 1; }
.stage-number { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; box-sizing: border-box; flex: 0 0 40rpx; color: var(--theme-text-subtle, #958b82); font-size: 17rpx; border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 50%; }
.stage-copy { min-width: 0; }
.stage-title { overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 21rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.stage-state { margin-top: 2rpx; color: var(--theme-text-subtle, #958b82); font-size: 18rpx; white-space: nowrap; }
.stage-connector { width: 14rpx; height: 2rpx; margin: 0 3rpx; flex: 0 0 auto; background: var(--theme-line, rgba(41, 35, 30, .09)); }
.stage-current { background-color: var(--theme-accent-soft, #f6e5d8) !important; box-shadow: inset 0 -4rpx 0 var(--theme-accent, #d97732); }
.stage-current .stage-number { color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #d97732); border-color: var(--theme-accent, #d97732); }
.stage-current .stage-title { color: var(--theme-ink, #29231e); font-weight: 700; }
.stage-current .stage-state { color: var(--theme-accent-strong, #b85f2e); }
.stage-done .stage-number { color: var(--theme-secondary, #64705d); background: var(--theme-secondary-soft, #e8eadf); border-color: var(--theme-secondary-soft, #e8eadf); }
.stage-done .stage-state { color: var(--theme-secondary, #64705d); }
.stage-connector-done { background: var(--theme-secondary, #64705d); }
.stage-locked { opacity: .44; }
.stage-item.stage-locked[disabled] { opacity: .44; }

.idle-stage { padding: 54rpx 0 10rpx; }
.stage-panel-title { margin-top: 8rpx; color: var(--theme-ink, #29231e); font-size: 31rpx; font-weight: 600; }
.stage-panel-copy { max-width: 590rpx; margin-top: 10rpx; color: var(--theme-text-muted, #746a60); font-size: 24rpx; line-height: 1.6; }
.file-picker-actions { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 24rpx; }
.file-picker-action { min-width: 0; flex: 1 1 0; }
.file-picker-actions .choose-button,
.file-picker-actions .parse-button { width: 100%; min-width: 0; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; box-sizing: border-box; }
.parse-button-content { display: flex; height: 100%; align-items: center; justify-content: center; gap: 12rpx; }
.parse-button-spinner { width: 24rpx; height: 24rpx; box-sizing: border-box; border: 3rpx solid rgba(255, 250, 241, .42); border-top-color: var(--theme-on-accent, #fffaf1); border-radius: 50%; animation: processing-spin 760ms linear infinite; }
.stage-primary.parse-button-loading[disabled] { color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #d97732); opacity: 1; }
.choose-button-secondary { display: flex; align-items: center; justify-content: center; color: var(--theme-accent-strong, #b85f2e); font-size: 24rpx; font-weight: 600; line-height: normal; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-accent, #d97732); border-radius: 16rpx; }
.choose-button-secondary[disabled] { color: var(--theme-text-subtle, #958b82); background-color: var(--theme-accent-soft, #f5ddcb) !important; border-color: var(--theme-accent-soft, #f5ddcb); opacity: 1; }
.file-limit { margin-top: 14rpx; color: var(--theme-text-subtle, #958b82); font-size: 18rpx; line-height: 1.45; text-align: center; }
.file-picker-summary { margin-top: 14rpx; font-size: 18rpx; line-height: 1.45; }

.text-action { min-height: 88rpx; margin: 0; padding: 0; color: var(--theme-accent-strong, #b85f2e); font-size: 23rpx; line-height: 88rpx; background: transparent; border-radius: 0; }
.file-batch { padding: 10rpx 0 8rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.file-batch-head { display: flex; min-height: 38rpx; align-items: center; gap: 8rpx; }
.file-batch-title { color: var(--theme-secondary, #64705d); font-size: 17rpx; font-weight: 600; letter-spacing: 2rpx; }
.file-batch-count { color: var(--theme-text-subtle, #958b82); font-size: 17rpx; }
.file-list { border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.file-strip { display: flex; min-height: 88rpx; align-items: flex-start; gap: 12rpx; padding: 14rpx 0; box-sizing: border-box; }
.file-mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; flex: 0 0 auto; color: var(--theme-accent-strong, #b85f2e); font-size: 16rpx; font-weight: 600; background: var(--theme-accent-soft, #f6e5d8); border-radius: 10rpx; }
.file-copy { width: 0; min-width: 0; overflow: hidden; flex: 1 1 0%; }
.file-name { display: block; width: 100%; overflow: hidden; font-size: 21rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.file-meta { display: block; width: 100%; margin-top: 2rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.file-reselect { min-width: 88rpx; font-size: 20rpx; text-align: right; }

.processing-stage { display: flex; min-height: 440rpx; align-items: center; justify-content: center; flex-direction: column; text-align: center; }
.processing-mark { position: relative; display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; }
.processing-ring { position: absolute; inset: 0; box-sizing: border-box; border: 3rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-top-color: var(--theme-accent, #d97732); border-radius: 50%; animation: processing-spin 900ms linear infinite; }
.processing-value { color: var(--theme-accent-strong, #b85f2e); font-size: 22rpx; font-weight: 600; }
.processing-title { margin-top: 24rpx; color: var(--theme-ink, #29231e); font-size: 29rpx; font-weight: 600; }
.processing-copy { max-width: 520rpx; margin-top: 9rpx; color: var(--theme-text-muted, #746a60); font-size: 23rpx; line-height: 1.6; }
.committing-stage { min-height: 500rpx; }
@keyframes processing-spin { to { transform: rotate(360deg); } }

.step-section { padding-top: 24rpx; }
.step-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; }
.step-heading > view { min-width: 0; }
.step-title { margin-top: 6rpx; color: var(--theme-ink, #29231e); font-size: 28rpx; font-weight: 600; line-height: 1.32; }
.step-copy { max-width: 620rpx; margin-top: 8rpx; color: var(--theme-text-muted, #746a60); font-size: 20rpx; line-height: 1.55; }
.step-count { flex: 0 0 auto; padding-bottom: 2rpx; color: var(--theme-text-muted, #746a60); font-size: 19rpx; }
.step-footnote { margin-top: 20rpx; color: var(--theme-text-subtle, #958b82); font-size: 20rpx; line-height: 1.5; }

.parse-summary { display: flex; margin-top: 28rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.parse-summary-item { flex: 1; padding: 22rpx 12rpx 20rpx; text-align: center; border-right: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.parse-summary-item:last-child { border-right: 0; }
.parse-summary-value { color: var(--theme-ink, #29231e); font-size: 28rpx; font-weight: 600; }
.parse-summary-label { margin-top: 4rpx; color: var(--theme-text-muted, #746a60); font-size: 19rpx; }

.account-stage .stage-panel-kicker { font-size: 17rpx; letter-spacing: 2rpx; }
.account-stage .step-title { font-size: 26rpx; font-weight: 600; }
.account-stage .step-copy { margin-top: 6rpx; font-size: 19rpx; line-height: 1.5; }
.account-stage .step-count { font-size: 18rpx; }
.account-proof-list { margin-top: 14rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-proof-item { padding: 14rpx 0 16rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.account-proof-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.account-proof-title { min-width: 0; overflow: hidden; color: var(--theme-ink, #29231e); font-size: 21rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.account-proof-meta { flex: 0 0 auto; color: var(--theme-text-subtle, #958b82); font-size: 17rpx; white-space: nowrap; }
.account-decision-row { display: flex; min-height: 80rpx; align-items: stretch; margin-top: 8rpx; overflow: hidden; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 12rpx; }
.account-mode-trigger { min-width: 0; margin: 0; padding: 0; flex: 0 0 188rpx; color: var(--theme-ink, #29231e); text-align: left; line-height: normal; background: transparent; border-radius: 0; }
.account-mode-trigger.account-mode-trigger-create,
.account-mode-trigger.account-mode-trigger-create[disabled] { color: var(--theme-accent-strong, #b85f2e); background-color: var(--theme-accent-soft, #f6e5d8) !important; opacity: 1; }
.account-mode-trigger-wide { flex: 1 1 auto; }
.account-mode-control,
.account-compact-type-control { display: flex; height: 100%; min-height: 80rpx; align-items: center; box-sizing: border-box; padding: 0 18rpx; }
.account-mode-value,
.account-compact-type-value { min-width: 0; overflow: hidden; color: var(--theme-ink, #29231e); font-size: 19rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.account-mode-trigger-create .account-mode-value { color: var(--theme-accent-strong, #b85f2e); }
.account-dropdown-chevron { width: 10rpx; height: 10rpx; margin: 0 0 5rpx 12rpx; flex: 0 0 10rpx; color: var(--theme-text-subtle, #958b82); border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.account-mode-trigger-create .account-dropdown-chevron { color: var(--theme-accent-strong, #b85f2e); }
.account-decision-divider { width: 2rpx; margin: 14rpx 0; flex: 0 0 2rpx; background: var(--theme-line, rgba(41, 35, 30, .09)); }
.account-compact-name { min-width: 0; height: 80rpx; padding: 0 18rpx; flex: 1 1 auto; color: var(--theme-ink, #29231e); font-size: 19rpx; font-weight: 500; line-height: 80rpx; }
.account-compact-type { min-width: 0; flex: 0 0 218rpx; }
.account-decision-row:active { opacity: .76; }
.account-transfer-control { width: 100%; align-items: center; justify-content: space-between; padding: 0 18rpx; color: var(--theme-ink, #29231e); text-align: left; line-height: normal; }
.account-inline-note,
.account-state-note { width: 100%; margin-top: 10rpx; color: var(--theme-text-subtle, #958b82); font-size: 17rpx; line-height: 1.45; }
.account-state-confirmed { color: var(--theme-secondary, #64705d); }

.stage-action { padding: 24rpx 0 4rpx; }
.stage-action-error,
.stage-action-progress,
.stage-action-summary { min-height: 32rpx; color: var(--theme-text-muted, #746a60); font-size: 20rpx; line-height: 1.5; text-align: center; }
.stage-action-error { color: var(--theme-expense, #b54738); }
.stage-action-progress { color: var(--theme-secondary, #64705d); }
.stage-primary { width: 100%; min-height: 88rpx; margin-top: 12rpx; }
.stage-primary[disabled],
.final-primary[disabled] { color: var(--theme-text-subtle, #958b82); background-color: var(--theme-accent-soft, #f5ddcb) !important; opacity: 1; }

.review-stage { padding-top: 26rpx; }
.review-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.review-title { margin-top: 4rpx; font-size: 30rpx; font-weight: 600; }
.review-progress { color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.review-status-tabs { display: flex; width: 100%; min-height: 72rpx; margin-top: 18rpx; border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.review-status-tab { position: relative; display: flex; min-width: 0; min-height: 72rpx; align-items: center; justify-content: center; gap: 9rpx; margin: 0; padding: 0 10rpx; flex: 1; color: var(--theme-text-muted, #746a60); font-size: 19rpx; line-height: 72rpx; background: transparent; border-radius: 0; }
.review-status-tab-active { color: var(--theme-accent-strong, #b85f2e); font-weight: 650; background: var(--theme-accent-soft, #f6e5d8); box-shadow: inset 0 -4rpx 0 var(--theme-accent, #d97732); }
.review-status-tab-label { line-height: 1; }
.review-status-tab-count { display: flex; min-width: 30rpx; height: 30rpx; align-items: center; justify-content: center; box-sizing: border-box; padding: 0 7rpx; color: var(--theme-text-subtle, #958b82); font-size: 16rpx; line-height: 30rpx; background: var(--theme-surface, #fffdf9); border-radius: 15rpx; }
.review-status-tab-active .review-status-tab-count { color: var(--theme-accent-strong, #b85f2e); background: var(--theme-accent-soft, #f6e5d8); }
.review-batch-list { margin-top: 18rpx; }
.review-batch { padding: 0 0 16rpx; }
.review-batch + .review-batch { margin-top: 4rpx; }
.review-decision-card { width: 100%; min-width: 100%; max-width: 100%; margin: 0; box-sizing: border-box; color: var(--theme-ink, #29231e); text-align: left; line-height: normal; border-radius: 12rpx; }
.review-decision-card:active { opacity: .76; }
.review-decision-copy,
.review-preview-copy { min-width: 0; flex: 1; }
.review-decision-title,
.review-decision-note,
.review-preview-title,
.review-preview-meta,
.review-preview-more { display: block; }
.review-decision-action { display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto; color: var(--theme-accent-strong, #b85f2e); font-size: 16rpx; font-weight: 500; }
.review-action-count { padding: 4rpx 8rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 15rpx; font-weight: 500; line-height: 1; background: var(--theme-accent-soft, #f6e5d8); border-radius: 12rpx; }
.review-action-button { padding: 6rpx 10rpx; color: var(--theme-on-accent, #fffaf1); font-size: 16rpx; font-weight: 500; line-height: 1; background: var(--theme-accent, #d97732); border-radius: 10rpx; }
.review-preview-list { padding: 0 14rpx; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-top: 0; border-radius: 0 0 12rpx 12rpx; }
.review-preview-row { display: flex; min-height: 80rpx; align-items: center; gap: 12rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.review-preview-row:last-of-type { border-bottom: 0; }
.review-preview-date { display: flex; width: 54rpx; min-height: 46rpx; align-items: center; justify-content: center; flex: 0 0 54rpx; flex-direction: column; border-right: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.review-preview-day { color: var(--theme-text-muted, #746a60); font-size: 20rpx; font-weight: 500; line-height: 1.05; }
.review-preview-month { margin-top: 3rpx; color: var(--theme-text-subtle, #958b82); font-size: 14rpx; line-height: 1; }
.review-preview-title { overflow: hidden; font-size: 18rpx; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.review-preview-meta { margin-top: 4rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 15rpx; text-overflow: ellipsis; white-space: nowrap; }
.review-preview-amount { flex: 0 0 auto; color: var(--theme-ink, #29231e); font-size: 18rpx; font-weight: 500; }
.review-preview-amount.row-income { color: var(--theme-income, #477153); }
.review-preview-amount.row-expense { color: var(--theme-expense, #b54738); }
.review-preview-more { padding: 10rpx 0 12rpx; color: var(--theme-text-subtle, #958b82); font-size: 15rpx; text-align: center; }
.review-decision-card { padding: 0; overflow: hidden; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.review-decision-card + .review-decision-card { margin-top: 10rpx; }
.review-decision-heading { display: flex; min-height: 72rpx; align-items: center; gap: 14rpx; padding: 10rpx 14rpx; box-sizing: border-box; background: var(--theme-surface-muted, #f3eee6); border-left: 4rpx solid var(--theme-accent, #d97732); }
.review-decision-title { overflow: hidden; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.review-decision-note { margin-top: 4rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 15rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.review-decision-previews { padding-top: 0; border: 0; border-radius: 0; }
.review-audit-list { margin-top: 18rpx; }
.excluded-group-list { width: 100%; margin-top: 18rpx; }
.excluded-group-card { width: 100%; overflow: hidden; margin-top: 12rpx; box-sizing: border-box; background: var(--theme-surface-muted, #f3eee6); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 14rpx; }
.excluded-group-card:first-child { margin-top: 0; }
.excluded-group-toggle { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 18rpx; margin: 0; padding: 14rpx 18rpx; box-sizing: border-box; color: var(--theme-ink, #29231e); text-align: left; line-height: normal; background: var(--theme-surface-muted, #f3eee6); border-radius: 0; }
.excluded-group-toggle-pressed { opacity: .72; }
.excluded-group-copy { min-width: 0; flex: 1; }
.excluded-group-title { display: block; overflow: hidden; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.excluded-group-note { display: block; margin-top: 5rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 15rpx; text-overflow: ellipsis; white-space: nowrap; }
.excluded-group-side { display: flex; align-items: center; gap: 13rpx; flex: 0 0 auto; }
.excluded-group-count { color: var(--theme-accent-strong, #b85f2e); font-size: 17rpx; }
.excluded-group-chevron { width: 11rpx; height: 11rpx; margin: 0 4rpx 0 2rpx; border-top: 3rpx solid var(--theme-text-subtle, #958b82); border-right: 3rpx solid var(--theme-text-subtle, #958b82); transform: rotate(45deg); transition: transform 160ms ease-out; }
.excluded-group-chevron-expanded { transform: rotate(135deg); }
.excluded-group-records { padding: 0 16rpx; background: var(--theme-surface, #fffdf9); border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.review-audit-card { overflow: hidden; margin-top: 12rpx; background: var(--theme-surface, #fffdf9); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 14rpx; }
.review-audit-card:first-child { margin-top: 0; }
.review-audit-row { display: flex; min-height: 82rpx; align-items: center; gap: 18rpx; padding: 12rpx 18rpx; }
.review-audit-note { display: block; color: var(--theme-text-muted, #746a60); font-size: 17rpx; line-height: 1.4; }
.review-audit-card > .review-audit-note { padding: 10rpx 18rpx 13rpx; background: var(--theme-surface-muted, #f3eee6); }
.review-audit-footer { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 18rpx 13rpx; background: var(--theme-surface-muted, #f3eee6); }
.review-audit-badge { flex: 0 0 auto; padding: 5rpx 9rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 16rpx; line-height: 1; background: var(--theme-accent-soft, #f6e5d8); border-radius: 14rpx; }
.review-tabs { display: flex; margin-top: 20rpx; padding: 4rpx; background: var(--theme-surface-muted, #f3eee6); border-radius: 16rpx; }
