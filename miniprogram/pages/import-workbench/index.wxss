.readonly-copy { margin-top: 6rpx; color: var(--theme-text-muted, #746a60); font-size: 22rpx; }
.sheet-actions { display: flex; width: 100%; flex-direction: column; gap: 12rpx; margin-top: 22rpx; box-sizing: border-box; }
.sheet-utility-actions { display: flex; width: 100%; gap: 12rpx; }
.sheet-secondary,
.sheet-confirm { min-height: 84rpx; margin: 0; padding: 0 18rpx; box-sizing: border-box; flex: 1; font-size: 23rpx; font-weight: 600; line-height: 84rpx; border-radius: 14rpx; }
.sheet-secondary { color: var(--theme-text-muted, #746a60); background: var(--theme-accent-soft, #f5ddcb); }
.sheet-confirm { color: var(--theme-on-accent, #fffaf1); background: var(--theme-accent, #d97732); }
.sheet-confirm[disabled] { color: var(--theme-text-subtle, #958b82); background-color: var(--theme-accent-soft, #f5ddcb) !important; opacity: 1; }
.error-copy { margin-top: 20rpx; padding: 18rpx 0; color: var(--theme-expense, #b54738); border-top: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
@keyframes sheet-enter { from { transform: translateY(24rpx); opacity: .72; } to { transform: translateY(0); opacity: 1; } }

@media (prefers-reduced-motion: reduce) {
  .processing-ring { animation: none; }
  .workflow-sheet { animation: none; }
}
.inline-error {
  margin: 18rpx 0 4rpx;
  padding: 16rpx 20rpx;
  color: var(--theme-expense, #b54738);
  font-size: 21rpx;
  line-height: 1.5;
  background: var(--theme-surface, #fffdf9);
  border-left: 5rpx solid var(--theme-expense, #b54738);
}
.file-mark-ready { color: var(--theme-income, #477153); background: var(--theme-secondary-soft, #e8eadf); }
.file-mark-failed { color: var(--theme-expense, #b54738); background: var(--theme-expense-soft, #f7e6e2); }
.file-mark-duplicate { color: var(--theme-text-muted, #746a60); background: var(--theme-surface-muted, #f3eee6); }
.file-error { display: block; width: 100%; max-height: 48rpx; margin-top: 4rpx; overflow: hidden; color: var(--theme-expense, #b54738); font-size: 17rpx; line-height: 24rpx; word-break: break-all; }
.file-row-side { display: flex; width: 136rpx; min-width: 136rpx; min-height: 64rpx; align-items: flex-start; justify-content: flex-end; flex: 0 0 136rpx; }
.file-row-actions { display: flex; width: 136rpx; min-width: 136rpx; align-items: flex-start; justify-content: flex-end; gap: 8rpx; }
.file-row-state { display: block; min-width: 96rpx; padding-top: 20rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 18rpx; line-height: 1; text-align: right; white-space: nowrap; }
.file-small-action { display: flex; width: 64rpx; min-width: 64rpx; height: 64rpx; align-items: center; justify-content: center; box-sizing: border-box; flex: 0 0 64rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 18rpx; line-height: 1; }
.file-small-action-disabled { opacity: .38; }
.file-remove { color: var(--theme-expense, #b54738); }
.file-progress { height: 4rpx; margin-top: 8rpx; overflow: hidden; background: transparent; }
.file-progress-active { background: var(--theme-line, rgba(41, 35, 30, .09)); }
.file-progress-idle .file-progress-value { width: 0 !important; }
.file-progress-value { height: 100%; background: var(--theme-accent, #d97732); transition: width 160ms ease-out; }
.parsed-sources { margin-top: 24rpx; }
.event-list { margin-top: 22rpx; overflow: hidden; background: var(--theme-accent-soft, #f5ddcb); border: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 14rpx; }
.event-row { display: block; min-height: 96rpx; padding: 16rpx 14rpx; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.event-row-pressed { opacity: .76; }
.event-record-body { display: block; }
.event-record-primary,
.event-record-secondary { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.event-record-secondary { margin-top: 5rpx; }
.evidence-link { flex: 0 0 auto; color: var(--theme-accent-strong, #b85f2e); font-size: 17rpx; line-height: 32rpx; white-space: nowrap; }
.evidence-drilldown { display: flex; min-height: 0; height: 72vh; max-height: 72vh; flex-direction: column; }
.evidence-sheet-heading { display: block; }
.evidence-scroll { min-height: 0; margin-top: 18rpx; flex: 1; }
.evidence-return { width: 100%; min-width: 100%; max-width: none; min-height: 82rpx; margin: 14rpx 0 0; box-sizing: border-box; color: var(--theme-text-muted, #746a60); font-size: 22rpx; font-weight: 600; line-height: 82rpx; background: var(--theme-surface-muted, #f3eee6); border-radius: 14rpx; }
.evidence-card { margin-bottom: 20rpx; overflow: hidden; border: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 16rpx; background: var(--theme-surface, #fffdf9); }
.evidence-card-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 18rpx; background: var(--theme-accent-soft, #f6e5d8); }
.evidence-role { color: var(--theme-accent-strong, #b85f2e); font-size: 20rpx; font-weight: 600; }
.evidence-source { min-width: 0; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.evidence-fields { padding: 4rpx 18rpx; }
.evidence-field { display: flex; gap: 18rpx; padding: 13rpx 0; border-bottom: 1rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.evidence-field:last-child { border-bottom: 0; }
.evidence-key { width: 190rpx; flex: 0 0 190rpx; color: var(--theme-text-subtle, #958b82); font-size: 19rpx; }
.evidence-value { min-width: 0; flex: 1; color: var(--theme-ink, #29231e); font-size: 20rpx; line-height: 1.45; word-break: break-all; }
.event-selected { background: var(--theme-accent-soft, #f5ddcb); box-shadow: inset 5rpx 0 0 var(--theme-accent, #d97732); }
.event-title,
.event-meta,
.event-amount { display: block; }
.event-title { min-width: 0; overflow: hidden; flex: 1; font-size: 22rpx; font-weight: 600; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.event-meta { min-width: 0; overflow: hidden; flex: 1; color: var(--theme-text-muted, #746a60); font-size: 18rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.event-amount { flex: 0 0 auto; font-size: 22rpx; font-weight: 600; }
.relation-list { margin-top: 20rpx; }
.relation-heading { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 10rpx; }
.relation-heading text:first-child { color: var(--theme-ink, #29231e); font-size: 23rpx; font-weight: 600; }
.relation-heading text:last-child { color: var(--theme-text-subtle, #958b82); font-size: 18rpx; }
.relation-help { display: block; padding-bottom: 12rpx; color: var(--theme-text-muted, #746a60); font-size: 18rpx; line-height: 1.5; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.relation-options { border-top: 0; }
.relation-row { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 112rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0; margin-left: 0; margin-right: 0; padding: 15rpx 10rpx; box-sizing: border-box; color: var(--theme-ink, #29231e); text-align: left; background: transparent; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); border-radius: 0; }
.relation-selected { background: var(--theme-accent-soft, #f6e5d8); }
.relation-main { min-width: 0; flex: 1; }
.relation-title-line { display: flex; align-items: center; gap: 10rpx; }
.relation-title { min-width: 0; overflow: hidden; flex: 0 1 auto; font-size: 21rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.relation-badge { flex: 0 0 auto; padding: 3rpx 8rpx; color: var(--theme-accent-strong, #b85f2e); font-size: 15rpx; line-height: 1.35; background: var(--theme-accent-soft, #f6e5d8); border-radius: 6rpx; }
.relation-meta { display: block; margin-top: 5rpx; overflow: hidden; color: var(--theme-text-muted, #746a60); font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.relation-side { display: flex; align-items: center; gap: 14rpx; flex: 0 0 auto; }
.relation-amount { font-size: 21rpx; font-weight: 600; }
.relation-side.row-expense .relation-amount { color: var(--theme-expense, #b54738); }
.relation-radio { position: relative; width: 30rpx; height: 30rpx; box-sizing: border-box; border: 3rpx solid var(--theme-line-strong, #c7beb2); border-radius: 50%; }
.relation-selected .relation-radio { border-color: var(--theme-accent, #d97732); }
.relation-selected .relation-radio::after { position: absolute; inset: 6rpx; content: ''; background: var(--theme-accent, #d97732); border-radius: 50%; }
.relation-empty { padding: 26rpx 0; border-bottom: 2rpx solid var(--theme-line, rgba(41, 35, 30, .09)); }
.relation-empty text { display: block; color: var(--theme-text-muted, #746a60); font-size: 19rpx; line-height: 1.55; }
.relation-empty text:first-child { color: var(--theme-ink, #29231e); font-weight: 600; }
.sheet-danger {
  min-height: 84rpx;
  margin: 0;
  padding: 0 14rpx;
  flex: 1;
  color: var(--theme-expense, #b54738);
  font-size: 22rpx;
  line-height: 84rpx;
  background: var(--theme-accent-soft, #f5ddcb);
  border: 0;
  border-radius: 14rpx;
}
.sheet-confirm-wide { width: 100%; min-width: 100%; max-width: none; flex: none; }
.done-mark-muted { background: var(--theme-surface-muted, #f3eee6); }
