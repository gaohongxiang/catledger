.payment-resolution-form .mapping-field { margin-top: 10rpx; }

.repayment-allocation-account input { width: 100%; font-size: var(--font-caption, 24rpx); color: var(--ui-ink, #29231e); }
.repayment-allocation .repayment-allocation-remove { display: flex; align-items: center; justify-content: center; font-weight: 400; white-space: nowrap; box-sizing: border-box; flex: 0 0 88rpx; width: 88rpx; min-width: 88rpx; max-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; color: var(--ui-muted, #746a60); font-size: var(--font-body, 28rpx); line-height: 54rpx; background: transparent; border: 0; }
.repayment-allocation-add { padding: 16rpx 0; font-size: var(--font-caption, 24rpx); color: var(--ui-accent-strong, #b85f2e); }

/* 主任务与核对状态分两层，分类沿用同一证据行。 */
.review-main-tabs { display: flex; margin-top: 16rpx; border-bottom: 2rpx solid var(--ui-line); }
.review-main-tab { flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 16rpx 8rpx; color: var(--ui-muted); font-size: 28rpx; line-height: 1.6; background: transparent; border-radius: 0; }
.review-main-tab-active { color: var(--ui-accent-strong); font-weight: 500; box-shadow: inset 0 -3rpx 0 var(--ui-accent); }
.main-tab-count { margin-left: 8rpx; font-size: 24rpx; font-weight: 500; }
.category-search { box-sizing: border-box; width: 100%; height: 72rpx; margin: 18rpx 0; padding: 0 18rpx; background: var(--ui-surface); border: 1rpx solid var(--ui-line); border-radius: 12rpx; font-size: var(--font-caption, 24rpx); }
.category-decision-card { margin-bottom: 16rpx; }
.review-audit-row[bindtap], .review-audit-card[bindtap] { min-height: 96rpx; }

.category-completed-title { overflow: hidden; text-overflow: ellipsis; }

/* 表单行用上缘分隔；表单与账单证据的边界由证据区单独绘制。 */
.review-editor-sheet .mapping-field { border-bottom: 0; border-top: 1rpx solid var(--ui-line, rgba(41, 35, 30, .09)); }
.review-editor-sheet .relation-row:last-child,
.review-editor-sheet .relation-empty { border-bottom: 0; }

.parse-stage { margin-top: 28rpx; }

.account-mode-control { min-height: 88rpx; height: auto; padding: 12rpx 18rpx; justify-content: space-between; }

.account-mode-value { font-size: 28rpx; font-weight: 400; overflow: visible; white-space: normal; text-overflow: clip; line-height: 1.5; }

.account-inline-note { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }

.review-editor-sheet .sheet-kicker { display: none; }

.review-editor-sheet .sheet-secondary { min-height: 88rpx; height: auto; line-height: 1.5; padding: 18rpx 8rpx; }

.repayment-allocation-input { height: 88rpx; flex: 1 1 120rpx; width: auto; min-width: 0; background: var(--ui-surface); border: 1rpx solid var(--ui-border); }

.repayment-allocation-input input { height: 86rpx; font-size: 28rpx; }

.repayment-allocation .repayment-allocation-all { min-height: 88rpx; }

/* 文件和账户只呈现当前任务，不引入另一套业务状态。 */
.stage-panel-kicker { display: none; }
.file-picker-empty { margin-top: 16rpx; padding: 46rpx 28rpx 26rpx; text-align: center; background: var(--ui-surface); border: 1rpx solid var(--ui-line); border-radius: 26rpx; }
.file-picker-empty .stage-panel-copy { margin: 14rpx auto 26rpx; }
.file-picker-primary { width: 100%; min-height: 88rpx; color: var(--ui-on-accent); background: var(--ui-accent); font-size: 28rpx; font-weight: 500; border-radius: 20rpx; }
.file-picker-symbol { position: relative; width: 80rpx; height: 90rpx; margin: 0 auto 24rpx; }
.file-picker-paper { width: 60rpx; height: 76rpx; border: 2rpx solid var(--ui-border); border-radius: 8rpx; background: var(--ui-surface-muted); }
.file-picker-symbol text { position: absolute; right: 0; bottom: 0; display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; font-size: 30rpx; line-height: 1; background: var(--ui-accent); color: var(--ui-on-accent); border-radius: 50%; }
.file-stage-heading { margin-top: 12rpx; }
.file-list .file-strip:last-child { border-bottom: 0; }
.file-name { overflow: visible; text-overflow: clip; }
.account-proof-identity { min-width: 0; flex: 1; }
.account-match-status { display: block; margin-top: 6rpx; font-size: 24rpx; color: var(--ui-muted); font-weight: 400; line-height: 1.5; }
/* 三项同一行：选择方式 | 可编辑名称 | 类型；不改变任何账户决定。 */
.account-decision-create {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  overflow: hidden;
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-line);
  border-radius: 16rpx;
}
.account-decision-create .account-mode-trigger-create {
  flex: 0 0 176rpx;
  width: auto;
  color: var(--ui-account-create-ink);
  background: var(--ui-account-create-bg);
  border: 0;
  border-radius: 0;
}
.account-decision-create .account-mode-trigger-create[disabled] {
  color: var(--ui-muted);
  background: var(--ui-surface-muted);
  opacity: .65;
}
.account-decision-create .account-mode-value,
.account-decision-create .account-mode-trigger-create .account-dropdown-chevron {
  color: inherit;
}
.account-decision-create .account-mode-control,
.account-decision-create .account-compact-type-control {
  min-height: 88rpx;
  height: 100%;
  padding: 12rpx;
  gap: 8rpx;
}
.account-decision-create .account-mode-value { font-weight: 500; }
.account-decision-create .account-compact-name {
  min-width: 0;
  flex: 1 1 0;
  width: 0;
  height: 88rpx;
  padding: 0 16rpx;
  align-self: center;
  background: transparent;
  border: 0;
  border-radius: 0;
}
.account-decision-create .account-compact-name:focus {
  box-shadow: inset 0 -2rpx 0 var(--ui-accent);
}
.account-decision-create .account-compact-type {
  flex: 0 0 216rpx;
  width: 216rpx;
}
.account-decision-create .account-compact-type-value {
  white-space: normal;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.account-decision-create .account-decision-divider {
  width: 1rpx;
  flex: 0 0 1rpx;
  margin: 16rpx 0;
}
.account-decision-create .account-dropdown-chevron { flex: 0 0 auto; }
.payment-entry-row { display: flex; align-items: stretch; gap: 14rpx; margin-top: 6rpx; }
.payment-total { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; padding: 6rpx 0 24rpx; }
.payment-total-label { font-size: 26rpx; color: var(--ui-muted); }
.payment-total-amount { font-size: 40rpx; font-weight: 500; line-height: 1.4; overflow-wrap: anywhere; }
.sheet-save-hint { display: block; font-size: 24rpx; color: var(--ui-muted); line-height: 1.5; }
.import-page button[disabled] { color: var(--ui-muted); background: var(--ui-surface-muted); opacity: .65; }
.import-page input:focus { border-color: var(--ui-accent); }
/* 减少动态效果时仍保留处理中和禁用文字。 */
@media (prefers-reduced-motion: reduce) { .import-page view, .import-page button { animation: none !important; transition: none !important; } }

/* 问题类型只占标签本身宽度，不恢复整行浅橘标题带。 */
.review-decision-copy .review-decision-title { display: inline-block; max-width: 100%; width: auto; }
