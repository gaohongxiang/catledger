.review-decision-card.pairing-entry { display: block; width: 100%; margin: 18rpx 0 0; padding: 0; }
.pairing-entry-body { padding: 10rpx 20rpx 22rpx; }
.pairing-entry-total { display: flex; align-items: baseline; gap: 10rpx; }
.pairing-entry-number { font-size: var(--font-title, 40rpx); font-weight: 600; line-height: 1.3; color: var(--ui-accent-strong); }
.pairing-entry-title { color: var(--ui-ink); font-size: var(--font-section, 32rpx); font-weight: 500; }
.pairing-entry-copy, .pairing-entry-note { display: block; margin-top: 10rpx; color: var(--ui-muted); font-size: var(--font-caption, 24rpx); font-weight: 400; line-height: 1.5; }
.pairing-entry-note { margin-top: 8rpx; color: var(--ui-accent-strong); }
.pairing-entry[disabled] .review-decision-action { color: var(--ui-muted); }
.pairing-review-sheet .stage-previous { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; width: auto; min-width: 0; min-height: 56rpx; margin: 0; padding: 10rpx 18rpx; border-radius: var(--theme-radius-small, 12rpx); color: var(--ui-accent-strong); background: var(--ui-surface-muted); font-size: var(--font-caption, 24rpx); line-height: 1.5; }
.pairing-review-sheet .stage-previous::after { border: 0; }
.pairing-review-sheet .stage-previous[disabled] { color: var(--ui-muted); opacity: .5; }
.pairing-review-sheet { display: flex; flex-direction: column; height: 88vh; overflow: hidden; }
.pairing-heading { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 16rpx; }
.pairing-heading .sheet-title { flex: 1; min-width: 0; margin: 0; }
.pairing-scope { display: block; flex-shrink: 0; margin-top: 12rpx; font-size: var(--font-caption, 24rpx); line-height: 1.6; color: var(--ui-text); }
.pairing-choice { flex: 0 0 auto; color: var(--ui-accent); white-space: nowrap; }
.pairing-scroll { flex: 1; min-height: 0; height: 1px; margin-top: 20rpx; }
.pairing-scroll-with-selection { margin-top: 16rpx; }
.pairing-notice { display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx; margin-bottom: 20rpx; background: var(--ui-surface-muted); border-radius: 12rpx; font-size: var(--font-caption, 24rpx); line-height: 1.6; }
.pairing-notice .stage-previous { align-self: flex-start; margin: 0; }
.pairing-page-scope, .pairing-card-heading, .pairing-record-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.pairing-page-scope { flex-shrink: 0; flex-wrap: nowrap; justify-content: flex-start; gap: 12rpx; margin-top: 20rpx; padding: 0 22rpx 0 0; border-right: 1rpx solid transparent; font-size: 22rpx; line-height: 1.6; color: var(--ui-muted); }
.pairing-current-page { flex: 0 0 auto; white-space: nowrap; }
.pairing-card { padding: 22rpx; margin-bottom: 20rpx; border: 1rpx solid var(--ui-line); border-radius: 16rpx; }
.pairing-card-selected { border-color: var(--ui-accent); }
.pairing-nature { font-size: var(--font-body, 28rpx); color: var(--ui-text); font-weight: 600; }
.pairing-review-sheet .pairing-card-toggle { display: flex; flex: 1; align-items: center; gap: 12rpx; min-width: 0; min-height: 56rpx; margin: 0; padding: 0; color: var(--ui-text); background: transparent; border-radius: 0; line-height: 1.5; text-align: left; }
.pairing-card-toggle::after { border: 0; }
.pairing-expand-mark { flex: 0 0 10rpx; width: 10rpx; height: 10rpx; margin: -4rpx 4rpx 0 0; border-right: 2rpx solid var(--ui-muted); border-bottom: 2rpx solid var(--ui-muted); transform: rotate(45deg); }
.pairing-expand-mark-collapsed { margin-top: 0; transform: rotate(-45deg); }
.pairing-summary-amount { font-size: var(--font-body, 28rpx); font-weight: 400; white-space: nowrap; }
.pairing-record { padding: 14rpx 0; }
.pairing-source-label, .pairing-record-meta, .pairing-reason { font-size: var(--font-caption, 24rpx); color: var(--ui-muted); line-height: 1.5; }
.pairing-record-title, .pairing-record-meta, .pairing-reason { display: block; margin-top: 8rpx; overflow-wrap: anywhere; }
.pairing-record-title, .pairing-amount { color: var(--ui-text); font-size: var(--font-body, 28rpx); }
.pairing-evidence { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid var(--ui-line); }
.pairing-record-evidence + .pairing-record-evidence { margin-top: 24rpx; }
.pairing-evidence-label { display: block; color: var(--ui-text); font-size: var(--font-caption, 24rpx); font-weight: 500; line-height: 1.5; }
.pairing-original { margin-top: 14rpx; padding: 14rpx; border-radius: 8rpx; background: var(--ui-surface-muted); }
.pairing-link-mark { color: var(--ui-accent); border-top: 1rpx solid var(--ui-line); text-align: center; height: 8rpx; font-size: 32rpx; line-height: 8rpx; }
.pairing-review-sheet .pairing-select-control { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 10rpx; width: auto; min-width: 0; min-height: 56rpx; margin: 0; padding: 0; color: var(--ui-muted); background: transparent; border-radius: 0; font-size: var(--font-caption, 24rpx); font-weight: 400; line-height: 1.5; }
.pairing-review-sheet .pairing-select-all { margin-left: auto; min-height: 40rpx; }
.pairing-select-control::after { border: 0; }
.pairing-select-control[disabled] { opacity: .6; }
.pairing-check { display: flex; flex: 0 0 28rpx; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; box-sizing: border-box; border: 2rpx solid var(--ui-muted); border-radius: 6rpx; font-size: 20rpx; line-height: 1; }
.pairing-check-selected { color: #fff; border-color: var(--ui-accent); background: var(--ui-accent); }
.pairing-footer { flex-shrink: 0; display: flex; flex-direction: column; gap: 12rpx; padding-top: 16rpx; border-top: 1rpx solid var(--ui-line); }
.pairing-progress { color: var(--ui-muted); font-size: var(--font-caption, 24rpx); line-height: 1.5; }
