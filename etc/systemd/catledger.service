[Unit]
Description=CatLedger, a lightweight, self-hosted personal finance app with a user-friendly interface and powerful bookkeeping features.
After=syslog.target
After=network.target
After=mariadb.service mysqld.service postgresql.service

[Service]
Type=simple
User=catledger
Group=catledger
WorkingDirectory=/usr/local/bin/catledger
ExecStart=/usr/local/bin/catledger/catledger server run
Restart=on-failure

[Install]
WantedBy=multi-user.target
